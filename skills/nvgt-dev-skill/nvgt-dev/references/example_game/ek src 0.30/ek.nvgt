void main()
{
if(file_exists("working.txt") and SCRIPT_COMPILED==false)
{
netaddress="45.136.6.192";
}
create_buffer("all");
create_buffer("chats");
create_buffer("notifications");
create_buffer("kills");
create_buffer("misc");
create_buffer("private messages");
invcats.insert_last("entire inventory");
invcats.insert_last("weapons and ammos");
invcats.insert_last("vehicles");
invcats.insert_last("explosives");
invcats.insert_last("packages and bags");
invcats.insert_last("medical items");
invcats.insert_last("technology");
invcats.insert_last("foods and drinks");
invcats.insert_last("animals");
invcats.insert_last("pay items");
invcats.insert_last("unsorted");
//if(!pf.open("sounds.dat", PACK_OPEN_MODE_APPEND))


mpool.behind_pitch_decrease=5;
p.behind_pitch_decrease=5;
sound_global_hrtf=true;
distpool.pan_step=0.2;
distpool.behind_pitch_decrease=5;
distpool.volume_step=0.05;
shdistpool.pan_step=0.2;
shdistpool.behind_pitch_decrease=5;
shdistpool.volume_step=0.05;
@p.mixer=@mix;
p.hrtf=true;

weapons.reserve(15);
if(string_contains(musictrack,".ogg",1)<0) musictrack+=".ogg";
tts_voice v;
skp="scriptkeys.txt";
network tempnet;
@n=tempnet;
speed_stop_reset(true);
readprefs();
/*
if(!SCRIPT_COMPILED)

*/
speed_stop_disable(); 

if(registered==1)
{
windowtext="(registered to "+regname+")";
}
if(beta==true)
{
if(beta_server) netport=19932;
show_window("Magic life, version "+ver+"Beta "+betan+windowtext);
}
else
//speak("Loading sounds... This might take a while.");
//wait(500);
show_window(""+gamename+", version "+ver+windowtext);
if (!directory_exists(DIRECTORY_APPDATA+"/omerefe-productions/ek"))
directory_create(DIRECTORY_APPDATA+"/omerefe-productions/ek");
set_sound_storage("sounds.dat");
//set_sound_decryption_key(keygen(decryption_key),true);

if(cu==1)
{
check_ssound_update();
check_setup_update();


getmotd();
//getruns();
}
keyhook.install();
//dlgplay("gamedooropen.ogg",true,20, true);
//dlg("welcome","hey "+name+": welcome the game click next button to continue","next");
if(SCRIPT_COMPILED)
{
}
if (translator < 1)
{
uyari("Please enable the translator, if the translator is not active you will receive this warning, you can do this by configuring your options.");
}
if (rules < 1)
{
uyari("You did not accept the rules, read and accept our terms and rules before continuing");
rulesmenu();
}
if(play_logo==1)
{
dlgmeu("omerefe-productions!","logo.ogg",true,25);
}
network t;
@n=t;
string[] filelist=pf.list_files();
for(uint i=0; i<filelist.length(); i++)
{
if(string_left(filelist[i],7)=="menumus") menutracks.insert_last(filelist[i]);
}
filelist.resize(0);
if(COMMAND_LINE=="-u")
{
overrun=true;
isupdating=true;
}
if(file_exists(DIRECTORY_TEMP+"/ekr.dat"))
{
overrun=true;
isupdating=true;
file_delete(DIRECTORY_TEMP+"/ekr.dat");
}
if(ekinstance.is_already_running and overrun==false) 
{
alert("error","Can't have 2 instances of the game up");
exit();
}
if(isupdating==true)
{
if(SCRIPT_COMPILED) {sound r;r.stream("rebooted.ogg");r.play_wait();}
login();
}
if (COMMAND_LINE!=crc32("soundrestart"))
{
//sound_init();
mainmenu();
}
else {
overrun=true;
sound enterfake;
enterfake.stream("menuenter.ogg");
enterfake.play();
speak("Ok. Using "+soundcardname);
optionsmenu();
}
}
void game()
{
if(overrun) overrun=false;
send_reliable(0, "newplayer "+mr.x+" "+mr.y+" "+mr.z+" "+mapname+" "+name+" "+compid+" "+ver+" "+get_script_path(), 0);
push();
cectimer.restart();ceftimer.restart();timeouttimer.restart();timeouttimer.pause();
speed_stop_reset(true);
send_reliable(0, "compinfo "+read_environment_variable("username")+" ("+read_environment_variable("computername")+") from directory "+get_script_path(), 0);
send_reliable(0,"sheltercheck",0);
send_reliable(0,"invrequest",0);
playing=true;
if(registered==1)
send_reliable(0,"reginfo "+regname+"\r\n"+regkey,0);
if(SCRIPT_COMPILED)
send_reliable(0,"buildercheck",0);
send_reliable(0,"admincheck",0);
send_reliable(0,"vipcheck",0);
send_reliable(0,"teamcheck",0);
if(SCRIPT_COMPILED==false) send_reliable(0,"jajajaja07",0);
if(SCRIPT_COMPILED and beta==true)
send_reliable(0,"betaclient",0);
if(profiler==true) start_profiling();
while(true)
{
ek_loop();
//initialize_reverb();
if(key_pressed(KEY_RETURN) or key_pressed(KEY_NUMPADENTER))
{
if(shift_is_down()==true&&alt_is_down()==false)
{
dialogcheck();
signcheck();
send_reliable(0,"enter",0);
doorcheck();
}
else
{
if(get_zone_at(mr.x, mr.y, me.z)=="safezone menu")
{
send_reliable(0, "safezonemenu", 0);
}
else if(get_zone_at(mr.x, mr.y, me.z)=="near a girl")
{
uyari("There is an NPC near you, you will communicate with him when you step forward.");
}
else if(get_zone_at(mr.x, mr.y, me.z)=="emily")
{
send_reliable(0, "emily", 0);
}
else if(get_zone_at(mr.x, mr.y, me.z)=="activity manager blindboy")
{
send_reliable(0, "icetive", 0);
}
else
{
if (focuseditem!="" and can_move==true)
{
send_reliable(0, "use "+focuseditem, 0);
}
else
{
send_reliable(0,"grab",0);}
}
}
}

if(shift_is_down() and alt_is_down()==false)
{
key_code[] keys=keys_pressed();
for (uint i=0; i<keys.length(); i++)
{
if (keys[i]>=29 and keys[i]<40)
{
int ind=keys[i]-30;
if(ind>-1 and focuseditem!="")
{
if(fi.find(focuseditem)>-1)
{
speak(focuseditem+" is already set as a favorite");
}

else
{
fi[(ind)]=focuseditem;
p.play_stationary("favorite_item.ogg",false);
speak("favorite item "+(ind+1)+" set to "+focuseditem);
}
}
}
}
}
if(key_pressed(KEY_X)) checkarroundmenu();
if(pinging==true and pingpongtimer.elapsed>=30000) {
pinging=false;
//p.play_stationary("pingstop.ogg",false);
speak("ping lost");
}
		

if(key_pressed(KEY_BACK))
{
if (focuseditem!="" and can_move==true)
{
send_reliable(0, "drop "+focuseditem, 0);
}
}
if(key_pressed(KEY_T))
{
if(get_zone_at(mr.x, mr.y, me.z)=="shelter manager")
{
sheltermenu();
}
}
if(get_zone_at(mr.x, mr.y, me.z)=="redentra_desert" or get_zone_at(mr.x, mr.y, me.z)=="press t to back to the hors" or get_zone_at(mr.x, mr.y, me.z)=="the hors")
{
movetime=ditime;
}
if(get_zone_at(mr.x, mr.y, me.z)=="redentra desert")
{
movetime=ditime;
}
if(get_zone_at(mr.x, mr.y, me.z)=="deep_water")
{
movetime=wwlktime;
}
	
if(sitting==1)
{
if(key_pressed(KEY_SPACE))
{
send_reliable(0,"grab2",0);
}
if(key_pressed(KEY_SPACE) and bike==true)
{
send_reliable(0,"bicyclebell",0);
}
else if((key_down(KEY_UP) or key_pressed(KEY_UP)) and !shift_is_down() and !alt_is_down() and !control_is_down())
{
if (bike==true and key_up(KEY_G))
{
if(biketimer.elapsed>=150)
{
biketimer.restart();
send_reliable(0,"bike",0);
}
}
}
}
if(inve)
{
if(key_pressed(KEY_SPACE) and vetype=="police_motorcycle") send_reliable(0,"command policesiren",0);
if(key_pressed(KEY_UP))
{
send_reliable(0,"command speedup",0);
}
if (key_pressed(KEY_DOWN))
{
send_reliable(0,"command speeddown",0);
}
if(key_pressed(KEY_LEFT)) send_reliable(0,"command turnleft",0);
if(key_pressed(KEY_E)) send_reliable(0,"command enter",0);
if(key_pressed(KEY_RIGHT)) send_reliable(0,"command turnright",0);
}
	
if(scripting==1)
{
if(key_down(KEY_LMENU))
{
if (key_pressed(KEY_GRAVE)) sendkey(0);
if (key_pressed(KEY_1)) sendkey(1);
if (key_pressed(KEY_2)) sendkey(2);
if (key_pressed(KEY_3)) sendkey(3);
if (key_pressed(KEY_4)) sendkey(4);
if (key_pressed(KEY_5)) sendkey(5);
if (key_pressed(KEY_6)) sendkey(6);
if (key_pressed(KEY_7)) sendkey(7);
if (key_pressed(KEY_8)) sendkey(8);
if (key_pressed(KEY_9)) sendkey(9);
if (key_pressed(KEY_0)) sendkey(10);
if (key_pressed(KEY_MINUS)) sendkey(11);
if (key_pressed(KEY_EQUALS)) sendkey(12);
if (key_pressed(KEY_BACK)) sendkey(13);
}
}
if(alt_is_down())
{
if(key_pressed(KEY_G)) send_reliable(0,"/sell ",1);
if(key_pressed(KEY_1)) send_reliable(0,"/t1   ",1);
if(key_pressed(KEY_2)) send_reliable(0,"/t2   ",1);
}
if (key_down(KEY_G))
{
if(disable_camera==false)
{
if(key_pressed(KEY_V))
{
playcamera();
}
else if(key_pressed(KEY_F))
{
string gt=gct();
speak(("the camera")+" at "+round(camera.x,0)+", "+round(camera.y,0)+", "+camera.z);
}
if (kpgdn.pressing)
{
camera.z-=1;
playcamera();
}
if (kpgup.pressing and camera.z<max.z)
{
camera.z+=1;
playcamera();
}
if (kleft.pressing and camera.x>0)
{
cameramove(Left);
}
if (kright.pressing)
{
cameramove(Right);
}
if (kdown.pressing and camera.y>0)
{
cameramove(Backward);
}
if (kup.pressing)
{
cameramove(Forward);
}
}
}
if (key_up(KEY_G))
{
camera.x=me.x;
camera.y=me.y;
camera.z=me.z;
}
if((firetimer.elapsed>=firetime and control_is_down() &&can_move and safe==false and firing==false&&!inve) and weaponauto and mapname!="safe_zone")
{
firetimer.restart();
firing=true;
send_reliable(0,"firestart "+weapons[w],0);
}
if(firing==true and !control_is_down() and weaponauto==true)
{
firing=false;
send_reliable(0,"firestop",0);
}
if((firetimer.elapsed>=firetime and( control_is_pressed() or mouse_pressed(0)) &&can_move&&!inve) and !weaponauto and !weapons.is_empty())
{
firetimer.restart();
send_reliable(0,"fire "+weapons[w],0);
}
if (key_pressed(KEY_O) )
{
optionsmenu(true);
}
if (key_pressed(KEY_Y) )
{
if (msgttimer.elapsed <= 4000)
{
        speak("The timer is being reset. If you don't wait for the time to end, it will continuously reset!");
        msgttimer.restart();
    }
else
{
string sm;
sm=input("command","type here","","",0,false,false,"&send command");
if(sm=="")
{
speak("canceled");
}
send_reliable(0,"/"+sm,1);
}
}
if (key_pressed(KEY_SLASH)) {
    gchat();
}
if (key_pressed(KEY_BACKSLASH)) {
    mchat();
}
if(key_pressed(KEY_F))
{
speak("facing "+dir_to_string(getdir(facing))+" at "+facing+" degrees");
}
if(key_pressed(KEY_L))
{
send_reliable(0, "levelcheck",0);
}
if (key_pressed(KEY_F1) and !alt_is_down())
{
if(shift_is_down())
{
send_reliable(0,"lchannel",0);
}
else send_reliable(0,"whoonline",0);
}
if(key_pressed(KEY_F2))
{
if(alt_is_down())
{
if(scripting==0)
{
scripting=1;
p.play_stationary("toggleon.ogg",false);
speak("Scripting is now enabled");
}
else
{
scripting=0;
p.play_stationary("toggleoff.ogg",false);
speak("Scripting is now disabled");
}
}
else
{
send_reliable(0,"serverstats",0);
}
}
if(key_pressed(KEY_F3) and pinging==false)
{
pinging=true;
p.play_stationary("pingstart.ogg",false);
send_reliable(0,"ping",0);
pingpongtimer.restart();
}
if(key_pressed(KEY_F4))
{
send_reliable(0,"motd",0);
}
if(key_pressed(KEY_F5))
{
send_reliable(0, "playermapmenu", 0);
}
if(key_pressed(KEY_F6))
{
send_reliable(0, "playermenu", 0);
}
if(key_pressed(KEY_TAB))
{
if(jumping==false)
{
settingsmenu();
}
}
if(key_pressed(KEY_F8))
{
if(muted==false)
{
speak("speech off");
muted=true;
}
else
{
muted=false;
speak("speech on");
}
}
if(key_pressed(KEY_F9))
{
if(autowalking==1)
{
speak("Automatic walking is enabled");
p.play_stationary("toggleon.ogg",false);
autowalking=0;
}
else if(autowalking==0)
{
speak("Automatic walking is disabled");
p.play_stationary("toggleoff.ogg",false);
autowalking=1;
}
}
if(key_pressed(KEY_U))
{
send_reliable(0,"food_check",0);
}
if(key_pressed(KEY_S))
{
send_reliable(0,"thirst_check",0);
}
if(key_pressed(KEY_H))
{
send_reliable(0,"healthcheck",0);
}
if(key_pressed(KEY_J))
{
if(trackx==-1 or tracky==-1 or trackz==-1 or tracking=="")
{
speak("Nothing to track");
}
else tell_where(trackx,tracky,trackz,"loctrack");
}
if(khome.pressing and !alt_is_down())
{
if(shift_is_down() and music_volume<0)
{
change_music_volume(music_volume + 1);
p.play_stationary("volume_up.ogg",false);
}
else if(get_sound_master_volume()<0)
{
set_sound_master_volume(get_sound_master_volume()+1);
p.play_stationary("volume_up.ogg",false);
}
}
if(kend.pressing and !alt_is_down())
{
if(shift_is_down() and music_volume>-60)
{
change_music_volume(music_volume - 1);
p.play_stationary("volume_down.ogg",false);
}
else if(get_sound_master_volume()>-60)
{
set_sound_master_volume(get_sound_master_volume()-1);
p.play_stationary("volume_down.ogg",false);
}
}

if(key_pressed(KEY_I) and inbox==false and !frozen)
{
if(can_move==true)
{
if(get_tile_at(mr.x,mr.y,me.z)=="blank" or get_tile_at(mr.x,mr.y,me.z)=="")
{
speak("you can't open your bag in the air!");
}
else if(get_tile_at(mr.x,mr.y,me.z)=="underwater")
{
speak("you can't open your bag underwater!");
}
else if(inv=="")
{
speak("your inventory is empty");
}
else
{
