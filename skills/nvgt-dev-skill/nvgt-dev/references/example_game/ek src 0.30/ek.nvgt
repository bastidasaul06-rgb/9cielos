else if(parsed[0] == "builddialog")
{
    binput@ dat = builder_input("x=enter the x of dialog\ny=enter the y of the dialog\nz=enter the z of the dialog");
    string details = get_dialog_details();
    
    if(details == "")
    {
        speak("canceled");
        return;
    }
    
    if(@dat != null)
    {
        string[] parts = string_split(details, "\n", true);
        if(parts.length()>= 3)
        {
            double x = dat.num("x");
            double y = dat.num("y");
            double z = dat.num("z");
            string title = parts[0];
            string message = parts[1];
            string button = parts[2];
            
            send_reliable(0, "addtile dialog:" + x + ":" + y + ":" + z + ":" + title + ":" + message + ":" + button, 0);
        }
    }
}
