void fallcheck()
{
if(get_tile_at(mr.x, mr.y, me.z)=="" and falling==false and playing==true and jumping==false and playing==true and dmoving==false or get_tile_at(mr.x, mr.y, me.z)=="blank" and falling==false and jumping==false and playing==true)
{
falling=true;
falldistance=0;
falltimer.restart();
p.play_stationary("fall.ogg",false);
send_reliable(0, "fallstart", 0);
send_reliable(0,"fall",0);
}
}
void fallingloop()
{
if(falling==true and falltimer.elapsed > falltime)
{
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank" or me.z==0)
{
falling=false;
if(falldistance < 15)
{
send_reliable(0,"fallstop",0);
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send_reliable(0, "land", 0);
falling=false;
}
else
{
send_reliable(0,"fallstop",0);
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"fall"+random(1, 3)+".ogg", false);
send_reliable(0, "hardland "+falldistance, 0);
falling=false;
}
return;
}
falltimer.restart();
falldistance++;
me.z--;
if(me.z<0)
{
me.z=1;
falling=false;
}
send_reliable(0, "move_to "+me.x+" "+me.y+" "+me.z, 0);
}
}
void playcamera()
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].x==camera.x and players[i].y==camera.y and players[i].z==camera.z)
{
p.play_extended_3d("beacon.ogg", me.x, me.y, me.z, camera.x, camera.y, camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 200.0);
}
}
if (gct()=="")
{
p.play_3d("cameraair.ogg",me.x,me.y,me.z,round(camera.x,0),round(camera.y,0),camera.z,calculate_theta(facing), false);
}
else if (gct()=="fi")
{
p.play_3d("camerafire.ogg",me.x,me.y,me.z,round(camera.x,0),round(camera.y,0),camera.z,calculate_theta(facing), false);
}
else if (gct()=="teleport")
{
p.play_3d("cameratp.ogg",me.x,me.y,me.z,round(camera.x,0),round(camera.y,0),camera.z,calculate_theta(facing), false);
}
else if (gct()=="suicide")
{
p.play_3d("camerasuicide.ogg",me.x,me.y,me.z,round(camera.x,0),round(camera.y,0),camera.z,calculate_theta(facing), false);
}
else if (gct()=="icef")
{
p.play_3d("cameraicef.ogg",me.x,me.y,me.z,round(camera.x,0),round(camera.y,0),camera.z,calculate_theta(facing), false);
}
else if (gct()=="stun")
{
p.play_3d("camerastun.ogg",me.x,me.y,me.z,round(camera.x,0),round(camera.y,0),camera.z,calculate_theta(facing), false);
}
else if (string_contains(gct(),"wall",1)>-1)
{
p.play_extended_3d(gct()+".ogg", me.x, me.y, me.z, round(camera.x,0), round(camera.y,0), camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 200.0);
}
else
{
p.play_extended_3d(gct()+"step"+random(1,5)+".ogg", me.x, me.y, me.z, round(camera.x,0), round(camera.y,0), camera.z, calculate_theta(facing), 0, 0, 0, 0, 0,0,false, 0.0, 0.0, 0.0, 200.0);
}
}
void ek_loop()
{
wait(5);
netloop();
doorcheckloop();
playerloop();
reverb_loop();
if(lowhealth) healthloop();
checkloc();
//musiccheckloop();
msoundcheckloop();
sourcecheckloop();
music_loop();
//reverb_loop();
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
sourcepool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
//musicpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
mpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
distpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
mr.x=round(me.x,0);
mr.y=round(me.y,0);
if(speed_stop_is_hacking(200)==true)
killbitch();
//if(ereboot==true and reboottimer.elapsed>=2500)
if(ereboot==true)
{
ereboot=false;
writeprefs();
connectiontimer.restart();
reset_network();
connected=false;
login();
connected=true;
}
if(sonaring==1 and sonartimer.elapsed>=450)
{
sonartimer.restart();
sonarcheck(mr.x,mr.y,me.z);
}
if(trackitem==true)
{
if(itemtm.elapsed>=1000)
{
itemtm.restart();
p.play_3d("obj.ogg", me.x,me.y,me.z,trackix,trackiy,trackiz,calculate_theta(facing),false);
}
string get=calculate_x_y_string(calculate_x_y_angle(mr.x,mr.y,trackix,trackiy,facing));
if(get=="streight in front" and itemtm2.elapsed>=80)
{
itemtm2.restart();
p.play_stationary("track.ogg",false);
}
if(mr.x==trackix and mr.y==trackiy and me.z==trackiz)
{
p.play_stationary("loctracked.ogg",false);
trackix=-1; trackiy=-1; trackiz=-1;
trackitem=false;
}
}
if(trackx!=-1 and tracky!=-1 and trackz!=-1 and tracking!="")
{
if(trackingtimer.elapsed>700)
{
trackingtimer.restart();
p.play_3d("loctrack.ogg", me.x, me.y, me.z, trackx, tracky, trackz, calculate_theta(facing), false);
}
if(currentloc==tracking)
{
p.play_stationary("loctracked.ogg",false);
trackx=-1; tracky=-1; trackz=-1; tracking="";
}
}
if (jumping==true)
{
movetime=airtime;
}
else
{
movetime=walktime;
}
if(in_map&&!following&&!frozen&&playing&&!inve)
{
fallloop();
fallcheck();
fallingloop();
}
}
bool speak_chars=true;
string chat(string h, string t="") {
int cursor=0;
string []ms;
speak(h);
string message;
get_characters();
if(t!="") {
for(int i=0; i<t.length(); i++) {
ms.insert_last(t[i]);
cursor++;
}
speak(t);
}
while(true) {
wait(5);
ek_loop();
netloop();
string char=get_characters();
if(char!="") {

ms.insert_at(cursor, char);
cursor++;
speak_char(ms[cursor-1], speak_chars);
}
if(ms.length()>2048) {
//speak("Ïðåâûøåíî ìàêñèìàëüíîå êîëè÷åñòâî ñèìâîëîâ.", true);
for(int i=ms.length(); i>2048; i--) {
ms.remove_last();
cursor--;
}
}
if(key_pressed(KEY_F2)) {
if(speak_chars==true) {
speak_chars=false;
speak("character repeat off.");
}
else {
speak_chars=true;
speak("character repeat on.");
}
}
if(key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL)) {
if(key_pressed(KEY_C)) {
string c;
for(int i=0; i<ms.length(); i++)
c+=ms[i];
if(c.length()>0) {
clipboard_copy_text(c);
speak("text copied to clipboard.");
}
else
speak("null.");
}
if(key_pressed(KEY_V)) {
string v=clipboard_read_text();
if(v=="")
speak("no text on clipboard.");
else {
for(int i=0; i<v.length(); i++) {
ms.insert_last(v[i]);
cursor++;
}
speak("text pasted from clipboard.");
}
}
}
if(key_pressed(KEY_END)) {
if(ms.length()>0) {
cursor=ms.length();
speak_char("blank");
}
else
speak_char("blank");
}
if(key_pressed(KEY_HOME)) {
if(ms.length()>0) {
cursor=0;
speak_char(ms[cursor]);
}
else
speak_char("blank");
}
if(key_pressed(KEY_BACK) and ms.length()>0 and cursor>0) {
speak_char(ms[cursor-1]);
ms.remove_at(cursor-1);
cursor--;
}
if(key_pressed(KEY_DELETE)) {
if(cursor<ms.length()-1)
speak_char(ms[cursor+1]);
else
speak("blank");
if(ms.length()>0 and cursor<ms.length())
ms.remove_at(cursor);
}
if(key_pressed(KEY_LEFT)) {
if(ms.length()>0) {
if(cursor>0)
cursor--;
speak_char(ms[cursor], true);
}
else
speak_char("blank");
}
if(key_pressed(KEY_RIGHT)) {
if(cursor<ms.length() and ms.length()>0) {
cursor++;
if(cursor>=ms.length())
speak_char("blank");
else {
speak_char(ms[cursor], true);
}
}
else
speak_char("blank");
}
if(key_pressed(KEY_UP) or key_pressed(KEY_DOWN)) {
string a;
for(int i=0; i<ms.length(); i++) {
a+=ms[i];
}
if(a!="")
speak_char(a);
else
speak("blank");
}
if(key_pressed(KEY_ESCAPE))
break;
if(key_pressed(KEY_RETURN)) {
for(int i=0; i<ms.length(); i++) {
message+=ms[i];
}
return message;
}
}
return "";
}
void speak_char(string c, bool sp=true) {
if(sp==true) {
if(c==" ")
speak("blank");
else
speak(c);
}
}
bool is_sound_number(string t)
{
t=string_replace(t, ".", "", true);
t=string_replace(t, "-", "", true);
if(string_is_digits(t))
return true;
return false;
}

void killbitch()
{
//alert("error","You can not speedhack in the game");
send_reliable(0,"speedhacking",0);
exit();
}
void sendkey(int number)
{
string[] keys;
file f;
f.open(skp,"rb");
keys=string_split(f.read(),"\r\n",false);
f.close();
if ((keys.length()-1)>=number)
{
string[] stuff=string_split(keys[number],"::",true);
for(uint i=0; i<stuff.length(); i++)
{
if(stuff[i]!="")
{
send_reliable(1,stuff[i],1);
}
else
{
speak("Script key not assigned.");
}
}
}
else
{
speak("Script key not assigned.");
}
}
string get_script_path()
{
string scriptpath;
if(SCRIPT_COMPILED==false)
{
scriptpath=SCRIPT_CURRENT_FILE;
}
else
{
scriptpath=SCRIPT_EXECUTABLE;
}
return scriptpath;
}
void pos()
{
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
sourcepool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
//musicpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
mpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
distpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
}
void playermenu(string[] users)
{
get_characters();
string cl;
//speak("Players menu.");
speak("Players menu. Please select a player with the up/down arrows and use the f1 to f4 keys to view their information. You can send a private message to the player by pressing enter.");
int counter=0;
while(true)
{
if(speed_stop_is_hacking(200)==true)
killbitch();
cl=get_characters();
wait(5);
ek_loop();
netloop();
if(counter > users.length())
{
counter=users.length()-1;
}
if(cl!="" and cl.length()==1)
{
int f=0;
int oc=counter;
for(uint i=counter; i<users.length(); i++)
{
if(i==counter)
{
continue;
}
if(users[i][0]==cl)
{
counter=i;
speak(users[counter]);
cl="";
f=1;
break;
}
}
if(f==0)
{
counter=0;
for(uint i=counter; i<users.length(); i++)
{
if(users[i][0]==cl)
{
counter=i;
speak(users[counter]);
cl="";
f=1;
break;
}
}
}
if(f==0)
{
speak("No such player exists");
}
}
if(key_pressed(KEY_UP))
{
if(users.length()==1)
{
speak(users[0]);
counter=0;
}
else if(counter > 0)
{
counter--;
speak(users[counter]);
}
}
if(key_pressed(KEY_DOWN))
{
if(users.length()==1)
{
speak(users[0]);
counter=0;
}
else if(counter < users.length()-1)
{
counter++;
speak(users[counter]);
}
}
if(alt_is_down())
{
if(key_pressed(KEY_M))
{
send_reliable(0, "/mute "+users[counter], 1);
}
if(key_pressed(KEY_U))
{
send_reliable(0, "/unmute "+users[counter], 1);
}
}
if(key_pressed(KEY_F1) and users[counter]!="" and counter <= users.length()-1)
{
send_reliable(0, "/stats "+users[counter], 1);
}
if(key_pressed(KEY_F2) and users[counter]!="" and counter <= users.length()-1)
{
send_reliable(0, "/charinfo "+users[counter], 1);
}
if(key_pressed(KEY_F3) and users[counter]!="" and counter <= users.length()-1)
{
send_reliable(0, "/where "+users[counter], 1);
}
if(key_pressed(KEY_F4) and users[counter]!="" and counter <= users.length()-1)
{
send_reliable(0, "/lang "+users[counter], 1);
}
if(key_pressed(KEY_F5) and users[counter]!="" and counter <= users.length()-1)
{
send_reliable(0, "/check_vip "+users[counter], 1);
}

/*
if(key_pressed(KEY_F5) and users[counter]!="" and counter <= users.length()-1)
{
send_reliable(0, "/kills "+users[counter], 1);
}
*/
if(key_pressed(KEY_C) and control_is_down() and users[counter]!="" and counter <= users.length()-1)
{
speak(users[counter]+" copyed to clipboard");
clipboard_copy_text(users[counter]);
//return;
}
if(key_pressed(KEY_RETURN) or key_pressed(KEY_NUMPADENTER) and users[counter]!="" and counter <= users.length()-1)
{
string message=input("message","enter the message that you want to send to "+users[counter],"","",0,false,true,"&send message");
if(message!="") send_reliable(0, "/pm "+users[counter]+" "+message, 1);
return;
}
if(key_pressed(KEY_ESCAPE))
{
speak("canceled");
return;
}
}
return;
}
