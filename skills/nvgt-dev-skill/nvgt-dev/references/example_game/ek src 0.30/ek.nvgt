int get_sequence(const string s, const bool only_alpha=false) {
int o=1;
if (s.length()<=1)
return -1;
for(uint i=0; i<s.length(); i++) {
for(uint ii=i+1; ii<s.length(); ii++) {
if (s[i]==s[ii]) {
if (only_alpha and string_is_alphabetic(s[i]) or !only_alpha)
o++;
break;
}
else
return o;
}
}
return o;
}
bool is_eloquence_crash_word(string phrase)
{
phrase=string_to_lower_case(phrase);
if (string_contains(phrase,":22nd",1)!=-1)
return true;
if (string_contains(phrase,":23nd",1)!=-1)
return true;
if (string_contains(phrase,":24nd",1)!=-1)
return true;
if (string_contains(phrase,":25nd",1)!=-1)
return true;
if (string_contains(phrase,"hesday",1)!=-1)
return true;
if (string_contains(phrase,"'d're",1)!=-1)
return true;
if (string_contains(phrase,"'d've",1)!=-1)
return true;
if (string_contains(phrase,"uncosp",1)!=-1)
return true;
if (string_contains(phrase,"deadhes",1)!=-1)
return true;
if (string_contains(phrase,"webhes",1)!=-1)
return true;
if (string_contains(phrase,"melhes",1)!=-1)
return true;
if (string_contains(phrase,"hesfall",1)!=-1)
return true;
if (string_contains(phrase,"hesspace",1)!=-1)
return true;
if (string_contains(phrase,"heskill",1)!=-1)
return true;

return false;
}
void exitmenu()
{
get_characters();
speak("really exit? press enter or y for yes. otherwise, escape or n for no");
while(true)
{
wait(5);
ek_loop();
if(key_pressed(KEY_UP)||key_pressed(KEY_DOWN)||key_pressed(KEY_LEFT)||key_pressed(KEY_RIGHT))
{
speak("really exit? press enter or y for yes. otherwise, escape or n for no");
}
if(key_pressed(KEY_RETURN)||key_pressed(KEY_NUMPADENTER)||key_pressed(KEY_Y))
{
send_reliable(0,"close",0);
xtimer.restart();
x=true;
return;
}
if(key_pressed(KEY_ESCAPE)||key_pressed(KEY_N))
{
speak("canceled");
return;
}
}
}
void serverinput(string title="test",string packet="testmenu",string inputn="enter text",int length=0,int r=0,int ml=0,string button1="ok",string button2="&cancel",int button1auto=0,int button2auto=0)
{
bool read=int_to_bool(r);
bool mul=int_to_bool(ml);
bool but1=int_to_bool(button1auto);
bool but2=int_to_bool(button2auto);
string rofl;
rofl=input(title,inputn,"","",length,read,mul,button1,button2,but1,but2);
if(rofl=="")
{
send_reliable(0,packet+" [cncel]",0);
return;
}
send_reliable(0,packet+" "+rofl,0);
}
