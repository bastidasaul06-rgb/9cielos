#include"dlfile.bgt"
#include"hip.bgt"
void cfu(string name, string zipname, bool silent)
{
sound updating;
//speak("Checking game and sounds version...");
speak("Checking for updates...");
string latest=url_get("http://www.ice-master.duckdns.org/version.txt");
double lv=string_to_number(latest);
//string description=url_get("http://ice-master.duckdns.org/update_description.txt");
string[] yourversion=string_split(ver," ",true);
double yv=string_to_number(yourversion[0]);
if (yv>lv and silent==false)
{
speak("Oops! There was an error checking for updates!. This could be because you are running a beta, or the server was not contacted!. Version: "+ver+". Latest: "+latest);
}
else if (yv==lv and silent==false)
{
dlg("No updates were found at this time!",""+ver+" Is the newest version!","ok");
}
else if (yv<lv)
{
//string description=get_from_url("http://www.ice-master.duckdns.org/update_description.txt");
updatemus.stream("updating2.ogg");
//updatemus.volume=-10;
updatefound.stream("up_date.ogg");
updatefound.volume=-5;
updatedone.stream("updated.ogg");
p.play_stationary("update.ogg",false);
wait(5000);
updatefound.play_wait();
dlg("A new update for era of knights has been detected!","Your version: "+ver+": Required version: "+latest+": You can choose whether to download or not by pressing next.","next");
int e;
e=yesno("Do you like to download it now?");
if(e==1)
{
speak("Starting update process.");
sound updatestarting; updatestarting.stream("update_starting.ogg"); updatestarting.play_wait();
updatemus.play_looped();
string status=dl_file("http://www.ice-master.duckdns.org/ek.zip","ek.zip");
if(status=="finished")
{
updatemus.stop();
updatedone.play_wait();
alert("update completed","era of knights "+latest+" has been downloaded. Press enter to continue.");
//run("replacer.exe","",true,true);
//run("uz.exe","",true,true);
//run("unzip.exe","-o -qq "+zipname,false,false);
exit();
}
}
}
}
