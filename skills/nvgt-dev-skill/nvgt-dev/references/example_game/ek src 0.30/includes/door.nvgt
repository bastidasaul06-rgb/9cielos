bool dmoving;
door@[] doors(0);
class door
{
string ds, ds2, ds3, ds4;
int doorsound, doorsound2;
int dx;
int dy;
bool locked;
string passcode;
int dz;
int finishx;
int finishy;
int finishz;
int movetime=150;
bool moving;
bool aimoving;
timer movetimer;
string passtext="enter the password of this door";
door(int doorx, int doory, int doorz, int doorfinishx, int doorfinishy, int doorfinishz,int speed, string doorsnd, string doorsnd2, string doorsnd3, string doorsnd4,bool lc=false,string pscode="",string pt="enter the password of this door")
{
ds=doorsnd;
ds2=doorsnd2;
ds3=doorsnd3;
ds4=doorsnd4;
dx=doorx;
dy=doory;
dz=doorz;
finishx=doorfinishx;
finishy=doorfinishy;
finishz=doorfinishz;
movetime=speed;
doorsound=p.play_3d(ds, me.x, me.y, me.z,dx, dy, dz,calculate_theta(facing),true);
locked=lc;
if(locked)
{
passcode=pscode;
passtext=pt;
}
}
}
void doorcheckloop()
{
for (uint i=0; i<doors.length(); i++)
{
p.update_sound_3d(doors[i].doorsound, doors[i].dx, doors[i].dy,doors[i].dz);
if (doors[i].moving==true and doors[i].movetimer.elapsed>=doors[i].movetime)
{
doors[i].movetimer.restart();
if(doors[i].movetime==-1)
{
me.x=doors[i].finishx;
me.y=doors[i].finishy;
me.z=doors[i].finishz;
if(doors[i].finishx==me.x and doors[i].finishy==me.y and doors[i].finishz==me.z and doors[i].moving==true)
{
if (doors[i].ds2!="none.ogg")
{
p.destroy_sound(doors[i].doorsound2);
}
send_reliable(0,"xplay "+doors[i].ds4,0);
can_move=true;
dmoving=false;
doors[i].moving=false;
send_reliable(0,"iamnotdmoving",0);
send_reliable(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
send_reliable(0,"playonmap "+doors[i].ds4,0);
p.play_stationary(doors[i].ds4,false);
}
return;
}
if (mr.x>doors[i].finishx)
{
me.x-=1;
if(fordoor.elapsed>=2000)
{
fordoor.restart();
send_reliable(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
}
}
else if (mr.x<doors[i].finishx)
{
me.x+=1;
if(fordoor.elapsed>=2000)
{
fordoor.restart();
send_reliable(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
}
}
if (mr.y>doors[i].finishy)
{
me.y-=1;
if(fordoor.elapsed>=2000)
{
fordoor.restart();
send_reliable(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
}
}
else if (mr.y<doors[i].finishy)
{
me.y+=1;
if(fordoor.elapsed>=2000)
{
fordoor.restart();
send_reliable(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
}
}
if (me.z>doors[i].finishz)
{
me.z-=1;
if(fordoor.elapsed>=2000)
{
fordoor.restart();
send_reliable(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
}
}
else if (me.z<doors[i].finishz)
{
me.z+=1;
if(fordoor.elapsed>=2000)
{
fordoor.restart();
send_reliable(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
}
}
}
if(doors[i].finishx==mr.x and doors[i].finishy==mr.y and doors[i].finishz==me.z and doors[i].moving==true)
{
if (doors[i].ds2!="none.ogg")
{
p.destroy_sound(doors[i].doorsound2);
}
send_reliable(0,"xplay "+doors[i].ds4,0);
can_move=true;
dmoving=false;
doors[i].moving=false;
send_reliable(0,"iamnotdmoving",0);
send_reliable(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
send_reliable(0,"playonmap "+doors[i].ds4,0);
p.play_stationary(doors[i].ds4,false);
}
}
}
void destroy_door(int d)
{
p.destroy_sound(doors[d].doorsound);
doors.remove_at(d);
}
void destroy_all_doors()
{
for(uint i=0; i<doors.length(); i++)
{
p.destroy_sound(doors[i].doorsound);
}
doors.resize(0);
}
void spawn_door(int doorx, int doory, int doorz, int finishx, int finishy, int finishz, int speed, string doorsnd, string doorsnd2, string doorsnd3, string doorsnd4,bool locked=false,string passcode="",string passtext="enter the password of this door")
{
door door1(doorx, doory, doorz,finishx, finishy, finishz, speed, doorsnd, doorsnd2, doorsnd3, doorsnd4,locked,passcode,passtext);
doors.insert_last(door1);
}