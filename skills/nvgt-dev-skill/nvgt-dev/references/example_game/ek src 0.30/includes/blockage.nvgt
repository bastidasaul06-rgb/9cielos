blockage@[] blos;
class blockage
{
double minx,maxx,miny,maxy,minz,maxz; //coordinates
string text; //the text to speak.
blockage(double a,double b,double c,double d,double e,double f,string t)
{
minx=a;
maxx=b;
miny=c;
maxy=d;
minz=e;
maxz=f;
text=t;
}
}
void blockagecheck()
{
for(uint i=0; i<blos.length(); i++)
{
if((blos[i].minx<=mr.x and blos[i].maxx>=mr.x) and (blos[i].miny<=mr.y and blos[i].maxy>=mr.y) and (blos[i].minz<=me.z and blos[i].maxz>=me.z))
{
speak(blos[i].text);
}
}
}
void spawn_blockage(double a,double b,double c,double d,double e,double f,string t)
{
blockage s1(a,b,c,d,e,f,t);
blos.insert_last(s1);
}
void destroy_blockage(int d)
{
blos.remove_at(d);
}
void destroy_all_blos()
{
blos.resize(0);
}