}
if(m.get_item_name(mres)=="key_click_sounds")
{
if(key_click_sounds==0)
{
key_click_sounds=1;
speak("keyboard click sounds enabled");
writeprefs();
}
else
{
key_click_sounds=0;
speak("keyboard click sounds disabled");
writeprefs();
}
optionsmenu();
}
if (m.get_item_name(mres)=="redownload")
{
speak("Please wait...");
wait(1250);
run("C:\\Windows\\System32\\explorer.exe","http://www.engelsiz-productions.tk/ek.zip",false,false);
mainmenu();
}
if(m.get_item_name(mres)=="output")
soundcardmenu();
if(m.get_item_name(mres)=="musicmenu")
musicmenu();
if(m.get_item_name(mres)=="speechmode")
{
speechmodemenu();
}
else if(m.get_item_name(mres)=="sapivoice")
{
speak("Please select a voice using the up and down keys, and press enter to select");
ttsvoice=df_s.select_voice();
writeprefs();
df_s.set_voice(ttsvoice);
optionsmenu();
}
else if(m.get_item_name(mres)=="sprate")
{
speechratemenu();
}
else if(m.get_item_name(mres)=="vol")
{
volumemenu();
}
if(m.get_item_name(mres)=="visual")
{
if(playmusic==0)
{
playmusic=1;
speak("You will now hear music while playing the game");
writeprefs();
optionsmenu();
}
else
{
speak("You will no longer hear the music while playing the game");
playmusic=0;
optionsmenu();
writeprefs();
}
}
if (m.get_item_name(mres)=="back" or m.get_item_name(mres)==0)
{
dlgplay("gamedoorcancel.ogg",true,500);
exitgame(true);
mainmenu();
return;
}
}
