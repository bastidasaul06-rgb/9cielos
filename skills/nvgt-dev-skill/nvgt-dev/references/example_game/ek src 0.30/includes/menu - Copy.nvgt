{
importbufferlogs=1;
speak("buffer logging enabled");
writeprefs();
}
else
{
importbufferlogs=0;
speak("Buffer logging disabled");
writeprefs();
}
optionsmenu();
}
if(m.get_item_name(mres)=="bfbeep")
{
if(bufferbeep==0)
{
bufferbeep=1;
speak("buffer beeping sound enabled");
writeprefs();
}
else
{
bufferbeep=0;
speak("Buffer beeping sound disabled");
writeprefs();
}
optionsmenu();
}
if(m.get_item_name(mres)=="readerinterrupt")
{
readerinterrupt=toggle(readerinterrupt);
