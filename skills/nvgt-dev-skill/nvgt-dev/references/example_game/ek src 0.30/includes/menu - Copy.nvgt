#include"mapdata.bgt"
bool switched=false;
dynamic_menu_pro m;
void mainmenu()
{
show_game_window("aha nane");
setupmenu(true,true);
if(rules==1)
{
m.add_item_tts("login options","loptions");
}
m.add_item_tts("settings","optionsmenu");
m.add_item_tts("check for updates", "cfu");
if(!switched&&!SCRIPT_COMPILED) m.add_item_tts("change server to localhost","localhost");
m.add_item_tts("test speakers", "speaker_test");
m.add_item_tts("restart the game","reboot");
m.add_item_tts((rules==0?"You have not agreed to the era of knights rules. Press enter to agree":"You have agreed to the era of knights rules, thanks!"),"rules","",(rules==0?true:false));
m.add_item_tts("Exit","exit");int mres=m.run("Main Menu",true);
if(m.get_item_name(mres)=="cfu")
{
m.fade_music(20);
cfu("ek","ek.zip",false);
//sndcheck();
mainmenu();
}
else if(m.get_item_name(mres)=="rules") {
int r=question("Confirmation","Do you agree to the era of knights rules? These rules can be found in !rules.txt in your copy of era of knights. By clicking yes, you agree that you have read and understood these rules. Do you agree?");
if(r==1) {
rules=r;
writeprefs();
}
else {
alert("Unfortunately","you cannot play the game if you do not agree with the rules. Thank you, the game will exit.");
exit();
}
mainmenu();
}
if(m.get_item_name(mres)=="localhost")
{
connected=false;
switched=true;
if(netaddress=="engelsiz-productions.tk") netaddress="localhost";
else netaddress="engelsiz-productions.tk";
netaddress="localhost";
speak("switched");
mainmenu();
}
else if(m.get_item_name(mres)=="speaker_test")
{
//m.fade_music(20);
speakermenu();
}
if(m.get_item_name(mres)=="reboot")
{
m.fade_music(20);
if(!SCRIPT_COMPILED)
{
rebootmaster();
}
else
{
reboot();
}
}
if(m.get_item_name(mres)=="loptions")
{
//m.fade_music(30);
loginoptionsmenu();
}
else if(m.get_item_name(mres)=="unlock")
{
ask_for_reg();
mainmenu();
}
if(m.get_item_name(mres)=="multimenu")
{
mainmenu();
}
else if(m.get_item_name(mres)=="optionsmenu")
{
optionsmenu();
}
else
{
//m.fade_music(10);
writeprefs();
//wait(50);
wait(250);
dlgplay("gamedoorcancel.ogg",true,500);
exit();
}
}
void setupmenu(bool main=false, bool audo=false)
{
m.reset(true);
if (main==true)
m.add_music("menumus"+random(1,20)+".ogg");
m.open_sound="menuopen.ogg";
m.enter_sound="menuenter.ogg";
m.click_sound="menumove.ogg";
m.wrap_sound="menuwrap.ogg";
if(audo==true)
m.letters_autoactivate=true;
m.edge_sound="menuedge.ogg";
if(sidescrolling==1)
{
m.enable_side_scrolling=true;
}
if(wrap==1)
{
m.wrap=true;
}
m.enable_first_letter_navigation=true;
if(sidescrolling==1)
m.enable_left_and_right=true;
else
{
m.enable_up_and_down=true;
m.enable_side_scrolling=false;
}
if(wrap==1)
m.wrap=true;
else
{
m.wrap=false;
}
m.enable_home_and_end=true;
//m.click_at_edge=true;
m.repeat_items_at_edges=true;
//m.speak_position_information=true;
if(!main)
m.set_callback(netclb,"");
}
void loginoptionsmenu()
{
setupmenu(true,true);
if(rules==1)
{
m.add_item_tts("log in as "+name+"","login");
m.add_item_tts("Setup an existing account","setup","a");
m.add_item_tts("Create a new account","create");
//m.add_item_tts("forgot password","reset","f");
m.add_item_tts("Go back","back","b");
}
int mres=m.run("login menu",true);
if(m.get_item_name(mres)=="back" or mres==0) mainmenu();
else if(m.get_item_name(mres)=="reset")
{
//m.fade_music(20);
passmenu();
}
if(m.get_item_name(mres)=="login")
{
m.fade_music(20);
login();
m.fade_music(20);
}
else if(m.get_item_name(mres)=="create")
{
creating=true;
m.fade_music(20);
create();
m.fade_music(20);
}
else if(m.get_item_name(mres)=="setup")
{
m.fade_music(20);
string user=v.input("Enter a username", false, false);
if(user=="") mainmenu();
string pass=v.input("Enter a password", false, true);
if(pass=="")
mainmenu();
name=user;
password=pass;
writeprefs();
dlg("Success!");
mainmenu();
}
}
void passmenu()
{
setupmenu(true,true);
m.add_item_tts("request a password reset key","requestpasskey","q");
m.add_item_tts("enter a password reset key","enterpasskey","r");
m.add_item_tts("Go back","back","b");
int mres=m.run("password menu",true);
if(m.get_item_name(mres)=="back" or mres==0) loginoptionsmenu();
else if(m.get_item_name(mres)=="requestpasskey")
{
 resetpass();
}
if(m.get_item_name(mres)=="enterpasskey")
{
resetpasskey();
}
}
