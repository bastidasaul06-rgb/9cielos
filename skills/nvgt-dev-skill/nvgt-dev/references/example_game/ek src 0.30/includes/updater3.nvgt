#include "dlfile.bgt"
#include "hip.bgt"
void check_game_update()
{
sound update;
speak("checking for updates");
string current_version=version;
string latest_version=url_get("http://darkness-king.duckdns.org/games/sb/version.txt");
string description=url_get("http://darkness-king.duckdns.org/games/sb/description.txt");
string update_error_reason=url_get("http://darkness-king.duckdns.org/games/sb/update_error_reason.txt");
if(latest_version=="" or string_contains(latest_version," ",1)!=-1 or string_contains(latest_version,"html",1)!=-1 or latest_version.length()<2 or latest_version.length()>5)
{
update.stream("update_error.ogg");
speak("unable to check the update, reason, "+update_error_reason+".");
update_menu();
}
if(latest_version==current_version)
{
update.stream("update_latest.ogg");
speak("this is the latest version of the game, version "+latest_version+".");
update_menu();
}
if(current_version<latest_version)
{
update.stream("update_found.ogg");
dlg("There is a new update available for the game, your version, "+current_version+", latest version, "+latest_version+", description, "+description+"");
game_update_ask();
}
}
void game_update_ask()
{
sound updating;
setupmenu(true,true);
string latest_version=url_get("http://darkness-king.duckdns.org/games/sb/version.txt");
m.add_item_tts("download the update","download");
m.add_item_tts("don't download","don't_download");
m.add_item_tts("copy download link to clipboard","copy");
m.add_item_tts("go back","back");
int mres=m.run("would you like to download it",true);
if(m.get_item_name(mres)=="download")
{
show_game_window("updating game from version "+version+", to version "+latest_version+", please wait");
updating.stream("updatemus.ogg");
speak("update starting");
string status=dl_file("http://darkness-king.duckdns.org/games/sb/sb.zip","sb.zip");
if(status=="finished")
{
updating.stream("update_complete.ogg");
dlg("update complete, press enter to continue");
exit();
}
}
if(m.get_item_name(mres)=="don't_download")
{
speak("ok");
update_menu();
}
if(m.get_item_name(mres)=="copy")
{
updating.stream("copyed.ogg");
speak("the link of the game now been copied to your clipboard");
clipboard_copy_text("http://darkness-king.duckdns.org/games/sb/sb.zip");
update_menu();
}
if(m.get_item_name(mres)=="back" or mres==0)
{
mainmenu();
}
}
