source@[] sources(0);
int source_volume;
int source_pitch;
class source
{
int source_sound;
int lx;
int rx;
int miny;
int maxy;
int minz;
int maxz;
int volume;
int pitch;
string soundfile;
bool paused=false;
int id=-1;
bool p2;
string vetype;
source(int source_lx, int source_rx, int source_miny, int source_maxy, int source_minz, int source_maxz, string file, int vol=0, int spitch=100 , bool source_paused=false, int source_id=-1)
{
pitch=spitch;
if(pitch<0)
pitch=0;
volume=vol;
if (volume<-45)
volume=-45;
lx=source_lx;
rx = source_rx;
miny=source_miny;
maxy= source_maxy;
minz=source_minz;
maxz=source_maxz;
soundfile=file;
 source_sound=sourcepool.play_3d(soundfile, me.x, me.y, me.z, lx, miny, minz, facing, true);
id=source_id;
sourcepool.update_sound_3d(source_sound, lx, miny, minz);
sourcepool.update_sound_start_values(source_sound,0,source_volume+volume,source_pitch+pitch);
paused=source_paused;
if(paused==true)
{
sourcepool.pause_sound(source_sound);
}
p2=paused;
sourcepool.update_sound_range_3d(source_sound, 0, rx-lx, 0, maxy-miny, 0, maxz-minz);
}
}
class amb
{
double minx,maxx,miny,maxy,minz,maxz;
sound loop;
int volume=0;
int pitch=100;
bool inrange=false,force_paused=false;
amb(double c1, double c2, double c3, double c4, double c5, double c6, string so, int vo=0, int p=100)
{
minx=c1; maxx=c2; miny=c3; maxy=c4; minz=c5; maxz=c6; loop.stream(so);
volume=vo; pitch=p;
if(pitch<0)
pitch=0;
volume=vo;
if (volume<-45)
volume=-45;
}
bool is_in_range()
{
return (minx<=mr.x&&maxx>=mr.x&&miny<=mr.y&&maxy>=mr.y&&minz<=me.z&&maxz>=me.z);
}
void check()
{
if(force_paused) return;
loop.volume=source_volume+volume;
loop.pitch=source_pitch+pitch;
bool r=is_in_range();
if(r==true&&inrange==false)
{
inrange=true;
loop.play_looped();

}
else if(r==false&&inrange==true)
{
inrange=false;
loop.pause();
}
}
~amb()
{

if(loop.playing)
loop.stop();
loop.close();

}
}
amb@[] ambs;

void sourcecheckloop()
{
for (uint i=0; i<sources.length(); i++)
{
if(sources[i].paused!=sources[i].p2)
{
if(sources[i].paused==true and sources[i].p2==false)
{
sourcepool.pause_sound(sources[i].source_sound);
sources[i].p2=true;
}
else if(sources[i].paused==false and sources[i].p2==true)
{
sourcepool.resume_sound(sources[i].source_sound);
sources[i].p2=false;
}
}
}
for(uint i=0; i<ambs.length(); i++)
{
ambs[i].check();
}
}
void ambiencescheckloop()
{
for(uint i=0; i<ambs.length(); i++)
{
ambs[i].check();
}
}

void destroy_all_sources()
{
for(uint i=0; i<sources.length(); i++)
{
sourcepool.destroy_sound(sources[i].source_sound);
}
sources.resize(0);
ambs.resize(0);
}
void destroy_all_ambiences()
{
ambs.resize(0);
}

void pause_all_sources()
{
for(uint i=0; i<sources.length(); i++)
{
sources[i].paused=true;
}
for(uint i=0; i<ambs.length(); i++)
{
ambs[i].force_paused=true;
if(ambs[i].loop.playing) ambs[i].loop.pause();
}
}
void resume_all_sources()
{
for(uint i=0; i<sources.length(); i++)
{
sources[i].paused=false;
}
for(uint i=0; i<ambs.length(); i++)
{
ambs[i].force_paused=false;
ambs[i].check();
}
}
void spawn_source(int source_lx, int source_rx, int source_miny, int source_maxy, int source_minz, int source_maxz, string soundfile, int volume=0, int pitch=100, bool paused=false, int id=-1)
{
source source1(source_lx, source_rx, source_miny, source_maxy, source_minz, source_maxz, soundfile, volume, pitch, paused, id);
sources.insert_last(source1);
}
void destroy_source(int id)
{
for(uint i=0; i<sources.length(); i++)
{
if(sources[i].id==id and id > -1)
{
sourcepool.destroy_sound(sources[i].source_sound);
sources.remove_at(i);
}
}
}
void create_amb(int minx, int maxx, int miny, int maxy, int minz, int maxz, string sound, int v=100, int p=100)
{
amb amb1(minx,maxx,miny,maxy,minz,maxz,sound, v,p);
ambs.insert_last(amb1);
}

void change_source_volume_and_pitch(int volume, int pitch)
{
source_volume=volume;
source_pitch=pitch;
for (uint i=0; i<sources.length(); i++)
p.update_sound_start_values(sources[i].source_sound,0,source_volume+sources[i].volume,source_pitch+sources[i].pitch);
}