void scheck_readme_update()
{
sound update;
string readme_version=0.0;
string current_readme_version=readme_version;
file f;
f.open("docs/readmever.txt","rb");
current_readme_version=stn(f.read());
f.close();

string new_readme_version=url_get(webdir+"/ek/readmever.txt");
string update_error_reason=url_get(webdir+"/ek/update_error_reason.txt");
if(new_readme_version=="" or new_readme_version=="0" or string_contains(new_readme_version," ",1)!=-1 or string_contains(new_readme_version,"html",1)!=-1 or new_readme_version.length()<2 or new_readme_version.length()>5)
{
update.stream("update_error.ogg");
speak("unable to check the update, reason, "+update_error_reason+".");
}
if(new_readme_version==current_readme_version)
{
//update.stream("update_latest.ogg");
//speak("this is the latest version of the readme files, version "+new_readme_version+"");
//addmitems();
}
if(current_readme_version<new_readme_version)
{
update.stream("update_found.ogg");
dlg("There is a new update available for readme files, your version, "+current_readme_version+", latest version, "+new_readme_version+".");
readme_update_ask();
}
}
void check_readme_update()
{
sound update;
speak("checking readme files update");
string readme_version=1.1;
string current_readme_version=readme_version;
file f;
f.open("docs/readmever.txt","rb");
current_readme_version=stn(f.read());
f.close();

string new_readme_version=url_get(webdir+"/ek/readmever.txt");
string update_error_reason=url_get(webdir+"/ek/update_error_reason.txt");
if(new_readme_version=="" or new_readme_version=="0" or string_contains(new_readme_version," ",1)!=-1 or string_contains(new_readme_version,"html",1)!=-1 or new_readme_version.length()<2 or new_readme_version.length()>5)
{
update.stream("update_error.ogg");
speak("unable to check the update, reason, "+update_error_reason+".");
}
if(new_readme_version==current_readme_version)
{
update.stream("update_latest.ogg");
speak("this is the latest version of the readme files, version "+new_readme_version+"");
}
if(current_readme_version<new_readme_version)
{
update.stream("update_found.ogg");
dlg("There is a new update available for readme files, your version, "+current_readme_version+", latest version, "+new_readme_version+".");
readme_update_ask();
}
}
void readme_update_ask()
{
sound updating;
setupmenu(true,true);
string new_readme_version=url_get(webdir+"/ek/readme_version.txt");
m.add_item_tts("download the readme files","download");
m.add_item_tts("don't download","don't_download");
m.add_item_tts("copy download link to clipboard","copy");
m.add_item_tts("go back","back");
int mres=m.run("would you like to download it",true);
if(m.get_item_name(mres)=="download")
{
string readme_version=0.0;
show_game_window("updating readme files, from "+readme_version+" to, "+new_readme_version+", please wait");
updating.stream("updatemus.ogg");
speak("update starting");
string status=dl_file(webdir+"/ek/docs.zip","docs.zip");
if(status=="finished")
{
updating.stream("update_complete.ogg");
speak("update completed");
run("unzip.exe", "-o -qq docs.zip", false, false);
run("ek.exe","",false,false);
//file_delete("docs.zip");
exit();
}
}
if(m.get_item_name(mres)=="don't_download")
{
speak("ok");
//addmitems();
}
if(m.get_item_name(mres)=="copy")
{
updating.stream("copyed.ogg");
speak("the link of the readme files now been copied to your clipboard");
clipboard_copy_text(webdir+"/ek/docs.zip");
}
if(m.get_item_name(mres)=="back" or mres==0)
{

}
}