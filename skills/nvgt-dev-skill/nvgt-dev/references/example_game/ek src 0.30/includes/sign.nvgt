sign@[] signs;
class sign
{
int x,y,z;
string text;
string ss;
int ssound;
sign(int sx,int sy,int sz,string t)
{
x=sx;
y=sy;
z=sz;
text=t;
if(signsounds==1)
{
ssound=p.play_3d("sign.ogg", me.x, me.y, me.z,sx, sy, sz,calculate_theta(facing),true);
}
}
}
void signcheck()
{
for(uint i=0; i<signs.length(); i++)
{
p.update_sound_3d(signs[i].ssound, signs[i].x, signs[i].y,signs[i].z);
if(me.x==signs[i].x&&me.y==signs[i].y&&me.z==signs[i].z)
{
send_reliable(0,"signpress",0);
//p.play_3d("signpress.ogg", me.x, me.y, me.z,signs[i].x, signs[i].y, signs[i].z,calculate_theta(facing),false);
speak(signs[i].text);
}
}
}
void spawn_sign(int signx,int signy,int signz,string signtext)
{
sign s1(signx,signy,signz,signtext);
signs.insert_last(s1);
}
void destroy_sign(int d)
{
signs.remove_at(d);
}
void destroy_all_signs()
{
for(uint i=0; i<signs.length(); i++)
{
p.destroy_sound(signs[i].ssound);
}
signs.resize(0);
}