/*
void gmw(string project_name,string version,string author)
this function allows you to see the game window into your project, easily and shortly.
string project_name: the name of the project you wish to be shown.
string version: the version of the project that your project is in.
string author: the name of the development team that you are currently authorized.
*/
void gmw(string project_name,string version,string author)
{
string final;
if(project_name!="") final+=project_name;
if(version!="") final+=" version "+version;
if(author!="") final+=" by "+author;
show_game_window(final);
}
/*example:
gmw("file info checker","1.5","harry production");
then output should be file info checker version 1.5 by harry production
*end example*/

/*
string fgc(string fn)
this function allows you to get the text of the filename that you specified.
string fn: a string the filename to get the text from
*/
string fgc(string fn)
{
file f;
f.open(fn,"rb");
string s=f.read();
f.close();
return s;
}
/*
void fpc(string filename,string contents,int mode=0)
this function allows you to put the text into a file with the specify filename.
string filename: the filename to put the text to.
string contents: the text to put into the file.
int mode: the mode such as file write, append, or others.
there are 4 modes available:
0,1,2,3.
the mode 0 is the default, which return as wb.
mode 1 returns ab, mode 2 returns a, and mode 3 returns w.
I might not explain all the modes here, however try it by yourself. usually, mode 0 allows to use wb, which is write in binary mode contain. with removing the character b, will no longer it contain. mode1 allows you to append the contents in a file, which putting a new text with the old texts together. also this is in binary mode. mode2 allows you to put the contents to the file with the appending mode without the binary mode. and finally, mode3 allows you to put the contents in file write mode without any binary mode.
*/
void fpc(string filename,string contents,int mode=0)
{
string returning_as;
if(mode==0) returning_as="wb";
else if(mode==1) returning_as="ab";
else if(mode==2) returning_as="a";
else if(mode==3) returning_as="w";
file f;
f.open(filename,returning_as);
f.write(contents);
f.close();
}
