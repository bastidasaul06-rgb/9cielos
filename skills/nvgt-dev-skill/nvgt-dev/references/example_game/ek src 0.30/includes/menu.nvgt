#include"mapdata.nvgt"
bool switched=false;
dynamic_menu_pro m;
void mainmenu()
{
setupmenu(true,true);
if(name!=""||password!="")
{
m.add_item_tts("log in as "+name+"","login");
}
m.add_item_tts("character options","loptions");
m.add_item_tts("change game settings","optionsmenu");
//m.add_item_tts("server menu","soptions");
m.add_item_tts("check for updates", "cfu");
//if(!switched&&!SCRIPT_COMPILED) m.add_item_tts("change server to localhost, currently "+netaddress+"","localhost");
m.add_item_tts("test speakers", "speaker_test");
//m.add_item_tts("restart the game","reboot");
//m.add_item_tts("wiew all sounds","sounds");
//m.add_item_tts("change the server","sounds");
//m.add_item_tts((rules==0?"You have not agreed to the Era of knights rules. Press enter to agree":"You have agreed to the Era of knights rules, thanks!"),"rules","",(rules==0?true:false));
//m.add_item_tts("get your id, may be required for administrators: do not share with anyone.","getid");
//m.add_item_tts("listen to game documentation with audio","audio");
m.add_item_tts("Exit","exit");int mres=m.run("Main Menu",true);
if(m.get_item_name(mres)=="login")
{
m.fade_music(20);
login();
//m.fade_music(20);
}
if(m.get_item_name(mres)=="cfu")
{
m.fade_music(20);
//check_ssound_update();
check_setup_update();
//check_ssound_update();
//sndcheck();
mainmenu();
}
else if(m.get_item_name(mres)=="rules") {
int r=question("Confirmation","Do you agree to the Era of knights rules? These rules can be found in !rules.txt in your copy of Era of knights. By clicking yes, you agree that you have read and understood these rules. Do you agree?");
if(r==1) {
rules=r;
writeprefs();
}
else {
alert("Unfortunately","you cannot play the game if you do not agree with the rules. Thank you, the game will exit.");
exit();
}
mainmenu();
}
if(m.get_item_name(mres)=="localhost")
{
connected=false;
switched=true;
if(netaddress=="engelsiz-productions.tk") netaddress="localhost";
else netaddress="engelsiz-productions.tk";
netaddress="localhost";
speak("switched");
mainmenu();
}
else if(m.get_item_name(mres)=="speaker_test")
{
//m.fade_music(20);
speakermenu();
}
if(m.get_item_name(mres)=="reboot")
{
m.fade_music(20);
if(!SCRIPT_COMPILED)
{
rebootmaster();
}
else
{
reboot();
}
}
if(m.get_item_name(mres)=="getid")
{
dlg("your computer id",""+compid+"","ok thanks");
mainmenu();
}
if(m.get_item_name(mres)=="audio")
{
//m.fade_music(30);
docaudio();
}
if(m.get_item_name(mres)=="loptions")
{
//m.fade_music(30);
loginoptionsmenu();
}
else if(m.get_item_name(mres)=="unlock")
{
ask_for_reg();
mainmenu();
}
if(m.get_item_name(mres)=="multimenu")
{
mainmenu();
}
else if(m.get_item_name(mres)=="soptions")
{
serveroptionsmenu();
}
else if(m.get_item_name(mres)=="optionsmenu")
{
optionsmenu();
}
else
{
//m.fade_music(10);
writeprefs();
//wait(50);
wait(250);
dlgplay("gamedoorcancel.ogg",true,500);
exit();
}
}
void setupmenu(bool main=false, bool audo=false)
{
m.reset(true);
if (main==true)
{
m.add_music(musictrack);
}
m.open_sound="menuopen.ogg";
m.enter_sound="menuenter.ogg";
m.click_sound="menumove.ogg";
m.wrap_sound="menuwrap.ogg";
if(audo==true)
{
m.letters_autoactivate=false;
}
m.edge_sound="menuedge.ogg";
m.open_sound="menuopen.ogg";
m.enter_sound="menuenter.ogg";
m.click_sound="menumove.ogg";
m.wrap_sound="menuwrap.ogg";
if(firstnav==1 and mulnav==0)
{
m.enable_multi_letter_navigation=false;
m.enable_first_letter_navigation=true;
}
else if(firstnav==0 and mulnav==1)
{
m.enable_multi_letter_navigation=true;
m.enable_first_letter_navigation=false;
}
if(firstnav==0 and mulnav==0)
{
m.enable_multi_letter_navigation=false;
m.enable_first_letter_navigation=false;
}
if(sidescrolling==1)
{
m.enable_side_scrolling=true;
}
if(sidescrolling==1)
m.enable_left_and_right=true;
else
{
m.enable_up_and_down=true;
m.enable_side_scrolling=false;
}
if(wrap==1)
{
m.wrap=true;
}
if(wrap==0)
{
m.wrap=false;
}
if(riae==0)
{
m.repeat_items_at_edges=false;
}
else if(riae==1)
{
m.repeat_items_at_edges=true;
}
m.enable_home_and_end=true;
m.set_callback(netclb,"");
garbage_collect();
}
void docaudio()
{
setupmenu(true,true);
m.add_item_tts("listen the rules","rules");
m.add_item_tts("listen the readme","readme");
m.add_item_tts("Listen the rules in turkish.","rulestr");
m.add_item_tts("listen the readme in turkish.","readmetr");
m.add_item_tts("back to mainmenu","back");
int mres=m.run("Welcome, select the file you want to listen to and press enter.",true);
if(m.get_item_name(mres)=="back" or mres==0) mainmenu();
if(m.get_item_name(mres)=="rules")
{
m.fade_music(20);
dlgplay("rules.ogg",true,20, true);
docaudio();
}
if(m.get_item_name(mres)=="rulestr")
{
m.fade_music(20);
dlgplay("rulestr.ogg",true,20, true);
docaudio();
}
if(m.get_item_name(mres)=="readme")
{
m.fade_music(20);
dlgplay("readme.ogg",true,20, true);
docaudio();
}
if(m.get_item_name(mres)=="readmetr")
{
m.fade_music(20);
dlgplay("readmetr.ogg",true,20, true);
docaudio();
}
}
void loginoptionsmenu()
{
setupmenu(true,true);
m.add_item_tts("Setup an existing account","setup","a");
m.add_item_tts("Create a new account","create");
//m.add_item_tts("forgot password","reset","f");
m.add_item_tts("Go back","back","b");
//}
int mres=m.run("character settings; you can find many options for your character here, or create a new player account!",true);
if(m.get_item_name(mres)=="back" or mres==0) mainmenu();
else if(m.get_item_name(mres)=="reset")
{
//m.fade_music(20);
passmenu();
}
else if(m.get_item_name(mres)=="create")
{
creating=true;
m.fade_music(20);
create();
m.fade_music(20);
}
else if(m.get_item_name(mres)=="setup")
{
m.fade_music(20);
string user=input("username","type the username you want to set","","",0,false,false,"&next");
if(user=="") mainmenu();
string pass=input("password","type the password of the username "+user,"","*",0,false,false,"&finish");
if(pass=="")
mainmenu();
name=user;
password=pass;
writeprefs();
dlg("system message","Success!","ok");
mainmenu();
}
}
void passmenu()
{
setupmenu(true,true);
m.add_item_tts("request a password reset key","requestpasskey","q");
m.add_item_tts("enter a password reset key","enterpasskey","r");
m.add_item_tts("Go back","back","b");
int mres=m.run("password menu",true);
if(m.get_item_name(mres)=="back" or mres==0) loginoptionsmenu();
else if(m.get_item_name(mres)=="requestpasskey")
{
 resetpass();
}
if(m.get_item_name(mres)=="enterpasskey")
{
resetpasskey();
}
}
void serveroptionsmenu()
{
setupmenu(false,true);
m.speak_letter=false;
m.set_callback(null, "");
m.add_music("menumus19.ogg");
m.add_item_tts("currently netaddress "+netaddress+"","");
//m.add_item_tts("change manuel server address","address","a");
//m.add_item_tts("change manuel server port","port","p");
m.add_item_tts("public server list","pubc","p");
m.add_item_tts("Go back","back","b");
int mres=m.run("server menu, make your choice, for example, public serverlist",true);
if(m.get_item_name(mres)=="back" or mres==0) mainmenu();
else if(m.get_item_name(mres)=="pubc")
{
//m.fade_music(20);
pubcmenu();
}
if(m.get_item_name(mres)=="address")
{
string ad=v.input("enter the address");
