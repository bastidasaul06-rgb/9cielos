void langsmenu(string[] langs,string current="")
{
get_characters();
double counter=langs.find((current==""?"dc":current));
string char,multichar,test;
speak("please select a language, or disable the chat If you wouldn't like to chat. there are "+langs.length()+" languages available");
key_hold keyup(KEY_UP,300,50);
key_hold keydown(KEY_DOWN,300,60);
while(true)
{
wait(random(1, 5));
ek_loop();
if(counter<0) counter=0;
else if(counter>langs.length()-1) counter=langs.length()-1;
if (mulnav==1 and firstnav==0)
{
if(navtime.elapsed>1000 and multichar!="")
multichar="";
string c=string_to_lower_case(get_characters());
if(c!="" and multichar!=c)
{
navtime.restart();
multichar+=c;
}
if(multichar!="" and c!="")
{
multichar=string_to_lower_case(multichar);
bool found=false;
for (uint i=counter; i<langs.length(); i++)
{
if(i==counter) continue;
test=langs[i];
test=string_to_lower_case(test);
if (string_left(test, multichar.length())==multichar)
{
if(string_to_lower_case(string_left(langs[counter],multichar.length()))==multichar and multichar.length()>1)
{
found=true;
break;
}
if (counter<i)
counter=i;
else if (counter>i)
counter=i;
speak(langs[counter]);
found=true;
break;
}
}
if (found==false)
{
multichar=string_to_lower_case(multichar);
for (uint i=0; i<langs.length(); i++)
{
test=langs[i];
test=string_to_lower_case(test);
if (string_left(test, multichar.length())==multichar)
{
if(string_to_lower_case(string_left(langs[counter],multichar.length()))==multichar and multichar.length()>1)
{
found=true;
break;
}
if (counter<i)
counter=i;
else if (counter>i)
counter=i;
speak(langs[counter]);
found=true;
break;
}
}
}
if(!found)
{
speak("no such language exists");
}
}
}
else if(firstnav==1 and mulnav==0)
{
char=string_to_lower_case(get_characters());
if(char!="" and char!=" ")
{
char=string_to_lower_case(char);
bool found=false;
for (uint i=counter; i<langs.length(); i++)
{
if(i==counter) continue;
test=langs[i][0];
test=string_to_lower_case(test);
if (test==char)
{
if (counter<i)
counter=i;
else if (counter>i and test==char)
counter=i;
speak(langs[counter]);
found=true;
break;
}
}
if (found==false)
{
for (uint i=0; i<langs.length(); i++)
{
test=langs[i][0];
test=string_to_lower_case(test);
if (test==char)
{
if (counter<i)
counter=i;
else if (counter>i and test==char)
counter=i;
speak(langs[counter]);
found=true;
break;
}
}
}
if(!found)
{
speak("no such language exists");
}
}
}
if(keyup.pressing and counter>0)
{
counter--;
speak(langs[counter]);
}
if(keydown.pressing and counter<langs.length()-1)
{
counter++;
speak(langs[counter]);
}
if(key_pressed(KEY_HOME))
{
counter=0;
speak(langs[counter]);
}
if((key_pressed(KEY_LMENU)||key_pressed(KEY_RMENU)) and counter>-1)
{
speak(langs[counter]);
}
if(key_pressed(KEY_END))
{
counter=langs.length()-1;
speak(langs[counter]);
}
if(key_pressed(KEY_RETURN) or key_pressed(KEY_NUMPADENTER))
{
send_reliable(0,"lchannelset "+(langs[counter]=="disable chat"?"dc":langs[counter]),0);
return;
}
if(key_pressed(KEY_ESCAPE))
{
speak("canceled");
return;
}
}
}
int qa(string q,string a1="yes",string a2="no")
{
setupmenu(false,true);
m.add_item_tts(a1,"a1");
m.add_item_tts(a2,"a2");
int mres=m.run(q, true);
if (m.get_item_name(mres)=="a1") return 1;
else if(m.get_item_name(mres)==a2) return 2;
else return -1;
}