int charrepeat=0;

class virtualizer
{
int charrepeat=0;
string message;
string input(string title,string text="", bool online=false, bool secure_input=false,bool multiline=false)
{
audio_form r;
r.create_window(title,false,false,true);

string sc;
if(secure_input==true) sc="*";
string message;
speak(title);
int n=r.create_input_box("", text, sc, 0, false, multiline, false);
r.focus(n);
string t;
while(true)
{
wait(5);

if(key_pressed(KEY_TAB)) speak(title);
if(!control_is_down()&&key_pressed(KEY_RETURN))
{
r.reset();
message=t;
break;
}
if(key_pressed(KEY_ESCAPE))
{
r.reset();
message="";
break;
}
r.monitor();

if(online==true)
{
if(speed_stop_is_hacking(200)==true)
killbitch();
if(connected==true)
{
if(!following&&!frozen&&!inve)
{
fallloop();
fallcheck();
fallingloop();
}
msoundcheckloop();
healthloop();
netloop();
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
}
}
t=r.get_text(n);
}
return message;
}
}
