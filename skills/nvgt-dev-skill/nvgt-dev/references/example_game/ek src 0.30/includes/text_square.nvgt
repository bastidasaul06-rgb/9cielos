tsquare@[] tsquares;
class tsquare
{
double minx,maxx,miny,maxy,minz,maxz; //coordinates
string text; //the text to speak.
tsquare(double a,double b,double c,double d,double e,double f,string t)
{
minx=a;
maxx=b;
miny=c;
maxy=d;
minz=e;
maxz=f;
text=t;
}
}
void tsquarecheck()
{
for(uint i=0; i<tsquares.length(); i++)
{
if((tsquares[i].minx<=mr.x and tsquares[i].maxx>=mr.x) and (tsquares[i].miny<=mr.y and tsquares[i].maxy>=mr.y) and (tsquares[i].minz<=me.z and tsquares[i].maxz>=me.z))
{
speak(tsquares[i].text);
}
}
}
void spawn_tsquare(double a,double b,double c,double d,double e,double f,string t)
{
tsquare s1(a,b,c,d,e,f,t);
tsquares.insert_last(s1);
}
void destroy_tsquare(int d)
{
tsquares.remove_at(d);
}
void destroy_all_tsquares()
{
tsquares.resize(0);
}