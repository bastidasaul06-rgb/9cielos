enum ROBOTSTATES
{
ROBOT_STOP, ROBOT_MOVE, ROBOT_KILL, ROBOT_WAIT
}
class RobotTemplate
{
string name;
string hitby;
double health,defence,speed,damage,shoot,distance,aggro,spread,angle;
double minx,maxx,miny,maxy,minz,maxz;
double minsh=1,maxsh=500;
double mindamage,maxdamage;
double steps;
string loot;
double amount,voices,loops,shoots,hits,pains,kills;
double minxp, maxxp;
string killsound="",voicesound="",shootsound="",stepsound="",loopsound="",hitsound="",painsound="";
RobotTemplate () {}
}
uint robotid=0;
class Robot : RobotTemplate
{
double x,y,z,up;
int index;
uint id;
int look,reangle,state;
string player,weapon;
string map,zone,voice;
string ll,loop;
string[] loots;
timer movetimer,shoottimer,looptimer,voicetimer;
int wallhitcount;
timer wallhittimer;
Robot ()
{
this.map="main"; this.id=0;
this.minx=this.minx; this.maxx=this.maxx; this.miny=this.miny; this.maxy=this.maxy; this.minz=this.minz; this.maxz=this.maxz;
this.health=100; this.defence=0;
this.speed=1000; this.shoot=3000;
this.damage=5; this.state=ROBOT_WAIT;
this.mindamage=this.damage; this.maxdamage=this.damage;
this.minsh=5;
this.maxsh=10;
this.distance=1; this.aggro=50;
this.spread=5; this.angle=0; this.reangle=0;
this.look=0; this.steps=0;
this.shoots=0; this.hits=0; this.pains=0; this.kills=0;
this.name=""; this.loot=0; this.amount=0;
this.loots=string_split(this.loot,",",true);
this.voice="";
this.loop="";
this.wallhitcount = 0;
}
Robot (RobotTemplate@ tr, int index, double x, double y, double z, double a,double b,double c,double d,double e,double f,string map, int mnxp, int mxxp)
{
this.index=index; this.map=map;
this.x=x; this.y=y; this.z=z; this.up=z;
this.minx=a; this.maxx=b; this.miny=c; this.maxy=d; this.minz=e; this.maxz=f;
this.health=tr.health; this.defence=tr.defence;
this.speed=tr.speed; this.shoot=tr.shoot;
this.damage=tr.damage; this.state=ROBOT_STOP;
this.minsh=tr.minsh; this.maxsh=tr.maxsh;
this.killsound=tr.killsound; this.shootsound=tr.shootsound; this.voicesound=tr.voicesound; this.loopsound=tr.loopsound; this.stepsound=tr.stepsound; this.hitsound=tr.hitsound; this.painsound=tr.painsound;
this.mindamage=tr.mindamage; this.maxdamage=tr.maxdamage;
this.minxp=tr.minxp;
this.maxxp=tr.maxxp;
this.distance=tr.distance; this.aggro=tr.aggro;
this.spread=tr.spread; this.angle=tr.angle; this.reangle=360-this.angle;
this.look=random(0,359); this.steps=tr.steps;
this.loot=tr.loot; this.amount=tr.amount;
this.loots=string_split(this.loot,",",true);
this.voices=tr.voices; this.shoots=tr.shoots; this.loops=tr.loops; this.hits=tr.hits; this.pains=tr.pains; this.kills=tr.kills;
if (robotid>4000000000) {robotid=0;}
robotid+=1; this.id=robotid;
this.name=tr.name;
if (this.voicesound!="") {this.voice=spawn_moving_sound(this.voicesound+".ogg",this.x,this.y,this.z,this.map);}
if (this.loopsound!="") {this.loop=spawn_moving_sound(this.loopsound+".ogg",this.x,this.y,this.z,this.map);}
this.wallhitcount = 0;
}
void update ()
{
    update_moving_sound(this.voice,this.x,this.y,this.z);
    update_moving_sound(this.loop,this.x,this.y,this.z);
    
    if (this.voices<2 or this.steps==1) { return; }
    else if (voicetimer.elapsed >= 15000)
    {
        voicetimer.restart();
        destroy_moving_sound(this.voice);
        destroy_moving_sound(this.loop);
        string[] voiceArray = string_split(this.voicesound, ",", true);
        if (voiceArray.length() > 1)
        {
            int randomIndex = random(0, voiceArray.length() - 1);
            this.voice = spawn_moving_sound(voiceArray[randomIndex] + ".ogg", this.x, this.y, this.z, this.map);
        }
        else
        {
            this.voice = spawn_moving_sound(this.voicesound + ".ogg", this.x, this.y, this.z, this.map);
        }
    }
}
void hit (int damage, string weaponname, string playername="")
{
if (damage>this.defence) {
this.health-=(damage-this.defence);
if (this.health>0) {
if(this.painsound!="") play(this.painsound,this.x,this.y,this.z,this.map);
}
this.player=playername; this.weapon=weaponname;
}
}
~Robot ()
{
destroy_moving_sound(this.voice);
destroy_moving_sound(this.loop);
}
}
RobotTemplate@[] robottemps(0);
Robot@[] robots(0);
int get_rt_index (string name)
{
int r,l=robottemps.length();
for (r=0; r<l; r++) {
if (robottemps[r].name==name) {return(r);}
}
return(-1);
}
void robot_spawn (string name, double x, double y, double z, double minx,double maxx,double miny,double maxy,double minz,double maxz,int mid, int minxp, int maxxp)
{
int id=get_rt_index(name);
if (id<0) {return;}
Robot@ r=Robot(robottemps[id],id,x,y,z,minx,maxx,miny,maxy,minz,maxz,maps[mid].name, minxp, maxxp);
robots.insert_last(r);
maps[mid].currobots+=1;
}
int sign (int n1, int n2)
{
if (n1==n2) return(0);
if (n1<n2) return(-1);
return(1);
}
bool robot_move (Robot@ r, int m)
{
double rx=r.x+sine(r.look*pi/180);
double ry=r.y+cosine(r.look*pi/180);
if (m<0 or (rx==r.x or ry==r.y) or (rx<0 or rx>maps[m].max.x) or (ry<0 or ry>maps[m].max.y)) {return(false);}
else if(rx<r.minx or rx>r.maxx or ry<r.miny or ry>r.maxy) return(false);
string tile = get_tile_at(rx, ry, r.z, r.map);
if (string_contains(tile, "wall", 1) > -1)
{
    if (r.wallhittimer.elapsed > 200)
    {
        r.wallhitcount++;
        r.wallhittimer.restart();

        // Tile türüne göre ses dosyasını otomatik olarak çal
        play(tile, r.x, r.y, r.z, r.map); // Burada tile, ses dosyasının ismi olacak
        
        if (r.wallhitcount >= 2)
        {
            r.look = random(0, 359);
            r.wallhitcount = 0;
        }
    }
    return false;
}

r.x=rx; r.y=ry;
garbage_collect();
return(true);
}
void robotsloop ()
{
int m,r,l=robots.length();
int c,p=players.length();
double angle,dist;
for (r=0; r<l; r++) {
m=get_map_index(robots[r].map);
netloop();
switch (robots[r].state) {
case ROBOT_STOP:
if ((robots[r].state<ROBOT_KILL and robots[r].health<=0) or (m>=0 and maps[m].plays<=0 and robots[r].map==maps[m].name)) {robots[r].state=ROBOT_KILL; break;}
for (c=0; c<p; c++) {
if (robots[r].map!=players[c].map or players[c].invinsible or players[c].frequency) {continue;}
if(is_safe(players[c].x,players[c].y,players[c].z,maps[get_map_index(players[c].map)])) continue;
if(players[c].afk) continue;
if(round(players[c].x,0)<robots[r].minx or round(players[c].x,0)>robots[r].maxx or round(players[c].y,0)<robots[r].miny or round(players[c].y,0)>robots[r].maxy) continue;
if (get_3d_distance(robots[r].x,robots[r].y,robots[r].z,players[c].x,players[c].y,players[c].z)<=robots[r].aggro) {robots[r].state=ROBOT_MOVE;}
}
break;
case ROBOT_MOVE:
if (robots[r].health<=0 or (m>=0 and maps[m].plays<=0 and robots[r].map==maps[m].name)) {robots[r].state=ROBOT_KILL; break;}
if (robots[r].shoottimer.elapsed>=robots[r].shoot) {
robots[r].shoottimer.restart();
for (c=0; c<p; c++) {
if (robots[r].map!=players[c].map or players[c].invinsible or players[c].frequency) {continue;}
if(is_safe(players[c].x,players[c].y,players[c].z,maps[get_map_index(players[c].map)])) continue;
if(players[c].afk) continue;
if (get_3d_distance(robots[r].x,robots[r].y,robots[r].z,players[c].x,players[c].y,players[c].z)>robots[r].distance) {continue;}
if(round(players[c].x,0)<robots[r].minx or round(players[c].x,0)>robots[r].maxx or round(players[c].y,0)<robots[r].miny or round(players[c].y,0)>robots[r].maxy) continue;
angle=calculate_x_y_angle(robots[r].x,robots[r].y,players[c].x,players[c].y,robots[r].look);
if (angle<=robots[r].angle or angle>=robots[r].reangle) {
if (robots[r].shootsound!="") play(robots[r].shootsound,robots[r].x,robots[r].y,robots[r].z,robots[r].map);
if (players[c].is_dead) break;
if (absolute(robots[r].z-players[c].z)<=robots[r].spread) {
if(players[c].reflected==true)
{
play("wallstone", players[c].x, players[c].y, players[c].z, players[c].map, -1, true, false);
continue;
}
if(is_safe(players[c].x,players[c].y,players[c].z,maps[get_map_index(players[c].map)])) continue;
if(players[c].afk) continue;
if(round(players[c].x,0)<robots[r].minx or round(players[c].x,0)>robots[r].maxx or round(players[c].y,0)<robots[r].miny or round(players[c].y,0)>robots[r].maxy) continue;
if (players[c].shielded) {
players[c].playsound("shieldhit"+random(1,12));
players[c].shieldshots-=random(robots[r].minsh,robots[r].maxsh);
}else{
if(robots[r].hitsound!="") play(robots[r].hitsound,robots[r].x,robots[r].y,robots[r].z,robots[r].map);
players[c].hitby=robots[r].name; players[c].zone=get_zone_at(robots[r].x,robots[r].y,robots[r].z,maps[get_map_index(robots[r].map)]);
players[c].hit(robots[r].mindamage,robots[r].maxdamage);
}
}
break;
}else if (angle<180) {robots[r].look=turnright(robots[r].look,robots[r].angle/2); break;
}else{robots[r].look=turnleft(robots[r].look,robots[r].angle/2); break;
}
}
break;
}
if (robots[r].movetimer.elapsed>=robots[r].speed) {
robots[r].movetimer.restart();
if (robots[r].up<robots[r].z) robots[r].up=robots[r].z;
for (c=0; c<p; c++) {
if (robots[r].map!=players[c].map or players[c].invinsible or players[c].frequency) {continue;}
if(is_safe(players[c].x,players[c].y,players[c].z,maps[get_map_index(players[c].map)])) continue;
if(players[c].afk) continue;
if(round(players[c].x,0)<robots[r].minx or round(players[c].x,0)>robots[r].maxx or round(players[c].y,0)<robots[r].miny or round(players[c].y,0)>robots[r].maxy) continue;
angle=calculate_x_y_angle(robots[r].x,robots[r].y,players[c].x,players[c].y,robots[r].look);
dist=get_2d_distance(robots[r].x,robots[r].y,players[c].x,players[c].y);
if (robots[r].steps==1 and robots[r].z!=players[c].z and (robots[r].z>robots[r].minz or robots[r].z<robots[r].maxz)) {robots[r].z+=sign(players[c].z,robots[r].z);
}else if (dist<=2 and robots[r].z<players[c].z and (robots[r].z>robots[r].minz or robots[r].z<robots[r].maxz)) {
int type=get_tile_type(robots[r].x,robots[r].y,robots[r].z+1,robots[r].map);
if (robots[r].steps==0 and type==TILE_TILE) {robots[r].z+=1;}
if (robots[r].stepsound=="") {play(get_tile_at(robots[r].x,robots[r].y,robots[r].z,robots[r].map)+"step"+random(1,5),robots[r].x,robots[r].y,robots[r].z,robots[r].map);}
else if (robots[r].stepsound!="") {play(robots[r].stepsound,robots[r].x,robots[r].y,robots[r].z,robots[r].map);}
break;
}else if (robots[r].steps!=1 and get_tile_type(robots[r].x,robots[r].y,robots[r].z,robots[r].map)==TILE_NONE) {
robots[r].z-=1;
if (robots[r].up>robots[r].z and get_tile_type(robots[r].x,robots[r].y,robots[r].z,robots[r].map)>TILE_NONE) {
play(get_tile_at(robots[r].x,robots[r].y,robots[r].z,robots[r].map)+"hardland",robots[r].x,robots[r].y,robots[r].z,robots[r].map);
robots[r].up=robots[r].z;
}
break;
}else if (dist<=robots[r].aggro and absolute(robots[r].z-players[c].z)<=robots[r].aggro) {
if (angle<=robots[r].angle or angle>=robots[r].reangle) {
if (robot_move(robots[r],m)) {
if (robots[r].stepsound=="") {play(get_tile_at(robots[r].x,robots[r].y,robots[r].z,robots[r].map)+"step"+random(1,5),robots[r].x,robots[r].y,robots[r].z,robots[r].map);}
else if (robots[r].stepsound!="") {play(robots[r].stepsound,robots[r].x,robots[r].y,robots[r].z,robots[r].map);}
break;
}
}else if (angle<180) {robots[r].look=turnright(robots[r].look,robots[r].angle); break;
}else {robots[r].look=turnleft(robots[r].look,robots[r].angle); break;
}
}
}
robots[r].update();
}
break;
case ROBOT_KILL:
destroy_moving_sound(robots[r].voice);
destroy_moving_sound(robots[r].loop);
if(robots[r].killsound!="") play(robots[r].killsound,robots[r].x,robots[r].y,robots[r].z,robots[r].map);
robots[r].movetimer.restart();
robots[r].state=ROBOT_WAIT;
break;
case ROBOT_WAIT:
if (robots[r].movetimer.elapsed>=1000) {
if (robots[r].amount>0 and robots[r].loot!="" and robots[r].player!="") {
spawn_obj(robots[r].x, robots[r].y, robots[r].z, robots[r].map, robots[r].loots[random(0,robots[r].loots.length()-1)], random(1,robots[r].amount),true);
send_unreliable(0, "robotdeath "+killmsgr(robots[r].name,robots[r].player,get_zone_at(robots[r].x,robots[r].y,robots[r].z,maps[get_map_index(robots[r].map)])), 0);
string[] ha=string_split(robots[r].player,"'",false);
int pindex=get_player_index_from(ha[0]);
if(pindex>-1)
{
players[pindex].xp+=random(robots[r].minxp,robots[r].maxxp);
players[pindex].kills++;
int tm=is_in_team(players[pindex].name);
if(tm>-1) {
int l=random(1,300);
teams[tm].points+=l;
teams[tm].transmit("This team just got "+l+" extra points!");
teams[tm].teamkills+=1;
}
}
}
@robots[r]=null;
robots.remove_at(r);
if (maps[m].currobots>0) {maps[m].currobots-=1;}
return;
}
}
}
garbage_collect();
}
int kill_robots ()
{
int res=0;
for (int r=0; r<robots.length(); r++) {
destroy_moving_sound(robots[r].voice);
destroy_moving_sound(robots[r].loop);
robots[r].player=""; robots[r].weapon=""; robots[r].state=ROBOT_WAIT;
res+=1;
}
return(res);
}
void load_robots ()
{
if (!directory_exists("robots")) {return;}
string[] files=find_files("robots/*.txt");
string[] lines,params,damages;
string damage;
int line,l,f,size=files.length();
file fh;
for (f=0; f<size; f++) {
if (!fh.open("robots/"+files[f],"r")) {continue;}
RobotTemplate r;
lines=string_split(string_replace(fh.read(),"\r","",true),"\n",true);
fh.close();
line=lines.length();
for (l=0; l<line; l++) {
params=string_split(lines[l]," ",true);
if (params.length()!=2) {
alert("Error!","Not enough parameters in file: "+files[f]+". Line: "+lines[l]+".");
line=0;
break;
}
if (params[0]=="name") {r.name=params[1];}
else if (params[0]=="health") {r.health=string_to_number(params[1]);}
else if (params[0]=="defence") {r.defence=string_to_number(params[1]);}
else if (params[0]=="speed") {r.speed=string_to_number(params[1]);}
else if(params[0]=="shoot" and params.length()>1)
{
string[] ha=string_split(params[1],",",false);
if(ha.length()>1)
{
r.shoot=random(stn(ha[0]),stn(ha[1]));
}
else
{
r.shoot=stn(ha[0]);
}
}
else if (params[0]=="minxp") r.minxp=string_to_number(params[1]);
else if (params[0]=="maxxp") r.maxxp=string_to_number(params[1]);
else if (params[0]=="minsh") r.minsh=string_to_number(params[1]);
else if (params[0]=="maxsh") r.maxsh=string_to_number(params[1]);
else if (params[0]=="damage") {
damage=params[1];
damages=string_split(damage,",",true);
if (damages.length()==1) {r.mindamage=string_to_number(damages[0]); r.maxdamage=r.mindamage;}
else if (damages.length()>1) {r.mindamage=string_to_number(damages[0]); r.maxdamage=string_to_number(damages[1]);}
else {r.mindamage=0; r.maxdamage=0;}
r.damage=r.mindamage;
}
else if (params[0]=="distance") {r.distance=string_to_number(params[1]);}
else if (params[0]=="aggro") {r.aggro=string_to_number(params[1]);}
else if (params[0]=="spread") {r.spread=string_to_number(params[1]);}
else if (params[0]=="angle") {r.angle=string_to_number(params[1]);
if (r.angle>90) {r.angle=90;}
}
else if(params[0]=="killsound" and params.length()>1)
{
string[] hah=string_split(params[1],",",true);
if(hah.length()==1) r.killsound=hah[0];
else r.killsound=hah[random(0,hah.length()-1)];
}
else if(params[0]=="painsound" and params.length()>1)
{
string[] hah=string_split(params[1],",",true);
if(hah.length()==1) r.painsound=hah[0];
else r.painsound=hah[random(0,hah.length()-1)];
}
else if(params[0]=="hitsound" and params.length()>1)
{
string[] hah=string_split(params[1],",",true);
if(hah.length()==1) r.hitsound=hah[0];
else r.hitsound=hah[random(0,hah.length()-1)];
}
else if(params[0]=="voicesound" and params.length()>1)
{
string[] hah=string_split(params[1],",",true);
if(hah.length()==1) r.voicesound=hah[0];
else r.voicesound=hah[random(0,hah.length()-1)];
}
else if(params[0]=="stepsound" and params.length()>1)
{
string[] hah=string_split(params[1],",",true);
if(hah.length()==1) r.stepsound=hah[0];
else r.stepsound=hah[random(0,hah.length()-1)];
}
else if(params[0]=="shootsound" and params.length()>1)
{
string[] hah=string_split(params[1],",",true);
if(hah.length()==1) r.shootsound=hah[0];
else r.shootsound=hah[random(0,hah.length()-1)];
}
else if(params[0]=="loopsound" and params.length()>1)
{
string[] hah=string_split(params[1],",",true);
if(hah.length()==1) r.loopsound=hah[0];
else r.loopsound=hah[random(0,hah.length()-1)];
}
else if (params[0]=="steps") {r.steps=string_to_number(params[1]);}
else if (params[0]=="loot") {r.loot=params[1];}
else if (params[0]=="amount") {r.amount=string_to_number(params[1]);}
else if (params[0]=="voices") {r.voices=string_to_number(params[1]);}
else if (params[0]=="shoots") {r.shoots=string_to_number(params[1]);}
else if (params[0]=="hits") {r.hits=string_to_number(params[1]);}
else if (params[0]=="pains") {r.pains=string_to_number(params[1]);}
else if (params[0]=="kills") {r.kills=string_to_number(params[1]);}
}
if (line>0) {robottemps.insert_last(r);}
}
}