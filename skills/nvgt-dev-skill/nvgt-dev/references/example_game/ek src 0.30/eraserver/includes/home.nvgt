void homekicklist()
{
int index=get_player_index(e.peer_id);
int s=in_home(players[index].name);
if(index>-1 and s>-1)
{
if (homes[s].name!=players[index].name)
{
send_reliable(players[index].peer_id,"you do not own this house",2);
return;
}
server_menu m;
m.intro="select the user you want to remove from your home";
m.initial_packet="kick_hp";
//m.channel=0;
string []user;
for(int i=0; i<players.length(); i++)
{
if(players[index].name!=players[i].name and players[index].map==players[i].map)
{
user.insert_last(players[i].name);
}
}
if(user.length()>0)
{
for(int i=0; i<user.length(); i++)
{
m.add(user[i],user[i]);
}
m.send(players[index].peer_id);
return;
}
send_reliable(players[index].peer_id,"there is only you in this house",2);
}
}
