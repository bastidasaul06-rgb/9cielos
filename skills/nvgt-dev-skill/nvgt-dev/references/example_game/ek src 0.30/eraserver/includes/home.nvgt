bool players_nearby()
{
bool found=false;
for(uint i=0; i<players.length(); i++)
{
if(is_allowed(players[i].name)) continue;
if(players[i].distancecheck(x,y,z)<=25 and players[i].map==map)
{
found=true;
}
}
return found;
}
string get_allowed_players(bool output=false)
{
string outs;
if(aplayers.length()<=0)
{
if(output) return "nobody but you can enter this home";
else return "";
}
for(uint i=0; i<aplayers.length(); i++)
{
outs+=aplayers[i]+",";
if(output) outs+=" ";
}
return outs;
}
void set_allowed_players(string input)
{
aplayers.resize(0);
if(input=="") return;
string[] data=string_split(input,",",false);
for(uint i=0; i<data.length(); i++)
{
aplayers.insert_last(data[i]);
}
}
bool is_allowed(string playername)
{
return (aplayers.find(playername)>-1);
}
int add_allowed_player(string playername)
{
int index=get_player_index_from(playername);
if(index>-1)
{
if(aplayers.find(playername)<0&&playername!=name)
{
aplayers.insert_last(playername);
send_reliable(players[index].peer_id,"You have been granted access to the "+name+" home! home is located at "+x+", "+y+", "+z,2);
return 0;
}
return 2;
}
return 1;
}
bool remove_allowed_player(string playername)
{
if(aplayers.find(playername)>-1)
{
aplayers.remove_at(aplayers.find(playername));
return true;
}
return false;
}
}
void homeloop()
{

for(uint i=0; i<homes.length(); i++)
{
if(homes[i].openingtimer.elapsed>15000 and homes[i].opening==true)
{
homes[i].openingtimer.restart();
homes[i].opening=false;
homes[i].power=true;
}
if(homes[i].unlocktimer.elapsed>1000 and homes[i].unlocked==true)
{
homes[i].unlocked=false;
play("home_lock_ext.ogg",homes[i].x,homes[i].y,homes[i].z,homes[i].map);
play("home_lock_int.ogg",15,0,0,homes[i].name+"'s_home");
play("home_comp_locked.ogg",15,0,0,homes[i].name+"'s_house");
}
}
}
void spawn_home(int hx,int hy,int hz,string hname,string hmap,string hcode, string acs, int level)
{
home h(hx,hy,hz,hname,hmap, hcode, acs, level);
homes.insert_last(h);
save_homes();
}
bool has_home(player@p)
{
bool ret=false;
for(uint s=0; s<homes.length(); s+=1)
{
if(homes[s].is_allowed(p.name) or p.name==homes[s].name)
{
ret=true;
}
}
return ret;
}
void save_homes()
{
file homefile;
if(directory_exists("homes")==false)
directory_create("homes");
for(uint i=0; i<homes.length(); i++)
{
homefile.open("homes/"+homes[i].name+".hm","wb");
homefile.write("name:"+homes[i].name+
"\r\nhomex:"+homes[i].x+
"\r\nhomey:"+homes[i].y+
"\r\nz:"+homes[i].z+
"\r\nhomemap:"+homes[i].map+
"\r\npass:"+homes[i].code+
"\r\nacs:"+homes[i].acs+
"\r\nlevel:"+homes[i].level);
if(homes[i].aplayers.length()>0) homefile.write("\r\naplayers:"+homes[i].get_allowed_players());
homefile.close();
}
}
void load_home(string n)
{
if(n=="") return;
string name, map, aplayers, code, acs;
int x,y,z, level;
if(string_contains(n,".",1)>-1)
{
return;
}
file f;
f.open("homes/"+n+".hm","rb");
string[] hdata=string_split(f.read(),"\r\n",false);
f.close();
for(uint i=0; i<hdata.length(); i++)
{
string[] parsed=string_split(hdata[i],":",false);
if(parsed[0]=="name" and parsed.length()>1)
{
name=parsed[1];
}
if(parsed[0]=="homemap" and parsed.length()>1)
{
map=parsed[1];
}
if(parsed[0]=="acs" and parsed.length()>1)
{
acs=parsed[1];
}
if(parsed[0]=="homex" and parsed.length()>1)
{
x=stn(parsed[1]);
}
if(parsed[0]=="homey" and parsed.length()>1)
{
y=stn(parsed[1]);
}
if(parsed[0]=="z" and parsed.length()>1)
{
z=stn(parsed[1]);
}
if(parsed[0]=="aplayers"&&parsed.length()>1)
{
aplayers=parsed[1];
}
if(parsed[0]=="level" and parsed.length()>1)
{
level=stn(parsed[1]);
}
if(parsed[0]=="pass"&&parsed.length()>1)
{
code=parsed[1];
}
}
home h(x,y,z,map,name,code,acs, level);
h.x=x;
h.y=y;
h.z=z;
h.name=name;
h.map=map;
h.code=code;
h.acs=acs;
h.level=level;
h.set_allowed_players(aplayers);
homes.insert_last(h);
}
int home_index(string name)
{
for(uint i=0; i<homes.length(); i++)
{
if(homes[i].name==name) return i;
}
return -1;
}
void create_home(int level)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(file_exists("homes/"+players[index].name+".hm")==true)
{
send_reliable(players[index].peer_id,"you already have a house",2);
return;
}
vector max;
int x=0;
int y=1;
file f;
max=get_max_values("residential_area");
f.open("prefs/homecords.txt","rb");
string []xy=string_split(f.read(), " ", true);
f.close();
if (stn(xy[0])<max.x-1) x=stn(xy[0])+2;
y=stn(xy[1]);
if (stn(xy[0])>max.x-2)
{
x=1;
y=stn(xy[1])+2;
}
f.open("prefs/homecords.txt","wb");
f.write(x+" "+y);
f.close();
spawn_home(x,y,0,players[index].name, "residential_area",randomstring(12),"off", level);
int h=home_index(players[index].name);
send_reliable(0,"label_spawn "+x+" "+x+" "+y+" "+y+" 0 0 home(_owner_"+players[index].name+") residential_area",0);
send_reliable(players[index].peer_id,"Wonderful. You bought a new house. Location of his house: on the residential_area map, at coordinate"+x+", "+y+", 0 home 's password"+homes[h].code,2);
if(level==1)
{
players[index].give("dollar",-50000);
file f;
f.open("maps/"+players[index].name+"'s_house.map","wb");
f.write(homes[h].map1);
f.close();
}
if(level==2)
{
players[index].give("dollar",-250000);
file f;
f.open("maps/"+players[index].name+"'s_house.map","wb");
f.write(homes[h].map2);
f.close();
}
}
}
void remove_home(string name)
{
for(uint i=0; i<homes.length(); i++)
{
if (homes[i].name==name)
{
file_delete("homes/"+homes[i].name+".hm");
file_delete("maps/"+homes[i].name+"'s_house.map");
send_reliable(0,"label_remove "+homes[i].x+" "+homes[i].x+" "+homes[i].y+" "+homes[i].y+" 0 0 "+homes[i].map,0);
@homes[i]=null;
homes.remove_at(i);
}
}
}
void changepass(string owner, string pass)
{
int index=get_player_index(e.peer_id);
int h=home_index(owner);
if( h>-1)
{
if (players[index].name!=owner)
{
send_reliable(players[index].peer_id,"cheat attempt failed",2);
return;
}
else
{
homes[h].code=pass;
//save_homes();
send_reliable(players[index].peer_id,"Your password has been successfully changed. New password: "+homes[h].code,2);
}
}
}
void change_home_name(string oldname, string newname)
{
int h=home_index(oldname);
homes[h].name=newname;
if(homes[h].level==1)
{
file f;
f.open("maps/"+newname+"'s_house.map","wb");
f.write(homes[h].map1);
f.close();
}
if(homes[h].level==2)
{
file f;
f.open("maps/"+newname+"'s_house.map","wb");
f.write(homes[h].map2);
f.close();
}
file_delete("maps/"+oldname+"'s_house.map");
file_delete("homes/"+oldname+".hm");
save_homes();
}
int in_home(string pname)
{
int index=get_player_index_from(pname);
if(index<0) return -1;
for(uint x=0; x<homes.length(); x++)
{
if(players[index].map==homes[x].name+"'s_house") return x;
}
return -1;
}
void compitermenu()
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string finaltext="compitermenu ";
finaltext+="change password\r\n";
finaltext+="kick someone out of the house.\r\n";
finaltext+="open the door for 15 seconds\r\n";
for(int i=0; i<homes.length(); i++)
{
if (homes[i].name==players[index].name) finaltext+="Anyone can open the chest.:"+homes[i].acs+"\r\n";
}
send_reliable(e.peer_id, finaltext, 0);
}
}
void open_home_door()
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
int s=in_home(players[index].name);
if (homes[s].name!=players[index].name)
{
send_reliable(players[index].peer_id,"you do not own this house",2);
return;
}
else
{
homes[s].unlocktimer.restart();
homes[s].unlocked=false;
}
}
}
void updateacs()
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
int s=in_home(players[index].name);
if (homes[s].name!=players[index].name)
{
send_reliable(players[index].peer_id,"you do not own this house",2);
return;
}
else
{
if(homes[s].acs=="off")
{
homes[s].acs="on";
send_reliable(players[index].peer_id,"chest can be opened by anyone",2);
}
else
{
homes[s].acs="off";
send_reliable(players[index].peer_id,"Only you can open the chest.",2);
}
compitermenu();
}
}
}
