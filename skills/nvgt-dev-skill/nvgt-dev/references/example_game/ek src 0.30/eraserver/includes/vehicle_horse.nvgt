}
}
if(fueltimer.elapsed>1000 && fuel>5 and speed>0)
{
fueltimer.restart();
fuel-=1;
if(fuel<400 and lowfuel == false){
sendint("vestart horse_breeth.ogg 100",owner);
send_to_passenger("vestart horse_breeth.ogg 100",passenger_list);
lowfuel=true;}
if(fuel>=400 and lowfuel==true)
{
lowfuel=false;
sendint("vestop",owner);
send_to_passenger("vestop",passenger_list);
}
if(fuel ==6){
 play("horse_down",x,y,z,map);
destroy_moving_sound(mid);
//sendint("vedstart",owner);
//send_to_passenger("vedstart",passenger_list);
speed = 0;
}
}
if(tile=="" and not falling)
{
falling=true;
falldist=0;
falltimer.restart();
}

}
