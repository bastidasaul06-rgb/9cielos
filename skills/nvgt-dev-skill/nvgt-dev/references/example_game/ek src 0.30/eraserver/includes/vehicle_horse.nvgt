//string tile;
if(speed==0) tile=get_tile_at(x,y,z,map);


if(vturn==true and turn_timer.elapsed>30)
{
turn_timer.restart();
if(turn_type=="right") facing=turnright(facing, 1);
if(turn_type=="left")facing=turnleft(facing, 1);
sendint("facing "+facing,owner);
send_to_passenger("facing "+facing,passenger_list);
}
if(movetimer.elapsed>=movetime&&soundtimer.elapsed>=soundtime&&speed>0) 
{
movetimer.restart();
vector m=move(x,y,facing);
tile=get_tile_at(round(x,0),round(y,0),round(z,0),map);
string tile_type1=tile_type;
if(string_contains(tile,"deepwater",1)>-1 or   string_contains(tile,"water",1)>-1) tile_type1 = "water";
else if(string_contains(tile,"concrete",1)>-1) tile_type1 = "concrete";
else if(string_contains(tile,"grass",1)>-1 or string_contains(tile,"sand",1)>-1 or  string_contains(tile,"dirt",1)>-1) tile_type1 = "dirt";
else if(string_contains(tile,"glass",1)>-1 or string_contains(tile,"metal",1)>-1) tile_type1 = "metal";
else if(string_contains(tile,"gravel",1)>-1) tile_type1 = "gravel";
else if( string_contains(tile,"snow_wet",1)>-1 or string_contains(tile,"snow",1)>-1 or string_contains(tile,"deepsnow",1)>-1 or string_contains(tile,"ice",1)>-1 or string_contains(tile,"icef",1)>-1 or string_contains(tile,"mountain",1)>-1) tile_type1 = "snow";
else if(string_contains(tile,"sand",1)>-1and string_contains(tile,"dirt",1)>-1) tile_type1 = "dirt";
else if(string_contains(tile,"metal",1)>-1) tile_type1 = "metal";
else if(string_contains(tile,"wetconcrete",1)>-1or  string_contains(tile,"swamp",1)>-1 or string_contains(tile,"mud",1)>-1) tile_type1 = "short_water";
else tile_type1="none";
//if(string_contains(tile,"water",1)>-1) tile_type = "water";
//if(string_contains(tile,"water",1)>-1) tile_type = "water";

if(((mode == "fast" and fuel <100) or (mode=="slow" and fuel >=100) and mode_set==false) or (tile_type1!="" && tile_type!=tile_type1))
{
tile_type = tile_type1;
string mid1=mid;
if(fuel<100 and mode == "fast"){ mode = "slow"; movetime=100;}
if(fuel >=100 and mode == "slow"){ mode = "fast"; movetime=100;}
if(tile_type=="water") mid=spawn_moving_sound("horse_"+mode+"_run17.ogg",x,y,z,map,"null");
else if(tile_type=="gravel") mid=spawn_moving_sound("horse_"+mode+"_run18.ogg",x,y,z,map,"null");
else if(tile_type=="short_water") mid=spawn_moving_sound("horse_"+mode+"_run19.ogg",x,y,z,map,"null");
else if(tile_type=="snow") mid=spawn_moving_sound("horse_"+mode+"_run15.ogg",x,y,z,map,"null");
else if(tile_type=="concrete") mid=spawn_moving_sound("horse_"+mode+"_run"+random(3,8)+".ogg",x,y,z,map,"null");
else if(tile_type=="metal") mid=spawn_moving_sound("horse_"+mode+"_run16.ogg",x,y,z,map,"null");
else if(tile_type=="dirt") mid=spawn_moving_sound("horse_"+mode+"_run"+random(1,3)+".ogg",x,y,z,map,"null");
else if(tile_type1=="none") mid=spawn_moving_sound("horse_"+mode+"_run1.ogg",x,y,z,map,"null");
else mid=spawn_moving_sound("horse_"+mode+"_run"+random(1,3)+".ogg",x,y,z,map,"null");
destroy_moving_sound(mid1);
}

if(string_left(tile,4)=="wall")
{
int i;
string t;
for(i=1;i<=11;i++)
{
t=get_tile_at(x,y,z+i,map);
if(t==""||string_left(t,4)!="wall") break; 
}
if(i>=11||string_left(t,4)=="wall") 
{
destroy_moving_sound(mid);
mid="";
speed=0;
Move=false;
hit_wall=true;
//sendint("vedstop",owner);
//send_to_passenger("vedstop",passenger_list);
}
else {
z+=i+1; }
int index=get_player_index_from(owner);
if(index>-1)
{
players[index].x=x;
players[index].y=y;
players[index].z=z;
send_reliable(players[index].peer_id,"move "+x+" "+y+" "+z,0);
}
for(int i=0;i<passenger_list.length();i++)
{
int index2=get_player_index_from(passenger_list[i]);
if(index2>-1)
{
players[index2].x=x;
players[index2].y=y;
players[index2].z=z;
send_reliable(players[index2].peer_id,"move "+x+" "+y+" "+z,0);
}
}
}
if(Move==true)
{
x=m.x;y=m.y;
if(x<0) x=0; m.x=0;
if(y<0) y=0; m.y=0;
if(x>max.x) x=max.x; m.x=x;
if(y>max.y) y=max.y; m.y=y;
if(horne==true)
{
update_moving_sound(hmid,x,y,z);
}
update_moving_sound(mid,x,y,z,pitch);
int index=get_player_index_from(owner);
if(index>-1)
{
players[index].x=x;
players[index].y=y;
players[index].z=z;
send_reliable(players[index].peer_id,"move "+x+" "+y+" "+z,0);
}
for(int i=0;i<passenger_list.length();i++)
{
int index2=get_player_index_from(passenger_list[i]);
if(index2>-1)
{
players[index2].x=x;
players[index2].y=y;
players[index2].z=z;
send_reliable(players[index2].peer_id,"move "+x+" "+y+" "+z,0);
}
}
