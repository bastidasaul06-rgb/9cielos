//fast 1, 2, 6, 7,     8,  9, 11, 13,14,  15, 16 17, 
//slow 3, 4, 5, 10,  12, 14, 18, 19
class horse : vehicle
{
horse(int pind)
{
super("horse",pind);
health=10000; 
old_health=health;
old_owner=players[pind].name;
owner=players[pind].name;
soundtime=3000;
vmovetime=100;
pitch=100;
movetime=100;
tile=get_tile_at(x,y,z,map);
speed=0;
sendint("vedstart",owner);
send_to_passenger("vedstart",passenger_list);
fuel=1000;
lowfuel = false;
}
~horse()
{
sendint("vedstop",owner);
send_to_passenger("vedstop",passenger_list);
sendint("vesiren off", owner);
}
void command(string cmd,string pname,bool force=false)
{
//sendint("speak "+cmd, owner);
int index=get_player_index_from(owner);
if(index<0) return;
if(owner!=pname) return; 
if(soundtimer.elapsed<soundtime) return; //&&(!updatingsvr&&!force)) return;
//if(force==false&&updatingsvr) return;
else if(string_left(cmd,10)=="start_turn")
{
if(speed<=1) return;
if(cmd=="start_turn_right") turn_type = "right";
if(cmd=="start_turn_left") turn_type="left";
vturn=true;
}
else if(cmd=="stop_turn")
{
vturn=false;
sendint("speak facing "+dir_to_string(getdir(facing))+" at "+facing+" dgrees",owner);
}
else if(string_left(cmd,6)=="escape")
{
string[] parsed=string_split(cmd,":",true);
if(parsed[1]=="player")
{
string tid=get_tile_at(x,y,z,map);
if( speed>0|| tid=="")
{
sendint("stop your horse first..." , owner);
return;
}
}
if(lowfuel==true)
{
lowfuel=false;
sendint("vestop",owner);
send_to_passenger("vestop",passenger_list);
}
sendint("veunspawn",owner);
send_to_passenger("veunspawn",passenger_list);
play(type+"_unspawn",x,y,z,map);
sendint("vedstop",owner);
send_to_passenger("vedstop",passenger_list);
remove=true;
}

else if(string_left(cmd,10)=="start_move"&&speed==0&& fuel>6)
//else if(cmd=="start_move"&&speed==0)
{
string[] s = string_split(cmd,":", true);
mode = "fast";
if(s.length()>1 and s[1]=="slow"){ mode = "slow"; mode_set = true;}
else mode_set = false;
tile=get_tile_at(x,y,z,map);
string tile_type1;
if(string_contains(tile,"deepwater",1)>-1 or   string_contains(tile,"water",1)>-1) tile_type1 = "water";
else if(string_contains(tile,"concrete",1)>-1) tile_type1 = "concrete";
else if(string_contains(tile,"grass",1)>-1 or string_contains(tile,"sand",1)>-1 or  string_contains(tile,"dirt",1)>-1) tile_type1 = "dirt";
else if(string_contains(tile,"glass",1)>-1 or string_contains(tile,"metal",1)>-1) tile_type1 = "metal";
else if(string_contains(tile,"gravel",1)>-1) tile_type1 = "gravel";
if(string_contains(tile,"water",1)>-1) tile_type1 = "water";
if(string_contains(tile,"wetconcrete",1)>-1or  string_contains(tile,"swamp",1)>-1 or string_contains(tile,"mud",1)>-1) tile_type1 = "short_water";
if( string_contains(tile,"snow_wet",1)>-1 or string_contains(tile,"snow",1)>-1 or string_contains(tile,"deepsnow",1)>-1 or string_contains(tile,"ice",1)>-1 or string_contains(tile,"icef",1)>-1 or string_contains(tile,"mountain",1)>-1) tile_type1 = "snow";
//if(string_contains(tile,"water",1)>-1) tile_type1 = "water";
//if(string_contains(tile,"water",1)>-1) tile_type = "water";
tile_type = tile_type1;
//string mid1=mid;
if(fuel<100) mode = "slow";
if(tile_type=="water") mid=spawn_moving_sound("horse_"+mode+"_run17.ogg",x,y,z,map,"null");
else if(tile_type=="short_water") mid=spawn_moving_sound("horse_"+mode+"_run19.ogg",x,y,z,map,"null");
else if(tile_type=="gravel") mid=spawn_moving_sound("horse_"+mode+"_run18.ogg",x,y,z,map,"null");
else if(tile_type=="concrete") mid=spawn_moving_sound("horse_"+mode+"_run"+random(3,8)+".ogg",x,y,z,map,"null");
else if(tile_type=="metal") mid=spawn_moving_sound("horse_"+mode+"_run16.ogg",x,y,z,map,"null");
else if(tile_type=="dirt") mid=spawn_moving_sound("horse_"+mode+"_run"+random(1,3)+".ogg",x,y,z,map,"null");
else if(tile_type=="snow") mid=spawn_moving_sound("horse_"+mode+"_run15.ogg",x,y,z,map,"null");
//else if(tile_type=="gravel") mid=spawn_moving_sound("horse_running13.ogg",x,y,z,map,"null");
else mid=spawn_moving_sound("horse_"+mode+"_run"+random(1,3)+".ogg",x,y,z,map,"null");
//destroy_moving_sound(mid1);
//else mid=spawn_moving_sound("horse_running"+random(1,18)+".ogg",x,y,z,map,"null");
playsound("horse_voice"+random(1,8),true,false);
//send_to_vehicle(in_vehicle(owner),"vestart horse_running"+random(1,8)+".ogg 100",0);
speed=1;
if(Move==false) Move=true;
move1=true;
sendint("move "+x+" "+y+" "+z,owner);
int index=get_player_index_from(owner);
send_to_passenger("move "+x+" "+y+" "+z,passenger_list);
if(index>-1) {players[index].x=x;players[index].y=y;players[index].z=z;}
for(int i=0;i<passenger_list.length();i++)
{
int index2=get_player_index_from(passenger_list[i]);
if(index2>-1) {players[index2].x=x;players[index2].y=y;players[index2].z=z;}
}
soundtimer.restart();
soundtime=300;
}

else if(cmd=="stop_move"&&speed==1)
{
speed=0;
move1=false;
playsound("horse_breeth1",true,false);

destroy_moving_sound(mid);
//sendint("vedstop",owner);
//send_to_passenger("vedstop",passenger_list);
//send_to_vehicle(in_vehicle(owner), "vestop",0);
sendint("move "+x+" "+y+" "+z,owner);
int index=get_player_index_from(owner);
if(index>-1) {players[index].x=x;players[index].y=y;players[index].z=z;}
for(int i=0;i<passenger_list.length();i++)
{
int index2=get_player_index_from(passenger_list[i]);
if(index2>-1) {players[index2].x=x;players[index2].y=y;players[index2].z=z;}
}
soundtimer.restart();
soundtime=300;
}

else if(string_left(cmd,8)=="turnleft")
{
string[] parsed=string_split(cmd,":",true);
//sendint("speak "+cmd, owner);

facing=snapleft(facing,getdir(facing),stn(parsed[1]));
if(stn(parsed[1])==45){ playint("horse_turn_half_left",owner); playext("horse_turn_half_left",x,y,z,map,owner);}
if(stn(parsed[1])==90){ playint("horse_turn_left", owner); playext("horse_turn_left",x,y,z,map, owner);}

int index=get_player_index_from(owner);
if(index>-1) players[index].facing=facing;
sendint("facing "+facing,owner);
sendint("speak facing "+dir_to_string(getdir(facing)),owner);
send_to_passenger("facing "+facing,passenger_list);
send_to_passenger("speak facing "+dir_to_string(getdir(facing)),passenger_list);
soundtimer.restart();
soundtime=1000;
}
else if(string_left(cmd,9)=="turnright")
{
string[] parsed=string_split(cmd,":",true);
facing=snapright(facing,getdir(facing),stn(parsed[1]));
if(stn(parsed[1])==45){ playint("horse_turn_half_right",owner); playext("horse_turn_half_right",x,y,z,map,owner);}
if(stn(parsed[1])==90){ playint("horse_turn_right",owner); playext("horse_turn_right",x,y,z,map,owner);}
int index=get_player_index_from(owner);
if(index>-1) players[index].facing=facing;
sendint("facing "+facing,owner);
sendint("speak facing "+dir_to_string(getdir(facing)),owner);
send_to_passenger("facing "+facing,passenger_list);
send_to_passenger("speak facing "+dir_to_string(getdir(facing)),passenger_list);
soundtimer.restart();
soundtime=1000;
}
}

void loop()
{
if(get_player_index_from(owner)<0) remove=true;
if(health<=0)
{
//spawn_fire(x,y,z,map,random(400,700));
destroy_moving_sound(mid);
sendint("vestop",owner);
send_to_passenger("vestop",passenger_list);
sendint("vedstop",owner);
send_to_passenger("vedstop",passenger_list);
send_to_passenger("veunspawn",passenger_list);
sendint("veunspawn",owner);
int index=get_player_index_from(old_owner);
//play(type+"_die",x,y,z,map);
send_plus(players[get_player_index_from(owner)].peer_id,"distsound vehicle_die_dist "+x+" "+y+" "+z+" "+map,0);
remove=true;
string hb=hitby;
if(string_contains(hb,"'",1)>-1) hb=string_left(hb,string_contains(hb,"'",1));
int k=get_player_index_from(hb);
if(index>-1&&k>-1) achloop(k,index);
if(index>-1)
{
string km=killmsg(players[index].name+"'s "+type,hitby,players[index].zone);
send_reliable(0,"playerdeath "+km,0);
players[index].health-=random(200, 500);
players[index].hitby="internal:fall down from horse";
}
}
if(falling&&falltimer.elapsed>=70)
{
string ctile=get_tile_at(x,y,z,map);
falltimer.restart();
if(ctile=="")
{
z--;
falldist++;
if(z<0)
{
falling=false;
falldist=0;
z=10;
}
update_moving_sound(mid,x,y,z,pitch);
int index=get_player_index_from(owner);
if(index>-1)
{
players[index].x=x;
players[index].y=y;
players[index].z=z;
send_unreliable(players[index].peer_id,"move "+x+" "+y+" "+z,0);
}
for(int i=0;i<passenger_list.length();i++)
{
int index2=get_player_index_from(passenger_list[i]);
if(index2>-1)
{
players[index2].x=x;
players[index2].y=y;
players[index2].z=z;
send_reliable(players[index2].peer_id,"move "+x+" "+y+" "+z,0);
}
}
}
else
{
tile=ctile;
falling=false;
if(falldist>=6)
{
hit(falldist*random(250,500),"gravity","artillery");
falldist=0;
}
else
{
play("vehicle_small_fall1",x,y,z,map); 
playint("vehicle_small_fall1",owner);
falldist=0;
}
}
}
