#include "police_siren.bgt"
class RN5_bike : vehicle
{
int sirenmode=0;
string sirenid;
RN5_bike(int pind)
{
super("RN5_bike",pind);
health=players[pind].pchealth;
old_health=health;
old_owner=players[pind].name;
fuel=players[pind].pcfuel;
fueltime=1750;
firetime=1;
soundtime=1000;
vmovetime=1000;
vfueltime=85;
tile=get_tile_at(x,y,z,map);
}
~RN5_bike()
{
if(sirenid!="")
{
destroy_siren(sirenid);
sendint("vesiren off", owner);
}
}
void command(string cmd,string pname,bool force=false)
{
int index=get_player_index_from(owner);
if(index<0) return;
if(owner!=pname) return; 
if(soundtimer.elapsed<soundtime&&(!updatingsvr&&!force)) return;
if(force==false&&updatingsvr) return;
if(fuel<=0 and (cmd!="escape"&&cmd!="repair")) return;
 if(cmd=="tell")
{
sendint(" !"+speed,owner);
}
/* if(cmd=="bomb_cound")
{
sendint(" "+bombs,owner);
}*/
else if(cmd=="horne")
{
send_reliable(0,"playvsound bike_horn "+x+" "+y+" "+z+" "+map,4);
sendint("!"+speed,owner);
}
else if(cmd=="took_passenger"&&speed<2)
{
if(passenger_count>1)
{
sendint("this motor_cycle can't fly morethen 2 player.",owner);
passenger = false;
}
else
{
took_passenger(players[index].x, players[index].y, players[index].z, players[index].map, players[index].name);
//sendint(players[index].passenger_name,owner);
//passenger=true;
//passenger_count+=1;
}
}
else if (cmd=="remove_passenger")
{
remove_passenger(passenger_list, owner);
}			
else if (cmd=="change_d")
{
change_driver(passenger_list, owner);
}
//if(cmd!="repair") playint(type+"_command",owner);
if(speed==0) vmovetime=1000;
if(cmd=="repair")
{
if(speed>0)
{
sendint("speak your vehicle must be off to receive repairs.",owner);
return;
}
sendint("speak just a sec...",owner);
soundtime=repair;
soundtimer.restart();
playsound("vehicle_repair",true,false);
doing="repair";
}
else if(cmd=="enter")
{
doing=(speed==0 ? "start" : "stop");
if(doing=="start")
{
if(safety==false&& speed==0){
 sendint("dont drive bike with out helmat,  put helmat!",owner);
doing="";
return;}
}
if(doing=="stop"&&speed>1&&!force)
{
sendint("speak your "+type+" must be idling before it can be shut off",owner);
doing="";
return;
}
if(doing=="start")
{
Move=true;
vmovetime=1000;
playext("RN5_bike_"+doing, x, y, z,map, owner);
playint("RN5_bike_"+doing, owner);
sendint("vedstart",owner);
send_to_passenger("vedstart",passenger_list);
 soundtime=700;
if(doing=="stop") soundtime=3000; //pcstop;
}
if(doing=="start" ) lowfuel=false;
if(doing=="stop")
{
safety=false;
destroy_moving_sound(mid);
mid="";
playext("RN5_bike_"+doing, x, y, z,map, owner);
playint("RN5_bike_"+doing, owner);
playext("helmat_remove1", x, y, z,map, owner);
playint("helmat_remove1", owner);
if(sirenmode!=0 or sirenid!="")
{
destroy_siren(sirenid);
sirenid="";
sirenmode=0;
sendint("vesiren off",owner);
}
sendint("vestop",owner);
send_to_passenger("vestop",passenger_list);
sendint("goodfuel",owner);
}
soundtimer.restart();
//sendint("goodfuel"+doing,owner);
vmovetime=1000;
playsound("motorcycle_"+doing);
//speed=0;
speed=(speed==0 ? 1 : 0);
return;
}
if(cmd=="firegun"&&firetimer.elapsed>=firetime and map!="store" and speed>0)
{
doing="prefire";
soundtime=pcweapon;
playsound("police_motorcycle_weapon_power");
soundtimer.restart();
}
else if(cmd=="policesiren"&&speed>0)
{
if(sirenmode==0)
{
sirenmode=1;
sirenid=spawn_siren("police_motorcycle_siren1",x,y,z,map,owner);
sendint("vesiren police_motorcycle_siren1_int.ogg",owner);
}
else if(sirenmode==1)
{
sirenmode=2;
destroy_siren(sirenid);
sirenid=spawn_siren("police_motorcycle_siren2",x,y,z,map,owner);
sendint("vesiren police_motorcycle_siren2_int.ogg",owner);
}
else
{
sirenmode=0;
destroy_siren(sirenid);
sirenid="";
sendint("vesiren off",owner);
}
}
else if(string_left(cmd,8)=="speed_up")
{
string[] parsed=string_split(cmd,":",true);
if(parsed[1]=="start") speed_up=true;
if(parsed[1]=="stop") speed_up=false;
}
else if(string_left(cmd,10)=="speed_down")
{
string[] parsed=string_split(cmd,":",true);
if(parsed[1]=="start") speed_down=true;
if(parsed[1]=="stop") speed_down=false;
}

else if(cmd=="start_horne")
{
horne=true;
hmid=spawn_moving_sound("bike_horn.ogg",x,y,z,map,owner);
send_to_vehicle(in_vehicle(owner),"vehstart bike_horn.ogg 100",0);
}
else if(cmd=="stop_horne")
{
send_to_vehicle(in_vehicle(owner),"vehstop",0);
horne=false;
destroy_moving_sound(hmid);
}
else if(string_left(cmd,10)=="start_turn")
{
if(speed<=1) return;
if(cmd=="start_turn_right") turn_type = "right";
if(cmd=="start_turn_left") turn_type="left";
vturn=true;
}
else if(cmd=="stop_turn")
{
vturn=false;
sendint("speak facing "+dir_to_string(getdir(facing))+" at "+facing+" dgrees",owner);
}
else if(string_left(cmd,6)=="escape")
{
string[] parsed=string_split(cmd,":",true);
if(parsed[1]=="player"){
string tid=get_tile_at(x,y,z,map);
if( speed>0|| tid=="")
{
sendint("speak you cannot exit your vehicle until it is completely off "+tid, owner);
return;
}
}
sendint("veunspawn",owner);
send_to_passenger("veunspawn",passenger_list);
play(type+"_unspawn",x,y,z,map);
int index=get_player_index_from(old_owner);
if(index>-1)
{
players[index].motorcyclehealth=health;
players[index].motorcyclefuel=fuel;
if(parsed[1]=="player"){
players[index].motorcyclex=x; players[index].motorcycley=y; players[index].motorcyclez=z;}
if(parsed[1]=="server"){
players[index].motorcyclex=-1; players[index].motorcycley=-1; players[index].motorcyclez=-1;}
}
remove=true;
}
else if(speed==0)
{
vmovetime=1000;
}
else if(cmd=="speedup"&& vmovetime>=200&&speed!=0) //speed<5&&speed>0)
{
movetime=vmovetime-=10;
//speed++;
if(movetime>=1000) speed=1;
if(movetime>=840 && movetime<1000) speed = 2;
if(movetime>=680 && movetime<840) speed = 3;
if(movetime>=520 && movetime<680) speed=4;
if(movetime>= 360&& movetime<520) speed=5;
if(movetime>=200&&movetime<360) speed=6;
//movetime=vmovetime-((speed-1)*100);
double pi=10;
//pi = (100-(movetime%10));
pi = (100-movetime/10+100);
//double inc=10;
//pi+=inc*(speed-1);
update_moving_sound(mid,x,y,z,pi);
this.pitch=pi;
sendint("vepitch "+pitch,owner);
send_to_passenger("vepitch "+pitch,passenger_list);
}
else if(cmd=="speeddown"&& vmovetime<1000)//speed>1)
{
movetime=vmovetime+=10;
if(movetime==1000) speed=1;
if(movetime>=840 && movetime<1000) speed = 2;
if(movetime>=680 && movetime<840) speed = 3;
if(movetime>=520 && movetime<680) speed=4;
if(movetime<=360 && movetime<520) speed=5;
if(movetime>=200 &&movetime<360) speed=6;
//sendint(" "+speed+" "+movetime,owner);
//movetime=vmovetime-((speed-1)*100);
double pi=60;
pi = (100-movetime/10+100);
//double inc=10;
//pi+=inc*(speed-1);
update_moving_sound(mid,x,y,z,pi);
this.pitch=pi;
sendint("vepitch "+pitch,owner);
send_to_passenger("vepitch "+pitch,passenger_list);
}
/*else if(cmd=="speedup"&&speed<5&&speed>0)
{
int prevspeed=speed;
speed++;
movetime=vmovetime-((speed-1)*100);
if(speed==2)
{
destroy_moving_sound(mid);
sendint("vestop",owner);
mid=spawn_moving_sound("police_motorcycle_drive_ext.ogg",x,y,z,map,owner);
sendint("vestart police_motorcycle_drive_int.ogg 100",owner);
this.pitch=100;
}
else if(speed>2)
{
double pi=100;
double inc=10;
pi+=inc*(speed-2);
update_moving_sound(mid,x,y,z,pi);
this.pitch=pi;
sendint("vepitch "+pitch,owner);
}
}
else if(cmd=="speeddown"&&speed>1)
{
int prevspeed=speed;
speed--;
movetime=vmovetime-((speed-1)*100);
if(speed==1)
{
destroy_moving_sound(mid);
sendint("vestop",owner);
mid=spawn_moving_sound("police_motorcycle_idle_ext.ogg",x,y,z,map,owner);
sendint("vestart police_motorcycle_idle_int.ogg 100",owner);
this.pitch=100;
}
else
{
double pi=100;
double inc=10;
pi+=inc*(speed-2);
update_moving_sound(mid,x,y,z,pi);
this.pitch=pi;
sendint("vepitch "+pitch,owner);
}
}
else if(cmd=="turnleft"&&speed>0)
{
facing=snapleft(facing,getdir(facing),45);
int index=get_player_index_from(owner);
if(index>-1) players[index].facing=facing;
sendint("facing "+facing,owner);
sendint("speak facing "+dir_to_string(getdir(facing)),owner);
playsound(type+"_turn",true,false);
}
else if(cmd=="turnright"&&speed>0)
{
facing=snapright(facing,getdir(facing),45);
int index=get_player_index_from(owner);
if(index>-1) players[index].facing=facing;
sendint("facing "+facing,owner);
sendint("speak facing "+dir_to_string(getdir(facing)),owner);
playsound(type+"_turn",true,false);
}*/
else if(cmd=="turnleft"&&speed>0)
{
facing=snapleft(facing,getdir(facing),45);
int index=get_player_index_from(owner);
if(index>-1) players[index].facing=facing;
sendint("facing "+facing,owner);
sendint("speak facing "+dir_to_string(getdir(facing)),owner);
send_to_passenger("facing "+facing,passenger_list);
send_to_passenger("speak facing "+dir_to_string(getdir(facing)),passenger_list);
playsound(type+"_turn",true,false);
}
else if(cmd=="turnright"&&speed>0)
{
facing=snapright(facing,getdir(facing),45);
int index=get_player_index_from(owner);
if(index>-1) players[index].facing=facing;
sendint("facing "+facing,owner);
sendint("speak facing "+dir_to_string(getdir(facing)),owner);
send_to_passenger("facing "+facing,passenger_list);
send_to_passenger("speak facing "+dir_to_string(getdir(facing)),passenger_list);
playsound(type+"_turn",true,false);
}
}
void loop()
{
if(get_player_index_from(owner)<0) remove=true;
if(health<=0)
{
spawn_fire(x,y,z,map,random(400,700));
destroy_moving_sound(mid);
sendint("vestop",owner);
send_to_passenger("vestop",passenger_list);
sendint("vedstop",owner);
send_to_passenger("vedstop",passenger_list);
if(sirenmode!=0 or sirenid!="")
{
destroy_siren(sirenid);
sirenid="";
sirenmode=0;
sendint("vesiren off",owner);
}
sendint("veunspawn",owner);
send_to_passenger("veunspawn",passenger_list);
int index=get_player_index_from(old_owner);
play(type+"_die",x,y,z,map);
send_plus(players[get_player_index_from(owner)].peer_id,"distsound vehicle_die_dist "+x+" "+y+" "+z+" "+map,0);
remove=true;
string hb=hitby;
if(string_contains(hb,"'",1)>-1) hb=string_left(hb,string_contains(hb,"'",1));
int k=get_player_index_from(hb);
if(index>-1)
{
players[index].motorcyclefuel=100;
players[index].motorcyclehealth=10000000;
players[index].motorcyclex=-1; players[index].motorcycley=-1; players[index].motorcyclez=-1;
players[index].give(type,-1);
string km=killmsg(players[index].name+"'s "+type,hitby,players[index].zone);
send_reliable(0,"playerdeath "+km,0);
players[index].health-=random(300, 500);
players[index].hitby="internal:vehicle:"+type;
}
}
if(doing!=""&&soundtimer.elapsed>=soundtime)
{
if(doing=="repair")
{
if(health<0) health=1000;
health=random(500000,1000000); //10000000;
sendint("speak your "+type+" has been repaired!",owner);
}
if(doing=="start")
{
speed=1;
mid=spawn_moving_sound("RN5_bike_drive.ogg",x,y,z,map,owner);
this.pitch=100;
sendint("vestart RN5_bike_drive.ogg 100",owner);
send_to_passenger("vestart RN5_bike_drive.ogg 100",passenger_list);
sendint("move "+x+" "+y+" "+z,owner);
int index=get_player_index_from(owner);
if(index>-1) {players[index].x=x;players[index].y=y;players[index].z=z;}
for(int i=0;i<passenger_list.length();i++)
{
int index2=get_player_index_from(passenger_list[i]);
if(index2>-1)
{
players[index2].x=x;
players[index2].y=y;
players[index2].z=z;
//send_reliable(players[index2].peer_id,"move "+x+" "+y+" "+z,0);
}
}
}
if(doing=="stop")
{
speed =0;
destroy_moving_sound(mid);
sendint("vedstop",owner);
send_to_passenger("vedstop",passenger_list);
sendint("move "+x+" "+y+" "+z,owner);
int index=get_player_index_from(owner);
if(index>-1) {players[index].x=x;players[index].y=y;players[index].z=z;}
for(int i=0;i<passenger_list.length();i++)
{
int index2=get_player_index_from(passenger_list[i]);
if(index2>-1)
{
players[index2].x=x;
players[index2].y=y;
players[index2].z=z;
//send_reliable(players[index2].peer_id,"move "+x+" "+y+" "+z,0);
}
}
}
if(doing=="prefire")
{
playsound("police_motorcycle_weapon_fire");
send_plus(players[get_player_index_from(owner)].peer_id,"distsound police_motorcycle_weapon_fire_dist "+x+" "+y+" "+z+" "+map,0);
int hit=0;
for(uint i=0; i<players.length(); i++)
{
if(players[i].name==owner or players[i].invinsible or players[i].is_dead or players[i].map!=map or in_vehicle(players[i].name)>-1) continue;
if(get_3d_distance(x,y,z,players[i].x,players[i].y,players[i].z)<=16)
{
hit++;
players[i].playsound("hit"+random(1,5));
players[i].hit(12000,12000);
players[i].should_subtract=false;
players[i].hitby=owner+"'s police car";
}
}
int remhit=0;
for(uint i=0; i<remguns.length(); i++)
{
if(get_3d_distance(x,y,z,remguns[i].x,remguns[i].y,remguns[i].z)<=16 and map==remguns[i].map)
{
remhit++;
remguns[i].health-=random(8000,12000);
remguns[i].hitby=owner+"'s police car";
play("remgunhit"+random(1, 3),remguns[i].x,remguns[i].y,remguns[i].z,remguns[i].map);
}
}
int vhit=0;
for(uint i=0; i<vs.length(); i++)
{
if(get_3d_distance(x,y,z,vs[i].x,vs[i].y,vs[i].z)<=16 and vs[i].map==map and vs[i].owner!=owner)
{
vs[i].hit(random(8000,10000),owner+"'s police car","artillery");
vhit++;
}
}
for(uint j=0; j<impact_bombs.length(); j++)
{
if(get_3d_distance(x,y,z,impact_bombs[j].x,impact_bombs[j].y,impact_bombs[j].z)<=16 and impact_bombs[j].map==map)
{
play("ibombhit"+random(1,3),impact_bombs[j].x,impact_bombs[j].y,impact_bombs[j].z,impact_bombs[j].map);
impact_bombs[j].health-=random(4000,6000);
}
}
if(hit==0&&remhit==0&&vhit==0) sendint("speak hit nothing",owner);
else if(hit>0&&remhit==0&&vhit==0) sendint("speak hit "+hit+" players",owner);
else if(remhit>0&&hit==0&&vhit==0) sendint("speak hit "+remhit+" remote guns",owner);
else if(remhit>0&&vhit>0&&hit==0) sendint("speak hit "+vhit+" vehicles and "+remhit+" remote guns",owner);
else if(hit>0&&remhit==0&&vhit>0) sendint("speak hit "+hit+" players and "+vhit+" vehicles",owner);
else if(vhit>0&&hit==0&&remhit==0) sendint("speak hit "+vhit+" vehicles",owner);
else sendint("speak hit "+hit+" players, "+vhit+" vehicles and "+remhit+" remote guns",owner);
firetimer.restart();
}
doing="";
}
if(fueltimer.elapsed>=(fueltime-(vfueltime*(speed-1)))&&speed>0)
{
fuel-=0.1;
fuel=round(fuel,1);
fueltimer.restart();
}
if(fuel<=2.5&&lowfuel==false&&speed>0)
{
lowfuel=true;
sendint("lowfuel",owner);
}
if(fuel<=0&&doing!="fall"&&speed>0)
{
sendint("goodfuel",owner);
sendint("vestop",owner);
send_to_passenger("vestop",passenger_list);
sendint("vedstop",owner);
send_to_passenger("vedstop",passenger_list);
destroy_moving_sound(mid);
playext("police_motorcycle_stop_ext",x,y,z,map,owner);
playint("police_motorcycle_stop_int",owner);
mid="";
speed=0;
}

if(falling&&falltimer.elapsed>=70)
{
string ctile=get_tile_at(x,y,z,map);
falltimer.restart();
if(ctile=="")
{
z--;
falldist++;
if(z<0)
{
falling=false;
falldist=0;
z=10;
}
update_moving_sound(mid,x,y,z,pitch);
int index=get_player_index_from(owner);
if(index>-1)
{
players[index].x=x;
players[index].y=y;
players[index].z=z;
send_unreliable(players[index].peer_id,"move "+x+" "+y+" "+z,0);
}
for(int i=0;i<passenger_list.length();i++)
{
int index2=get_player_index_from(passenger_list[i]);
if(index2>-1)
{
players[index2].x=x;
players[index2].y=y;
players[index2].z=z;
send_reliable(players[index2].peer_id,"move "+x+" "+y+" "+z,0);
}
}
}
else
{
tile=ctile;
falling=false;
if(falldist>=6)
{
hit(falldist*random(250,500),"gravity","artillery");
falldist=0;
}
else
{
play("vehicle_small_fall1",x,y,z,map); 
playint("vehicle_small_fall1",owner);
falldist=0;
}
}
}


if(vehicle_accident==true)
{
speed_up=false; speed_down=false;
safety=false;
//falling=true;
doing="fall";
sendint("vestop",owner);
send_to_passenger("vestop",passenger_list);
sendint("vedstop",owner);
send_to_passenger("vedstop",passenger_list);
destroy_moving_sound(mid);
mid="";
speed=0;
playsound("aircraft_nofuel");
soundtime=aircraftdie;
soundtimer.restart();
health-=orginal_health/6;
vehicle_accident=false;
}
if(speed_up==true&&move_speed_timer.elapsed>300) //speed_time&&speed>0)
{
//sendint("speed man!", owner);
move_speed_timer.restart();
if(vmovetime>=200&&speed!=0) //speed<5&&speed>0)
{
movetime=vmovetime-=10;
//speed++;
if(movetime>=1000) speed=1;
if(movetime>=810 && movetime<1000) speed = 2;
if(movetime>=620 && movetime<810) speed = 3;
if(movetime>=410 && movetime<620) speed=4;
if(movetime>=200 && movetime<410) speed=5;
if(movetime>=70&&movetime<200) speed=6;
//movetime=vmovetime-((speed-1)*100);
double pi=10;
//pi = (100-(movetime%10));
pi = (100-movetime/10+100);
//double inc=10;
//pi+=inc*(speed-1);
update_moving_sound(mid,x,y,z,pi);
this.pitch=pi;
sendint("vepitch "+pitch,owner);
send_to_passenger("vepitch "+pitch,passenger_list);
}
}
else if((speed_down==true||speed_up==false) &&move_speed_timer.elapsed>speed_time&&speed>0)
{
if(speed_down==false&&speed>1)
{
speed_time=1000-movetime;
if(speed_time<180)speed_time=180;
}
else speed_time=70;
move_speed_timer.restart();
if(vmovetime<1000)//speed>1)
{
movetime=vmovetime+=10;
if(movetime==1000) speed=1;
if(movetime>=810 && movetime<1000) speed = 2;
if(movetime>=620 && movetime<810) speed = 3;
if(movetime>=410 && movetime<620) speed=4;
if(movetime>=200 && movetime<410) speed=5;
if(movetime>=70&&movetime<200) speed=6;
//sendint(" "+speed+" "+movetime,owner);
//movetime=vmovetime-((speed-1)*100);
double pi=60;
pi = (100-movetime/10+100);
//double inc=10;
//pi+=inc*(speed-1);
update_moving_sound(mid,x,y,z,pi);
this.pitch=pi;
sendint("vepitch "+pitch,owner);
send_to_passenger("vepitch "+pitch,passenger_list);
}
}
if(ononsmentimer.elapsed>3000)
{
ononsmentimer.restart();
if(health<old_health) {old_health=health; ononsment="h";}
if(hit_wall==true){ hit_wall=false; ononsment="w";}
if(ononsment=="w") playint("cmd_vehicle_drive_carefully",owner);
if(ononsment=="h") playint("cmd_vehicle_attack"+random(1,5),owner);
ononsment="";
} 

if(vturn==true and turn_timer.elapsed>30)
{
turn_timer.restart();
if(turn_type=="right") facing=turnright(facing, 1);
if(turn_type=="left")facing=turnleft(facing, 1);
sendint("facing "+facing,owner);
send_to_passenger("facing "+facing,passenger_list);
}
if(speed==0) tile=get_tile_at(x,y,z,map);
if(Move==false) Move=true;
if(movetimer.elapsed>=movetime&&soundtimer.elapsed>=soundtime&&speed>1) //&&!falling)
{
movetimer.restart();
vector m=move(x,y,facing);
tile=get_tile_at(m.x,m.y,m.z,map);
if(string_left(tile,4)=="wall")
{
int i;
string t;
for(i=1;i<=7;i++)
{
