health+=random(100,100);
}
if(fooditem=="cola")
{
food+=random(200,300);
health+=random(10000,15000);
}
if(fooditem=="cracker")
{
food+=random(200,300);
health+=random(600,600);
}
if(fooditem=="juce_box")
{
food+=random(200,300);
health+=random(1000,1000);
}
if(fooditem=="meat")
{
food+=random(200,300);
health+=random(200,200);
}
if(fooditem=="melon")
