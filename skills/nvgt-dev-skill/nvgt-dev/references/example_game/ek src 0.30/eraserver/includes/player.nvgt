}
    marriagesystem.marriagecheck(players[i]);
//        player_tileloop(); // Add this line to call the player_tile loop
if(players[i].level>=1 and players[i].level<=50) players[i].ptitle="newbie";
if(players[i].level>=51 and players[i].level<=100) players[i].ptitle="soldier";
if(players[i].level>=101 and players[i].level<=150) players[i].ptitle="corporal";
if(players[i].level>=151 and players[i].level<=200) players[i].ptitle="Sergeant";
