if(players[i].level>=1001 and players[i].level<=1300) players[i].ptitle="Captain";
if(players[i].level>=1301 and players[i].level<=1500) players[i].ptitle="Major";
if(players[i].level>=1501 and players[i].level<=1750) players[i].ptitle="Lieutenant_Colonel";
if(players[i].level>=1751 and players[i].level<=2000) players[i].ptitle="Colonel";
if(players[i].level>=2001 and players[i].level<=2500) players[i].ptitle="Brigadier";
if(players[i].level>=2501 and players[i].level<=3000) players[i].ptitle="Major_General";
if(players[i].level>=3001 and players[i].level<=4000) players[i].ptitle="Lieutenant_General";
if(players[i].level>=4001 and players[i].level<=5000) players[i].ptitle="General";
if(players[i].level>=5001 and players[i].level<=10000) players[i].ptitle="Field_Marshal";
if(players[i].map=="jail") players[i].ptitle="prisoner";
if(players[i].map=="safe_zone") players[i].ptitle="safe";
if(players[i].map=="test") players[i].ptitle="tester";
if(players[i].super=="no")
{
/*
if (players[i].xp>=players[i].xprequired)
{
players[i].level+=1;
players[i].xprequired=(50*(players[i].level*(players[i].level*2)));
//players[i].xprequired=(25*(players[i].level*(players[i].level*5)));
