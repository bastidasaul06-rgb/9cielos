}
void spawn_item(double x,double y,double z,string type,int amount,string map)
{
if(spawned_total(type)<10)
{
if(string_left(get_tile_at(x, y, z, map), 4)=="wall") return;
item item1(x,y,z,type,amount,map);
items.insert_last(item1);
}
}
int get_item_index(string id)
{
for(uint i=0; i<items.length(); i++)
{
if(items[i].itemid==id) return i;
}
return -1;
}
int spawned_total(string name)
{
int count=0;
for(uint i=0; i<items.length(); i++)
{
if(items[i].type==name) count++;
}
return count;
}