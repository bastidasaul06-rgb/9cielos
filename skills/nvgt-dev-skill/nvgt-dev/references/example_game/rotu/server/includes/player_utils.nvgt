void emote(string action,int number_of_times=1)
{
if(number_of_times>3) return;
for(uint i=0; i<players.length(); i++)
{
if(players[i].emotes==1)
{
for(uint n=1; n<number_of_times; n++)
{
send(players[i].peer_id,"play_s me"+action+".ogg",6);
}
}
}
}

