bool ip_match(string ip)
{
int ipcounter=0;
string[]foundnames;
string[]ipnames;
string[]dirs=find_directories("players*");
for(uint i=0; i<dirs.length(); i++)
{
ipnames.insert_last(dirs[i]);
}
for(uint i2=0; i2<ipnames.length(); i2++)
{
if(get_file("players/"+ipnames[i2]+"/ip.dat")==ip)
{
foundnames.insert_last(ipnames[i2]);
ipcounter++;
}
}
if(ipcounter>1)
{
admintell(lister(foundnames));
return true;
}
else return false;
}

void play(string filename,int x,int y,int z,string map,int index=-1)
{
if(index>-1)
{
send(players[index].peer_id,"play "+filename+".ogg "+x+" "+y+" "+z+" "+map,6);
}
else
{
send(0,"play "+filename+".ogg "+x+" "+y+" "+z+" "+map,6);
}
}

void play2(string filename,int x,int y,int z,string map,int index=-1)
{
if(index>-1)
{
send(players[index].peer_id,"play_s "+filename+".ogg",6);
}
for(uint i=0; i<players.length(); i++)
{
netloop();
if(i==index and index>-1) continue;
if(players[i].mymap.name==map and get_3d_distance(players[i].x, players[i].y, players[i].z, x, y, z)<=35)
send(players[i].peer_id,"play "+filename+".ogg "+x+" "+y+" "+z+" "+map,6);
}
}

void notify(string message,string notify_sound="notify.ogg")
{
send(0,message,2);
send(0,"play_s "+notify_sound,6);
}

void map_notify(string message,string map)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].map==map) send(players[i].peer_id,message,2);
}
}

string get_event_message()
{
string receiver=e.message;
if(receiver.is_empty()) return "";
receiver=string_decrypt(receiver,decryptkey);
return receiver;
}

void send_unreliable(uint peer,string message,uint channel)
{
message=string_encrypt(message,decryptkey);
n.send_unreliable(peer,message,channel);
}

void send(uint peer,string message,uint channel)
{
message=string_encrypt(message,decryptkey);
n.send_reliable(peer,message,channel);
}

void send_nearby_unreliable(string message,uint channel,int distance,double x,double y,double z,string map)
{
message=string_encrypt(message,decryptkey);
for(uint i=0; i<players.length(); i++)
{
if(players[i].map!=map) continue;
if(get_3d_distance(x,y,z,players[i].x,players[i].y,players[i].z)<=distance)
{
n.send_unreliable(players[i].peer_id,message,channel);
}
}
}

void send_nearby_reliable(string message,uint channel,int distance,double x,double y,double z,string map)
{
message=string_encrypt(message,decryptkey);
for(uint i=0; i<players.length(); i++)
{
if(get_3d_distance(x,y,z,players[i].x,players[i].y,players[i].z)<=distance and players[i].map==map)
{
n.send_reliable(players[i].peer_id,message,channel);
}
}
}
void send_nearby_reliablen(int peer_id, string message,uint channel,int distance,double x,double y,double z,string map)
{
message=string_encrypt(message,decryptkey);
for(uint i=0; i<players.length(); i++){
if(players[i].peer_id==peer_id)continue;
if(get_3d_distance(x,y,z,players[i].x,players[i].y,players[i].z)<=distance and players[i].map==map)
{
n.send_reliable(players[i].peer_id,message,channel);
}
}
}
void send_nearby_unreliablen(int peer_id, string message,uint channel,int distance,double x,double y,double z,string map)
{
message=string_encrypt(message,decryptkey);
for(uint i=0; i<players.length(); i++){
if(players[i].peer_id==peer_id)continue;
if(get_3d_distance(x,y,z,players[i].x,players[i].y,players[i].z)<=distance and players[i].map==map)
{
n.send_unreliable(players[i].peer_id,message,channel);
}
}
}