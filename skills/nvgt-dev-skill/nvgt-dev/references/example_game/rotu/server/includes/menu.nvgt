void fbmenu(int id)
{
server_menu m;
file f;
f.open("feedbacks.txt","rb");
string[]feedbacks=string_split(f.read(),"\r\n",false);
f.close();
m.intro="Viewing feedback list. Contains "+feedbacks.length()+" items.";
m.initial_packet="feedbacks";
for(uint i=0; i<feedbacks.length(); i++)
{
m.add("#"+(i+1)+". "+(string_contains(feedbacks[i],"*",1)==0?"(completed by developer) "+string_replace(feedbacks[i],"*","",false):feedbacks[i]),feedbacks[i]);
}
m.send(id);
}

void storemenu(int id)
{
int nd=get_player_index(id);
if(nd==-1) return;
server_menu m;
m.initial_packet="purchase";
m.intro="Store. Select an option.";
string[]stitems=string_split(get_file("store.dat"),"\r\n",false);
for(uint i=0; i<stitems.length(); i++)
{
string[] itms=string_split(stitems[i],":",false);
bool will_added=true;
if(itms.length()==5) {
if(itms[4]=="*" and players[nd].paid==0) will_added=false;
}
if(stn(itms[3])<=players[nd].lvl and will_added)
{
int price=stn(itms[1]);
if(players[nd].paid==1 and price>=25) price-=price*0.25;
m.add(itms[0]+" for "+price+" gold",itms[0]);
}
else continue;
}
m.send(id);
}

void chansmenu(int id)
{
int ind=get_player_index(id);
string[]chans=string_split(get_file("languages.lng"),"\r\n",false);
server_menu m;
m.intro="Channels list. There are "+chans.length()+" channels available.";
m.initial_packet="chanselect";
m.add("Disable chat","disable");
if((ind>-1) and players[ind].admin or players[ind].dev) m.add("Admin chat","Admin chat");
for(uint i=0; i<chans.length(); i++)
{
m.add(chans[i],chans[i]);
}
m.send(id);
}

void playersmenu(int id)
{
server_menu m;
m.intro="Viewing "+(players.length()-1)+" players. Press Control plus C to copy their names to your clipboard.";
m.initial_packet="playerselect";
int ind=get_player_index(id);

for(uint i=0; i<players.length(); i++)
{
if(players[i].name!=players[ind].name)
{
m.add((players[i].afk?"AFK ":"")+(players[i].dev?"Developer ":"")+(players[i].admin and !players[i].dev?"Admin ":"")+players[i].exprank+" "+players[i].char+(players[i].char!=players[i].name?" ("+players[i].name+")":"")+": "+(players[i].channel!=players[ind].channel?(players[i].channel==""?"Chat disabled. ":players[i].channel+" channel. "):"")+"on "+players[i].map+". "+players[i].kills+" kills, "+players[i].deaths+" deaths.",players[i].name);
}
}
m.send(id);
}

void questmenu(int index=-1) {
if(index==-1) return;
server_menu m;
m.intro="Choose a quest to accept, escape to cancel";
m.initial_packet="accept_quest";
for(uint i=0; i<quests.length(); i+=1) {
m.add(quests[i].title+", description: "+quests[i].description+".\nYou must be level "+quests[i].minlevel+" to do this quest. For completing this quest, you will receive "+quests[i].rewarded_item_amount+" "+quests[i].rewarded_item+" and "+quests[i].exp+" experience", quests[i].title);
}
m.add("Cancel", "back");
m.send(players[index].peer_id);
}
