}


void smsboard(int id)
{
server_menu m;
string[]posts=string_split(motd,"\r\n",false);
if(posts.length()<2) {
send(id, motd, 2);
return;
}
m.intro="Viewing message board. Contains "+posts.length()+" items.";
m.initial_packet="bruh";
for(uint i=0; i<posts.length(); i++)
{
m.add("#"+(i+1)+": "+posts[i],posts[i]);
}
m.send(id);
}
void charmenu(int id)
{
int index=get_player_index(id);
if(index<=-1){
 send(id,"dlgblock Error. Something went wrong.",0);
return;
}
server_menu m;
m.intro="Character menu.";
m.initial_packet="char_option";
string[]mychars=find_directories("players/"+players[index].name+"/*");
for(uint i=0; i<mychars.length(); i++)
{
m.add(mychars[i],mychars[i]);
}
int max=2;
if(players[index].paid==1) max=10;
if(mychars.length()<max) m.add("Create new character","createchar");
//m.add("remove a character", "removechar");
m.send(id);
}
void gendermenu(int id)
{
server_menu m;
m.intro="Select gender.";
m.initial_packet="genderset";
m.add("Male","Male");
m.add("Female","Female");
m.send(id);
}
void itemsmenu(int id)
{
int nd=get_player_index(id);
server_menu m;
m.intro="Game Objects menu. Select an object to track.";
m.initial_packet="itemtrack";
m.add("Stop tracking","stoptrack");
for(uint i=0; i<items.length(); i++)
{
int dist=get_3d_distance(items[i].x,items[i].y,items[i].z,players[nd].x,players[nd].y,players[nd].z);
if(dist<35 and items[i].map==players[nd].map)
{
string ab;
if(items[i].z>players[nd].z) ab="above";
if(items[i].z<players[nd].z) ab="below";
m.add(items[i].amount+" "+items[i].type+" is "+(ab!=""?ab+", ":"")+calculate_x_y_string(calculate_x_y_angle(players[nd].x,players[nd].y,items[i].x,items[i].y,players[nd].dir))+", "+dist+" tiles away.",items[i].x+":"+items[i].y+":"+items[i].z);
}
}
m.send(id);
}
void linemenu(int id,string action="")
{
if(action=="") return;
server_menu m;
if(action=="remove") m.initial_packet="remove_line";
if(action=="edit") m.initial_packet="edit_line";
m.intro="Select line.";
int index=get_player_index(id);
if(index<=-1) return;
map_data@mp=get_map_handle(players[index].map);
if(@mp==null) return;
string[]lines=string_split(mp.rawdata,"\r\n",true);
for(uint i=0; i<lines.length(); i++)
{
m.add(lines[i],i);
}
m.send(id);
}