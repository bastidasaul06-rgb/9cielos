void buildermenu(int id)
{
int index=get_player_index(id);
if(index<=-1) return;
map_data@m2=get_map_handle(players[index].map);
if(@m2==null)
{
send(e.peer_id,"This map is damaged, does not exist, or an error occured.",0);
return;
}
server_menu m;
m.intro="Builder menu";
m.initial_packet="build";
m.add("surface","surface");
m.add("source","source");
m.add("url source", "url");
m.add("music","music");
m.add("travelpoint","travelpoint");
m.add("door","door");
m.add("zone","zone");
m.add("sign","sign");
m.add("beacon","beacon");
m.add("hazard", "hazard");
m.add("spawnpoint","spawnpoint");
m.add("safezone","safezone");
m.add("PVP is "+(m2.fights?"allowed":"disallowed")+" on this map. Press Enter to change.","fights");
m.add("Map viewpoint, controls how weather is heard on the map. Current viewpoint is "+m2.viewpoint+". Press Enter to change.","view");
m.add("Undead auto-spawning is "+(m2.can_have_items?"enabled":"disabled")+" on this map. Press Enter to change.","itemspawn");
m.add("Inventory type is currently "+m2.invtype+". Press Enter to change.","invtype");
m.add("Map Max X is "+m2.maxx+". Press Enter to change.","editmaxx");
m.add("Map Max Y is "+m2.maxy+". Press Enter to change.","editmaxy");
m.add("Add a line","addline");
m.add("Edit an existing line","editline");
m.add("Remove a line","remline");
m.add("Create a new map","newmap");
m.add("Delete this map","delmap");
m.send(id);
}

void trackmenu(int id)
{
int index=get_player_index(id);
if(index>-1){
server_menu m;
m.intro="Player track menu";
m.initial_packet="trackselect";
if(players[index].trackingplayer)
{
m.add("Stop tracking","stoptracking");
}
for(uint i=0; i<players.length(); i++)
{
if(players[i].map==players[index].map and players[i].name!=players[index].name)
{
m.add(players[i].name,players[i].name);
}
}
m.send(id);
}
}


void mapsmenu(int id)
{
server_menu m;
m.intro="Maps list";
m.initial_packet="mapselect";
string[]mapfiles=find_files("maps/*.map");
for(uint i=0; i<mapfiles.length(); i++)
{
string replacer=string_replace(mapfiles[i],".map","",true);
int load=get_map_index(replacer);
m.add(replacer+(load>-1?" (loaded)":""),replacer);
}
m.send(id);
}

void throwmenu(int id)
{
server_menu m;
m.intro="Select how you would like to throw this grenade.";
m.initial_packet="grenadethrow";
m.add("level","0");
m.add("downward","-1");
m.add("upward","1");
m.send(id);
}

void mpadmenu(int id)
{
int nd=get_player_index(id);
server_menu m;
m.intro=(players[nd].mpad?"The pad reawakens as your finger touchs the screen.":"The tablet lights up, and the home screen appears.")+" Select an option.";
m.initial_packet="mpadselect";
double calcpercent=round((9000000*players[nd].mpadbat)/60,0);
m.add("Digital clock: "+get_sayable_time(),get_sayable_time());
m.add("mPad battery level: "+players[nd].mpadbat+" percent, "+ms_to_readable_time(calcpercent)+" remaining","mpadbattery");
m.add("Item Transfer status: "+(players[nd].mtrans==1?"on":"off"),"itemtrans");
if(players[nd].paid==1) m.add("Online Store","quickbuy");
m.add("Walkie Talkie"+(players[nd].wtchannel!=0?" (on channel "+players[nd].wtchannel+")":""),"mradio");
m.add("Gold Flip","__goldflip__");
m.add("iRoll","__iroll__");
m.add("Power off","off");
m.send(id);
}

void viewallplayers(int id)
{
server_menu m;
string[]dirs=find_directories("players/*");
m.intro="Viewing "+dirs.length()+" players in the database.";
m.initial_packet="playerget";
for(uint i=0; i<dirs.length(); i++)
{
string[] charlist=find_directories("players/"+dirs[i]+"/*");
m.add(dirs[i]+" with "+charlist.length()+" characters",dirs[i]);
}
m.send(id);
}

void wtmenu(int id)
{
server_menu m;
m.initial_packet="wtchanselect";
m.intro="A list of available transmission channels fills the screen. Select the desired channel.";
m.add("Disable walkie talkie","disable");
for(uint i=1; i<100; i++)
