void ctfloop()
{
for(uint i=0; i<ctfs.length(); i++)
{
if(ctfs.length()==0) break;
if(ctfs[i].red_members.length()<=0 and ctfs[i].green_members.length()<=0)
{
delete_map(ctfs[i].name);
@ctfs[i]!=null;
ctfs.remove_at(i);
return;
}
if(ctfs[i].started==false)
{
if(ctfs[i].greenscore!=0) ctfs[i].greenscore=0;
if(ctfs[i].redscore!=0) ctfs[i].redscore=0;
}
if(ctfs[i].started)
{
for(uint x=0; x<players.length(); x++)
{
if(players[x].map!=ctfs[i].name and players[x].cf==ctfs[i].name)
{
int[]redside={50,25,0};
int[]greenside={50,125,0};
players[x].health=5000;
if(players[x].incar) players[x].carcom="getout";
if(players[x].ctfteam=="red") changemap(players[x],get_map_handle(ctfs[i].name),redside);
if(players[x].ctfteam=="green") changemap(players[x],get_map_handle(ctfs[i].name),greenside);
}
}
}

if(ctfs[i].redscore>=10)
{
for(uint x=0; x<players.length(); x++)
{
if(players[x].map==ctfs[i].name)
{
if(players[x].ctfteam=="red")
{
players[x].give("gold",random(75,200));
send(players[x].peer_id,"You have just beat the green team "+ctfs[i].redscore+" to "+ctfs[i].greenscore+"!",2);
}
if(players[x].ctfteam=="green")
{
send(players[x].peer_id,"You have just lost to the red team "+ctfs[i].greenscore+" to "+ctfs[i].redscore+"!",2);
}
players[x].cf="";
players[x].ctfteam="";
int[]newpos={223,434,0};
changemap(players[x],get_map_handle("main"),newpos);
}
}
delete_map(ctfs[i].name);
@ctfs[i]!=null;
ctfs.remove_at(i);
return;
}
if(ctfs[i].greenscore>=10)
{
for(uint x=0; x<players.length(); x++)
{
if(players[x].map==ctfs[i].name)
{
if(players[x].ctfteam=="green")
{
players[x].give("gold",random(25,100));
send(players[x].peer_id,"You have just beat the red team "+ctfs[i].greenscore+" to "+ctfs[i].redscore+"!",2);
}
if(players[x].ctfteam=="red")
{
send(players[x].peer_id,"You have just lost to the green team "+ctfs[i].redscore+" to "+ctfs[i].greenscore+"!",2);
}
players[x].cf="";
players[x].ctfteam="";
int[]newpos={223,434,0};
changemap(players[x],get_map_handle("main"),newpos);
}
}
delete_map(ctfs[i].name);
@ctfs[i]!=null;
ctfs.remove_at(i);
return;
}
}
}
void add_ctf_member(string ctfname,string color,string membername)
{
bool success=false;
int index=get_ctf_index(ctfname);
if(index>-1)
{
if(color=="red" and ctfs[index].red_members.find(membername)<=-1 and ctfs[index].green_members.find(membername)<=-1)
{
ctfs[index].red_members.insert_last(membername);
success=true;
}
else if(color=="green" and ctfs[index].green_members.find(membername)<=-1 and ctfs[index].red_members.find(membername)<=-1)
{
ctfs[index].green_members.insert_last(membername);
success=true;
}
}
int index2=get_player_index_from(membername);
if(index2>-1)
{
send(players[index2].peer_id,(success?"You have joined the event!":"Error. Something went wrong. Either you are already on a team, or there was a different error."),2);
}
}
void rem_ctf_member(string ctfname,string color,string membername)
{
bool success=false;
int index=get_ctf_index(ctfname);
if(index>-1)
{
if(color=="red" and ctfs[index].red_members.find(membername)>-1)
{
int memdex=ctfs[index].red_members.find(membername);
ctfs[index].red_members.remove_at(memdex);
success=true;
}
else if(color=="green" and ctfs[index].green_members.find(membername)>-1)
{
int memdex=ctfs[index].green_members.find(membername);
ctfs[index].green_members.remove_at(memdex);
success=true;
}
}
int index2=get_player_index_from(membername);
if(index2>-1)
{
send(players[index2].peer_id,(success?"You left the event.":"Error. Something went wrong."),2);
}
}
int get_ctf_index(string ctfname)
{
for(uint i=0; i<ctfs.length(); i++)
{
if(ctfs[i].name==ctfname) return i;
}
return -1;
}
class flag{
double x,y,z;
string color,map;
flag(double fx,double fy,double fz,string fc,string fm)
{
x=fx;
y=fy;
z=fz;
color=fc;
map=fm;
}
}
bool create_ctf(string name)
{
if(get_ctf_index(name)<=-1)
{
ctf ctf1(name);
ctfs.insert_last(ctf1);
return true;
}
else return false;
}
string ret_leader(string ctfname)
{
for(uint i=0; i<ctfs.length(); i++)
{
if(ctfs[i].name==ctfname) return string_trim_right(ctfs[i].name,4);
}
return "";
}
void ctf_notify(string ctfname,string message)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].cf==ctfname) send(players[i].peer_id,message,2);
}
}
void cancel_ctf(string name)
{
for(uint i=0; i<ctfs.length(); i++)
{
if(ctfs[i].name==name)
{
ctf_notify(ctfs[i].name,"The event has been canceled.");
for(uint i2=0; i2<players.length(); i2++)
{
if(players[i2].cf==name)
{
players[i2].cf="";
players[i2].ctfteam="";
}
}
delete_map(ctfs[i].name);
@ctfs[i]!=null;
ctfs.remove_at(i);
return;
}
}
}