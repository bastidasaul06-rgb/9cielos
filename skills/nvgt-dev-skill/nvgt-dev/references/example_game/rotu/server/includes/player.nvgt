bool is_valid_username(string username)
{
    if(username.length() < 3 or username.length() > 15) return false;
    string allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_";
    for(uint i = 0; i < username.length(); i++)
    {
        if(allowed.find(username[i]) == -1) return false;
    }
    return true;
}

