void give(string item,int amount)
{
this.inv.give(item,amount);
string current_serial=this.inv.serialize_inv();
if(this.cachedinv!=current_serial) {
this.cachedinv=current_serial;
send(this.peer_id, "invis "+this.cachedinv, 0);
}
}
void track_player()
{
string ret;
if(trackplayer=="") ret="You're not tracking anyone.";
else
{
int t=get_player_index_from(trackplayer);
if(t<=-1) ret="Player not found.";
if(t>-1)
{
if(players[t].map!=map) ret="This player is not on your map.";
else
{
int dist=get_3d_distance(this.x,this.y,this.z,players[t].x,players[t].y,players[t].z);
string ab;
if(players[t].z>z) ab="above";
if(players[t].z<z) ab="below";
ret+=(ab!=""?ab+", ":"")+calculate_x_y_string((dist==0?0:calculate_x_y_angle(this.x,this.y,players[t].x,players[t].y,this.dir)))+", "+dist+" tiles away. ";
}
}
}
send(peer_id,ret,0);
}
void checkitems()
{
int count=0;
for(uint i=0; i<items.length(); i++)
{
if(get_3d_distance(items[i].x,items[i].y,items[i].z,x,y,z)>35 and items[i].map!=map) continue;
if(get_3d_distance(x,y,z,items[i].x,items[i].y,items[i].z)<=35 and items[i].map==map)
{
if(itemsfound==false)
{
send(peer_id,"play_s itemfind.ogg",6);
itemsfound=true;
}
count++;
}
}
if(count==0){ 
if(itemsfound){
itemsfound=false;
send(peer_id,"play_s itemdisappear.ogg",6);
}
}
}
void check_around_me()
{
string ret;
for(uint i=0; i<players.length(); i++)
{
int dist=get_3d_distance(this.x,this.y,this.z,players[i].x,players[i].y,players[i].z);
if(dist<=30 and players[i].map==this.map and players[i].name!=this.name)
{
string ab;
if(players[i].z>this.z) ab="above,";
if(players[i].z<this.z) ab="below,";
ret+=(players[i].sitting and !players[i].incar?"Sitting ":"")+(players[i].crouching and !players[i].incar?"Crouching ":"")+(players[i].afk?"AFK ":"")+(players[i].incar?"Driving ":"")+(players[i].newb==1?"Newbie ":"")+players[i].char+" is "+(ab!=""?ab+" ":"")+calculate_x_y_string((dist==0?0:calculate_x_y_angle(this.x,this.y,players[i].x,players[i].y,this.dir)))+", "+dist+" tiles away. ";
}
}
for(uint i=0; i<unds.length(); i++)
{
int dist=get_3d_distance(this.x,this.y,this.z,unds[i].x,unds[i].y,unds[i].z);
if(dist<=30 and unds[i].mymap.name==this.map)
{
string ab;
if(unds[i].z>this.z) ab="above,";
if(unds[i].z<this.z) ab="below,";
ret+=unds[i].type+" is "+(ab!=""?ab+" ":"")+calculate_x_y_string((dist==0?0:calculate_x_y_angle(this.x,this.y,unds[i].x,unds[i].y,this.dir)))+", "+dist+" tiles away. ";
}
}
if(ret!="") send(this.peer_id,ret,0);
else send(this.peer_id,"There is no one around you.",0);
}
void save_main()
{
main.add("onlinefor",onlinefor);
main.add("beacon_on",beacon_on);
main.add("paid", paid);
main.add("jailinfo",jailinfo);
main.add("lastonline",lastonline);
main.add("plevents",plevents);
main.add("canchat",canchat);
main.add("beacon_on",beacon_on);
main.add("emotes",emotes);
main.add("disabled", string_join(this.disabled, "\r\n"));
file f;
if(mutelist.length()==0)
{
file_delete("players/"+name+"/mutelist.dat");
}
if(mutelist.length()>0)
{
f.open("players/"+name+"/mutelist.dat","wb");
string mutedata;
for(uint i=0; i<mutelist.length(); i++)
{
mutedata+=mutelist[i]+"\r\n";
}
f.write(mutedata);
f.close();
}
save();
main.save();
}
void save()
{
sd.add("x",x);
sd.add("chardescription",chardescription);
sd.add("gender",gender);
sd.add("lvl",lvl);
sd.add("newb", newb);
sd.add("mtrans",mtrans);
sd.add("mpadbat",mpadbat);
sd.add("y",y);
sd.add("head",head);
sd.add("shoulders",shoulders);
sd.add("feet",feet);
sd.add("chest",chest);
sd.add("hands",hands);
sd.add("legs",legs);
sd.add("channel",channel);
sd.add("exprank",exprank);
sd.add("exp",exp);
sd.add("kills",kills);
sd.add("deaths",deaths);
sd.add("health",health);
sd.add("z",z);
sd.add("map",map);
sd.add("gang",gang);
sd.add("ammo",serialize(am.amd));
sd.add("loaded",serialize(loaded));
file f;
if(inventories[0].items.length()>0)
{
f.open("players/"+name+"/"+char+"/inventory.dat","wb");
f.write(inventories[0].export());
f.close();
}
sd.save();
}
void load_main()
{
main.load();
if(main.d.exists("onlinefor")) onlinefor=main.readn("onlinefor");
if(main.d.exists("paid")) paid=main.readn("paid");
if(main.d.exists("beacon_on")) beacon_on=main.readn("beacon_on");
if(main.d.exists("disabled")) this.disabled=string_split(main.read("disabled"), "\r\n", false);
if(main.d.exists("emotes")) emotes=main.readn("emotes");
if(main.d.exists("canchat")) canchat=main.readn("canchat");
if(main.d.exists("beacon_on")) beacon_on=main.readn("beacon_on");
if(main.d.exists("plevents")) plevents=main.readn("plevents");
if(main.d.exists("jailinfo")) jailinfo=main.read("jailinfo");
file f;
if(file_exists("players/"+name+"/mutelist.dat"))
{
f.open("players/"+name+"/mutelist.dat","rb");
string[] mutedata=string_split(f.read(),"\r\n",false);
f.close();
for(uint i=0; i<mutedata.length(); i++)
{
mutelist.insert_last(mutedata[i]);
}
}
}
void load()
{
sd.load();
if(sd.d.exists("lvl")){ 
lvl=sd.readn("lvl");
default_health=lvl*5000;
}
if(!sd.d.exists("lvl")){
lvl=1;
default_health=lvl*5000;
}
if(sd.d.exists("chardescription")) chardescription=sd.read("chardescription");
if(sd.d.exists("newb")) newb=sd.readn("newb");
if(sd.d.exists("gender")) gender=sd.read("gender");
if(sd.d.exists("x")) x=sd.readn("x");
if(sd.d.exists("mpadbat")) mpadbat=sd.readn("mpadbat");
if(sd.d.exists("head")) head=sd.read("head");
if(sd.d.exists("loaded")) import_loaded(sd.read("loaded"));
if(sd.d.exists("shoulders")) shoulders=sd.read("shoulders");
if(sd.d.exists("mtrans")) mtrans=sd.readn("mtrans");
if(sd.d.exists("hands")) hands=sd.read("hands");
if(sd.d.exists("legs")) legs=sd.read("legs");
if(sd.d.exists("feet")) feet=sd.read("feet");
if(sd.d.exists("chest")) chest=sd.read("chest");
if(sd.d.exists("y")) y=sd.readn("y");
if(sd.d.exists("kills")) kills=sd.readn("kills");
if(sd.d.exists("channel")) channel=sd.read("channel");
if(sd.d.exists("deaths")) deaths=sd.readn("deaths");
if(sd.d.exists("z")) z=sd.readn("z");
if(sd.d.exists("health")) health=sd.readn("health");
if(sd.d.exists("map")){
map=sd.read("map");
int mapind=get_map_index(map);
if(mapind>-1) {
@mymap=maps[mapind];
if(@mymap==null){ 
map="main";
int main_idx = get_map_index("main");
if (main_idx == -1 && maps.length() > 0) main_idx = 0;
if (main_idx > -1) {
@mymap=maps[main_idx];
}
x=223;
y=434;
z=0;
}
}
}
if(sd.d.exists("exp")) exp=sd.readn("exp");
if(sd.d.exists("exprank")) exprank=sd.read("exprank");
if(sd.d.exists("gang")) gang=sd.read("gang");
if(sd.d.exists("ammo")) am.amd=deserialize(sd.read("ammo"));
heart_rate=round((5000/health)*35,0);
heart_vol=round(percent(health,5000)*100-50,0);
file f;
if(file_exists("players/"+name+"/"+char+"/inventory.dat"))
{
f.open("players/"+name+"/"+char+"/inventory.dat","rb");
string[]myitems=string_split(f.read(),"\r\n",false);
f.close();
for(uint i2=0; i2<myitems.length(); i2++)
{
string[]st=string_split(myitems[i2],"=",false);
if(st.length()>=2) {
inventory_item temp(st[0],stn(st[1]));
inv.items.insert_last(temp);
}
}
send(this.peer_id, "invis "+this.inv.serialize_inv(), 0);
}
}
}
void create_player(string username,string password,string email,uint id,string banid)
{
if(!is_valid_username(username))
{
send(id,"dlgblock Error. Invalid username. Only alphanumeric characters and underscores are allowed (3-15 characters).",0);
return;
}
string pdir="players/"+username;
if(directory_exists(pdir))
{
send(id,"dlgblock Error. This player already exists.",0);
return;
}
if(is_banned(banid,n.get_peer_address(id)))
{
send(id,"dlgblock Error. Unable to create an account. You have been banned.",0);
return;
}
directory_create(pdir);
file f;
f.open(pdir+"/pw.dat","wb");
f.write(string_hash(password, 2, false));
f.close();
f.open(pdir+"/username.dat","wb");
f.write(username);
f.close();
f.open(pdir+"/email.dat","wb");
f.write(email);
f.close();
f.open(pdir+"/banid.dat","wb");
f.write(banid);
f.close();
send(id,"created",0);
player p1(username,id,banid);
p1.create_char(username);
p1.load_char(username);
}

void spawn_player(string username,uint id,string banid)
{
player player1(username,id,banid);
players.insert_last(player1);
}
void playerloop()
{
if(players.length()<=0) undamount=0;
else
undamount=200*0.6/players.length();
for(uint x=0; x<players.length(); x++)
{
if(@players[x] == null) continue;
if(x<=players.length()) {
if(players[x].include_in_loop==false) continue;
if(@players[x].myquest!=null) {
if(players[x].questwon==true) {
players[x].questwon=false;
string rec_item=players[x].myquest.rewarded_item;
int rec_item_amount=players[x].myquest.rewarded_item_amount;
int new_exp=players[x].myquest.exp;
send(players[x].peer_id, "You have gained "+new_exp+" experience", 2);
new_exp+=players[x].exp;
players[x].exp=new_exp;
send(0, "play_s quest_complete.ogg -1", 6);
send(0, players[x].char+" has just completed the quest "+players[x].myquest.title+"! They have just received "+rec_item_amount+" "+rec_item+"! Time: "+ms_to_readable_time(players[x].questtimer.elapsed), 2);
players[x].give(rec_item, rec_item_amount);
@players[x].myquest=null;
}
}
if(players[x].beacontimer.elapsed>=players[x].beacontime)
{
players[x].beacontimer.restart();
for (uint i2=0; i2<players.length(); i2++)
{
if(players[i2].beacon_on==0 or players[x].map!=players[i2].map or x==i2 or get_3d_distance(players[i2].x, players[i2].y, players[i2].z, players[x].x, players[x].y, players[x].z)>15) continue;
if(players[x].cf==players[i2].cf and players[x].ctfteam!=players[i2].ctfteam)
{
send(players[i2].peer_id,"play beacon2.ogg "+players[x].x+" "+players[x].y+" "+players[x].z+" "+players[x].map,6);
}
else send(players[i2].peer_id,"play beacon1.ogg "+players[x].x+" "+players[x].y+" "+players[x].z+" "+players[x].map,6);
}
}
if(@players[x].mymap != null and players[x].map!=players[x].mymap.name) players[x].map=players[x].mymap.name;
if(players[x].savetimer.elapsed>=players[x].savetime) {
players[x].savetimer.restart();
players[x].save_main();
}
if(players[x].itemsfoundtimer.elapsed>players[x].itemsfoundtime){
players[x].itemsfoundtimer.restart();
players[x].checkitems();
}
/*
if(players[x].heart_rate!=round((5000/players[x].health)*35,0) and players[x].heart_vol!=round(percent(players[x].health,5000)*100-50,0))
{
players[x].heart_rate=round((5000/players[x].health)*35,0);
players[x].heart_vol=round(percent(players[x].health,5000)*100-50,0);
//send(players[x].peer_id,"adjust_heartbeat "+players[x].heart_rate+" "+players[x].heart_vol,0);
}
if(royale_participants.find(players[x].name)<=-1 and players[x].admin==false and players[x].dev==false and players[x].map=="battle_royale")
{
int[]newpos={223,434,0};
changemap(x,get_map_index("main"),newpos);
@players[x].inv=players[x].inventories[0];
}
*/
if(players[x].unwraptimer.elapsed>players[x].unwraptime and players[x].unwrapping)
{
play2("giftreveal",players[x].x,players[x].y,players[x].z,players[x].map,x);
gift(x);
players[x].unwrapping=false;
}
if(players[x].onlinefortimer.elapsed>1000)
{
players[x].onlinefor+=1000;
players[x].onlinesince+=1000;
players[x].onlinefortimer.restart();
}
if(players[x].afktimer.elapsed>players[x].afktime and !players[x].afk)
{
players[x].afk=true;
send(0,players[x].name+" is now AFK.",2);
}
if(players[x].exprank!=identify_rank(players[x].exp,players[x].gender))
{
players[x].give("gold",random(100,1000));
players[x].exprank=identify_rank(players[x].exp,players[x].gender);
//send(0,"play_s event.ogg",0);
player_event("The darkness in the sky parts, revealing the name "+players[x].char+". Above it, words spell out to read: "+players[x].exprank+(players[x].lvl>1?" level "+players[x].lvl+".":"."),"event.ogg");
}
if(players[x].mpadbattimer.elapsed>players[x].mpadbattime and players[x].mpad)
//if(players[x].mpadbattimer.elapsed>1000 and players[x].mpad)
{
players[x].mpadbattimer.restart();
players[x].mpadbat-=1;
if(players[x].mpadbat<=10)
{
play2("marketpadbatlow",players[x].x,players[x].y,players[x].z,players[x].map);
send(players[x].peer_id,"Your mPad flashes red, and words appear on the top of the screen. Low battery. "+players[x].mpadbat+" percent remaining.",2);
if(players[x].mpadbat==0)
{
play2("marketpadoff",players[x].x,players[x].y,players[x].z,players[x].map);
players[x].mpad=false;
send(players[x].peer_id,"The device powers off, having no more battery to keep itself running.",2);
}
}
}
/*
if(players[x].inv.get_item_amount("red_flag")>0 and get_ctf_index(players[x].cf)<=-1)
{
send(players[x].peer_id,"Red flags detected in your inventory. Removing...",2);
players[x].give("red_flag",-players[x].inv.get_item_amount("red_flag"));
}
if(players[x].inv.get_item_amount("green_flag")>0 and get_ctf_index(players[x].cf)<=-1)
{
send(players[x].peer_id,"Green flags detected in your inventory. Removing...",2);
players[x].give("green_flag",-players[x].inv.get_item_amount("green_flag"));
}
*/
if(players[x].spamcounttimer.elapsed>1000 and players[x].spamcount>0) players[x].spamcount=0;
if(players[x].spamcounttimer.elapsed<1000 and players[x].spamcount>4)
{
players[x].spamcounttimer.restart();
players[x].canchat=0;
notify("Alert! "+players[x].name+"'s chat was just disabled because they were spamming! If you believe this is a mistake please contact an available admin or the developer.");
players[x].spamcount=0;
}
if(players[x].health<=0)
{
if(royale_participants.find(players[x].name)>-1) remove_from_royale(players[x].name);
play2("death",players[x].x,players[x].y,players[x].z,players[x].map,x);
bodyfall(players[x].x,players[x].y,players[x].z,get_tile_at(players[x].x,players[x].y,players[x].z,players[x].map)+"fall",players[x].map,4500);
/*
if(players[x].cf.is_empty() and players[x].ctfteam.is_empty() and string_contains(players[x].map,"_CTF",1)>-1)
{
players[x].health=5000;
if(players[x].ctfteam=="red")
{
map_notify("Red "+players[x].name+" just got killed!",players[x].map);
players[x].x=50;
players[x].y=25;
send(players[x].peer_id,"move "+players[x].x+" "+players[x].y+" 0",0);
if(players[x].inv.get_item_amount("green_flag")>0)
{
players[x].give("green_flag",-1);
map_notify("Red "+players[x].name+" just dropped the green flag! It has been returned to the green zone.",players[x].map);
int fl=get_ctf_index(players[x].cf);
if(fl>-1)
{
ctfs[fl].redhasflag=false;
flag green(50,25,0,"green",ctfs[fl].name);
ctfs[fl].flags.insert_last(green);
}
}
}
else if(players[x].ctfteam=="green")
{
map_notify("Green "+players[x].name+" just got killed!",players[x].map);
players[x].x=50;
players[x].y=125;
send(players[x].peer_id,"move "+players[x].x+" "+players[x].y+" 0",0);
if(players[x].inv.get_item_amount("red_flag")>0)
{
players[x].give("red_flag",-1);
map_notify("Green "+players[x].name+" just dropped the red flag! It has been returned to the red zone.",players[x].map);
int fl=get_ctf_index(players[x].cf);
if(fl>-1)
{
ctfs[fl].greenhasflag=false;
flag red(50,125,0,"red",ctfs[fl].name);
ctfs[fl].flags.insert_last(red);
}
}
}
}
else
{
*/
player_event(players[x].char+" was just killed by "+players[x].hitby);
players[x].hitby="no one. Isn't that strange?";
players[x].health=5000;
players[x].deaths+=1;
changemap_safe(x, get_map_index(@players[x].mymap != null ? players[x].mymap.name : "main"));
}
if(players[x].health>players[x].default_health) {
send(players[x].peer_id, "play_s heal.ogg", 6);
players[x].health=players[x].default_health;
}
if(((players[x].health<players[x].default_health) and players[x].safe() or players[x].shoulders=="dark_blue_cape") and players[x].hptimer.elapsed>players[x].hptime)
{
int enc=25;
if(players[x].paid==1) enc=random(26, 45);
players[x].hptimer.restart();
players[x].health+=enc;
}
if(players[x].carcomtimer.elapsed>players[x].carcomtime-(absolute(players[x].carspeed*100)) and players[x].incar)
{
players[x].carcomtimer.restart();
players[x].caract();
}
if(!file_exists("maps/"+players[x].map+".map"))
