bool delete_char(string charname)
{
if(directory_exists("players/"+name))
{
if(directory_exists("players/"+name+"/"+charname))
{
directory_delete("players/"+name+"/"+charname);
return true;
}
}
return false;
}
bool char_exists(string charname)
{
if(directory_exists("players/"+name+"/"+charname)) return true;
return false;
}
void create_char(string charname)
{
if(directory_exists("players/"+name))
{
directory_create("players/"+name+"/"+charname);
file f;
f.open("players/"+name+"/"+charname+"/inventory.dat","wb");
f.write("starter_pack=1\r\n");
f.close();
}
}
bool load_char(string charname)
{
if(directory_exists("players/"+name+"/"+charname))
{
char=charname;
sd.fn="players/"+name+"/"+charname+"/data.dat";
sd.key=plkey;
load();
include_in_loop=true;
return true;
}
else return false;
}
int get_items_in_category(string catname)
{
int c=0;
for(uint i=0; i<inv.items.length(); i++)
{
if(get_item_category(inv.items[i].name)==catname or catname=="All") c++;
}
return c;
}
int get_current_ammo(string w)
{
return this.get_ammo_count_from(w);
}
void import_loaded(string data)
{
loaded=deserialize(data);
}
int get_ammo_count_from(string we)
{
string[] loaded_ammo=loaded.get_keys();
int amount=0;
for(uint i=0; i<loaded_ammo.length(); i++)
{
int a=0;
if(loaded_ammo[i]==we)
loaded.get(we,a);
amount+=a;
}
return amount;
}
string get_quest_instructions() {
if(@this.myquest==null) return "No quest currently in progress";
if(this.myquest.type==1) {
string[] k=this.myquest.needed.get_keys();
string[] a;
string ret="You need to ";
for(uint i=0; i<k.length(); i+=1) {
int temp;
this.myquest.needed.get(k[i], temp);
int org;
org=temp;
if(this.working_quest_dict.get_size()>0) {
if(this.working_quest_dict.exists(k[i])) {
int temp2=0;
this.working_quest_dict.get(k[i], temp2);
if(temp2>0) {
org-=temp2;
}
}
}
a.insert_last("kill "+org+" undead with your "+k[i]);
}
ret+=string_join(a, ", ");
return ret;
}
return "No information for this quest available. Please contact an admin";
}
void checkquest() {
if(@this.myquest==null) return;
if(this.myquest.type==1) {
if(this.working_quest_dict.get_size()==0 or this.myquest.needed.get_size()==0) return;
string[] n=this.myquest.needed.get_keys();
int checked=0;
for(uint x=0; x<n.length(); x+=1) {
int temp;
this.myquest.needed.get(n[x], temp);
if(temp>0) {
string[] keys=this.working_quest_dict.get_keys();
if(keys.length()<0)
break;
for(uint x2=0; x2<keys.length(); x2+=1) {
if(keys[x2]==n[x]) {
int temp2;
this.working_quest_dict.get(keys[x2], temp2);
if(temp2>=temp) checked+=1;
}
}
}
}
if(checked>=n.length()) this.questwon=true;
}
}
void ammo_give(string we,int amount)
{
int a;
if(!loaded.exists(we))
{
loaded.set(we,amount);
}
else
{
loaded.get(we,a);
if(a+amount<=0)
loaded.delete(we);
else
{
int b=(a+amount);
loaded.delete(we);
loaded.set(we,b);
}
}
}
int get_armor_value(string type)
{
if(type=="brass_knuckles") return 8;
if(type=="leather_helmet") return 10;
if(type=="steel_helmet") return 20;
if(type=="chestplate") return 35;
if(type=="combat_boots") return 28;
if(type=="steel_toed_boots") return 24;
if(type=="plate_armor") return 40;
if(type=="chainmail_armor") return 36;
if(type=="leather_armor") return 20;
if(type=="leather_leggings") return 14;
if(type=="plated_leggings") return 28;
if(type=="leather_shoulder_pads") return 18;
if(type=="metal_shoulder_pads") return 30;
return 0;
}
void damage(int hp)
{
if(devshield) return;
int totaldamage=hp;
int protecteddamage=0;
totaldamage-=get_armor_value(head);
protecteddamage+=get_armor_value(head);
totaldamage-=get_armor_value(shoulders);
protecteddamage+=get_armor_value(shoulders);
totaldamage-=get_armor_value(chest);
protecteddamage+=get_armor_value(chest);
totaldamage-=get_armor_value(feet);
protecteddamage+=get_armor_value(feet);
totaldamage-=get_armor_value(hands);
protecteddamage+=get_armor_value(hands);
totaldamage-=get_armor_value(legs);
protecteddamage+=get_armor_value(legs);
protection+=protecteddamage;
if(totaldamage<0) totaldamage=0;
health-=totaldamage*lvl;
}
bool safe()
{
if(@mymap == null) return false;
return mymap.is_sz(x,y,z);
}
string gt() {
if(@this.mymap==null) return "";
return mymap.get_tile_at(this.x,this.y,this.z);
}
bool mute(string playername)
{
if(mutelist.find(playername)>-1 or !directory_exists("players/"+playername)) return false;
mutelist.insert_last(playername);
return true;
}
bool unmute(string playername)
{
if(mutelist.find(playername)<=-1) return false;
int m=mutelist.find(playername);
mutelist.remove_at(m);
save();
return true;
}
bool jailed()
{
return jailcheck(name);
}
void caract()
{
if(incar)
{
int carpitch=100;
if(carspeed==0) carpitch=100;
if(carspeed==1) carpitch=150;
if(carspeed==2) carpitch=200;
if(carspeed==3) carpitch=250;
send(peer_id,"updatemsound "+name+"_carint "+x+" "+y+" "+z+" "+carpitch,7);
send(0,"updatemsound "+name+"_car "+x+" "+y+" "+z+" "+carpitch,7);
if(carcom=="horn")
{
play2("carhorn",x,y,z,map);
}
if(carcom=="getout")
{
if(carspeed==0)
{
if(carstartstoptimer.elapsed<carstartstoptime)
{
send(peer_id,"You need to wait 5 seconds before trying to shut off the car.",0);
}
else
{
incar=false;
carspeed=0;
send(peer_id,"stop_car",0);
send(0,"destroymsound "+name+"_carint",7);
carstartstoptimer.restart();
send(peer_id,"play_s carstopint.ogg",6);
for(uint i=0; i<players.length(); i++)
{
if(players[i].name!=name)
{
send(players[i].peer_id,"play carstopext.ogg "+x+" "+y+" "+z+" "+map,6);
send(players[i].peer_id,"destroymsound "+name+"_car",7);
}
}
}
}
else
{
send(peer_id,"Your car needs to be idle.",0);
}
}
if(carcom=="crash")
{
incar=false;
carspeed=0;
send(peer_id,"stop_car",0);
send(0,"destroymsound "+name+"_carint",7);
send(peer_id,"play_s carcrash.ogg",6);
if(map!="race_track" and map!="race_track2"){
give("auto_saturn",-1);
give("broken_auto_saturn",1);
hitby="a car crash.";
health-=random(1000,5000);
}
if(map=="race_track" or map=="race_track2")
{
x=10;
y=249;
z=0;
send(peer_id,"move "+x+" "+y+" "+z+" "+map,0);
}
for(uint i=0; i<players.length(); i++)
{
if(players[i].name!=name)
{
send(players[i].peer_id,"play carcrash.ogg "+x+" "+y+" "+z+" "+map,6);
send(players[i].peer_id,"destroymsound "+name+"_car",7);
}
}
}

if(carcom=="speedup")
{
if(carspeed<3)
{
carspeed+=1;
send(peer_id,"speed "+carspeed,0);
}
else
{
send(peer_id,"Max speed reached.",0);
}
}
if(carcom=="slowdown")
{
if(carspeed>0)
{
carspeed-=1;
send(peer_id,"speed "+carspeed,0);
}
else
{
send(peer_id,"Min speed reached.",0);
}
}
if(carcom=="left")
{
if(carturntimer.elapsed<carturntime)
{
send(peer_id,"You can't turn your car that fast!",0);
}
else
{
carturntimer.restart();
cardir-=90;
if(cardir<0) cardir=270;
dir=cardir;
send(peer_id,"dir "+cardir,0);
send(peer_id,"direction "+dir_to_string(cardir),0);
}
}
if(carcom=="right")
{
if(carturntimer.elapsed<carturntime)
{
send(peer_id,"You can't turn your car that fast!",0);
}
else
{
carturntimer.restart();
cardir+=90;
if(cardir>359) cardir=0;
dir=cardir;
send(peer_id,"dir "+cardir,0);
send(peer_id,"direction "+dir_to_string(cardir),0);
}
}
if(carspeed!=0)
{
if(cardir==0)
{
y+=carspeed;
if(@mymap != null and y>mymap.maxy){
y=mymap.maxy;
carspeed=0;
}
send(peer_id,"move "+x+" "+y+" "+z,0);
crashcheck();
}
if(cardir==90)
{
x+=carspeed;
if(@mymap != null and x>mymap.maxx){ 
x=mymap.maxx;
carspeed=0;
}
send(peer_id,"move "+x+" "+y+" "+z,0);
crashcheck();
}
if(cardir==180)
{
y-=carspeed;
if(y<0){
 y=0;
carspeed=0;
}
send(peer_id,"move "+x+" "+y+" "+z,0);
crashcheck();
}
if(cardir==270)
{
x-=carspeed;
if(x<0){ 
x=0;
carspeed=0;
}
send(peer_id,"move "+x+" "+y+" "+z,0);
crashcheck();
}
}
carcom="";
}
}
void crashcheck()
{
if(@mymap == null) return;
if(incar)
{
if(cardir==0)
{
for(uint i=0; i<carspeed+30; i++)
{
if(string_left(mymap.get_tile_at(x,y+i,z), 4)=="wall")
{
send(peer_id,"play_s pingstop.ogg",6);
if(i<5)
{
carcom="crash";
caract();
}
break;
}
}
}
if(cardir==90)
{
for(uint i=0; i<carspeed+30; i++)
{
if(string_left(mymap.get_tile_at(x+i,y,z),4)=="wall")
{
send(peer_id,"play_s pingstop.ogg",6);
if(i<5)
{
carcom="crash";
caract();
}
break;
}
}
}
if(cardir==180)
{
for(uint i=0; i<carspeed+30; i++)
{
if(string_left(mymap.get_tile_at(x,y-i,z),4)=="wall")
{
send(peer_id,"play_s pingstop.ogg",6);
if(i<5)
{
carcom="crash";
caract();
}
break;
}
}
}
if(cardir==270)
{
for(uint i=0; i<carspeed+30; i++)
{
if(string_left(mymap.get_tile_at(x-i,y,z), 4)=="wall")
{
send(peer_id,"play_s pingstop.ogg",6);
if(i<5)
{
carcom="crash";
caract();
}
break;
}
}
}

}
}
