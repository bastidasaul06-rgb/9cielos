}
}
}
}
player@get_player_handle(string name)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].name==name) return players[i];
}
return null;
}
string identify_rank(int xp,string ge)
{
if(xp<500) return "Apprentice";
if(xp>=500 and xp<1000) return "Junior Apprentice";
if(xp>=1000 and xp<1500) return "Senior Apprentice";
if(xp>=1500 and xp<2000) return "Trainee";
if(xp>=2000 and xp<3000) return "Novice";
if(xp>=3000 and xp<4000) return "Specialist";
if(xp>=4000 and xp<6000) return "Arch Specialist";
if(xp>=6000 and xp<8000) return "Master";
if(xp>=8000 and xp<10000) return "Arch Master";
if(xp>=10000 and xp<15000) return "Warrior";
if(xp>=15000 and xp<20000) return "Arch Warrior";
if(xp>=20000 and xp<30000) return "Sage";
if(xp>=30000 and xp<50000) return "Arch Sage";
if(xp>=50000 and xp<60000) return (ge=="Female"?"Queen's":"King's")+" Guard";
if(xp>=60000 and xp<75000) return (ge=="Female"?"Queen's":"King's")+" Adviser";
if(xp>=75000 and xp<100000) return "Hand of the "+(ge=="Female"?"Queen":"King");
if(xp>=100000 and xp<115000) return (ge=="Female"?"Queen":"King");
if(xp>=115000 and xp<125000) return "High "+(ge=="Female"?"Queen":"King");
if(xp>=125000 and xp<150000) return (ge=="Female"?"Empress":"Emperor");
if(xp>=150000) return "General";
return "";
}

void kill_spam_players()
{
for(uint i=0; i<players.length(); i++){ players[i].save(); }
string[]pdirs=find_directories("players/*");
string spamlist="";
int spamcounter=0;
for(uint i=0; i<pdirs.length(); i++){
bool spammy=false;
if(string_is_digits(pdirs[i]))
{
spamlist+=pdirs[i]+": Entirely numeric. \r\n";
spammy=true;
}
if(undtypes.find(pdirs[i])>-1)
{
spamlist+=pdirs[i]+": Mentions undead names. \r\n";
spammy=true;
}
savedata temp("players/"+pdirs[i]+"/data.dat",plkey);
temp.load();
if(!temp.d.exists("lastonline")) temp.add("lastonline",get_slashed_date());
temp.save();
string[]spamcheckdate=string_split(temp.read("lastonline"),"/",true);
int onfor=temp.readn("onlinefor");
if(onfor<300000)
{
spamlist+=pdirs[i]+": Has not played the game for at least 5 minutes. Play time: "+onfor+".\r\n";
spammy=true;
}
if(is_one_month(stn(spamcheckdate[0]),stn(spamcheckdate[1]),stn(spamcheckdate[2])))
{
spamlist+=pdirs[i]+": Inactive for more than 30 days. Last played: "+spamcheckdate[0]+"/"+spamcheckdate[1]+"/"+spamcheckdate[2]+".\r\n";
spammy=true;
}

if(string_contains(pdirs[i],"[]",1)>-1 or string_contains(pdirs[i]," ",1)>-1)
{
spamlist+=pdirs[i]+": Contains special characters that could cause client-side runtime errors.\r\n";
spammy=true;
}
if(string_contains(pdirs[i],"admin",1)>-1 or string_contains(pdirs[i],"dev",1)>-1 or string_contains(pdirs[i],"developer",1)>-1)
{
spamlist+=pdirs[i]+": Contains mentioning of ranks. \r\n";
spammy=true;
}
if(spammy)
{
int index=get_player_index_from(pdirs[i]);
if(index>-1)
{
kick(index,"the spam killing system.");
}
directory_delete("players/"+pdirs[i]);
spamcounter++;
}
}
if(spamcounter>0) admintell("List of spam users. "+spamlist);
double perc=round(percent(spamcounter,pdirs.length()),1);
notify((spamcounter>0?"Complete. "+spamcounter+" out of "+pdirs.length()+" players ("+perc+" percent) of players were marked as spam. They have been successfully deleted.":"No spam players were found!"));
}

int get_player_index(uint pid)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].peer_id==pid) return i;
}
return -1;
}

int get_player_index_from(string name, bool include_hidden = false)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].name==name and (players[i].hidden==false or include_hidden==true)) return i;
}
return -1;
}

void gift(int index=-1)
{
if(index>-1)
{
string[]gift_list={"auto_saturn","plate_armor","plated_leggings","mPad","barrett_sniper_rifle","hand_grenade","metal_shoulder_pads","mPad_battery_pack","graven_feather","combat_boots","steel_helmet","shotgun","micro_smg","rifle","toy_remote_controlled_car","toy_nerf_gun","toy_dinosaur","toy_dog","toy_robot","toy_cat","toy_farm_set","toy_doll","barrett_sniper_rifle_ammo_pack","shotgun_ammo_pack","micro_smg_ammo_pack","rifle_ammo_pack","pistol_ammo_pack"};
string giftitem=gift_list[random(0, gift_list.length()-1)];
players[index].give(giftitem,1);
send(players[index].peer_id, "You have received 1 "+giftitem+"!", 2);
}
else return;
}