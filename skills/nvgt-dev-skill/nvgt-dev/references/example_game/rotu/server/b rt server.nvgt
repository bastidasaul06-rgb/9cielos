void timers()
{
if(savetimer.elapsed>60000)
{
savetimer.restart();
for(uint i=0; i<players.length(); i++)
{
if(players[i].char!=""){
players[i].save();
}
players[i].save_main();
}
addprefs();
}
if(startraintimer.elapsed>startraintime and raining==false)
{
startraintimer.restart();
startraintime=random(300000,3600000);
thundertimer.restart();
endraintimer.restart();
endraintime=random(300000,1500000);
start_raining();
}
if(thundertimer.elapsed>thundertime and raining and endvol>-25)
{
thundertimer.restart();
thundertime=random(30000,120000);
send(0,"play_s2 thunder"+random(1,20)+".ogg "+random(90,110),6);

}
if(endraintimer.elapsed>endraintime and raining)
{
endraintimer.restart();
startraintimer.restart();
thundertimer.restart();
stop_raining();
}
if(adtimer.elapsed>3600000)
{
adtimer.restart();
send(0,"play_s copy.ogg",6);
send(0,generate_advertisement(),2);
}
if(spawnitemtimer.elapsed>spawnitemtime)
{
spawnitemtimer.restart();
spawn_item(228,random(371,378),0,"kyle's_crossbow",1,"main");
if(royale==true)
{
spawn_item(random(0,2000),random(0,2000),0,objtypes[random(0,objtypes.length()-1)],1,"battle_royale");
spawn_item(random(0,2000),random(0,2000),0,objtypes[random(0,objtypes.length()-1)],1,"battle_royale");
spawn_item(random(0,2000),random(0,2000),0,objtypes[random(0,objtypes.length()-1)],1,"battle_royale");
spawn_item(random(0,2000),random(0,2000),0,objtypes[random(0,objtypes.length()-1)],1,"battle_royale");
spawn_item(random(0,2000),random(0,2000),0,objtypes[random(0,objtypes.length()-1)],1,"battle_royale");
spawn_item(random(1714,1732),random(1629,1646),10,objtypes[random(0,objtypes.length()-1)],1,"battle_royale");
}
}
if(garbagetimer.elapsed>1800000)
{
garbagetimer.restart();
garbage_collect();
send(0,"garbage",0);
}
if(updtimer.elapsed>10000 and upding)
{
notify("The server is rebooting for an update. Please hold...");
for(uint i=0; i<players.length(); i++)
{
players[i].save_main();
players[i].save();
send(players[i].peer_id,"reboot",0);
}
lastupdate=get_current_date();
addprefs();
wait(500);
run("updater.exe","",false,false);
wait(100);
exit();
}
if(uptimer.elapsed>totaluptime)
{
totaluptime=uptimer.elapsed;
}
if(players.length()>0) {
if(doublegoldtimer.elapsed>doublegoldtime and players.length()>1)
{
doublegoldtimer.restart();
doublegold=(doublegold?false:true);
notify("Double gold and experience event "+(doublegold?"activated":"deactivated")+"!");
unds.resize(0);
}
if(bosstimer.elapsed>bosstime and dragons.length()==0 and players.length()>0){
bosstimer.restart();
send(0,"play_s dragonlanddist.ogg",6);
send(0,"In the distance, a very large shape lands, causing the ground to quake immensely. A black dragon. Type /dragons to find out where it is located.",2);
spawn_dragon(0,500,0,500,0,150,"main");
}
if(undtimer.elapsed>undtime and unds.length()<undamount)
{
undtimer.restart();
int times=random(2, 5);
string[] mlist=public;
for(int i=1; i<=times; i+=1) undead_appear(undtypes[random(0,undtypes.length()-1)], get_map_handle(mlist[random(0,mlist.length()-1)]));
undtime=random(5000, 15000);
}
}
}

void netloop()
{
const network_event@ old_e = @e;
real_netloop();
@e = @old_e;
}
void real_netloop()
{
if(key_pressed(KEY_E))
{
generate_profile("profile.log");
exit();
}
for(uint i=0; i<5; i++)
{
@e=n.request();
if(e.type==event_none)
break;
if(players.length()>peak)
{
notify("We have reached a new peak of "+players.length()+" players!");
peak=players.length();
addprefs();
}
if(e.type==event_disconnect)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string pname = players[index].name;
//players[index].remove_from_events();
players[index].save_main();
players[index].save();
//send(0,"play_s offline.ogg",0);
send(0,"remplayer "+players[index].name,0);
log_entry("onoffs",players[index].name+" lost connection.");
player_event(players[index].name+" just lost their connection to the server.","lostconnection.ogg");
discons+=1;
for(uint j=0; j<unds.length(); j++)
{
if(@unds[j].target != null)
{
if(unds[j].target.name == pname)
{
@unds[j].target = null;
unds[j].trackingplayer = false;
}
}
}
@players[index]=null;
players.remove_at(index);
}
}
else if(e.type==event_receive)
{
if(e.channel==9)
{
string[]parsed=string_split(get_event_message()," ",true);
if(parsed[0]=="voice_chat")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string vc=string_replace(get_event_message(),"voice_chat ","",true);
send_nearby_reliable("ogg_file "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].map+" "+vc,9,30,players[index].x,players[index].y,players[index].z,players[index].map);
}
}
}
if(e.channel==1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
players[index].afktimer.restart();
if(players[index].afk)
{
send(0,players[index].name+" is no longer AFK.",2);
players[index].afk=false;
}
string[]parsed=string_split(get_event_message()," ",true);
if(string_left(parsed[0],1)!="/")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].channel.is_empty()) 
{
send(e.peer_id,"Your chat is disabled. Please re-enable it by typing /channel, or by pressing the F5 key.",0);
return;
}
if(players[index].disabled.find("chat")>-1)
{
send(e.peer_id,"You are restricted from chatting.",0);
return;
}
string msg;
if(players[index].prisoner) msg+="Jailed ";
if(players[index].rflag)
{
if(players[index].dev==true)
{
msg+="Dev ";
}
if(players[index].admin and players[index].dev==false and players[index].mod==false)
{
msg+="Admin ";
}
if(players[index].dev==false and players[index].mod==true)
{
msg+="Moderator ";
}
}
msg+=players[index].exprank+" "+players[index].char;
players[index].spamcount+=1;
players[index].spamcounttimer.restart();
log_entry(players[index].name+"_chats",get_event_message(),true,"logs/player_chats");
for(uint i=0; i<players.length(); i++)
{
if(players[i].channel==players[index].channel and players[i].mutelist.find(players[index].name)<=-1)
{
send(players[i].peer_id,"play_s chat.ogg",6);
send(players[i].peer_id,msg+" says: "+get_event_message(),1);
}
}
}
}
else if(parsed[0]=="/m" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].mpad==false)
{
send(e.peer_id,"Your mPad needs to be on for the message to be transmitted.",0);
return;
}
if(players[index].canchat==0)
{
send(e.peer_id,"You are restricted from chatting.",0);
return;
}
if(players[index].mpad==true and players[index].wtchannel==0)
{
send(e.peer_id,"The mPad is on, but the walkie talkie app is closed. Please open it by selecting it from the home screen, then selecting a channel.",0);
return;
}
string msg=string_trim_left(get_event_message(),3);
log_entry(players[index].name+"_chats",players[index].name+" (via walkie talkie) "+msg,true,"logs/player_chats");
for(uint i=0; i<players.length(); i++)
{
if(players[i].wtchannel==players[index].wtchannel and players[i].mpad==true and players[i].mutelist.find(players[index].name)<=-1 and players[i].map==players[index].map)
{
if(get_3d_distance(players[i].x,players[i].y,players[i].z,players[index].x,players[index].y,players[index].z)>150)
{
int scramble_type=random(0,2);
if(scramble_type==0) msg=string_trim_left(msg,random(1,msg.length()-1));
if(scramble_type==1) msg=string_trim_right(msg,random(1,msg.length()-1));
if(scramble_type==2){
for(uint i=0; i<msg.length(); i++)
{
int r=random(0,1);
if(r==1) msg=string_replace(msg,msg[i]," ",false);
}
}
}
play2("marketpadradio",players[i].x,players[i].y,players[i].z,players[i].map,i);
send(players[i].peer_id,players[index].char+" transmits: "+msg,8);
}
}
}
}
else if(parsed[0]=="/support" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string support_msg = string_trim_left(get_event_message(), 9);
last_ticket_id++;
Ticket t(last_ticket_id, players[index].name, support_msg);
tickets.insert_last(t);
send(e.peer_id, "Your support request has been submitted. Ticket ID: " + last_ticket_id, 0);
for(uint i=0; i<players.length(); i++)
{
if(players[i].dev || players[i].admin || players[i].mod)
{
send(players[i].peer_id, "ticket_alert " + last_ticket_id + "|" + players[index].name + "|" + support_msg, 0);
send(players[i].peer_id, "play_s chat.ogg", 6);
}
}
}
}
else if(parsed[0]=="/onlinetime")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
send(e.peer_id,"Since your account was created, you've been online for a total of "+ms_to_readable_time(players[index].onlinefor)+". Since logging in last, you have been online for "+ms_to_readable_time(players[index].onlinesince)+".",0);
}
}
else if(parsed[0]=="/me" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].channel.is_empty()) 
{
send(e.peer_id,"Your chat is disabled. Please re-enable it by typing /channel, or by pressing the F5 key.",0);
return;
}
if(players[index].canchat==0)
{
send(e.peer_id,"You are restricted from chatting.",0);
return;
}
string msg=string_trim_left(get_event_message(),4);
log_entry(players[index].name+"_chats",players[index].char+" "+msg,true,"logs/player_chats");
players[index].spamcount+=1;
players[index].spamcounttimer.restart();
int pcount=0,kcount=0,lcount=0;
for(uint i=0; i<players.length(); i++)
{
if(players[i].channel==players[index].channel and players[i].mutelist.find(players[index].name)<=-1)
{
send(players[i].peer_id,"play_s chat.ogg",6);
send(players[i].peer_id,players[index].char+" "+msg,1);
}
}
if(string_contains(msg,"punch",1)>-1 and pcount<3) pcount++;
if(string_contains(msg,"kick",1)>-1 and kcount<3) kcount++;
if(string_contains(msg,"laugh",1)>-1 and lcount<3) lcount++;
if(pcount>0) emote("punch",pcount);
if(kcount>0) emote("kick",kcount);
if(lcount>0) emote("laugh",lcount);
}
}
else if(parsed[0]=="/canchat" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,"Player not found.",0);
return;
}
if(players[index2].canchat==1)
{
players[index2].canchat=0;
send(players[index2].peer_id,"Your chat is now disabled.",0);
notify(players[index2].name+"'s chat was just disabled by "+players[index].name+".");
return;
}
if(players[index2].canchat==0)
{
players[index2].canchat=1;
send(players[index2].peer_id,"Your chat is now enabled.",0);
notify(players[index2].name+"'s chat was just enabled by "+players[index].name+".");
return;
}
}
}
else if(parsed[0]=="/gettells")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
send(e.peer_id,"clipcopy "+get_file("logs/admintells.log"),0);
send(e.peer_id,"The admintells log has been copied to your clipboard.",0);
}
}
else if(parsed[0]=="/getchats" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
if(players[index].mod==true)
{
send(e.peer_id,"Moderators are not allowed to use this command.",0);
return;
}
string playername=parsed[1];
if(!directory_exists("players/"+playername))
{
send(e.peer_id,"This player doesn't exist in the database.",0);
return;
}
if(!file_exists("logs/player_chats/"+playername+"_chats.log"))
{
send(e.peer_id,"This player doesn't have a log yet.",0);
return;
}
file f;
f.open("logs/player_chats/"+playername+"_chats.log","rb");
send(e.peer_id,"clipcopy "+f.read(),0);
send(e.peer_id,playername+"'s log has been copied to your clipboard.",0);
f.close();
}
}
else if(parsed[0]=="/flag")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
players[index].rflag=(players[index].rflag?false:true);
notify((players[index].rflag?"Attention! "+players[index].name+" has just enabled their rank flag. They are to be taken very seriously!":players[index].name+" has disabled their rank flag."),(players[index].rflag?"flagon.ogg":"flagoff.ogg"));
}
}
else if(parsed[0]=="/channel")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
chansmenu(players[index].peer_id);
}
}
else if(parsed[0]=="/stats" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,"Player not found or not online.",0);
return;
}
send(e.peer_id,players[index2].char+" ("+players[index2].name+") has "+players[index2].kills+" kills, and "+players[index2].deaths+" deaths. They have "+players[index2].exp+" experience, giving them the rank of "+players[index2].exprank+(players[index].lvl>1?" level "+players[index].lvl:"")+".",0);
}
}
else if(parsed[0]=="/convertgifts")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].inv.get_item_amount("giftbox")<=0)
{
send(e.peer_id,"You do not have any giftboxes to convert at this time.",0);
return;
}
int gft=players[index].inv.get_item_amount("giftbox");
players[index].give("giftbox",-gft);
players[index].give("gift",gft);
send(e.peer_id,"Complete. "+gft+" gifts were converted.",2);
}
}
else if(parsed[0]==        "/help")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
server_menu m;
m.intro="Help commands";
m.initial_packet="help";
string[] ca=string_split(get_file("help.txt"),"\r\n",false);
for(uint i=0; i<ca.length(); i++)
{
m.add(ca[i],ca[i]);
}
m.send(players[index].peer_id);
}
}
else if(parsed[0]=="/voting")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(!players[index].admin)
{
send(e.peer_id,"How about you enable your brain. You're not an admin!",0);
return;
}
if(voting==0 and parsed.length()>1)
{
votemsg=string_trim_left(get_event_message(),8);
notify(players[index].name+" has enabled voting for the following: "+votemsg);
voting=1;
addprefs();
return;
}
if(voting==1 and parsed.length()<=1)
{
voting=0;
notify(players[index].name+" has disabled voting.");
votemsg="";
addprefs();
return;
}
}
}
else if(parsed[0]=="/vote" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(string_contains(votelist,players[index].name,1)>-1)
{
send(e.peer_id,"You can only vote once!",0);
return;
}
if(voting==0)
{
send(e.peer_id,"Voting is disabled",0);
return;
}
if(parsed[1]!="yes" and parsed[1]!="no")
{
send(e.peer_id,parsed[1]+" is not a valid voting option. It's either yes, or no.",0);
return;
}
if(parsed[1]=="yes")
{
yes+=1;
send(e.peer_id,"Your vote has been recorded. Thank you.",0);
votelist+=players[index].name+". ";
addprefs();
return;
}
if(parsed[1]=="no")
{
no+=1;
send(e.peer_id,"Your vote has been recorded. Thank you.",0);
votelist+=players[index].name+". ";
addprefs();
return;
}
}
}
else if(parsed[0]=="/votes")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(voting==0)
{
send(e.peer_id,"Voting is disabled",0);
return;
}
if(string_contains(votelist,players[index].name,1)>-1)
{
int vtotal=yes+no;
float v1=percent(yes,vtotal);
float v2=percent(no,vtotal);
send(e.peer_id,"Votes. Yes: "+yes+", "+round(v1,1)+" percent. No: "+no+", "+round(v2,1)+" percent.",0);
}
}
}
else if(parsed[0]=="/clearvotes")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{

if(!players[index].admin) 
{
send(e.peer_id,"You can't do that.",0);
return;
}
votemsg="";
yes=0;
no=0;
votelist="";
notify(players[index].name+" has just cleared all votes.");
}
}
else if(parsed[0]=="/setxp" and parsed.length()>2)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
if(players[index].disabled.find("setxp")>-1) {
send(players[index].peer_id, "You are restrcited from using this command", 0);
return;
}
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,"Player not found.",0);
return;
}
if(stn(parsed[2])<0)
{
send(e.peer_id,"Um, no...",0);
return;
}
players[index2].exp=stn(parsed[2]);
admintell("Alert. "+players[index].name+" just changed "+players[index2].char+"'s ("+players[index2].name+") experience to "+parsed[2]+".");
p_notify("EX P modification alert", players[index].name+" just changed "+players[index2].char+"'s ("+players[index2].name+") experience to "+parsed[2]+".");
}
}
else if(parsed[0]==        "/adminhelp")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
server_menu m;
m.intro="Admin commands";
m.initial_packet="adminhelp";
string[] ca=string_split(get_file("adminhelp.txt"),"\r\n",false);
for(uint i=0; i<ca.length(); i++)
{
m.add(ca[i],ca[i]);
}
m.send(players[index].peer_id);
}
}
else if(parsed[0]=="/builderhelp")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin and !players[index].builder) return;
server_menu m;
