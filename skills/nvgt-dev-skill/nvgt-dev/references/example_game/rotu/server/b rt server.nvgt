}
}
else if(parsed[0]=="/chardelete" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
int charamount=players[index].get_char_amount();
if(charamount==1)
{
send(e.peer_id,"It's not a good idea to delete this character if it's the only one you have left. Maybe try creating a new one and then deleting it, or if you would like to delete your entire account, ask an admin or developer.",0);
return;
}
if(!players[index].char_exists(parsed[1]))
{
send(e.peer_id,parsed[1]+" could not be found in your character list.",0);
return;
}
bool success=players[index].delete_char(parsed[1]);
if(!success)
{
send(e.peer_id,"Uh-oh. Something went wrong. Try again.",0);
return;
}
send(e.peer_id,parsed[1]+" deleted successfully.",0);
if(players[index].char==parsed[1])
{
kick(index,"character deletion system.");
return;
}
}
}
else if(parsed[0]=="/delete" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].admin==false and players[index].dev==false) return;
if(!directory_exists("players/"+parsed[1]))
{
send(e.peer_id,"This player doesn't exist in the database.",0);
return;
}
notify(players[index].name+" just deleted "+parsed[1]+"'s account!");
directory_delete("players/"+parsed[1]);

int index2=get_player_index_from(parsed[1]);
if(index2>-1)
{
send(players[index2].peer_id,"exitclient",0);
@players[index2]=null;
players.remove_at(index2);
return;
}
}
}
else if(parsed[0]=="/fblist")
{
