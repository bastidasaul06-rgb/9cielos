else if(parsed[0]=="/pm" and parsed.length()>2)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(parsed[1]==players[index].name)
{
send(e.peer_id,"Now why in the world would you have any reason to PM yourself. I mean, you could achieve the same thing just by, oh, I don't know, maybe talking to yourself out loud or in your head, if you understand what I am saying...?",0);
return;
}
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
if(directory_exists("players/"+parsed[1]))
{
file f;
f.open("players/"+parsed[1]+"/offline_pm's.txt","ab");
f.write("A private message from "+players[index].name+": "+string_replace(get_event_message(),"/pm "+parsed[1]+" ","",true)+"\r\n");
f.close();
send(e.peer_id,"This player is offline, but they will see your PM when they return.",2);
send(e.peer_id,"play_s pm.ogg",6);
return;
}
else{
send(e.peer_id,"Player not found.",0);
return;
}
}
if(players[index2].mutelist.find(players[index].name)>-1)
{
send(e.peer_id,players[index2].name+" has muted you. You are not allowed to private message them.",0);
return;
}
players[index2].lastpm=players[index].name;
players[index].lastpm=players[index2].name;
send(players[index].peer_id,"play_s pm.ogg",6);
send(players[index2].peer_id,"play_s pm.ogg",6);
send(players[index2].peer_id,"PM from "+players[index].name+": "+string_replace(get_event_message(),parsed[0]+" "+parsed[1]+" ","",true),4);
send(players[index].peer_id,"PM to "+players[index2].name+": "+string_replace(get_event_message(),parsed[0]+" "+parsed[1]+" ","",true),4);
}
}
