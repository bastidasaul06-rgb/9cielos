if(used_item=="toy_nerf_gun" or used_item=="cannon_launcher" or used_item=="axe" or used_item=="pistol" or used_item=="rifle" or used_item=="micro_smg" or used_item=="shotgun" or used_item=="kyle's_crossbow" or used_item=="barrett_sniper_rifle" or used_item=="energy_saber" or used_item=="energy_saber_plus")
{
