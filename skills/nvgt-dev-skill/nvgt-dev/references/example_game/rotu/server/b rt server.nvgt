}
else if(parsed[0]=="itemsmenu") itemsmenu(players[index].peer_id);
else if(parsed[0]=="itemtrack" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1]=="")
{
send(players[index].peer_id,"Canceled.",0);
return;
}
else if(parsed[1]=="stoptrack")
{
send(players[index].peer_id,"stopitemtrack",0);
send(players[index].peer_id,"Stopped tracking.",0);
return;
}
else{
string[]xyz=string_split(parsed[1],":",false);
int x=stn(xyz[0]);
int y=stn(xyz[1]);
int z=stn(xyz[2]);
send(players[index].peer_id,"trackitem "+x+" "+y+" "+z,0);
send(players[index].peer_id,"Tracking.",0);
}
}
else if(parsed[0]=="trackselect" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1].is_empty() or parsed[1]=="stoptracking")
{
if(players[index].trackingplayer or players[index].trackplayer!="")
{
send(players[index].peer_id,"Stopped tracking",0);
players[index].trackingplayer=false;
players[index].trackplayer="";
}
else
{
send(players[index].peer_id,"Canceled.",0);
}
}
else
{
players[index].trackplayer=parsed[1];
players[index].trackingplayer=true;
send(players[index].peer_id,"Tracking "+parsed[1],0);
}
}
else if(parsed[0]=="checktrack")
{
players[index].track_player();
}
else if(parsed[0]=="track")
{
trackmenu(players[index].peer_id);
}
else if(parsed[0]=="buildermenu")
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
buildermenu(players[index].peer_id);
}
else if(parsed[0]=="build" and parsed.length()>1)
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
if(parsed[1]=="" or parsed[1]=="back")
{
send(players[index].peer_id,"Canceled.",0);
return;
}
string wt=parsed[1];
if(wt=="source") send(players[index].peer_id,"addsrc",0);
if(wt=="url") send(players[index].peer_id, "addurl", 0);
if(wt=="hazard") send(players[index].peer_id, "addhazard", 0);
if(wt=="travelpoint") send(players[index].peer_id,"addtravelpoint",0);
if(wt=="door") send(players[index].peer_id,"adddoor",0);
if(wt=="sign") send(players[index].peer_id,"addsign",0);
if(wt=="zone") send(players[index].peer_id,"addzone",0);
if(wt=="surface") send(players[index].peer_id,"addsurface",0);
if(wt=="beacon") send(players[index].peer_id,"addbeacon",0);
if(wt=="music") send(players[index].peer_id,"addmusic",0);
if(wt=="spawnpoint") send(players[index].peer_id,"addspawnpoint",0);
if(wt=="safezone") send(players[index].peer_id,"addsafezone",0);
if(wt=="fights")
{
map_data@m=get_map_handle(players[index].map);
if(@m==null) return;
if(m.fights==false)
{
m.remove_entry("no_fights");
m.fights=true;
m.save();
refresh_map(m.name);
buildermenu(players[index].peer_id);
return;
}
if(m.fights==true)
{
m.rawdata+="no_fights\r\n";
m.save();
refresh_map(m.name);
buildermenu(players[index].peer_id);
return;
}
}
if(wt=="view")
{
map_data@m=get_map_handle(players[index].map);
if(@m==null) return;
if(m.viewpoint=="outside")
{
m.rawdata+="viewpoint inside";
m.save();
refresh_map(m.name);
buildermenu(players[index].peer_id);
return;
}
if(m.viewpoint=="inside")
{
m.remove_entry("viewpoint inside");
m.viewpoint="outside";
m.save();
refresh_map(m.name);
buildermenu(players[index].peer_id);
return;
}
}
if(wt=="itemspawn")
{
map_data@m=get_map_handle(players[index].map);
if(@m==null) return;
if(m.can_have_items==true)
{
string[] lines = string_split(m.rawdata, "\r\n", false);
m.rawdata = "";
for(uint i=0; i<lines.length(); i++) {
if(lines[i] == "spawn") continue;
m.rawdata += lines[i] + "\r\n";
}
m.can_have_items=false;
if(in_array(m.name, @public))
{
public.remove_at(public.find(m.name));
}
m.save();
refresh_map(m.name);
buildermenu(players[index].peer_id);
return;
}
if(m.can_have_items==false)
{
m.rawdata+="spawn\r\n";
m.can_have_items=true;
if(!in_array(m.name, @public))
{
public.insert_last(m.name);
}
m.save();
refresh_map(m.name);
buildermenu(players[index].peer_id);
return;
}
}
if(wt=="invtype")
{
map_data@m=get_map_handle(players[index].map);
if(@m==null) return;
if(m.invtype=="battle")
{
m.set_invtype("main");
m.save();
refresh_map(m.name);
for(uint i=0; i<players.length(); i++)
{
if(players[i].map==m.name)
{
@players[i].inv = players[i].inventories[0];
send(players[i].peer_id, "Your inventory has been restored to your main inventory.", 2);
}
}
buildermenu(players[index].peer_id);
return;
}
else
{
m.set_invtype("battle");
m.save();
refresh_map(m.name);
for(uint i=0; i<players.length(); i++)
{
if(players[i].map==m.name)
{
@players[i].inv = players[i].inventories[1];
players[i].inv.id = players[i].peer_id;
send(players[i].peer_id,"The map that you are currently on has forced your inventory to the battle inventory. To change this, ask an available admin or developer.", 2);
}
}
buildermenu(players[index].peer_id);
return;
}
}
if(wt=="editmaxx")
{
string packet="edit_box **title=Enter new Max X:**answer=setmaxx **answer_channel=0";
send(players[index].peer_id,packet,0);
}
if(wt=="editmaxy")
{
string packet="edit_box **title=Enter new Max Y:**answer=setmaxy **answer_channel=0";
send(players[index].peer_id,packet,0);
}
if(wt=="newmap")
{
send(players[index].peer_id,"createnewmap",0);
}
if(wt=="delmap")
{
send(players[index].peer_id,"confirmdeletemap "+players[index].map,0);
}
if(wt=="addline")
{
string packet="edit_box **title=Add what?**answer=add**answer_channel=0";
send(players[index].peer_id,packet,0);
}
if(wt=="editline") linemenu(players[index].peer_id,"edit");
if(wt=="remline") linemenu(players[index].peer_id,"remove");
}
else if(parsed[0]=="setmaxx" and parsed.length()==2)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
int new_maxx=stn(parsed[1]);
if(new_maxx>0)
{
map_data@m=get_map_handle(players[index].map);
if(@m!=null)
{
m.set_maxx(new_maxx);
m.save();
refresh_map(m.name);
}
}
}
}
else if(parsed[0]=="setmaxy" and parsed.length()==2)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
int new_maxy=stn(parsed[1]);
if(new_maxy>0)
{
map_data@m=get_map_handle(players[index].map);
if(@m!=null)
{
m.set_maxy(new_maxy);
m.save();
refresh_map(m.name);
}
}
}
}
else if(parsed[0]=="create_map" and parsed.length()==5)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
string tempname=parsed[1];
if(file_exists("maps/"+tempname+".map") or get_map_index(tempname)>-1)
{
send(players[index].peer_id, "this map already exists", 2);
return;
}
int maxx=stn(parsed[2]);
int maxy=stn(parsed[3]);
string surface=parsed[4];
if(maxx<=0 or maxy<=0) return;
string mdata="name "+tempname+"\r\nmaxx "+maxx+"\r\nmaxy "+maxy+"\r\nplatform 0 "+maxx+" 0 "+maxy+" 0 0 "+surface;
file_put_contents("maps/"+tempname+".map", mdata, 250);
maps.insert_last(map_data(tempname));
int[] position={0, 0, 0};
changemap(index, get_map_index(tempname), position);
send(players[index].peer_id, "Map "+tempname+" created successfully.", 0);
}
}
else if(parsed[0]=="delete_map_confirm" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
string target_map = parsed[1];
bool success=delete_map(target_map);
if(!success)
{
send(e.peer_id,"This map could not be deleted, either because it doesn't exist, or there was another error.",0);
}
else
{
send(e.peer_id,"The "+target_map+" map was deleted successfully.",0);
}
}
}
else if(parsed[0]=="change_line" and parsed.length()>1)
{
string the_lines=string_trim_left(get_event_message(),12);
string[]change_it=string_split(the_lines,"{}",true);
if(change_it.length()>2 or change_it.length()<=1 or change_it[1]==change_it[0]) return;
map_data@m=get_map_handle(players[index].map);
if(@m==null) return;
string[]lines=string_split(m.rawdata,"\r\n",true);
for(uint i=0; i<lines.length(); i++)
{
if(lines[i]==change_it[0])
{
m.rawdata=string_replace(m.rawdata,change_it[0],change_it[1],false);
}
}
m.save();
refresh_map(m.name);
}
else if(parsed[0]=="edit_line" and parsed.length()>1)
{
if(parsed[1]=="" or parsed[1]=="back")
{
send(players[index].peer_id,"Canceled.",0);
return;
}
int pos=stn(parsed[1]);
map_data@m=get_map_handle(players[index].map);
if(@m==null) return;
string editting=m.get_data_at(pos);
string packet="edit_box **title=Editting.**default="+editting+"**answer=change_line "+editting+"{} **answer_channel=0";
send(players[index].peer_id,packet,0);
}
else if(parsed[0]=="remove_line" and parsed.length()>1)
{
if(parsed[1]=="" or parsed[1]=="back")
{
send(players[index].peer_id,"Canceled.",0);
return;
}
int line_number=stn(parsed[1]);
map_data@m=get_map_handle(players[index].map);
if(@m==null) return;
string[]lines=string_split(m.rawdata,"\r\n",true);
for(uint i=0; i<lines.length(); i++)
{
if(i==line_number){
m.remove_entry(lines[i]);
m.save();
break;
}
}
refresh_map(m.name);
}
else if(parsed[0]=="mpadselect" and parsed.length()>1)
{
if(parsed[1]=="off")
{
send(players[index].peer_id,"The mPad shuts off, the screen slowly fading to black.",0);
play2("marketpadoff",players[index].x,players[index].y,players[index].z,players[index].map);
players[index].mpad=false;
return;
}
else if(parsed[1]=="" or parsed[1]=="back")
{
send(players[index].peer_id,"You temporarily set the pad aside.",0);
return;
}
else if(parsed[1]=="mradio") wtmenu(players[index].peer_id);
else if(parsed[1]=="itemtrans")
{
players[index].mtrans=players[index].mtrans==1?0:1;
send(players[index].peer_id,(players[index].mtrans==1?"A blue LED light flashes on the side of your tablet. 'Item transferring enabled' appears on the screen.":"The blue LED light shuts off. Item transferring disabled."),2);
play2((players[index].mtrans==1?"vcon":"vcoff"),players[index].x,players[index].y,players[index].z,players[index].map);
}
else if(parsed[1]=="quickbuy") storemenu(players[index].peer_id);
else if(parsed[1]=="__goldflip__")
{
send(players[index].peer_id,"mPadUI goldflip",0);
}
else if(parsed[1]=="__iroll__")
{
send(players[index].peer_id,"mPadUI iroll",0);
}
else if(parsed[1]=="iroll")
{
int amount=stn(parsed[2]);
dice@[]dcs(0);
for(uint a=0; a<amount; a++)
{
dice temp(6);
dcs.insert_last(temp);
}
string ddata;
for(uint i=0; i<dcs.length(); i++)
{
ddata+=dcs[i].num+". ";
}
if(all_dice_match(dcs,1) or all_dice_match(dcs,2) or all_dice_match(dcs,3) or all_dice_match(dcs,4) or all_dice_match(dcs,5) or all_dice_match(dcs,6))
{
send(players[index].peer_id,"Great! You got all of the same number!",0);
players[index].give("gold",10*amount);
play2("dicematch",players[index].x,players[index].y,players[index].z,players[index].map);
}
play2("dice",players[index].x,players[index].y,players[index].z,players[index].map,index);
send(players[index].peer_id,ddata,0);
for(uint i=0; i<players.length(); i++)
{
if(players[i].name!=players[index].name and get_3d_distance(players[i].x,players[i].y,players[i].z,players[index].x,players[index].y,players[index].z)<=3)
{
send(players[i].peer_id,players[index].name+" rolls "+amount+" "+(amount==1?"die":"dice")+". "+ddata,2);
}
}
}
else if(parsed[1]=="goldflip")
{
string sidename;
int side=random(0,1);
if(side==0) sidename="heads";
if(side==1) sidename="tails";
send(players[index].peer_id,"An animation of a coin flipping temporarily fills the screen, then the screen clears to reveal: "+sidename,2);
}
else send(players[index].peer_id,"This feature is not yet supported.",0);
}
else if(parsed[0]=="getmapdata" and parsed.length()>1)
{
if(file_exists("maps/"+parsed[1]+".map"))
{
send(players[index].peer_id,"mapdata "+get_file("maps/"+parsed[1]+".map"),0);
}
}
else if(parsed[0]=="invselect" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1]=="")
{
play2("invclose",players[index].x,players[index].y,players[index].z,players[index].map,index);
return;
}
play2("invclose",players[index].x,players[index].y,players[index].z,players[index].map,index);
players[index].inv.invpos=stn(parsed[1]);

}
else if(parsed[0]=="invopen")
{
if(players[index].get_items_in_category(players[index].invcat)==0)
{
send(players[index].peer_id,"No items in this category.",0);
return;
}
play2("invopen",players[index].x,players[index].y,players[index].z,players[index].map,index);
//send(players[index].peer_id,"invmenu",0);
players[index].inv.invmenu(players[index].peer_id,players[index].invcat);
}
else if(parsed[0]=="iamcrouching") players[index].crouching=true;
else if(parsed[0]=="iamnotcrouching") {
players[index].crouching=false;
if(players[index].weapon=="cannon_launcher") send(players[index].peer_id, "walktime 240", 0);
}
else if(parsed[0]=="iamsitting") players[index].sitting=true;
else if(parsed[0]=="iamnotsitting") players[index].sitting=false;
else if(parsed[0]=="buy" and parsed.length()>2)
{
string[]st=string_split(get_file("store.dat"),"\r\n",false);
for(uint i=0; i<st.length(); i++)
{
string[]s=string_split(st[i],":",false);
if(s[0]==parsed[1])
{
if(stn(parsed[2])>0)
{
double price=stn(s[1]);
if(players[index].paid==1 and price<25) price-=price*0.25;
if(players[index].inv.get_item_amount("gold")<(price*stn(parsed[2])))
{
send(players[index].peer_id,"You do not have enough gold to purchase "+parsed[2]+" "+parsed[1],0);
return;
}
else
{
int price=stn(s[1])*stn(parsed[2]);
if(players[index].paid==1 and price<25) price-=price*0.25;
int goldcheck=players[index].inv.get_item_amount("gold");
int itemamount=stn(parsed[2]);
if(itemamount>0 and price>0)
{
players[index].give("gold",-price);
players[index].give(parsed[1],itemamount);
send(players[index].peer_id,"Purchase successful!",0);
}
}
}
else if(stn(parsed[2])<0)
{
if(players[index].inv.get_item_amount(s[0])<absolute(stn(parsed[2])) or players[index].inv.get_item_amount(s[0])<=0)
{
send(players[index].peer_id,"You don't have this much to sell!",0);
return;
}
else
{
double goldgive=round((stn(parsed[2])*stn(s[1]))/2,0);
players[index].give(parsed[1],stn(parsed[2]));
players[index].give("gold",absolute(goldgive));
send(players[index].peer_id,"You sold "+absolute(stn(parsed[2]))+" "+parsed[1]+", and received "+absolute(goldgive)+" gold.",0);
}
}
}
}
}
else if(parsed[0]=="mapselect" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1]=="")
{
send(players[index].peer_id,"Canceled.",0);
return;
}
int m=get_map_index(parsed[1]);
if(m==-1) {
send(players[index].peer_id, "This map does not exist", 0);
return;
}
int[]cm={0,0,0};
changemap(index,m,cm);
}
else if(parsed[0]=="grenadethrow" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1]=="")
{
send(players[index].peer_id,"Canceled.",0);
return;
}
if(players[index].safe()){
send(players[index].peer_id,"Nope. You can't throw a grenade in this location.",0);
return;
}
play2("grenadethrow",players[index].x,players[index].y,players[index].z,players[index].map);
spawn_weapon(players[index].x,players[index].y,players[index].z,"grenade",players[index].dir,players[index].name,players[index].map,stn(parsed[1]));
attract_undead(players[index].x, players[index].y, players[index].z, players[index].map);
players[index].give("hand_grenade",-1);
}
else if(parsed[0]=="purchase" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1]=="")
{
send(players[index].peer_id,"Store closed.",0);
return;
}
string packet="edit_box **title=Enter the amount of "+parsed[1]+" you would like to buy, then press Enter to verify your purchase. Enter a negative quantity to sell that item.**answer=buy "+parsed[1]+"**answer_channel=0";
send(players[index].peer_id,packet,0);
}
else if(parsed[0]=="drop" and parsed.length()>1)
{
if(players[index].inv.invpos<0 or players[index].inv.invpos>players[index].inv.items.length()-1)
{
send(players[index].peer_id,"No focused item.",0);
return;
}
if(get_jail_index(players[index].name)>-1 and players[index].map=="jail")
{
send(players[index].peer_id,"You can't drop any items from your inventory.",0);
return;
}
else if(players[index].inv.items.length()==0)
{
send(players[index].peer_id,"Empty",0);
return;
}
else{
if(players[index].inv.get_item_amount(players[index].inv.getitem())<stn(parsed[1]))
{
send(players[index].peer_id,"You don't have this much!",0);
return;
}
spawn_item(players[index].x,players[index].y,players[index].z,players[index].inv.getitem(),stn(parsed[1]),players[index].map);
players[index].give(players[index].inv.getitem(),-stn(parsed[1]));
play2("handsdrop",players[index].x,players[index].y,players[index].z,players[index].map,index);
}
}
else if(parsed[0]=="use" and parsed.length()==2)
{
if(get_jail_index(players[index].name)>-1 and players[index].map=="jail")
{
send(players[index].peer_id,"You can't use any items from your inventory.",0);
return;
}
else if(players[index].inv.items.length()==0)
{
send(players[index].peer_id,"Empty",0);
return;
}
else
{
bool take=true;
string used_item=parsed[1];
if(players[index].incar and exclude.find(used_item)>-1) return;
if(used_item==eventitem)
{
send(players[index].peer_id,"This seems like an event item. On "+eventdate+", you will submit this item by typing /submit in the chat box. Whoever has the most of this item will win.",0);
take=false;
return;
}
if(used_item=="police_whistle") {
if(players[index].whistletimer.elapsed<=25000) {
take=false;
return;
}
take=false;
players[index].whistletimer.restart();
play2("police_whistle", players[index].x, players[index].y, players[index].z, players[index].map, index);
attract_undead(players[index].x, players[index].y, players[index].z, players[index].map, true);
}
if(used_item=="gift_sack")
{
play2("sacksearch",players[index].x,players[index].y,players[index].z,players[index].map);
int r=random(5,30);
players[index].give("giftbox",r);
send(players[index].peer_id,"You search the sack and find "+r+" giftboxes.",2);
}
if(used_item=="giftbox")
{
if(players[index].unwrapping==true)
{
send(players[index].peer_id,"You are currently unwrapping a gift right now, wait a moment.",0);
take=false;
return;
}
send(players[index].peer_id,"You begin to tear at the wrapping paper on the box. Just what could be inside?",2);
play2("giftopen",players[index].x,players[index].y,players[index].z,players[index].map);
players[index].unwraptimer.restart();
players[index].unwrapping=true;
}
if(used_item=="gift")
{
play2("giftreveal",players[index].x,players[index].y,players[index].z,players[index].map,index);
gift(index);
}
if(used_item=="tactile_watch")
{
send(players[index].peer_id,"You open up the cover of the watch and feel inside the interior for the tactile hands. You discern that the time is "+get_sayable_time()+".",0);
take=false;
}
if(string_contains(used_item,"_ammo_pack",1)>-1)
{
string ammoreplace=string_replace(used_item,"_pack","",false);
players[index].am.ammogive(ammoreplace,random(10,50));
play2("shotgunshell",players[index].x,players[index].y,players[index].z,players[index].map,index);
send(players[index].peer_id,"You open the ammo pack.",0);
}
string[] cls=string_split(get_file("clothes_list.dat"),"\r\n",false);
for(uint c=0; c<cls.length(); c++)
{
string[]cl=string_split(cls[c],"|",false);
if(used_item==cl[0])
{
if(cl[1]=="feet")
{
if(players[index].feet==cl[0])
{
players[index].feet="";
send(players[index].peer_id,"You take off the "+cl[0],0);
}
else{
players[index].feet=cl[0];
send(players[index].peer_id,"You put on the "+cl[0],0);
}
}
if(cl[1]=="legs")
{
if(players[index].legs==cl[0])
{
players[index].legs="";
send(players[index].peer_id,"You take off the "+cl[0],0);
}
else{
players[index].legs=cl[0];
send(players[index].peer_id,"You put on the "+cl[0],0);
}
}
if(cl[1]=="shoulders")
{
if(players[index].shoulders==cl[0])
{
players[index].shoulders="";
send(players[index].peer_id,"You take off the "+cl[0],0);
}
else{
players[index].shoulders=cl[0];
send(players[index].peer_id,"You put on the "+cl[0],0);
}
}
if(cl[1]=="chest")
{
if(players[index].chest==cl[0])
{
players[index].chest="";
send(players[index].peer_id,"You take off the "+cl[0],0);
}
else{
players[index].chest=cl[0];
send(players[index].peer_id,"You put on the "+cl[0],0);
}
}
if(cl[1]=="hands")
{
if(players[index].hands==cl[0])
{
players[index].hands="";
send(players[index].peer_id,"You take off the "+cl[0],0);
}
else{
players[index].hands=cl[0];
send(players[index].peer_id,"You put on the "+cl[0],0);
}
}
if(cl[1]=="head")
{
if(players[index].head==cl[0])
{
players[index].head="";
send(players[index].peer_id,"You take off the "+cl[0],0);
}
else{
players[index].head=cl[0];
send(players[index].peer_id,"You put on the "+cl[0],0);
}
}
/*
if(cl.length()>2)
{
for(uint l=2; l<cl.length(); l++){
send(players[index].peer_id,cl[l],0);
}
}
*/
take=false;
}
}
if(used_item=="graven_feather")
{
if(players[index].inv.get_item_amount("graven_feather")<1000)
{
int featheramount=players[index].inv.get_item_amount("graven_feather");
send(players[index].peer_id,"The feather of this long dead raven seems quite valuable to you, but you can't quite figure out why. It seems to pulse with an extravagantly dark blue light. If only you had "+(1000-featheramount)+" more of these feathers, you could probably create something out of them, and maybe you wouldn't even have to create anything at all. Judging by the light, it seems to be capable of transforming on its own.",0);
take=false;
return;
}
play2("darkbluecape",players[index].x,players[index].y,players[index].z,players[index].map,index);
send(players[index].peer_id,"Before your eyes, the feathers group together, weaving in and out to create a raven with outspread wings. Then, the feathers lengthen and grow, forming into a dark blue cape, with the wings coming to settle upon your shoulders, and the body of the raven surrounding the rest of your body.",2);
players[index].shoulders="dark_blue_cape";
players[index].give("graven_feather",-1000);
players[index].give("dark_blue_cape",1);
take=false;
}
if(used_item=="mPad_battery_pack")
{
if(players[index].mpad)
{
send(players[index].peer_id,"It's not a good idea to try and insert a battery into a device that is still powered on.",0);
take=false;
return;
}
if(players[index].mpadbat>10)
{
send(players[index].peer_id,"The battery that is currently in the mPad is still in good condition. Wait until the battery on your mPad is 10 percent or lower before trying to insert a new battery pack.",0);
take=false;
return;
}
players[index].mpadbat=100;
send(players[index].peer_id,"You take off the back cover of the tablet, remove the old battery from the device, and insert the new battery pack into the compartment, then you slide the back cover of the device back on.",0);
}
if(used_item=="mPad")
{
if(players[index].mpadbat==0)
{
send(players[index].peer_id,"You try to power on the mPad, but the screen flashes red. It seems like the battery is completely drained.",0);
take=false;
return;
}
else
{
if(players[index].mpad==false)
{
play2("marketpadon",players[index].x,players[index].y,players[index].z,players[index].map);
}
take=false;
mpadmenu(players[index].peer_id);
players[index].mpad=true;
}
}
if(used_item=="starter_pack")
{
play2("starter_pack",players[index].x,players[index].y,players[index].z,players[index].map);
send(players[index].peer_id,"Upon opening the pack, you receive 75 cans of nectar, as well as 300 rounds of 9.5mm ammo for a standard pistol.",2);
players[index].am.ammogive("pistol_ammo",300);
players[index].give("can_of_nectar",75);
players[index].give("mPad_battery_pack",50);
players[index].give("mPad",1);
players[index].give("gold",1000000);
}
if(used_item=="broken_auto_saturn")
{
if(players[index].inv.get_item_amount("gold")<875)
{
send(players[index].peer_id,"You do not have the 875 gold required to make this repair.",0);
take=false;
return;
}
else
{
if(players[index].x>216 and players[index].x<228 and players[index].y<456 and players[index].y>446 and players[index].z==0)
{
play2("repair",players[index].x,players[index].y,players[index].z,players[index].map);
send(players[index].peer_id,"You repair the car to usable condition.",2);
players[index].give("auto_saturn",1);
players[index].give("gold",-875);
}
else
{
send(players[index].peer_id,"You can't repair the car here!",0);
take=false;
return;
}
}
}
if(used_item=="hand_grenade")
{
take=false;
throwmenu(players[index].peer_id);
}
if(used_item=="auto_saturn")
{
if(players[index].incar==true or players[index].cf!="" or players[index].ctfteam!="" or players[index].paid==0)
{
take=false;
return;
}
if(!players[index].sitting)
{
send(players[index].peer_id,"It's best if you sit down before driving a car.",0);
take=false;
return;
}
bool can_spawn_vehicle=true;
for(uint i=1; i<=10; i+=1) {
vector ts;
ts=move(players[index].x, players[index].y, players[index].dir);
if(string_left(get_tile_at(ts.x, ts.y, players[index].z, players[index].mymap.name), 4)=="wall") {
can_spawn_vehicle=false;
break;
}
}
if(can_spawn_vehicle==false) {
send(players[index].peer_id, "You may not want to start your car now, you're facing the wall!", 0);
return;
}
if(players[index].carstartstoptimer.elapsed<players[index].carstartstoptime)
{
send(players[index].peer_id,"You need to wait 5 seconds before you can start your car.",0);
take=false;
return;
}
send(players[index].peer_id,"start_car",0);
send(players[index].peer_id,"play_s carstartint.ogg",6);
players[index].cardir=players[index].dir;
players[index].carstartstoptimer.restart();
for(uint i=0; i<players.length(); i++)
{
if(players[i].name!=players[index].name)
{
send(players[i].peer_id,"play carstartext.ogg "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].map,6);
send(players[i].peer_id,"createmsound "+players[index].name+"_car carloopext "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].map+" 100",7);
}
}
send(players[index].peer_id,"createmsound "+players[index].name+"_carint carloopint "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].map+" 100",7);
players[index].incar=true;
take=false;
}
