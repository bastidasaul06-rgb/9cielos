{
if(items[i].pickuptimer.elapsed<3000)
{
send(players[index].peer_id,"This item only just spawned. Wait a few seconds.",0);
return;
}
play2("itemget",players[index].x,players[index].y,players[index].z,players[index].map,index);
if(string_contains(items[i].type,"_ammo",1)>-1)
{
players[index].am.ammogive(items[i].type,items[i].amount);
send(players[index].peer_id,items[i].amount+" "+items[i].type,2);
}
else
{
players[index].give(items[i].type,items[i].amount);
send(players[index].peer_id,items[i].amount+" "+items[i].type,2);
}
@items[i]=null;
items.remove_at(i);
}
}
