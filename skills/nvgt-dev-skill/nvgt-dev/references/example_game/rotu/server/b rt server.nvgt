else if(parsed[0]=="questinfo" and parsed.length()==2) send(players[index].peer_id, players[index].get_quest_instructions(), 2);
else if(parsed[0]=="abandon_quest" and parsed.length()>1) {
if(parsed[1]=="back" or parsed[1].is_empty()) {
send(players[index].peer_id, "canceled", 0);
}
else {
players[index].working_quest_dict.delete_all();
string qtitle=players[index].myquest.title;
@players[index].myquest=null;
send(0, "play_s questfail.ogg -5", 6);
send(0, players[index].char+" has failed the "+qtitle+" quest!", 2);
}
}
else if(parsed[0]=="accept_quest" and parsed.length()==2) {
if(parsed[1]=="back" or parsed[1].is_empty()) {
send(players[index].peer_id, "Canceled", 0);
}
else {
int q=get_quest(parsed[1]);
if(q>-1) {
@players[index].myquest=quests[q];
players[index].working_quest_dict.delete_all();
players[index].questtimer.restart();
players[index].questwon=false;
send(players[index].peer_id, "play_s quest.ogg -5", 6);
send(players[index].peer_id, players[index].get_quest_instructions(), 2);
}
else {
send(players[index].peer_id, "The quest you are attempting to accept is corrupted. Please contact an admin or developer if this problem continues", 2);
return;
}
}
}
else if(parsed[0]=="playsvr" and parsed.length()>1) {
if(parsed[1]=="back" or parsed[1].is_empty())
{
send(players[index].peer_id,"Closed.",0);
return;
}
if(file_exists("sounds\\"+parsed[1])) {
for(uint i=0; i<players.length(); i+=1) send(players[i].peer_id, "playdata "+get_file("sounds\\"+parsed[1]), 6);
}
}
else if(parsed[0]=="szselect" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1].is_empty())
{
send(players[index].peer_id,"Closed.",0);
return;
}
if(parsed[1]=="accquest") questmenu(index);
