void addprefs()
{
save_clock();
sd.add("motd",motd);
sd.add("totaluptime",totaluptime);
sd.add("votemsg",votemsg);
sd.add("can_voicechat", can_voicechat);
sd.add("peak",peak);
sd.add("voting",voting);
sd.add("yes",yes);
sd.add("no",no);
save_tempbans();
save_jails();
sd.add("lastupdate",lastupdate);
file f;
f.open("otps.dat","wb");
f.write(serialize(otps));
f.close();
f.open("ipbans.dat","wb");
f.write(serialize(ipbans));
f.close();
f.open("compbans.dat","wb");
f.write(serialize(compbans));
f.close();
sd.save();
}
void readprefs()
{
sd.load();
load_all_tempbans();
load_all_jails();
load_clock();
if(sd.d.exists("voting")) voting=sd.readn("voting");
if(sd.d.exists("can_voicechat")) can_voicechat=sd.readn("can_voicechat");
if(sd.d.exists("yes")) yes=sd.readn("yes");
if(sd.d.exists("no")) no=sd.readn("no");
if(sd.d.exists("votemsg")) votemsg=sd.read("votemsg");
if(sd.d.exists("motd")) motd=sd.read("motd");
if(sd.d.exists("peak")) peak=sd.readn("peak");
if(sd.d.exists("totaluptime")) totaluptime=sd.readn("totaluptime");
if(sd.d.exists("lastupdate")) lastupdate=sd.read("lastupdate");
file f;
if(file_exists("otps.dat"))
{
f.open("otps.dat","rb");
otps=deserialize(f.read());
f.close();
}
if(file_exists("ipbands.dat"))
{
f.open("ipbans.dat","rb");
ipbans=deserialize(f.read());
f.close();
}
if(file_exists("compbans.dat"))
{
f.open("compbans.dat","rb");
compbans=deserialize(f.read());
f.close();
}
}

void handle_crash()
{
    // 1. Try to save all players and preferences before doing anything else (critical data safety!)
    try {
        for(uint i=0; i<players.length(); i++)
        {
            try {
                if(players[i].char != "") {
                    players[i].save();
                }
                players[i].save_main();
            } catch {}
        }
    } catch {}
    try {
        addprefs();
    } catch {}

    // 2. Create the error runtime directory if it doesn't exist
    try {
        if(!directory_exists("error runtime")) {
            directory_create("error runtime");
        }
    } catch {}

    // 3. Write exception details to a file
    try {
        file f;
        string filename = "error runtime/" + TIME_HOUR + "_" + TIME_MINUTE + "_" + TIME_SECOND + "_" + DATE_DAY + "_" + DATE_MONTH + "_" + DATE_YEAR + ".txt";
        if(f.open(filename, "w")) {
            string log_content = "ROTU SERVER RUNTIME CRASH LOG\r\n";
            log_content += "========================================\r\n";
            log_content += "Date/Time: " + DATE_DAY + "/" + DATE_MONTH + "/" + DATE_YEAR + " " + TIME_HOUR + ":" + TIME_MINUTE + ":" + TIME_SECOND + "\r\n";
            log_content += "Exception Info: " + get_exception_info() + "\r\n";
            log_content += "Exception File: " + get_exception_file() + "\r\n";
            log_content += "Exception Line: " + get_exception_line() + "\r\n";
            log_content += "Exception Function: " + get_exception_function() + "\r\n\r\n";
            log_content += "Call Stack:\r\n" + last_exception_call_stack + "\r\n";
            log_content += "========================================\r\n";
            
            f.write(log_content);
            f.close();
        }
    } catch {}

    // 4. Safely exit the server
    exit();
}

void main()
{
    try {
        real_main();
    }
    catch {
        handle_crash();
    }
}

void real_main()
{
@sd = savedata("server.dat", "youguysarehugegiantsandwiches");
string apikey="5e269db0dcdd6c81737fcfb1931c0afc299acebb";
string[] ks={apikey};
add_prowl_api_keys(ks);

// reserving allocated memory for objects
/* Is this what's taking up so much damn CPU?
unds.reserve(200);
dragons.reserve(50);
maps.reserve(200);
bfalls.reserve(200);
players.reserve(100);

*/
add_quests();
n.setup_server(netport,20, 500);
if(!directory_exists("players")) directory_create("players");
if(!directory_exists("maps")) directory_create("maps");
if(!directory_exists("gangs")) directory_create("gangs");
load_all_gangs();
// speech.speak("Active");
if(!eventitem.is_empty() and !eventdescription.is_empty()) anevent=true;

readprefs();
load_all_maps();
show_game_window("rotu server, by, lc boy production, pressed e to exit");
print("Server is running.");
while(true)
{
netloop();
loops();
wait(5);
}
}
