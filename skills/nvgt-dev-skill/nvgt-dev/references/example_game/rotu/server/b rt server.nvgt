for(uint i=0; i<ca.length(); i++)
{
m.add(ca[i],ca[i]);
}
m.send(players[index].peer_id);
}
}

else if(parsed[0]==        "/rules")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
server_menu m;
m.intro="Rules list";
m.initial_packet="rules";
string[] ca=string_split(get_file("rules.txt"),"\r\n",false);
for(uint i=0; i<ca.length(); i++)
{
m.add(ca[i],ca[i]);
}
m.send(players[index].peer_id);
