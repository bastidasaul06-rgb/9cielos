else if(parsed[0]=="/emotes")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
players[index].emotes=(players[index].emotes==1?0:1);
send(e.peer_id,"Emotes "+(players[index].emotes==1?"enabled":"disabled"),0);
}
}
else if(parsed[0]=="/mutelist")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
send(e.peer_id,"You have "+players[index].mutelist.length()+" muted players on your mute list."+(players[index].mutelist.length()>0?" They are: "+lister(players[index].mutelist):""),0);
}
}
else if(parsed[0]=="/mute" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
bool success=players[index].mute(parsed[1]);
if(!success)
{
send(e.peer_id,"This player is already muted, or does not exist.",0);
}
else
{
send(e.peer_id,parsed[1]+" has been successfully muted. They will not be able to send any private messages, and you will no longer see their chats.",0);
}
}
}
else if(parsed[0]=="/unmute" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
bool success=players[index].unmute(parsed[1]);
if(!success)
{
send(e.peer_id,"This player is already unmuted, or does not exist.",0);
}
else
{
send(e.peer_id,parsed[1]+" has been successfully unmuted.",0);
}
}
}
else if(parsed[0]=="/mutelistclear")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].mutelist.length()==0)
{
send(e.peer_id,"Your mute list is empty.",0);
return;
}
players[index].mutelist.resize(0);
file_delete("players/"+players[index].name+"/mutelist.dat");
send(e.peer_id,"Mute list successfully cleared.",0);
}
}
else if(parsed[0]=="/afk")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].afk==false)
{
players[index].afktimer.force(300000);
}
else
{
players[index].afktimer.restart();
}
}
}
else if(parsed[0]=="/transfer" and parsed.length()>3)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string transfname=parsed[1];
string itemtype=parsed[2];
int amount=stn(parsed[3]);
if(transfname==players[index].name)
{
send(e.peer_id,"You can't give yourself items!",0);
return;
}
if(players[index].inv.get_item_amount(itemtype)<amount)
{
send(e.peer_id,"You don't have "+amount+" "+itemtype+".",0);
return;
}
if(amount<0)
{
send(e.peer_id,"You can't steal items from people!",0);
return;
}
if(players[index].mpad==false)
{
send(e.peer_id,"You can't transfer any items with your mPad turned off can you?",0);
return;
}
if(players[index].mpad and players[index].mtrans==0)
{
send(e.peer_id,"You have disabled the ability to transfer and receive items from other players. Please re-enable it by selecting the item transfer status option on your mPad and try again.",0);
return;
}
int index2=get_player_index_from(transfname);
if(index2<=-1)
{
send(e.peer_id,"This player does not exist or is not online.",0);
return;
}
if(players[index2].mpad==false)
{
send(e.peer_id,players[index2].name+"'s mPad is currently turned off. Please tell them to turn it on.",0);
return;
}
if(players[index2].mpad==true and players[index2].mtrans==0)
{
send(e.peer_id,players[index2].name+" has item transferring disabled on their mPad. Ask them to turn it on.",0);
return;
}
players[index].give(itemtype,-amount);
players[index2].give(itemtype,amount);
send(e.peer_id,"Your screen flashes as "+amount+" "+itemtype+" is transferred electronically to "+players[index2].name+".",2);
send(players[index2].peer_id,"Your mPad's screen lights up and displays the following text: "+players[index].name+" has sent you "+amount+" "+itemtype+".",2);
admintell("Alert. "+players[index].name+" just transferred "+amount+" "+itemtype+" to "+players[index2].name+".");
}
}
else if(parsed[0]=="/changeinv" and parsed.length()>2)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
int ind=get_player_index_from(parsed[1]);
if(ind<=-1)
{
send(e.peer_id,"This player can't be found.",0);
return;
}
string invtype=parsed[2];
if(invtype=="main")
{
@players[ind].inv=players[ind].inventories[0];
players[ind].inv.id=players[ind].peer_id;
admintell("Alert. "+players[index].name+" changed "+players[ind].name+"'s inventory to their default inventory.");
}
if(invtype=="battle")
{
@players[ind].inv=players[ind].inventories[1];
players[ind].inv.id=players[ind].peer_id;
admintell("Alert. "+players[index].name+" changed "+players[ind].name+"'s inventory to the battle inventory.");
}
if(invtype!="main" and invtype!="battle")
{
send(e.peer_id,invtype+" isn't a valid inventory type.",0);
}
}
}
else if(parsed[0]=="/feature" and parsed.length()==3 and players[index].dev) {
int index2=get_player_index_from(parsed[1]);
if(index2<0) {
send(players[index].peer_id, "Not found", 2);
}
else {
string text;
int f=players[index].disabled.find(parsed[2]);
if(f<0) {
players[index].disabled.insert_last(parsed[2]);
text="the "+parsed[2]+" feature has been disabled";
}
else {
players[index].disabled.remove_at(f);
text="The "+parsed[2]+" feature has been enabled";
}
players[index].save_main();
send(players[index].peer_id, text, 2);
}
}
else if(parsed[0]=="/give" and parsed.length()>3)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
int ind=get_player_index_from(parsed[1]);
if(ind<=-1)
{
send(e.peer_id,"This player can't be found.",0);
return;
}
string gitem=parsed[2];
int gamount=stn(parsed[3]);
if(players[index].disabled.find("give")>-1) {
send(players[index].peer_id, "You are restrcited from using this command", 0);
return;
}
players[ind].give(gitem,gamount);
admintell("Alert. "+players[index].name+" just gave "+players[ind].name+" "+gamount+" "+gitem);
}
}
else if(parsed[0]=="/sethealth" and parsed.length()==3) {
int index=get_player_index(e.peer_id);
if(index>-1) {
if(players[index].dev) {
int index2=get_player_index_from(parsed[1]);
if(index2>-1) {
players[index2].health=stn(parsed[2]);
send(players[index].peer_id, "Done", 2);
}
else {
send(players[index].peer_id, "This player could not be found", 0);
}
}
else {
send(players[index].peer_id, "You must be a developer to change healths", 2);
}
}
}
else if(parsed[0]=="/newbie" and players[index].newb==1) {
players[index].newb=0;
notify(players[index].char+" is no longer a newbie!");
players[index].save_main();
send(players[index].peer_id,"newb_status 0",0);
}
else if(parsed[0]=="/setpaid" and parsed.length()>1 and players[index].dev==true)
{
if(players[index].name==mdev)
{
int index2=get_player_index_from(parsed[1]);
if(index2==-1)
{
send(players[index].peer_id, "Error: player not found", 0);
return;
}
players[index2].paid=1;
players[index2].give("gold", 3500);
players[index2].give("hand_grenade", 35);
players[index2].give("rifle", 5);
players[index2].give("mPad_battery_pack", 15);
players[index2].give("shotgun", 2);
players[index2].give("plate_armor", 3);
players[index2].give("barrett_sniper_rifle", 1);
send(players[index2].peer_id, "play_s purchaase.ogg -10", 6);
send(players[index].peer_id, "Player upgraded", 2);
players[index2].save_main();
}
else {
send(players[index].peer_id, "Not authorized", 0);
return;
}
}
else if(parsed[0]=="/where" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
int ind=get_player_index_from(parsed[1]);
if(ind<=-1)
{
send(e.peer_id,"This player can't be found.",0);
return;
}
send(e.peer_id,players[ind].name+" is in "+players[ind].location+", on "+players[ind].map+" at "+players[ind].x+", "+players[ind].y+", "+players[ind].z+".",0);
}
}
else if(parsed[0]=="/moveplayer" and parsed.length()==3) {
int index=get_player_index(e.peer_id);
if(index>-1) {
if(players[index].dev==false and players[index].admin==false and !players[index].builder) return;
if(players[index].disabled.find("moveplayer")>-1) {
send(players[index].peer_id, "you are restricted from using this command", 0);
return;
}
int i2=get_player_index_from(parsed[1]);
int i3=get_player_index_from(parsed[2]);
if(i2<0 or i2<0) {
send(players[index].peer_id, "one or more players by that name couldn't be found", 0);
return;
}
int[] n={players[i2].x, players[i2].y, players[i2].z};
int m=get_map_index(players[i2].map);
changemap(i3, m, n);
send(players[index].peer_id, "moved", 2);
}
}
else if(parsed[0]=="/gotoplayer" and parsed.length()==2) {
if(players[index].dev==false and players[index].admin==false and !players[index].builder) return;
int index2=get_player_index_from(parsed[1]);
if(index2<0) {
send(players[index].peer_id, "That player could not be found", 0);
}
else {
if(players[index].disabled.find("gotoplayer")>-1) {
send(players[index].peer_id, "you are restricted from using this command", 0);
return;
}
int[] pos={players[index2].x, players[index2].y, players[index2].z};
int m=get_map_index(players[index2].map);
changemap(index, m, pos);
send(players[index].peer_id, "Done", 2);
}
}
else if(parsed[0]=="/game") {
int index=get_player_index(e.peer_id);
if(index>-1) {
if(!players[index].dev) return;
gamestopped=(gamestopped?false:true);
send(0, "the game has been "+(gamestopped?"stopped":"resumed")+"!", 2);
send(0, "play_s game"+(gamestopped?"stop":"start")+".ogg", 6);
send(0, "stunstate "+(gamestopped?"10":"1"), 0);
}
}
else if(parsed[0]=="/voicechat" and players[index].dev) {
can_voicechat=(can_voicechat==1?0:1);
send(players[index].peer_id, "Voicechat has been "+(can_voicechat==1?"enabled":"disabled"), 2);
addprefs();
}
else if(parsed[0]=="/go" and parsed.length()==5) {
int index=get_player_index(e.peer_id); if(index>-1) {
if(players[index].dev==false and players[index].admin==false and !players[index].builder) return;
int m=get_map_index(parsed[1]);
if(m<0) {
send(players[index].peer_id, "this map does not exist", 0);
return;
}
if(players[index].disabled.find("go")>-1) {
send(players[index].peer_id, "You are restricted from using this command", 0);
return;
}
int newx=stn(parsed[2]);
int newy=stn(parsed[3]);
int newz=stn(parsed[4]);
int[] position={newx, newy, newz};
changemap(index, m, position);
}
}
else if(parsed[0]=="/move" and parsed.length()>4)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,"This player can't be found.",0);
return;
}
players[index2].x=stn(parsed[2]);
players[index2].y=stn(parsed[3]);
players[index2].z=stn(parsed[4]);
send(players[index2].peer_id,"move "+players[index2].x+" "+players[index2].y+" "+players[index2].z,0);
send(e.peer_id,"Player moved successfully.",0);
}
}

else if(parsed[0]=="/cm" and parsed.length()>5)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false and !players[index].builder) return;
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,"This player can't be found.",0);
return;
}
int m=get_map_index(parsed[2]);
if(m==-1) {
send(e.peer_id, "this map does not exist", 2);
return;
}
else
{
int[] new_position={stn(parsed[3]), stn(parsed[4]), stn(parsed[5])};
changemap(index,m,new_position);
send(e.peer_id,"Player moved successfully.",0);
}
}
}
else if(parsed[0]=="/spawn" and parsed.length()==3 and players[index].dev==true) {
string type=parsed[1];
string mapname=parsed[2];
int mapind=get_map_index(mapname);
if(mapind<0) {
send(players[index].peer_id, "this map is not loaded or does not exist", 2);
return;
}
map_data@m=maps[mapind];
if(@m==null) return;
if(type=="undead") {
string t=undtypes[random(0, undtypes.length()-1)];
undead_appear(t, m);
send(players[index].peer_id, "done", 0);
notify(players[index].name+" has released a "+t+" on map "+m.name+"!");
}
else if(type=="dragon") {
spawn_dragon(0,m.maxx,0,m.maxy,0,150,m.name);
notify(players[index].name+" just unleashed a dragon! Look out!");
}
else {
send(players[index].peer_id, "Invalid type", 0);
return;
}
}
else if(parsed[0]=="/public" and players[index].dev)
{
string ret = string_join(@public, ", ");
send(e.peer_id, "the maps where undead will spawn are "+ret, 2);
}
else if(parsed[0]=="/unadmin" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
