else if(parsed[0]=="/rawmap")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
send(e.peer_id,"clipcopy "+players[index].mymap.rawdata,0);
send(e.peer_id,players[index].map+" has been copied to your clipboard.",0);
}
}
else if(parsed[0]=="/rawdata" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
string mdata=string_trim_left(get_event_message(),9);
string[] p=string_split(mdata, "\r\n", false);
bool mapmatched=false;
for(uint x=0; x<p.length(); x+=1) {
string[] lines=string_split(p[x], " ", true);
if(lines.length()<2) continue;
if(lines[0]=="name" and lines.length()==2 and lines[1]==players[index].map) mapmatched=true;
}
if(mapmatched) {
file f;
f.open("maps/"+players[index].map+".map","wb");
f.write(mdata);
f.close();
refresh_map(players[index].map);
}
else {
send(players[index].peer_id, "Error: map security check failed. Please make sure map header is set", 2);
}
}
}
else if(parsed[0]=="/newmap" and parsed.length()==5) {
int index=get_player_index(e.peer_id);
if(index>-1) {
if(players[index].dev==false and players[index].admin==false and players[index].builder==false) return;
string tempname=parsed[1];
if(file_exists("maps/"+tempname+".map")) {
send(players[index].peer_id, "this map already exists", 2);
return;
}
int maxx=string_to_number(parsed[2]);
int maxy=string_to_number(parsed[3]);
string surface=parsed[4];
string mdata="name "+tempname+"\r\nmaxx "+maxx+"\r\nmaxy "+maxy+"\r\nplatform 0 "+maxx+" 0 "+maxy+" 0 0 "+surface;
file_put_contents("maps/"+tempname+".map", mdata, 250);
send(players[index].peer_id, "Done", 2);
maps.insert_last(map_data(tempname));
int[] position={0, 0, 0};
changemap(index, get_map_index(tempname), position);
}
}
else if(parsed[0]=="/garbage")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
notify("Alert. "+players[index].name+" is getting the garbage, please hold...");
garbage_collect();
notify("Success. Garbage collected.");
}
}
else if(parsed[0]=="/profile")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
generate_profile("profile.log");
send(e.peer_id,get_file("profile.log"),2);
start_profiling();
}
}
else if(parsed[0]=="/play" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
