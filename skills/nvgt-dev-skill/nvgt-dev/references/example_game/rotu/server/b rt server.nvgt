return;
}
for(uint i=0; i<players.length(); i++)
{
if(players[i].channel==players[index].channel)send(players[i].peer_id,"play_s "+parsed[1]+".ogg",6);
}
}
}
else if(parsed[0]=="/play2" and parsed.length()>2)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
for(uint i=0; i<players.length(); i++)
{
if(players[i].channel==players[index].channel)send(players[i].peer_id,"play_s2 "+parsed[1]+".ogg "+parsed[2],6);
}
}
}
else if(parsed[0]=="/playsvr")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
string[] lst=find_files("sounds/*.ogg");
if(lst.length()<=0) {
send(players[index].peer_id, "No sounds found", 2);
return;
}
server_menu m;
m.initial_packet="playsvr";
m.intro=lst.length()+" sounds found. Select one";
for(uint i=0; i<lst.length(); i+=1) {
m.add(string_replace(lst[i], ".ogg", "", true)+", "+(i+1)+" of "+lst.length(), lst[i]);
}
m.send(players[index].peer_id);
}
}

else if(parsed[0]=="/packet" and parsed.length()>3)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
if(parsed[1]=="all")
{
int chan=stn(parsed[2]);
string mess=string_replace(get_event_message(),"/packet "+parsed[1]+" "+parsed[2]+" ","",true);
send(0,mess,chan);
}
else
{
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,"Player not found.",0);
return;
}
int chan=stn(parsed[2]);
string mess=string_replace(get_event_message(),"/packet "+parsed[1]+" "+parsed[2]+" ","",true);
send(players[index2].peer_id,mess,chan);
}
send(e.peer_id,"Packet sent.",0);
}
}
