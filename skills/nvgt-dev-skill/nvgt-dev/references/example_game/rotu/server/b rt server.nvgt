else if(parsed[0]=="/jail" and parsed.length()>3)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
string pname=parsed[1];
int mins=stn(parsed[2]);
string reason=string_replace(get_event_message(),"/jail "+parsed[1]+" "+parsed[2]+" ","",true);
int index2=get_player_index_from(pname);
if(index2<=-1)
{
send(e.peer_id,"Not found.",0);
return;
}
if(index2>-1)
{
if(players[index2].name==players[index].name)
{
send(e.peer_id,"Stop misusing your commands, "+players[index].name+"!",0);
admintell("Alert. "+players[index].name+" is misusing the following command: "+get_event_message(),true);
return;
}
if(players[index2].prisoner)
{
send(e.peer_id,"You can't jail a jailed player!",0);
return;
}
int[] newpos={5,5,0};
changemap(index2,get_map_index("jail"),newpos);
notify(players[index2].name+" was just sent to jail for "+mins+" minutes"+(mins>60?" ("+ms_to_readable_time((mins*60000))+")":"")+" for the following reason: "+reason);
players[index2].jailinfo=reason;
create_jail(players[index2].name,mins);
players[index2].prisoner=true;
players[index2].save_main();
players[index2].save();
}
}
}
else if(parsed[0]=="/unjail" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
string pname=parsed[1];
int index2=get_player_index_from(pname);
if(index2<=-1)
{
send(e.peer_id,"Not found.",0);
return;
}
if(index2>-1)
{
if(!players[index2].prisoner)
{
send(e.peer_id,"You can't unjail an unjailed player!",0);
return;
}
int[] newpos={222,434,0};
changemap(index2,get_map_index("main"),newpos);
unjail(players[index2].name,players[index].name);
players[index2].prisoner=false;
players[index2].jailinfo="";
players[index2].save_main();
players[index2].save();
}
}
}
else if(parsed[0]=="/jailinfo")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(parsed.length()>1)
{
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,"Not found.",0);
return;
}
if(index2>-1)
{
if(!players[index2].prisoner)
{
send(e.peer_id,"This player is not even in jail.",0);
return;
}
int jl=get_jail_index(players[index2].name);
send(e.peer_id,players[index2].name+" was jailed for the following reason: "+players[index2].jailinfo+" They have "+ms_to_readable_time(jails[jl].ms-jails[jl].jailtimer.elapsed)+" until they get out.",2);
}
}
if(parsed.length()<=1)
{
if(!players[index].prisoner)
{
send(e.peer_id,"You're not even in jail.",0);
return;
}
int jl=get_jail_index(players[index].name);
send(e.peer_id,"You were jailed for the following reason: "+players[index].jailinfo+" You've got "+ms_to_readable_time(jails[jl].ms-jails[jl].jailtimer.elapsed)+" until you get out.",2);
}
}
}
else if(parsed[0]=="/warn" and parsed.length()>3)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
string warnthem=parsed[1];
int lvl=stn(parsed[2]);
string reason=string_replace(get_event_message(),"/warn "+parsed[1]+" "+parsed[2]+" ","",true);
if(lvl>3 or lvl<0)
{
send(e.peer_id,"You can only warn between levels 1 and 3.",0);
return;
}
int w=get_player_index_from(warnthem);
if(w<=-1)
{
send(e.peer_id,"This player doesn't exist.",0);
return;
}
if(players[w].name==players[index].name)
{
send(e.peer_id,"Stop misusing your commands, "+players[index].name+"!",0);
admintell("Alert. "+players[index].name+" is misusing the following command: "+get_event_message(),true);
return;
}
send(e.peer_id,"Warning sent.",0);
send(players[w].peer_id,"play_s warn"+lvl+".ogg",6);
send(players[w].peer_id,"You have been given a warning by "+players[index].name+" at level "+lvl+"! It reads: "+reason,2);
admintell("Alert. "+players[index].name+" just gave "+players[w].name+" a warning at level "+lvl+", that reads: "+reason);
}
}
else if(parsed[0]=="/playerbackup")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
notify("Alert. A player backup has just been started by "+players[index].name+". Please wait, this may take a second.");
string[]pdirs=find_directories("players/*");
if(!directory_exists("players_backup")) directory_create("players_backup");
string backupdir=DATE_YEAR+"/"+DATE_MONTH+"/"+DATE_DAY+"/"+TIME_HOUR+"-"+TIME_MINUTE+"-"+TIME_SECOND;
if(!directory_exists("players_backup/"+backupdir)) directory_create("players_backup/"+backupdir);
for(uint i=0; i<pdirs.length(); i++)
{
netloop();
string[]pdirs2=find_files("players/"+pdirs[i]+"/*.*");
if(!directory_exists("players_backup/"+backupdir+"/"+pdirs[i])) directory_create("players_backup/"+backupdir+"/"+pdirs[i]);
for(uint i2=0; i2<pdirs2.length(); i2++)
{
file_copy("players/"+pdirs[i]+"/"+pdirs2[i2],"players_backup/"+backupdir+"/"+pdirs[i]+"/"+pdirs2[i2],true);
}

string[]pdirs3=find_directories("players/"+pdirs[i]+"/*");
for(uint i3=0; i3<pdirs3.length(); i3++)
{
string[]pdirs4=find_files("players/"+pdirs[i]+"/"+pdirs3[i3]+"/*.*");
if(!directory_exists("players_backup/"+backupdir+"/"+pdirs[i]+"/"+pdirs3[i3])) directory_create("players_backup/"+backupdir+"/"+pdirs[i]+"/"+pdirs3[i3]);
for(uint i4=0; i4<pdirs4.length(); i4++)
{
file_copy("players/"+pdirs[i]+"/"+pdirs3[i3]+"/"+pdirs4[i4],"players_backup/"+backupdir+"/"+pdirs[i]+"/"+pdirs3[i3]+"/"+pdirs4[i4],true);
}
}
}
notify("Complete. "+pdirs.length()+" players were backed up.");
}
}
else if(parsed[0]=="/serverclear")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
notify("Alert. "+players[index].name+" is clearing all undead, bullets, and items from the server. Please hold, this may cause lag.");
int undam=unds.length();
int objam=items.length();
int bulam=weapons.length();
weapons.resize(0);
unds.resize(0);
items.resize(0);
notify("Complete. "+undam+" undead, "+objam+" items, and "+bulam+" bullets were successfully cleared.");
}
}
else if(parsed[0]=="/spamkill")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
notify("Alert. "+players[index].name+" is performing a spam kill, please hold...");
kill_spam_players();
}
}
else if(parsed[0]=="/ascend")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].exp<150000)
{
send(e.peer_id,"You don't have enough experience to level up yet. You need "+(150000-players[index].exp)+" more experience.",0);
return;
}
players[index].lvl+=1;
notify(players[index].name+" has reached level "+players[index].lvl+"!");
players[index].exp=0;
players[index].default_health=players[index].lvl*5000;
players[index].health=players[index].default_health/2;
}
}
else if(parsed[0]=="/submit" and !eventitem.is_empty())
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].inv.get_item_amount(eventitem)<=0)
{
send(e.peer_id,"Sorry, but you don't have any "+eventitem+" to submit. Come back when you have more.",0);
return;
}
int ei=players[index].inv.get_item_amount(eventitem);
admintell("Alert! "+players[index].name+" has submitted their share of "+eventitem+"s. They obtained "+ei+" of them.");
send(e.peer_id,"Thank you. Your "+eventitem+"s were submitted.",2);
players[index].give(eventitem,-ei);
}
}
else if(parsed[0]=="/royale")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
if(royalestarted==true)
{
send(e.peer_id,"The royale has already begun. Please stop it first using the /royalestop command, this ensures that you actually want to force stop the battle.",0);
return;
}
if(royale==true)
{
stop_royale();
return;
}
if(royale==false)
{
send(0,"play_s important_notice.ogg",6);
send(0,players[index].name+" has enabled the battle royale event! To join, type /join_royale.",2);
royale=true;
return;
}
}
}
else if(parsed[0]=="/royalekick" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
bool is_success=remove_from_royale(parsed[1]);
if(is_success)
{
notify(parsed[1]+" was kicked from the royale by "+players[index].name+"'s command!");
}
else send(e.peer_id,"Error. Something went wrong. Either this person is not in the royale, or another error occurred.",0);
}
}
else if(parsed[0]=="/royaleplayers")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(royale==false or royale_participants.length()==0) return;
int connected=0;
string[]royalelist;
for(uint i=0; i<royale_participants.length(); i++)
{
royalelist.insert_last(royale_participants[i]+(get_player_index_from(royale_participants[i])>-1?" (online)":""));
if(get_player_index_from(royale_participants[i])>-1) connected++;
}
send(e.peer_id,"There are "+royalelist.length()+" players in the royale, and "+connected+" are online, leaving "+(royalelist.length()-connected)+" players disconnected. They are: "+lister(royalelist)+".",0);
}
}

else if(parsed[0]=="/join_royale")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(royale_participants.find(players[index].name)>-1)
{
send(e.peer_id,"You are already in the royale. To leave, type /leave_royale.",0);
return;
}
if(royalestarted==true)
{
send(e.peer_id,"The royale is already in progress.",0);
return;
}
if(royale==false)
{
send(e.peer_id,"The royale isn't even enabled.",0);
return;
}
if(players[index].exp>0)
{
send(e.peer_id,"You need to use an alternate character to join the royale, preferably one with no items, or armor.",0);
return;
}
bool success=add_to_royale(players[index].name);
if(!success)
{
send(e.peer_id,"Something went wrong. Please try again later.",0);
return;
}
}
}
else if(parsed[0]=="/leave_royale")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(royale_participants.find(players[index].name)<=-1)
{
send(e.peer_id,"You are not even in the royale. To leave, type /leave_royale.",0);
return;
}
if(royale==false)
{
send(e.peer_id,"The royale isn't even enabled.",0);
return;
}
bool success=remove_from_royale(players[index].name);
if(!success)
{
send(e.peer_id,"Something went wrong. Please try again later.",0);
return;
}
}
}
else if(parsed[0]=="/royalestop")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
if(royalestarted==false)
{
send(e.peer_id,"This command only needs to be used if the royale is actually in progress, not if it is still waiting for players. In this case, you can just use the /royale command again to disable it.",0);
return;
}
stop_royale();
}
}
else if(parsed[0]=="/royalestart")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
if(royale_participants.length()<=1)
{
send(e.peer_id,"There needs to be more players.",0);
return;
}
if(royale==false)
{
send(e.peer_id,"Enable the royale first.",0);
return;
}
start_royale();
}
}
else if(parsed[0]=="/notify" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
string mess=string_trim_left(get_event_message(),8);
notify(mess);
admintell("This notification was sent by "+players[index].name+".");
}
}
else if(parsed[0]=="/items")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
server_menu m;
m.intro="Items list";
m.initial_packet="itemsthing";
for(uint i=0; i<items.length(); i++)
{
m.add(items[i].type+", at "+items[i].x+", "+items[i].y+", "+items[i].z,i);
}
m.send(players[index].peer_id);
}
}
else if(parsed[0]=="/devshield")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
players[index].devshield=players[index].devshield?false:true;
send(e.peer_id,"Shield "+(players[index].devshield?"on":"off"),0);
}
}
else if(parsed[0]=="/exit" and players[index].dev)
{
notify("server is shuttingdown");
for(uint i=0; i<players.length(); i++)
{
players[i].save_main();
players[i].save();
}
send(0,"exit_srv",0);
wait(1000);
addprefs();
exit();
}
else if(parsed[0]=="/reboot" and players[index].dev)
{
notify("server rebooting");
for(uint i=0; i<players.length(); i++)
{
players[i].save_main();
players[i].save();
}
send(0,"reboot",0);
wait(1000);
addprefs();
run("b rt server.exe","",false,false);
exit();
}
else if(parsed[0]=="/update")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
notify("The server will reboot for an update in 10 seconds.");
updtimer.restart();
upding=true;
for(uint i=0; i<players.length(); i+=1) {
netloop();
players[i].save_main();
}
}
}
else if(parsed[0]=="/tempban" and parsed.length()>2)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
string banname=parsed[1];
int banmins=stn(parsed[2]);
int index2=get_player_index_from(banname);
if(index2<=-1)
{
send(e.peer_id,"Player not found.",0);
return;
}
if(players[index2].dev) {
send(players[index2].peer_id, "play_s admintell.ogg", 0);
send(players[index2].peer_id, "alert: "+players[index].name+" has attempted to ban you", 0);
send(players[index].peer_id, "You can't do that", 0);
return;
}
create_temp_ban(players[index2].name,banmins);
p_notify("temp ban alert", players[index2].name+" was just banned by "+players[index].name+" for "+banmins+" minutes "+(banmins>60?" ("+ms_to_readable_time((banmins*60000))+") ":"")+"!");
notify(players[index2].name+" was just banned by "+players[index].name+" for "+banmins+" minutes "+(banmins>60?" ("+ms_to_readable_time((banmins*60000))+") ":"")+"!");
send(players[index2].peer_id,"exitclient",0);
@players[index2]=null;
players.remove_at(index2);
return;
}
}
else if(parsed[0]=="/untempban" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
string banname=parsed[1];
if(directory_exists("players/"+banname)==false)
{
send(e.peer_id,"Player not found.",0);
return;
}
untempban(banname,players[index].name);
}
}
else if(parsed[0]=="/ban2" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
if(players[index].mod==true)
{
send(e.peer_id,"Moderators are not allowed to use this command.",0);
return;
}
string banname=parsed[1];
if(banname==players[index].name)
{
send(e.peer_id,"Stop misusing your commands, "+players[index].name+"!",0);
admintell("Alert. "+players[index].name+" is misusing the following command: "+get_event_message(),true);
return;
}
if(!directory_exists("players/"+banname))
{
send(e.peer_id,"This player does not exist in the database.",0);
return;
}
if(!file_exists("players/"+banname+"/banid.dat"))
{
send(e.peer_id,"This player does not have a computer ID file in their directory.",0);
return;
}
file f;
f.open("players/"+banname+"/banid.dat","rb");
string banid=f.read();
f.close();
compban_offline(banname,banid);
send(e.peer_id,"Success",0);
admintell("Alert. "+players[index].name+" has just issued an offline ban on the player "+banname+", with the following computer ID: "+banid);
p_notify("offline ban Alert", players[index].name+" has just issued an offline ban on the player "+banname+", with the following computer ID: "+banid);
}
}
else if(parsed[0]=="/bans")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
send(e.peer_id,get_comp_bans(),2);
}
}
else if(parsed[0]=="kick" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string reason=string_trim_left(get_event_message(),5);
kick(index,reason);
}
}
else if(parsed[0]=="/giveall" and parsed.length()==3) {
string itemname=parsed[1];
int itemamount=stn(parsed[2]);
if(players[index].dev==false and players[index].mod==false and players[index].admin==false) return;
for(uint i=0; i<players.length(); i+=1) {
players[i].give(itemname, itemamount);
}
send(players[index].peer_id, "Done", 0);
notify("alert: "+players[index].name+" has just given "+itemamount+" "+(itemamount==1?itemname:itemname+"s")+" to everyone!");
}
else if(parsed[0]=="/get_email" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin and !players[index].mod) return;
string target=parsed[1];
string pdir="players/"+target;
if(!directory_exists(pdir))
{
send(e.peer_id,"This player does not exist in the database.",1);
return;
}
string email="No email listed.";
if(file_exists(pdir+"/email.dat"))
{
file ef;
ef.open(pdir+"/email.dat","rb");
email=ef.read();
ef.close();
if(email=="") email="Empty email file.";
}
send(e.peer_id,"The email for "+target+" is: "+email,1);
}
}
else if(parsed[0]=="/kick" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,parsed[1]+" does not exist or is not online.",0);
return;
}
if(players[index2].name==players[index].name)
{
send(e.peer_id,"Stop misusing your commands, "+players[index].name+"!",0);
admintell("Alert. "+players[index].name+" is misusing the following command: "+get_event_message(),true);
return;
}
p_notify("kick alert", players[index].name+" has kicked "+players[index2].name+" from the server");
kick(index2,players[index].name+"!");
}
}
else if(parsed[0]=="/ban" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
if(players[index].mod==true)
{
send(e.peer_id,"Moderators are not allowed to use this command.",0);
return;
}
int index2=get_player_index_from(parsed[1]);
if(index2<=-1)
{
send(e.peer_id,"This player cannot be found.",0);
return;
}
if(players[index2].name==players[index].name)
{
send(e.peer_id,"Stop misusing your commands, "+players[index].name+"!",0);
admintell("Alert. "+players[index].name+" is misusing the following command: "+get_event_message(),true);
p_notify("command abuse", players[index].name+" is misusing the following command: "+get_event_message());
return;
}
if(devlist.find(players[index2].name)>-1)
{
send(e.peer_id,"You cannot ban a developer.",0);
return;
}
bool success=comp_ban(index2);
if(!success)
{
send(e.peer_id,"There was an error while trying to ban this user. Please try again later.",0);
return;
}
if(success)
{
p_notify("ban alert", players[index].name+" has just banned "+players[index2].name+" from the server.");
notify(players[index].name+" has just banned "+players[index2].name+" from the server.","ban.ogg");
send(players[index2].peer_id,"exitclient",0);
return;
}
}
}
else if(parsed[0]=="/unban" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and !players[index].admin) return;
if(players[index].mod==true)
{
send(e.peer_id,"Moderators are not allowed to use this command.",0);
return;
}
bool success=comp_unban(parsed[1]);
if(!success)
{
send(e.peer_id,"Player not found",0);
return;
}
if(success)
{
send(e.peer_id,"Player successfully unbanned.",0);
notify(players[index].name+" has just unbanned "+parsed[1]+".");
}
}
}
else if(parsed[0]=="/addmotd")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
string oldmotd=motd;
string nmotd=string_trim_left(get_event_message(),9);
motd=nmotd+"\r\n"+oldmotd;
send(0,"play_s newmotd.ogg",6);
send(0,"The Server Message has been editted: "+motd,2);
addprefs();
}
}
else if(parsed[0]=="/setmotd")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false and players[index].admin==false) return;
motd=string_trim_left(get_event_message(),9);
send(0,"play_s newmotd.ogg",6);
send(0,"The Server Message has been changed to: "+motd,2);
addprefs();
}
}
else send(e.peer_id,"Sorry, "+parsed[0]+" doesn't seem to exist yet. If you would like to recommend "+parsed[0]+" to the developer, use /feedback.",0);
}
}
if(e.channel==3)
{
string[]parsed=string_split(get_event_message()," ",true);
int index=get_player_index(e.peer_id);
if(index>-1)
{
players[index].afktimer.restart();
if(players[index].afk)
{
send(0,players[index].name+" is no longer AFK.",2);
players[index].afk=false;
}
if(parsed[0]=="move" and parsed.length()>3)
{
if(index<0) return;
players[index].x=stn(parsed[1]);
players[index].y=stn(parsed[2]);
players[index].z=stn(parsed[3]);
if(!players[index].gt().is_empty())
{
send_nearby_unreliablen(players[index].peer_id, "step "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].name+" "+players[index].map,3,30,players[index].x,players[index].y,players[index].z,players[index].map);
}
}
else if(parsed[0]=="move_to" and parsed.length()>3)
{
players[index].x=stn(parsed[1]);
players[index].y=stn(parsed[2]);
players[index].z=stn(parsed[3]);
}
else if(parsed[0]=="hazard" and parsed.length()==2) {
players[index].hitby="a "+parsed[1]+" hazard";
players[index].health=-1;
}
else if(parsed[0]=="i_landed")
{
send_nearby_reliable("land "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].name+" "+players[index].map,3,30,players[index].x,players[index].y,players[index].z,players[index].map);
}
else if(parsed[0]=="i_fell" and parsed.length()>1)
{
int dmg=stn(parsed[1]);
players[index].hitby="the miraculous works of gravity.";
players[index].health-=dmg*20;
send_nearby_reliable("fall "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].name+" "+players[index].map,3,30,players[index].x,players[index].y,players[index].z,players[index].map);
}
}
}
if(e.channel==0)
{
string[]parsed=string_split(get_event_message()," ",true);
if(parsed[0]=="login" and parsed.length()>=5)
{
login(parsed[1],parsed[2],e.peer_id,parsed[3],parsed[4]);
}
else if(parsed[0]=="hide_me")
{
int index=get_player_index(e.peer_id);
if(index>-1) players[index].hidden=true;
}
else if(parsed[0]=="speak" and parsed.length()>1)
{
send(0,string_trim_left(get_event_message(),5),0);
}
else if(parsed[0]=="createplayer" and parsed.length()>4)
{
create_player(parsed[1],parsed[2],parsed[3],e.peer_id,parsed[4]);
}
else if(parsed[0]=="update_email" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string email=parsed[1];
string pdir="players/"+players[index].name;
file ef;
ef.open(pdir+"/email.dat","wb");
ef.write(email);
ef.close();
send(e.peer_id,"char_wait",0);
log_entry("onoffs",players[index].name+" logged in after updating email.");
player_event(players[index].name+" just came online.","online.ogg",index);
cons+=1;
login_continue(index);
}
}
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(string_left(parsed[0], 5) == "gang_")
{
handle_gang_packets(index, parsed, get_event_message(), e.peer_id);
return;
}
players[index].afktimer.restart();
if(players[index].afk)
{
send(0,players[index].name+" is no longer AFK.",2);
players[index].afk=false;
}
else if(parsed[0]=="genderset" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1]=="")
{
if(players[index].gender=="") gendermenu(players[index].peer_id);
else send(players[index].peer_id,"Canceled.",0);
return;
}
players[index].gender=parsed[1];
send(players[index].peer_id,"Gender set.",0);
}
else if(parsed[0]=="switch_char")
{
players[index].save_main();
players[index].save();
players[index].char="";
player_event(players[index].name+" is switching characters.","offline.ogg");
charmenu(players[index].peer_id);
}
else if(parsed[0]=="char_option" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1]=="")
{
send(players[index].peer_id,"dlgblock Canceled. Connection now closing...",0);
}

else if(parsed[1]!="" and parsed[1]!="back" and parsed[1]!="createchar")
{
players[index].load_char(parsed[1]);
player_event(players[index].name+" has logged in as "+players[index].char+".","charon.ogg");
send(players[index].peer_id,"loggedin",0);
send(players[index].peer_id,"newb_status "+players[index].newb,0);
send(players[index].peer_id,"gang_myname "+players[index].gang,0);
int[] my_position={players[index].x,players[index].y,players[index].z};
changemap(index,get_map_index(players[index].mymap.name),my_position);
if(royale_participants.find(players[index].name)>-1) 
{
@players[index].inv=players[index].inventories[1];
players[index].inv.id=players[index].peer_id;
}
players[index].cachedinv=players[index].inv.serialize_inv();
if(!players[index].cachedinv.is_empty()) {
send(players[index].peer_id, "invis "+players[index].cachedinv, 0);
}
send(players[index].peer_id, "iampaid "+players[index].paid, 0);
if(players[index].gender=="") gendermenu(players[index].peer_id);
}
else if(parsed[1]=="createchar")
{
players[index].char="";
string pckt="edit_box **title=Enter the name of your character.**answer=create_char**answer_channel=0";
send(players[index].peer_id,pckt,0);
}
/*
else if(parsed[1]=="removechar")
{
players[index].char="";
delcharmenu(index);
}
*/
}
else if(parsed[0]=="create_char" and parsed.length()>1)
{
bool verify=true;
if(parsed[1]=="back" or parsed[1]=="") verify=false;
string cname=string_trim_left(get_event_message(),12);
if(string_contains(cname," ",1)>-1)
{
send(players[index].peer_id,"Your name cannot contain spaces.",0);
verify=false;
}
if(cname.length()<3)
{
send(players[index].peer_id,"Your name cannot be less than 3 characters long.",0);
verify=false;
}
if(cname.length()>15)
{
send(players[index].peer_id,"Your name cannot be more than 15 characters long.",0);
verify=false;
}
if(players[index].get_char_amount()>9)
{
send(players[index].peer_id,"You can only have up to 10 characters on one account.",0);
verify=false;
}
if(players[index].char_exists(cname))
{
send(players[index].peer_id,"A character with this name already exists.",0);
verify=false;
}
if(!verify) send(players[index].peer_id,"exitclient",0);
if(verify)
{
players[index].create_char(cname);
send(players[index].peer_id,"Character created.",0);
charmenu(players[index].peer_id);
}
}
else if(parsed[0]=="location" and parsed.length()>1)
{
string loc=string_trim_left(get_event_message(),9);
players[index].location=loc;
}
else if(parsed[0]=="ping")
{
send(players[index].peer_id,"pong",0);
}
else if(parsed[0]=="request_staff_control")
{
string dev_s = players[index].dev ? "true" : "false";
string admin_s = players[index].admin ? "true" : "false";
string mod_s = players[index].mod ? "true" : "false";
string builder_s = players[index].builder ? "true" : "false";
if(players[index].dev || players[index].admin || players[index].mod || players[index].builder)
{
send(players[index].peer_id, "staff_control_init " + dev_s + " " + admin_s + " " + mod_s + " " + builder_s, 0);
}
else
{
send(players[index].peer_id, "staff_control_denied", 0);
}
}
else if(parsed[0]=="store_req_list")
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "store_action_failed Access denied.", 0);
}
else if(!file_exists("store.dat"))
{
send(players[index].peer_id, "store_action_failed store.dat does not exist.", 0);
}
else
{
string content = get_file("store.dat");
content = string_replace(content, "\r\n", "|", true);
content = string_replace(content, "\n", "|", true);
send(players[index].peer_id, "store_res_list " + content, 0);
}
}
else if(parsed[0]=="store_add" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "store_action_failed Access denied.", 0);
}
else
{
string item_data_raw = string_trim_left(get_event_message(), 10);
string[] itm = string_split(item_data_raw, ":", false);
if(itm.length() < 4)
{
send(players[index].peer_id, "store_action_failed Invalid data format.", 0);
}
else
{
string name = itm[0];
string price = itm[1];
string desc = itm[2];
string level = itm[3];
string limit = (itm.length() >= 5) ? itm[4] : "";
string content = get_file("store.dat");
string new_line = name + ":" + price + ":" + desc + ":" + level;
if(limit == "*") new_line += ":*";
if(content != "")
{
if(content.substr(content.length() - 2) == "\r\n") content += new_line + "\r\n";
else if(content.substr(content.length() - 1) == "\n") content += new_line + "\n";
else content += "\r\n" + new_line + "\r\n";
}
else
{
content = new_line + "\r\n";
}
file f;
if(f.open("store.dat", "wb"))
{
f.write(content);
f.close();
string cat = "Medical Items";
string name_lower = string_to_lower_case(name);
if(string_contains(name_lower, "rifle", 1) >= 0 || string_contains(name_lower, "shotgun", 1) >= 0 || string_contains(name_lower, "gun", 1) >= 0 || string_contains(name_lower, "saber", 1) >= 0 || string_contains(name_lower, "grenade", 1) >= 0 || string_contains(name_lower, "axe", 1) >= 0 || string_contains(name_lower, "launcher", 1) >= 0)
{
cat = "Weapons";
}
else if(string_contains(name_lower, "ammo", 1) >= 0)
{
cat = "Ammo";
}
else if(string_contains(name_lower, "helmet", 1) >= 0 || string_contains(name_lower, "armor", 1) >= 0 || string_contains(name_lower, "leggings", 1) >= 0 || string_contains(name_lower, "boots", 1) >= 0 || string_contains(name_lower, "shoulder", 1) >= 0 || string_contains(name_lower, "sneakers", 1) >= 0 || string_contains(name_lower, "jeans", 1) >= 0 || string_contains(name_lower, "shirt", 1) >= 0 || string_contains(name_lower, "cap", 1) >= 0 || string_contains(name_lower, "jacket", 1) >= 0)
{
cat = "Armor and Clothing";
}
else if(string_contains(name_lower, "mpad", 1) >= 0 || string_contains(name_lower, "watch", 1) >= 0)
{
cat = "Technology";
}
else if(string_contains(name_lower, "saturn", 1) >= 0 || string_contains(name_lower, "car", 1) >= 0)
{
cat = "Vehicles";
}
string cat_content = get_file("item_categories.dat");
if(string_contains(cat_content, name + "=", 1) == -1)
{
string cat_line = name + "=" + cat;
if(cat_content != "")
{
if(cat_content.substr(cat_content.length() - 2) == "\r\n") cat_content += cat_line + "\r\n";
else if(cat_content.substr(cat_content.length() - 1) == "\n") cat_content += cat_line + "\n";
else cat_content += "\r\n" + cat_line + "\r\n";
}
else
{
cat_content = cat_line + "\r\n";
}
file f_cat;
if(f_cat.open("item_categories.dat", "wb"))
{
f_cat.write(cat_content);
f_cat.close();
}
}
send(players[index].peer_id, "store_action_success Item added successfully!", 0);
}
else
{
send(players[index].peer_id, "store_action_failed Failed to write to store.dat.", 0);
}
}
}
}
else if(parsed[0]=="store_edit" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "store_action_failed Access denied.", 0);
}
else
{
string raw_msg = string_trim_left(get_event_message(), 11);
string[] edit_parts = string_split(raw_msg, "|", false);
if(edit_parts.length() < 2)
{
send(players[index].peer_id, "store_action_failed Invalid data format.", 0);
}
else
{
string old_name = edit_parts[0];
string[] itm = string_split(edit_parts[1], ":", false);
if(itm.length() < 4)
{
send(players[index].peer_id, "store_action_failed Invalid edit data format.", 0);
}
else
{
string name = itm[0];
string price = itm[1];
string desc = itm[2];
string level = itm[3];
string limit = (itm.length() >= 5) ? itm[4] : "";
string[] lines = string_split(get_file("store.dat"), "\r\n", false);
bool found = false;
for(uint i=0; i<lines.length(); i++)
{
if(lines[i] == "") continue;
string[] fields = string_split(lines[i], ":", false);
if(fields[0] == old_name)
{
string new_line = name + ":" + price + ":" + desc + ":" + level;
if(limit == "*") new_line += ":*";
lines[i] = new_line;
found = true;
break;
}
}
if(!found)
{
send(players[index].peer_id, "store_action_failed Item not found in store.dat.", 0);
}
else
{
string content = "";
for(uint i=0; i<lines.length(); i++)
{
if(lines[i] != "") content += lines[i] + "\r\n";
}
file f;
if(f.open("store.dat", "wb"))
{
f.write(content);
f.close();
if(old_name != name)
{
string[] cat_lines = string_split(get_file("item_categories.dat"), "\r\n", false);
for(uint i=0; i<cat_lines.length(); i++)
{
if(cat_lines[i] == "") continue;
string[] parts = string_split(cat_lines[i], "=", false);
if(parts[0] == old_name)
{
cat_lines[i] = name + "=" + (parts.length() >= 2 ? parts[1] : "Medical Items");
break;
}
}
string cat_content = "";
for(uint i=0; i<cat_lines.length(); i++)
{
if(cat_lines[i] != "") cat_content += cat_lines[i] + "\r\n";
}
file f_cat;
if(f_cat.open("item_categories.dat", "wb"))
{
f_cat.write(cat_content);
f_cat.close();
}
}
send(players[index].peer_id, "store_action_success Item updated successfully!", 0);
}
else
{
send(players[index].peer_id, "store_action_failed Failed to write to store.dat.", 0);
}
}
}
}
}
}
else if(parsed[0]=="store_delete" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "store_action_failed Access denied.", 0);
}
else
{
string name = string_trim_left(get_event_message(), 13);
string[] lines = string_split(get_file("store.dat"), "\r\n", false);
bool found = false;
string content = "";
for(uint i=0; i<lines.length(); i++)
{
if(lines[i] == "") continue;
string[] fields = string_split(lines[i], ":", false);
if(fields[0] == name)
{
found = true;
continue;
}
content += lines[i] + "\r\n";
}
if(!found)
{
send(players[index].peer_id, "store_action_failed Item not found in store.dat.", 0);
}
else
{
file f;
if(f.open("store.dat", "wb"))
{
f.write(content);
f.close();
string[] cat_lines = string_split(get_file("item_categories.dat"), "\r\n", false);
string cat_content = "";
for(uint i=0; i<cat_lines.length(); i++)
{
if(cat_lines[i] == "") continue;
string[] parts = string_split(cat_lines[i], "=", false);
if(parts[0] == name)
{
continue;
}
cat_content += cat_lines[i] + "\r\n";
}
file f_cat;
if(f_cat.open("item_categories.dat", "wb"))
{
f_cat.write(cat_content);
f_cat.close();
}
send(players[index].peer_id, "store_action_success Item deleted successfully!", 0);
}
else
{
send(players[index].peer_id, "store_action_failed Failed to write to store.dat.", 0);
}
}
}
}
else if(parsed[0]=="player_req_info" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string target_name = parsed[1];
int t_idx = get_player_index_from(target_name);
if(t_idx == -1)
{
send(players[index].peer_id, "staff_action_failed Player is offline.", 0);
}
else
{
string username_s = players[t_idx].name;
string lvl_s = "" + players[t_idx].lvl;
string exp_s = "" + players[t_idx].exp;
string gold_s = "" + players[t_idx].inv.get_item_amount("gold");
string hp_s = "" + players[t_idx].health;
string map_s = players[t_idx].map;
string x_s = "" + round(players[t_idx].x, 0);
string y_s = "" + round(players[t_idx].y, 0);
string z_s = "" + round(players[t_idx].z, 0);
string ip_s = n.get_peer_address(players[t_idx].peer_id);
string comp_s = players[t_idx].banid;
send(players[index].peer_id, "player_res_info " + username_s + "|" + lvl_s + "|" + exp_s + "|" + gold_s + "|" + hp_s + "|" + map_s + "|" + x_s + "|" + y_s + "|" + z_s + "|" + ip_s + "|" + comp_s, 0);
}
}
}
else if(parsed[0]=="player_update_stat" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string raw_msg = string_trim_left(get_event_message(), 19);
string[] parts = string_split(raw_msg, "|", false);
if(parts.length() < 3)
{
send(players[index].peer_id, "staff_action_failed Invalid data.", 0);
}
else
{
string target_name = parts[0];
string field = parts[1];
int value = stn(parts[2]);
int t_idx = get_player_index_from(target_name);
if(t_idx == -1)
{
send(players[index].peer_id, "staff_action_failed Player is offline.", 0);
}
else
{
if(field == "lvl")
{
players[t_idx].lvl = value;
send(players[t_idx].peer_id, "Your level has been updated to " + value + " by staff.", 2);
}
else if(field == "xp")
{
players[t_idx].exp = value;
players[t_idx].exprank = identify_rank(value, players[t_idx].gender);
send(players[t_idx].peer_id, "Your experience has been updated to " + value + " by staff.", 2);
}
else if(field == "gold")
{
int current_gold = players[t_idx].inv.get_item_amount("gold");
players[t_idx].give("gold", value - current_gold);
}
else if(field == "hp")
{
players[t_idx].health = value;
send(players[t_idx].peer_id, "Your health has been updated to " + value + " by staff.", 2);
}
players[t_idx].save();
send(players[index].peer_id, "staff_action_success Stats updated successfully!", 0);
}
}
}
}
else if(parsed[0]=="player_req_inv" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string target_name = parsed[1];
int t_idx = get_player_index_from(target_name);
if(t_idx == -1)
{
send(players[index].peer_id, "staff_action_failed Player is offline.", 0);
}
else
{
string inv_str = players[t_idx].inv.serialize_inv();
send(players[index].peer_id, "player_res_inv " + target_name + "|" + inv_str, 0);
}
}
}
else if(parsed[0]=="player_update_inv" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string raw_msg = string_trim_left(get_event_message(), 18);
string[] parts = string_split(raw_msg, "|", false);
if(parts.length() < 3)
{
send(players[index].peer_id, "staff_action_failed Invalid data.", 0);
}
else
{
string target_name = parts[0];
string item_name = parts[1];
int amount = stn(parts[2]);
int t_idx = get_player_index_from(target_name);
if(t_idx == -1)
{
send(players[index].peer_id, "staff_action_failed Player is offline.", 0);
}
else
{
int current_amount = players[t_idx].inv.get_item_amount(item_name);
players[t_idx].give(item_name, amount - current_amount);
players[t_idx].save();
send(players[index].peer_id, "staff_action_success Inventory updated successfully!", 0);
}
}
}
}
else if(parsed[0]=="svr_req_stats")
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string uptime_s = ms_to_readable_time(uptimer.elapsed);
string peak_s = "" + peak;
string undead_s = "" + unds.length();
string players_s = "" + players.length();
string cons_s = "" + cons;
string discons_s = "" + discons;
string rcv_s = convert_size(n.bytes_received);
string snt_s = convert_size(n.bytes_sent);
send(players[index].peer_id, "svr_res_stats " + uptime_s + "|" + peak_s + "|" + undead_s + "|" + players_s + "|" + cons_s + "|" + discons_s + "|" + rcv_s + "|" + snt_s, 0);
}
}
else if(parsed[0]=="svr_req_banlist")
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string[] ip_keys = ipbans.get_keys();
string[] comp_keys = compbans.get_keys();
string ips = string_join(ip_keys, ",");
string comps = string_join(comp_keys, ",");
send(players[index].peer_id, "svr_res_banlist " + ips + "|" + comps, 0);
}
}
else if(parsed[0]=="svr_unban_ip" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string ip = parsed[1];
if(ipbans.exists(ip))
{
ipbans.delete(ip);
file f;
f.open("ipbans.dat", "wb");
f.write(serialize(ipbans));
f.close();
send(players[index].peer_id, "staff_action_success IP " + ip + " has been unbanned.", 0);
}
else
{
send(players[index].peer_id, "staff_action_failed IP not found in ban list.", 0);
}
}
}
else if(parsed[0]=="svr_unban_comp" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string comp = parsed[1];
if(compbans.exists(comp))
{
compbans.delete(comp);
file f;
f.open("compbans.dat", "wb");
f.write(serialize(compbans));
f.close();
send(players[index].peer_id, "staff_action_success Computer ID " + comp + " has been unbanned.", 0);
}
else
{
send(players[index].peer_id, "staff_action_failed Computer ID not found in ban list.", 0);
}
}
}
else if(parsed[0]=="staff_toggle_invis")
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
players[index].hidden = !players[index].hidden;
string state = players[index].hidden ? "1" : "0";
send(players[index].peer_id, "staff_invis_state " + state, 0);
if(players[index].hidden)
{
send(players[index].peer_id, "You are now invisible to other players and undead.", 2);
}
else
{
send(players[index].peer_id, "You are now visible to other players and undead.", 2);
}
}
}
else if(parsed[0]=="staff_set_weather" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string type = parsed[1];
if(type == "rain")
{
start_raining();
send(players[index].peer_id, "staff_action_success Weather set to rain.", 0);
}
else if(type == "clear")
{
stop_raining();
send(players[index].peer_id, "staff_action_success Weather set to clear.", 0);
}
}
}
else if(parsed[0]=="staff_spawn_undead" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string raw_msg = string_trim_left(get_event_message(), 19);
string[] parts = string_split(raw_msg, "|", false);
if(parts.length() < 3)
{
send(players[index].peer_id, "staff_action_failed Invalid data.", 0);
}
else
{
string type = parts[0];
int hp = stn(parts[1]);
int speed = stn(parts[2]);
double x = players[index].x;
double y = players[index].y;
double z = players[index].z;
string map = players[index].map;
undead_appear(x, y, z, type, map);
if(unds.length() > 0)
{
unds[unds.length() - 1].health = hp;
unds[unds.length() - 1].speed = speed;
}
send(players[index].peer_id, "staff_action_success Spawned " + type + " successfully!", 0);
}
}
}
else if(parsed[0]=="ticket_req_list")
{
if(!players[index].dev && !players[index].admin && !players[index].mod)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
string ticket_data = "";
for(uint i=0; i<tickets.length(); i++)
{
string status = (tickets[i].claimed_by == "") ? "Open" : "Claimed by " + tickets[i].claimed_by;
ticket_data += tickets[i].id + ":" + tickets[i].username + ":" + tickets[i].message + ":" + status + "|";
}
send(players[index].peer_id, "ticket_res_list " + ticket_data, 0);
}
}
else if(parsed[0]=="ticket_claim" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin && !players[index].mod)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
int t_id = stn(parsed[1]);
bool found = false;
for(uint i=0; i<tickets.length(); i++)
{
if(tickets[i].id == t_id)
{
tickets[i].claimed_by = players[index].name;
found = true;
int t_user_idx = get_player_index_from(tickets[i].username);
if(t_user_idx > -1)
{
send(players[t_user_idx].peer_id, "Staff member " + players[index].name + " has claimed your ticket and is reviewing it.", 2);
}
send(players[index].peer_id, "staff_action_success Ticket " + t_id + " claimed.", 0);
break;
}
}
if(!found)
{
send(players[index].peer_id, "staff_action_failed Ticket not found.", 0);
}
}
}
else if(parsed[0]=="ticket_close" and parsed.length()>1)
{
if(!players[index].dev && !players[index].admin && !players[index].mod)
{
send(players[index].peer_id, "staff_action_failed Access denied.", 0);
}
else
{
int t_id = stn(parsed[1]);
bool found = false;
for(uint i=0; i<tickets.length(); i++)
{
if(tickets[i].id == t_id)
{
int t_user_idx = get_player_index_from(tickets[i].username);
if(t_user_idx > -1)
{
send(players[t_user_idx].peer_id, "Your support ticket has been closed. Thank you!", 2);
}
tickets.remove_at(i);
found = true;
send(players[index].peer_id, "staff_action_success Ticket closed.", 0);
break;
}
}
if(!found)
{
send(players[index].peer_id, "staff_action_failed Ticket not found.", 0);
}
}
}
else if(parsed[0]=="stats")
{
string rcv=convert_size(n.bytes_received);
string snt=convert_size(n.bytes_sent);
send(players[index].peer_id,"The server has been up for "+ms_to_readable_time(uptimer.elapsed)+". Total recorded uptime: "+ms_to_readable_time(totaluptime)+". Server version: "+version+". Last updated: "+lastupdate+". Peak of "+peak+" players online at once! There are currently "+unds.length()+" undead animals roaming around on the server. "+cons+" connections, "+discons+" disconnections. Received: "+rcv+". Sent: "+snt+".",0);
}
else if(parsed[0]=="wtchanselect" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1].is_empty())
{
send(players[index].peer_id,"You swipe up from the bottom of the screen, and the app closes.",0);
return;
}
if(parsed[1]=="disable")
{
send(players[index].peer_id,"You turn off the walkie talkie completely, then close the app.",0);
players[index].mpadbattime=180000;
players[index].wtchannel=0;
return;
}
players[index].wtchannel=stn(parsed[1]);
send(players[index].peer_id,"The walkie talkie is now set to channel "+parsed[1]+". You let the app run in the background.",0);
players[index].mpadbattime=60000;
}
else if(parsed[0]=="chanselect" and parsed.length()>1)
{
if(parsed[1]=="back" or parsed[1].is_empty())
{
send(players[index].peer_id,"Canceled.",0);
return;
}
else if(parsed[1]=="disable")
{
players[index].channel="";
send(players[index].peer_id,"Chat disabled.",0);
return;
}
else
{
players[index].channel=parsed[1];
send(players[index].peer_id,"Channel set to "+parsed[1]+".",0);
}
}
