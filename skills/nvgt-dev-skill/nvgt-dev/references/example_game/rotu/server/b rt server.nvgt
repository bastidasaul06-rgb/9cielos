return;
}
if(descr.length()<15)
{
send(e.peer_id,"Your description must be more than 15 characters. Your description length was "+descr.length()+" characters.",0);
return;
}
players[index].chardescription=descr;
send(e.peer_id,"Description set.",0);
}
}
