return;
}
fbmenu(players[index].peer_id);
}
}
else if(parsed[0]=="/fbreply" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].dev==false) return;
int num=stn(parsed[1]);
string fbre=string_replace(get_event_message(),"/fbreply "+num+" ","",true);
string[]fbs=string_split(get_file("feedbacks.txt"),"\r\n",false);
if(num>fbs.length()-1)
{
send(e.peer_id,"This value is bigger than the feedback list.",0);
return;
}
fbs.insert_at((num+1),"Reply to #"+num+" from the developer: "+fbre);
file f;
f.open("feedbacks.txt","wb");
f.write(linear(fbs));
f.close();
send(e.peer_id,"Reply submitted.",0);
}
}
else if(parsed[0]=="/feedback" and parsed.length()>2)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string fbmess=string_trim_left(get_event_message(),10);
if(string_contains(fbmess,"\r\n",1)>-1)
{
send(e.peer_id,"You cannot insert new lines into feedback messages to prevent incorrect numbering.",0);
return;
}
file f;
if(file_exists("feedbacks.txt"))
{
f.open("feedbacks.txt","ab");
f.write(players[index].name+": "+fbmess+"\r\n");
f.close();
}
else
{
f.open("feedbacks.txt","wb");
f.write(players[index].name+": "+fbmess+"\r\n");
f.close();
}
admintell(players[index].name+" submitted feedback. If you would like to check it out, type /fblist.",true);
send(e.peer_id,"Success. Thank you.",0);
}
}
else if((parsed[0]=="/admintell" or parsed[0]=="/at") and parsed.length()>1)
{
