{
send(players[index].peer_id,"You're totally fine.",0);
take=false;
return;
}
if(players[index].nectartimer.elapsed<1000)
{
send(players[index].peer_id,"Whoa, chill out. You can't drink that fast.",0);
take=false;
return;
}
players[index].health+=(players[index].paid==1?random(500,1500):random(200, 650));
send(0,"play can_of_nectar.ogg "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].map,6);
players[index].nectartimer.restart();
}
if(used_item=="gold" or invweps.find(used_item)>-1 or string_contains(used_item,"_armor",1)>-1 or string_contains(used_item,"_flag",1)>-1) take=false;
if(take==true)
{
players[index].give(used_item,-1);
}
}
