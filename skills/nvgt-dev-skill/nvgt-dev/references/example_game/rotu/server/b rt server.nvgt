if(players[index].map=="main" and players[index].z==0 and players[index].x>214 and players[index].y>429 and players[index].y<446 and players[index].x<231)
{
szmenu(players[index].peer_id);
}
}
else if(parsed[0]=="checkmotd")
{
send(players[index].peer_id,"Server message: "+motd,2);
}
else if(parsed[0]=="checkmotd2")
{
smsboard(players[index].peer_id);
}
else if(parsed[0]=="toggle_events")
{
players[index].plevents=(players[index].plevents==1?0:1);
send(players[index].peer_id,"Player events "+(players[index].plevents==1?"enabled":"disabled"),2);
}
else if(parsed[0]=="togglebeacon")
{
players[index].beacon_on=players[index].beacon_on==1?0:1;
send(players[index].peer_id,"Beacons "+(players[index].beacon_on==1?"enabled":"disabled"),0);
}
else if(parsed[0]=="iamwearing")
{
string head=(players[index].head==""?"nothing":players[index].head);
string shoulders=(players[index].shoulders==""?"nothing":players[index].shoulders);
string feet=(players[index].feet==""?"nothing":players[index].feet);
string legs=(players[index].legs==""?"nothing":players[index].legs);
string chest=(players[index].chest==""?"nothing":players[index].chest);
string hands=(players[index].hands==""?"nothing":players[index].hands);
send(players[index].peer_id,"You are wearing "+feet+" on your feet, "+legs+" on your legs, "+chest+" on your chest, "+hands+" on your hands, "+shoulders+" on your shoulders, and "+head+" on your head.",0);
}
else if(parsed[0]=="who_is_near")
{
players[index].check_around_me();
}
else if(parsed[0]=="viewplayers")
{
if(players.length()==1)
{
send(players[index].peer_id,"You are the only one online.",0);
return;
}
playersmenu(players[index].peer_id);
}
else if(parsed[0]=="who_is_online")
{
string[] plist;
for(uint i=0; i<players.length(); i++)
{
plist.insert_last((players[i].paid==1?"*":"")+(players[i].afk?"AFK ":"")+(players[i].dev?"Developer ":"")+(!players[i].dev and players[i].admin?"Admin ":"")+players[i].exprank+" "+players[i].char+(players[i].char!=players[i].name?" ("+players[i].name+")":""));
}
if(plist.length()>1)
{
send(players[index].peer_id,"There are "+players.length()+" players online. They are: "+lister(plist),0);
}
else
{
send(players[index].peer_id,"You are the only one online.",0);
}
}
else if(parsed[0]=="leave")
{
//players[index].remove_from_events();
players[index].save_main();
players[index].save();
//send(0,"play_s offline.ogg",0);
log_entry("onoffs",players[index].name+" logged out.");
send(0,"remplayer "+players[index].name,0);
player_event(players[index].char+" logged out","charout.ogg");
player_event(players[index].name+" just went offline.","offline.ogg");
discons+=1;
@players[index]=null;
players.remove_at(index);
return;
}
else if(parsed[0]=="dir" and parsed.length()>1)
{
players[index].dir=stn(parsed[1]);
}
else if(parsed[0]=="cycle2" and parsed.length()>1)
{
int pos;
if(parsed[1]=="forward")
{
pos=categories.find(players[index].invcat);
if(pos<=-1) pos=0;
pos++;
if(pos>categories.length()-1) pos=0;
players[index].invcat=categories[pos];
send(players[index].peer_id,players[index].invcat+" ("+players[index].get_items_in_category(players[index].invcat)+" items)",0);
play2("invcat",players[index].x,players[index].y,players[index].z,players[index].map,index);
}
if(parsed[1]=="backward")
{
pos=categories.find(players[index].invcat);
if(pos<=-1) pos=0;
pos--;
if(pos<0) pos=categories.length()-1;
players[index].invcat=categories[pos];
send(players[index].peer_id,players[index].invcat+" ("+players[index].get_items_in_category(players[index].invcat)+" items)",0);
play2("invcat",players[index].x,players[index].y,players[index].z,players[index].map,index);
}
}
else if(parsed[0]=="cycle" and parsed.length()>1)
{
if(parsed[1]=="forward") players[index].inv.cycle();
if(parsed[1]=="backward") players[index].inv.cycle(0);
}
else if(parsed[0]=="checkexp")
{
send(players[index].peer_id,"You have "+players[index].exp+" experience, giving you the rank of "+players[index].exprank+(players[index].lvl>1?" level "+players[index].lvl+".":"."),0);
}
else if(parsed[0]=="health")
{
float myhp=players[index].health;
double percentage=round((myhp/players[index].default_health)*100,1);
send(players[index].peer_id,myhp+" out of "+players[index].default_health+" health, "+percentage+" percent."+(players[index].protection>0?" Since the first time you've been attacked, your armor has protected you by "+players[index].protection+" health.":""),0);
}
else if(parsed[0]=="ammocheck")
{
if(is_melee(players[index].weapon))
{
send(players[index].peer_id,"This is a melee weapon. Therefore, it doesn't hold any ammo.",0);
return;
}
if(players[index].weapon.is_empty())
{
send(players[index].peer_id,"Seems like you don't have a weapon drawn. Try drawing one first.",0);
return;
}
int checker=players[index].am.ammo_exists(players[index].weapon+"_ammo");
send(players[index].peer_id,players[index].get_current_ammo(players[index].weapon)+" out of "+get_max_ammo(players[index].weapon)+" ammo loaded. "+(checker<=0?"no":checker)+" ammo left in reserve.",0);
}
else if(parsed[0]=="travelto" and parsed.length()>4)
{
if(players[index].incar==true)
{
return;
}
double tpx=stn(parsed[1]);
double tpy=stn(parsed[2]);
double tpz=stn(parsed[3]);
int tpmap=get_map_index(parsed[4]);
if(tpmap==-1)
{
send(players[index].peer_id,"This map doesn't exist. We wouldn't want you falling into the void now would we?",0);
return;
}
int[]tppos={tpx,tpy,tpz};
changemap(index,tpmap,tppos);
if(parsed.length()>6) {
players[index].give(parsed[5], stn(parsed[6]));
send(players[index].peer_id, "Congratulations, you have received "+parsed[6]+" "+parsed[5]+"!", 2);
notify("alert: "+players[index].char+" has just earned "+parsed[6]+" "+parsed[5]+"!");
}
}
else if(parsed[0]=="reload")
{
string wn=players[index].weapon;
if(players[index].reloading==true)
{
return;
}
if(players[index].get_current_ammo(wn)==get_max_ammo(wn)) return;

if(is_melee(wn)==true)
{
send(players[index].peer_id,"This weapon doesn't take ammo",0);
return;
}
int amount=players[index].am.ammo_exists(wn+"_ammo");
if(amount<=0)
{
send(players[index].peer_id,"No ammo",0);
return;
}
int max=get_max_ammo(wn);
if(amount<=max)
{
max=amount;
}
if(players[index].get_current_ammo(wn)<max and amount>=max)
{
max=max-players[index].get_current_ammo(wn);
}
players[index].ammo_give(players[index].weapon,max);
if(players[index].get_current_ammo(players[index].weapon)>get_max_ammo(players[index].weapon))
{
players[index].loaded.set(players[index].weapon,get_max_ammo(players[index].weapon));
}
//players[index].reload(players[index].weapon,max);
//int subtract=0-max;
players[index].am.ammotake(wn+"_ammo",max);
play2(wn+"reload",players[index].x,players[index].y,players[index].z,players[index].map,index);
send(players[index].peer_id,"reloadtime "+get_reloadtime(wn),0);
}
else if(parsed[0]=="fire")
{
if(gamestopped) return;
if(players[index].incar) return;
if(players[index].weapon.is_empty())
{
send(players[index].peer_id,"I know how fun it would be to fire bullets out of your hands. But unfortunately, that's not how it works.",0);
return;
}
if(players[index].crouching==false and players[index].weapon=="barrett_sniper_rifle")
{
send(players[index].peer_id,"It's best to be crouched before trying to utilize a sniper.",0);
return;
}
if(players[index].safe())
{
return;
}
if(players[index].newb==1) {
send(players[index].peer_id, "You can't fire if you are a newbie. Type /newbie to turn this off", 0);
return;
}
string wname=players[index].weapon;
if(is_melee(wname)==false)
{
if(players[index].get_current_ammo(wname)<=0)
{
return;
}
}
if(players[index].reloading==true)
{
send(players[index].peer_id,"you must wait for your weapon to fully reload!",0);
return;
}
attract_undead(players[index].x, players[index].y, players[index].z, players[index].map);
play2(players[index].weapon,players[index].x,players[index].y,players[index].z,players[index].map,index);
spawn_weapon(players[index].x,players[index].y,players[index].z,wname,players[index].dir,players[index].name,players[index].map);
if(is_melee(wname)==false)
{
players[index].ammo_give(wname,-1);
}
}
else if(parsed[0]=="fire_second")
{
if(players[index].safe())
{
return;
}
if(exclude.find(players[index].weapon)>-1 and players[index].incar) return;
if(parsed.length()>1 and parsed[1]=="off") return;
if(players[index].weapon.is_empty())
{
send(players[index].peer_id,"I know how fun it would be to fire bullets out of your hands. But unfortunately, that's not how it works.",0);
return;
}
if(players[index].crouching==false and players[index].weapon=="barrett_sniper_rifle")
{
send(players[index].peer_id,"It's best to be crouched before trying to utilize a sniper.",0);
return;
}
string wname=players[index].weapon;
if(is_melee(wname)==false)
{
if(players[index].get_current_ammo(wname)<=0)
{
return;
}
}
if(players[index].reloading==true)
{
send(players[index].peer_id,"you must wait for your weapon to fully reload!",0);
return;
}
play2(players[index].weapon+"2",players[index].x,players[index].y,players[index].z,players[index].map,index);
spawn_weapon(players[index].x,players[index].y,players[index].z,wname+"2",players[index].dir,players[index].name,players[index].map);
if(is_melee(wname)==false)
{
if(parsed.length()>1) {
if(parsed[1]=="Burst")
{
players[index].ammo_give(wname,-3);
return;
}
else players[index].ammo_give(wname,-1);
}
}
}
else if(parsed[0]=="draw" and parsed.length()>1)
{
string wp=parsed[1];
if(players[index].incar) return;
bool d=false;
if(wp==0)
{
players[index].weapon="axe";
send(players[index].peer_id,"draw axe",0);
d=true;
}
else if(wp==1)
{
players[index].weapon="pistol";
send(players[index].peer_id,"draw pistol",0);
d=true;
}
else if(wp=="2" and players[index].inv.get_item_amount("rifle")>0)
{
players[index].weapon="rifle";
send(players[index].peer_id,"draw rifle",0);
d=true;
}
else if(wp=="3" and players[index].inv.get_item_amount("micro_smg")>0)
{
players[index].weapon="micro_smg";
send(players[index].peer_id,"draw micro_smg",0);
d=true;
}
else if(wp=="4" and players[index].inv.get_item_amount("shotgun")>0)
{
players[index].weapon="shotgun";
send(players[index].peer_id,"draw shotgun",0);
d=true;
}
else if(wp=="5" and players[index].inv.get_item_amount("hand_grenade")>0) throwmenu(players[index].peer_id);
else if(wp=="6" and players[index].inv.get_item_amount("kyle's_crossbow")>0)
{
players[index].weapon="kyles_crossbow";
send(players[index].peer_id,"draw kyles_crossbow",0);
d=true;
}
else if(wp=="7" and players[index].inv.get_item_amount("barrett_sniper_rifle")>0)
{
if(players[index].crouching==false)
{
send(players[index].peer_id,"It's best to be crouched before trying to utilize a sniper.",0);
return;
}
players[index].weapon="barrett_sniper_rifle";
send(players[index].peer_id,"draw barrett_sniper_rifle",0);
d=true;
}
else if(wp=="8" and players[index].inv.get_item_amount("energy_saber")>0)
{
players[index].weapon="energy_saber";
send(players[index].peer_id,"draw energy_saber",0);
d=true;
}
else if(wp=="9" and players[index].inv.get_item_amount("energy_saber_plus")>0)
{
players[index].weapon="energy_saber_plus";
send(players[index].peer_id,"draw energy_saber_plus",0);
d=true;
}
else
{
play2("draw",players[index].x,players[index].y,players[index].z,players[index].map);
send(players[index].peer_id,"You are not carrying a weapon in slot "+(stn(wp)+1)+".",0);
}
if(d) send(players[index].peer_id, "walktime 180", 0);
}
else if(parsed[0]=="checkmsounds")
{
for(uint i=0; i<msounds.length(); i++)
{
if(msounds[i].map==players[index].map)
{
send(players[index].peer_id,"createmsound "+msounds[i].id+" "+msounds[i].soundloop+" "+msounds[i].x+" "+msounds[i].y+" "+msounds[i].z+" "+msounds[i].map+" "+msounds[i].pitch,0);
}
}
}
else if(parsed[0]=="playmap" and parsed.length()>5)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].map==parsed[5] and players[i].name!=players[index].name)
{
send(players[i].peer_id,"play "+parsed[1]+".ogg "+stn(parsed[2])+" "+stn(parsed[3])+" "+stn(parsed[4])+" "+parsed[5],6);
}
}
}
}
}
}
}
@e = null;
}