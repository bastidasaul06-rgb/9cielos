return;
}
players[index2].lastpm=players[index].name;
players[index].lastpm=players[index2].name;
send(players[index].peer_id,"play_s pm.ogg",6);
send(players[index2].peer_id,"play_s pm.ogg",6);
send(players[index2].peer_id,"PM from "+players[index].name+": "+string_replace(get_event_message(),parsed[0]+" ","",true),4);
send(players[index].peer_id,"PM to "+players[index2].name+": "+string_replace(get_event_message(),parsed[0]+" ","",true),4);
}
