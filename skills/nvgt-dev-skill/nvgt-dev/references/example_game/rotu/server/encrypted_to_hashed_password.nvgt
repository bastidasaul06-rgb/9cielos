const string plkey="1a2b3c4d5efghij";
void main()
{
show_game_window("Encrypt to Hash converter");
int success=0;
string[]players=find_directories("players/*");
file f;
for(uint i=0; i<players.length(); i++)
{
if(file_exists("players/"+players[i]+"/pw.dat"))
{
f.open("players/"+players[i]+"/pw.dat","rb");
string new_pw=string_decrypt(f.read(),plkey);
f.close();
f.open("players/"+players[i]+"/pw.dat","wb");
f.write(string_hash(new_pw, 2, false));
success++;
}
}
alert("Done","Passwords converted: "+success+" out of "+players.length()+".");
exit();
}