void main()
{
show_game_window("Password changer");
string param=input_box("Player name:","");
if(param=="" or !directory_exists("players/"+param)) exit();
file f;
f.open("players/"+param+"/pw.dat","wb");
string newpass="changeme123";
f.write(string_hash(newpass,2,false));
f.close();
alert("Done","Change complete.");
exit();
}