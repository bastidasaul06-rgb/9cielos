void restart()
{
speak("Restarting.");
if(SCRIPT_COMPILED)
{
run("rotu.exe","",false,false);
}
else
{
run("C:/nvgt/nvgtw.exe","rotu.nvgt",false, false);
}
exit();
}
void boundaries()
{
if(me.x<0) me.x=0;
if(me.x>maxx) me.x=maxx;
if(me.y<0) me.y=0;
if(me.y>maxy) me.y=maxy;
}
void gocam(string direction)
{
if(direction=="left")
{
int camx=cam.x;
int camy=cam.y;
cam=move(cam.x,cam.y,cam.z,west,dir);
cam.x=round(cam.x,0);
cam.y=round(cam.y,0);
if(cam.x<0 or cam.x>maxx or cam.y<0 or cam.y>maxy)
{
cam.x=camx;
cam.y=camy;
return;
}
if(string_contains(gmc(),"wall",1)>-1)
{
if(camwalled==false)
{
playcam();
camwalled=true;
}
cam.x=camx;
cam.y=camy;
return;
}
playcam();
}
if(direction=="right")
{
int camx=cam.x;
int camy=cam.y;
cam=move(cam.x,cam.y,cam.z,east,dir);
cam.x=round(cam.x,0);
cam.y=round(cam.y,0);
if(cam.x<0 or cam.x>maxx or cam.y<0 or cam.y>maxy)
{
cam.x=camx;
cam.y=camy;
return;
}
if(string_contains(gmc(),"wall",1)>-1)
{
if(camwalled==false)
{
playcam();
camwalled=true;
}
cam.x=camx;
cam.y=camy;
return;
}
playcam();
}
if(direction=="forward")
{
int camx=cam.x;
int camy=cam.y;
cam=move(cam.x,cam.y,cam.z,north,dir);
cam.x=round(cam.x,0);
cam.y=round(cam.y,0);
if(cam.x<0 or cam.x>maxx or cam.y<0 or cam.y>maxy)
{
cam.x=camx;
cam.y=camy;
return;
}
if(string_contains(gmc(),"wall",1)>-1)
{
if(camwalled==false)
{
playcam();
camwalled=true;
}
cam.x=camx;
cam.y=camy;
return;
}
playcam();
}
if(direction=="backward")
{
int camx=cam.x;
int camy=cam.y;
cam=move(cam.x,cam.y,cam.z,south,dir);
cam.x=round(cam.x,0);
cam.y=round(cam.y,0);
if(cam.x<0 or cam.x>maxx or cam.y<0 or cam.y>maxy)
{
cam.x=camx;
cam.y=camy;
return;
}
if(string_contains(gmc(),"wall",1)>-1)
{
if(camwalled==false)
{
playcam();
camwalled=true;
}
cam.x=camx;
cam.y=camy;
return;
}
playcam();
}
if(direction=="up")
{
int camz=cam.z;
cam.z++;
if(string_contains(gmc(),"wall",1)>-1)
{
if(camwalled==false)
{
playcam();
camwalled=true;
}
cam.z=camz;
return;
}
playcam();
}
if(direction=="down")
{
int camz=cam.z;
cam.z--;
if(string_contains(gmc(),"wall",1)>-1)
{
if(camwalled==false)
{
playcam();
camwalled=true;
}
cam.z=camz;
return;
}
playcam();
}
}
void recloop()
{
if(key_down(KEY_D) and key_up(KEY_G) and alt_is_down() and !recding and recspamtimer.elapsed>5000 and is_paid==1)
{
recding=true;
p.play_stationary("vcon.ogg",false);
r.record();
rectimer.restart();
}
if((key_up(KEY_D) or rectimer.elapsed>30000) and recding)
{
recding=false;
r.stop(true,DIRECTORY_TEMP+"\\convert.ogg");
p.play_stationary("vcoff.ogg",false);
file f;
f.open(DIRECTORY_TEMP+"/convert.ogg","rb");
string vc=f.read();
f.close();
send("voice_chat "+vc,9);
recspamtimer.restart();
}
}
int generate_numeric_key(int length)
{
string ret;
string numlist="1234567890";
for(uint i=0; i<length; i++)
{
ret=ret+numlist[random(0,numlist.length()-1)];
}
return stn(ret);
}
void webload(const string w) {
run("C:\\Windows\\explorer.exe",w,false,false);
}
bool alt_is_down()
{
if((key_down(KEY_LMENU)) or key_down(KEY_RMENU))
{
return true;
}
else return false;
}
void fallcheck(){
if(!jumping&&!falling&&get_tile_at(me.x, me.y, me.z)=="" and mapname!="" and !doormove)
{
falling=true;
p.play_stationary("fall.ogg", false);
send("playmap fall "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
}
if(falling)
{
if(falltimer.elapsed>=falltime&&me.z>0)
{
falltimer.restart();
me.z--;
fallcounter++;
if(fallpackettimer.elapsed>500){
send("move_to "+me.x+" "+me.y+" "+me.z,3);
}
}
if(get_tile_at(me.x, me.y, me.z)!="")
{
if(fallcounter<=jumpheight)
{
playland();
send("i_landed",3);
}
else if(fallcounter>jumpheight)
{
playfall();
send("i_fell "+fallcounter,3);
}
falling=false;
fallcounter=0;
}
}
if(jumping)
{
walktime=airtime;
if(rising&&jumpcounter<jumpheight&&jumptimer.elapsed>=jumptime&&get_tile_at(me.x, me.y, me.z+1)=="")
{
jumptimer.restart();
jumpcounter++;
me.z++;
send("move_to "+me.x+" "+me.y+" "+me.z,3);
hazardcheck();
}
if(jumpcounter>=jumpheight or get_tile_at(me.x,me.y,me.z+1)!="")
{
rising=false;
lowering=true;
}
if(lowering&&get_tile_at(me.x, me.y, me.z)==""&&falltimer.elapsed>=falltime&&me.z>0)
{
falltimer.restart();
jumpcounter--;
me.z--;
fallcounter++;
send("move_to "+me.x+" "+me.y+" "+me.z,3);
fallpackettimer.restart();
hazardcheck();
}
if(get_tile_at(me.x, me.y, me.z)!="")
{
rising=false;
lowering=false;
jumping=false;
if(fallcounter<=jumpheight){
playland();
send("i_landed",3);
hazardcheck();
}
else
{
send("i_fell "+fallcounter,3);
playfall();
hazardcheck();
}
walktime=defwalktime;
fallcounter=0;
jumpcounter=0;
}
}
}
void adjust_master_volume(string direction)
{
if(direction=="up")
{
if(get_sound_master_volume()<100) set_sound_master_volume(get_sound_master_volume()+5);
}
if(direction=="down")
{
if(get_sound_master_volume()>0) set_sound_master_volume(get_sound_master_volume()-5);
}
double bass_db = (get_sound_master_volume() - 100) * 0.5;
set_url_volume(bass_db);
}
void itemloop()
{
if(trackitem)
{
if(me.x==itm.x and me.y==itm.y and me.z==itm.z)
{
p.play_stationary("itemreach.ogg",false);
p.destroy_sound(itemloopr);
itm.x=-1;
itm.y=-1;
itm.z=-1;
trackitem=false;
}
}
}

