void go(string where)
{
if(!doormove and !sitting){
if(where=="forward")
{
double mx=me.x;
double my=me.y;
me=move(me.x,me.y,me.z,north,dir);
me.x=round(me.x,0);
me.y=round(me.y,0);
if(me.x<0 or me.x>maxx or me.y<0 or me.y>maxy)
{
me.x=mx;
me.y=my;
return;
}
if(string_contains(gmt(),"wall",1)>-1)
{
if(!walled)
{
p.play_stationary(gmt()+".ogg",false);
send("playmap "+gmt()+" "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
walled=true;
}
me.x=mx;
me.y=my;
return;
}
hazardcheck();
playstep();
if(!walled) send("move "+me.x+" "+me.y+" "+me.z,3);
}
if(where=="backward")
{
double mx=me.x;
double my=me.y;
me=move(me.x,me.y,me.z,south,dir);
me.x=round(me.x,0);
me.y=round(me.y,0);
if(me.x<0 or me.x>maxx or me.y<0 or me.y>maxy)
{
me.x=mx;
me.y=my;
return;
}
if(string_contains(gmt(),"wall",1)>-1)
{
if(!walled)
{
p.play_stationary(gmt()+".ogg",false);
send("playmap "+gmt()+" "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
walled=true;
}
me.x=mx;
me.y=my;
return;
}
hazardcheck();
playstep();
if(!walled) send("move "+me.x+" "+me.y+" "+me.z,3);
}
if(where=="left")
{
double mx=me.x;
double my=me.y;
me=move(me.x,me.y,me.z,west,dir);
me.x=round(me.x,0);
me.y=round(me.y,0);
if(me.x<0 or me.x>maxx or me.y<0 or me.y>maxy)
{
me.x=mx;
me.y=my;
return;
}
if(string_contains(gmt(),"wall",1)>-1)
{
if(!walled)
{
p.play_stationary(gmt()+".ogg",false);
send("playmap "+gmt()+" "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
walled=true;
}
me.x=mx;
me.y=my;
return;
}
hazardcheck();
playstep();
if(!walled) send("move "+me.x+" "+me.y+" "+me.z,3);
}
if(where=="right")
{
double mx=me.x;
double my=me.y;
me=move(me.x,me.y,me.z,east,dir);
me.x=round(me.x,0);
me.y=round(me.y,0);
if(me.x<0 or me.x>maxx or me.y<0 or me.y>maxy)
{
me.x=mx;
me.y=my;
return;
}
if(string_contains(gmt(),"wall",1)>-1)
{
if(!walled)
{
p.play_stationary(gmt()+".ogg",false);
send("playmap "+gmt()+" "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
walled=true;
}
me.x=mx;
me.y=my;
return;
}
hazardcheck();
playstep();
if(!walled) send("move "+me.x+" "+me.y+" "+me.z,3);
}
if(where=="up")
{
if(get_tile_at(me.x,me.y,me.z+1)!="")
{
int oldz=me.z;
me.z++;
if(string_contains(gmt(),"wall",1)>-1)
{
if(!walled)
{
p.play_stationary(gmt()+".ogg",false);
send("playmap "+gmt()+" "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
walled=true;
}
me.z=oldz;
return;
}
hazardcheck();
playstep();
if(!walled) send("move "+me.x+" "+me.y+" "+me.z,3);
}
}
if(where=="down")
{
if(get_tile_at(me.x,me.y,me.z-1)!="")
{
int oldz=me.z;
me.z--;
if(string_contains(gmt(),"wall",1)>-1)
{
if(!walled)
{
p.play_stationary(gmt()+".ogg",false);
send("playmap "+gmt()+" "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
walled=true;
}
me.z=oldz;
return;
}
hazardcheck();
playstep();
if(!walled) send("move "+me.x+" "+me.y+" "+me.z,3);
}
}
}
}
string get_event_message()
{
string sender=e.message;
if(sender.is_empty()) return "";
sender=string_decrypt(sender,decryptkey);
if(debug_packets==1 or debug==true)
speak(sender);
return sender;
}
void send(uint peer,string message, uint channel)
{
message=string_encrypt(message,decryptkey);
n.send_reliable(peer,message,channel);
}
void send(string message, uint channel)
{
message=string_encrypt(message,decryptkey);
n.send_reliable(0,message,channel);
}
void send_unreliable(uint peer,string message, uint channel)
{
message=string_encrypt(string_compress(message), decryptkey);
n.send_unreliable(peer,message,channel);
}
string generate_ban_id()
{
return generate_computer_id("thisisacompid123",true);
}
void kill_game()
{
p.destroy_all();
mpool.destroy_all();
srcpool.destroy_all();
rnloop.stop();
players.resize(0);
destroy_all_hazards();
destroy_all_platforms();
destroy_all_urls();
raining=false;
defwalktime=180;
walktime=defwalktime;
saberloop.stop();
rnstart=false;
rnstop=false;
destroy_all_doors();
beacons.resize(0);
sitting=false;
crouching=false;
destroy_all_signs();
zones.resize(0);
travelpoints.resize(0);
defwalktime=180;
walktime=defwalktime;
pinging=false;
players.resize(0);
incar=false;
mapname="";
sources.resize(0);
//destroy_all_item_beeps();
destroy_songs();
resetnet();
}
string validate_nickname(string text)
{
if(string_contains(text," ",1)>-1)
{
return "Contains spaces";
}
else if(string_is_digits(text))
{
return "Contains digits only";
}
else if(text.length()>15)
{
return "Exceeds limit of 15 characters";
}
else if(text.length()<3)
{
return "Less than 3 characters";
}
else return "";
}
bool shift_is_down()
{
if((key_down(KEY_LSHIFT)) or key_down(KEY_RSHIFT))
{
return true;
}
else return false;
}
bool control_is_down()
{
if(key_down(KEY_LCONTROL))
{
return true;
}
if(key_down(KEY_RCONTROL) and rcontrolfires==1)
{
return true;
}
return false;
}
bool control_is_pressed()
{
if(key_pressed(KEY_LCONTROL))
{
return true;
}
if(key_pressed(KEY_RCONTROL) and rcontrolfires==1)
{
return true;
}
return false;
}
