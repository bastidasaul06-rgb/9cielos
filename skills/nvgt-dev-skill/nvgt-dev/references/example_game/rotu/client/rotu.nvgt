upcoming::sound@ prog;
tone_synth progress_synth;
upcoming::sound@ generate_beep(double freq)
{
    progress_synth.waveform_type = 4;
    progress_synth.set_edge_fades(75, 50);
    progress_synth.freq_ms(freq, 40);
    upcoming::sound@ s = progress_synth.write_wave_sound();
    progress_synth.reset();
    return s;
}
