string[]categories={"All","Weapons","Ammo","Armor and Clothing","Medical Items","Currency","Technology","Vehicles","Misc/Unsorted"};
//inventory class.
//written: July 9, 2020 Ivan Soto (IMS-Productions).
inventory inv;
class inventory {
inventory_item@[]items(0);
//constructor.
int invpos=-1;
inventory() {
reset();
}
int get_item_index(const string a) {
for(uint i=0; i<this.items.length(); i+=1) {
if(this.items[i].name==a) return i;
}
return -1;
}
string getitem() {
if(this.invpos<0 or this.invpos>this.items.length()-1) {
return "";
}
return this.items[this.invpos].name;
}
/*
void invmenu(int id,string category="All")
{
server_menu m;
m.intro=category+" Inventory:";
m.initial_packet="invselect";
for(uint i=0; i<this.items.length(); i++)
{
if(get_item_category(this.items[i].name)!=category and category!="All")continue;
