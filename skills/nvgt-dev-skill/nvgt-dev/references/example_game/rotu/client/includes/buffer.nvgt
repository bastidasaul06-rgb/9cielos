
int bufferpos;
buffer@[] buffers(0);
class buffer
{
	int interrupt;
	int active=1;
	int pos;
	string name;
	string[] items;
	bool hidden=false;
	buffer(string n)
	{
		name=n;
	}
}
void create_buffer(string bname)
{
	buffer b1(bname);
	buffers.insert_last(b1);
}
void firstbuffer()
{
	bufferpos=0;
	speakfocusedbuffer();
if(buffbeeps==1) progress_pitch_and_pan(bpos,bufferpos,buffers.length());
	
}
void lastbuffer()
{
	bufferpos=buffers.length()-1;
	speakfocusedbuffer();
if(buffbeeps==1) progress_pitch_and_pan(bpos,bufferpos,buffers.length());
}
void bufferleft()
{
	if (bufferpos<=0)
	{
		bufferpos=0;
		speakfocusedbuffer();
	if(buffbeeps==1) progress_pitch_and_pan(bpos,bufferpos,buffers.length());
		
	}
	else
	{
		bufferpos-=1;
		//if(buffer_hidden(bufferpos)) bufferpos-=1;
		if (buffers[bufferpos].items.length()==0)
		{
			bufferleft();
			return;
		}
		
		speakfocusedbuffer();
	if(buffbeeps==1) progress_pitch_and_pan(bpos,bufferpos,buffers.length());
	}
}
void bufferright()
{
	if (bufferpos>=(buffers.length()-1))
	{
		if (buffers.length()>0)
		bufferpos=buffers.length()-1;
		speakfocusedbuffer();
	if(buffbeeps==1) progress_pitch_and_pan(bpos,bufferpos,buffers.length());
		
	}
	else
	{
		bufferpos+=1;
		//if(buffer_hidden(bufferpos)) bufferpos+=1;
		if (buffers[bufferpos].items.length()==0)
		{
			bufferright();
			return;
		}
		speakfocusedbuffer();
	if(buffbeeps==1) progress_pitch_and_pan(bpos,bufferpos,buffers.length());
		
	}
}
void nextbufferitem()
{
	if (buffers[bufferpos].pos<(buffers[bufferpos].items.length()-1))
	{
		buffers[bufferpos].pos+=1;
if(buffbeeps==1) progress_pitch_and_pan(bnext,buffers[bufferpos].pos,buffers[bufferpos].items.length());
		
if(string_contains(buffers[bufferpos].items[buffers[bufferpos].pos],"http",1)>-1)
{
p.play_stationary("link.ogg",false);
}
speak(buffers[bufferpos].items[buffers[bufferpos].pos],true);

	}
}
void prevbufferitem()
{
	if (buffers[bufferpos].pos>0)
	{
		buffers[bufferpos].pos-=1;
if(buffbeeps==1) progress_pitch_and_pan(bnext,buffers[bufferpos].pos,buffers[bufferpos].items.length());
		
if(string_contains(buffers[bufferpos].items[buffers[bufferpos].pos],"http",1)>-1)
{
p.play_stationary("link.ogg",false);
}
speak(buffers[bufferpos].items[buffers[bufferpos].pos],true);
	}
}
void topbufferitem()
{
	if (buffers[bufferpos].items.length()>0)
	{
		buffers[bufferpos].pos=0;
if(buffbeeps==1) progress_pitch_and_pan(bnext,buffers[bufferpos].pos,buffers[bufferpos].items.length());
		
if(string_contains(buffers[bufferpos].items[buffers[bufferpos].pos],"http",1)>-1)
{
p.play_stationary("link.ogg",false);
}
speak(buffers[bufferpos].items[buffers[bufferpos].pos],true);
	}
}
void bottombufferitem()
{
	if (buffers[bufferpos].items.length()>0)
	{
		buffers[bufferpos].pos=(buffers[bufferpos].items.length()-1);
if(buffbeeps==1) progress_pitch_and_pan(bnext,buffers[bufferpos].pos,buffers[bufferpos].items.length());
		
if(string_contains(buffers[bufferpos].items[buffers[bufferpos].pos],"http",1)>-1)
{
p.play_stationary("link.ogg",false);
}
speak(buffers[bufferpos].items[buffers[bufferpos].pos],true);
	}
}
void add_buffer_item(string buffername, string item)
{
	for (uint i=0; i<buffers.length(); i++)
	{
if(buffers.length()==0) break;
		if (buffers[i].name==buffername and buffers[i].active==1 or buffers[i].name=="all" and buffers[i].active==1)
		{
			if (buffers[i].name!="all")
			speak(item,(buffers[i].interrupt==1?true:false));
			buffers[i].items.insert_last(item);
		}
	}
}
void export_buffer(string buffername)
{
	if(directory_exists("logs")==false)
	directory_create("logs");
	for (uint i=0; i<buffers.length(); i++)
	{
if(buffers.length()==0) break;
		if (buffers[i].name==buffername)
		{
			
			if (buffers[i].items.length()==0)
			return;
			string temp="\r\nThis buffer log was generated on "+get_date()+", at "+get_time();
			for (uint i2=0; i2<buffers[i].items.length(); i2++)
			{
				temp+="\r\n"+buffers[i].items[i2];
			}
			file f;
			f.open("logs/"+username+"_"+buffers[i].name+".log","ab");
			f.write(temp);
			f.close();
		}
	}
}
void export_all_buffers()
{
	for (uint i=0; i<buffers.length(); i++)
	{
if(buffers.length()==0) break;
		export_buffer(buffers[i].name);
	}
}
void activate_buffer()
{
	if (buffers[bufferpos].active==1)
	{
		buffers[bufferpos].active=0;
		speak(buffers[bufferpos].name+" deactivated.",true);
	}
	else if (buffers[bufferpos].active==0)
	{
		buffers[bufferpos].active=1;
		speak(buffers[bufferpos].name+" activated.",true);
	}
}
void interrupt_buffer()
{
	if (buffers[bufferpos].interrupt==1)
	{
		buffers[bufferpos].interrupt=0;
		speak(buffers[bufferpos].name+" not interrupting.",true);
	}
	else if (buffers[bufferpos].interrupt==0)
	{
		buffers[bufferpos].interrupt=1;
		speak(buffers[bufferpos].name+" interrupting.",true);
	}
}
int buffer_active(string buffername)
{
	for (uint i=0; i<buffers.length(); i++)
	{
if(buffers.length()==0) break;
		if (buffers[i].name==buffername)
		{
			return buffers[i].active;
		}
	}
	return 0;
}
void copy_buffer_item()
{
	if (buffers[bufferpos].items.length()>0)
	clipboard_copy_text(buffers[bufferpos].items[buffers[bufferpos].pos]);
}
void speakfocusedbuffer()
{
	if (buffers[bufferpos].items.length()>0)
	speak(buffers[bufferpos].name+". "+(buffers[bufferpos].pos+1)+" of "+buffers[bufferpos].items.length()+" items. Buffer "+(bufferpos+1)+" of "+buffers.length(),true);
	else
	speak(buffers[bufferpos].name+". Empty. Buffer "+(bufferpos+1)+" of "+buffers.length(),true);
}
bool buffer_hidden(uint bufferindex)
{
	if(bufferindex>=0&&bufferindex<buffers.length())
	return buffers[bufferindex].hidden;
	return false;
}
void activate_link(string bfitem=buffers[bufferpos].items[buffers[bufferpos].pos])
{
if(string_contains(bfitem,"http",1)<=-1)
{
speak("There are no links in this buffer item.");
return;
}
setupmenu(false);
string[]spaces=string_split(bfitem," ",false);
string[]linknames;
int linkcounter=0;
for(uint i=0; i<spaces.length(); i++)
{
if(string_contains(spaces[i],"http://",1)>-1 or string_contains(spaces[i],"www.",1)>-1 or string_contains(spaces[i],"https://",1)>-1)
{
linkcounter++;
linknames.insert_last(spaces[i]);
}
}
if(linknames.length()==1)
{
int qt=yesno("Only one link was detected in this buffer item. Open anyway?","Open link","Cancel");
if(qt==1)
{
p.play_stationary("linkenter.ogg",false);
webload(linknames[0]);
}
else speak("Okay.");
}
else
{
for(uint i2=0; i2<linknames.length(); i2++)
{
m.add_item_tts("Link "+(i2+1)+": "+linknames[i2],linknames[i2]);
}
m.add_item_tts("Cancel","cancel");
mres=m.run(linknames.length()+" links were detected in this buffer item. Select a link from the following list to visit.",true);
string murl=m.get_item_name(mres);
if(murl!="" and murl!="cancel")
{
speak("Opening link...");
p.play_stationary("linkenter.ogg",false);
webload(murl);
return;
}
else
speak("Canceled.");
return;
}
}
string get_date()
{
return DATE_MONTH+"/"+DATE_DAY+"/"+DATE_YEAR;
}
string get_time()
{
return TIME_HOUR+":"+TIME_MINUTE;
}