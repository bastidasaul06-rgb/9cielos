// gang_menu.nvgt - Client Side Gang Menu and Option Menu Online
// Written for ROTU (NVGT)

string temp_gang_info = "";
string temp_gang_list = "";
string temp_gang_requests = "";
string temp_gang_invites = "";

// Synchronous gang info fetch
string get_gang_info_sync() {
    temp_gang_info = "";
    send("gang_request_info", 0);
    timer t;
    while(temp_gang_info == "") {
        wait(5);
        netloop();
        if(t.elapsed > 2000) break;
    }
    return temp_gang_info;
}

// Synchronous gang list fetch
string get_gang_list_sync() {
    temp_gang_list = "";
    send("gang_request_list", 0);
    timer t;
    while(temp_gang_list == "") {
        wait(5);
        netloop();
        if(t.elapsed > 2000) break;
    }
    return temp_gang_list;
}

// Synchronous gang requests fetch
string get_gang_requests_sync() {
    temp_gang_requests = "";
    send("gang_request_requests", 0);
    timer t;
    while(temp_gang_requests == "") {
        wait(5);
        netloop();
        if(t.elapsed > 2000) break;
    }
    return temp_gang_requests;
}

// Synchronous pending invites fetch
string get_gang_invites_sync() {
    temp_gang_invites = "";
    send("gang_request_invites", 0);
    timer t;
    while(temp_gang_invites == "") {
        wait(5);
        netloop();
        if(t.elapsed > 2000) break;
    }
    return temp_gang_invites;
}

// Show Detailed Gang Info Menu
void show_gang_info_menu(string gname, string gleader, string gslogan, int glevel, int gexp, int gkills, string online_mems, string offline_mems) {
    while(true) {
        dynamic_menu_pro m;
        m.reset(false);
        m.click_sound = "menuclick.ogg";
        m.enter_sound = "menuenter.ogg";
        m.edge_sound = "menuedge.ogg";
        m.wrap_sound = "menuwrap.ogg";
        m.open_sound = "menuopen.ogg";
        m.enable_first_letter_navigation = true;
        m.enable_up_and_down = true;
        m.set_callback(staff_menu_callback, "");

        m.add_item_tts("Gang Name: " + gname, "gname");
        m.add_item_tts("Leader: " + gleader, "leader");
        m.add_item_tts("Slogan: " + gslogan, "slogan");
        m.add_item_tts("Level: " + glevel, "level");
        m.add_item_tts("Experience: " + gexp + " / " + (glevel * 1000), "exp");
        m.add_item_tts("Undead Kills: " + gkills, "kills");

        // Parse online members
        string[] onlines = string_split(online_mems, ",", false);
        uint online_count = 0;
        for(uint i = 0; i < onlines.length(); i++) {
            if (onlines[i].is_empty() == false) {
                online_count++;
            }
        }
        m.add_item_tts("--- Online Members (" + online_count + ") ---", "online_header");
        for(uint i = 0; i < onlines.length(); i++) {
            if (onlines[i].is_empty() == false) {
                m.add_item_tts(onlines[i], "online_mem_" + i);
            }
        }

        // Parse offline members
        string[] offlines = string_split(offline_mems, ",", false);
        uint offline_count = 0;
        for(uint i = 0; i < offlines.length(); i++) {
            if (offlines[i].is_empty() == false) {
                offline_count++;
            }
        }
        m.add_item_tts("--- Offline Members (" + offline_count + ") ---", "offline_header");
        for(uint i = 0; i < offlines.length(); i++) {
            if (offlines[i].is_empty() == false) {
                m.add_item_tts(offlines[i], "offline_mem_" + i);
            }
        }

        m.add_item_tts("Go Back", "back");

        int res = m.run("Gang Info Menu for " + gname, true);
        string opt = m.get_item_name(res);
        if (opt == "back" or res <= 0) {
            break;
        }
    }
}

// Online Option Menu (Shift + O)
void account_options_menu() {
    while(true) {
        dynamic_menu_pro m;
        m.reset(false);
        m.click_sound = "menuclick.ogg";
        m.enter_sound = "menuenter.ogg";
        m.edge_sound = "menuedge.ogg";
        m.wrap_sound = "menuwrap.ogg";
        m.open_sound = "menuopen.ogg";
        m.enable_first_letter_navigation = true;
        m.enable_up_and_down = true;
        m.set_callback(staff_menu_callback, "");

        m.add_item_tts("Set Character Description", "desc");
        m.add_item_tts("Change Password", "password");
        m.add_item_tts("Change Email", "email");
        m.add_item_tts("Go Back", "back");

        int res = m.run("Account and Character Options", true);
        string opt = m.get_item_name(res);
        if (opt == "back" or res <= 0) {
            break;
        }
        else if (opt == "desc") {
            string desc = txt.input("Enter character description", true);
            if (desc != "") send("/setdescription " + desc, 1);
        }
        else if (opt == "password") {
            string old_pass = txt.input("Enter old password", true);
            if (old_pass != "") {
                string new_pass = txt.input("Enter new password", true);
                if (new_pass != "") send("/changepass " + old_pass + " " + new_pass, 1);
            }
        }
        else if (opt == "email") {
            string new_email = txt.input("Enter new email address", true);
            if (new_email != "") send("/changemail " + new_email, 1);
        }
    }
}

