void progress_pan(sound@ handle, int current, uint max) {
handle.pan=(current*200/max)-100;
//handle.stop();
//handle.play();
}
void progress_pitch(sound@ handle, int current, int max) {
handle.pitch=(current*200/max);
handle.stop();
handle.play();
}
void progress_pitch_and_pan(sound@ handle, int current, int max) {
handle.pan=(current*200/max)-100;
handle.pitch=(current*200/max);
if(handle.pitch<20) handle.pitch=20;
handle.stop();
handle.play();
}