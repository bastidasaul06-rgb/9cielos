void joymenu(bool called_from_form = false)
{
if(stick.joysticks==0)
{
dlg("Error. There were no joysticks detected on your system. Please ensure that your joystick is connected properly, then try again.");
if (called_from_form) return;
prefsmenu();
}
if(stick.joysticks==1)
{
dlg("There is only one joystick on your system.");
int qt=yesno("Would you like to use that joystick as your main one?","Yes","No");
if(qt==1)
{
my_stick=0;
stick.set(my_stick);
if(stick.active==false)
{
my_stick=-1;
alert("Error","Something went wrong. Try again.");
}
if(stick.active==true)
{
dlg("Success.");
addprefs();
}
if (called_from_form) return;
prefsmenu();
}
else {
if (called_from_form) return;
prefsmenu();
}
}
string[]joylist=stick.list_joysticks();
m.add_item_tts("Refresh list","refresh");
for(uint i=0; i<joylist.length(); i++)
{
m.add_item_tts(joylist[i],i);
}
mres=m.run("Select joystick.",true);
string j=m.get_item_name(mres);
if(j!="" and j!="refresh")
{
int j2=stn(j);
my_stick=j2;
stick.set(my_stick);
if(stick.active==false)
{
alert("Error","Something wentw rong. TRy again.");
my_stick=-1;
}
if(stick.active==true)
{
dlg("Success.");
}
addprefs();
if (called_from_form) return;
prefsmenu();
}
else if(j=="refresh"){
stick.refresh_joystick_list();
joymenu(called_from_form);
}
else {
if (called_from_form) return;
prefsmenu();
}
}
void select_host_menu()
{
setupmenu(false);
m.add_item_tts("Local server (localhost)","localhost");
m.add_item_tts("Main server (example.com)","example.com");
m.add_item_tts("Go back","back");
mres=m.run("Select host.",true);
string host=m.get_item_name(mres);
if(host!="" and host!="back")
{
netaddress=host;
speak("Now using "+netaddress+" as host.");
addprefs();
prefsmenu();
}
else prefsmenu();
}