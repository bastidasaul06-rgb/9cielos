void ttsvoicemenu(bool called_from_form = false)
{
int vcounter=sapivoice;
speak("Use the (up) and (down) arrow keys to select a voice. Use the (Left) and (Right) arrow keys to adjust the speech rate, and the (A) and (D) keys to adjust the rate. When you are satisfied, hit (Enter) to save your selection. To cancel, hit (Escape).",true);
string[]vnames=tts.get_voice_names();
while(true)
{
wait(5);
if(key_pressed(KEY_UP))
{
if(vcounter<=0)
{
spool.play_stationary("menuedge.ogg", false);
}
else
{
vcounter--;
tts.set_current_voice(vcounter);
speak(vnames[vcounter],true,true);
}
}
if(key_pressed(KEY_DOWN))
{
if(vcounter>=vnames.length()-1)
{
spool.play_stationary("menuedge.ogg", false);
}
else
{
vcounter++;
tts.set_current_voice(vcounter);
speak(vnames[vcounter],true,true);
}
}
if(key_pressed(KEY_LEFT) and tts.pitch>-10)
{
tts.pitch=tts.pitch-1;
speak("Pitch "+tts.pitch,true,true);
}
if(key_pressed(KEY_RIGHT) and tts.pitch<10)
{
tts.pitch=tts.pitch+1;
speak("Pitch "+tts.pitch,true,true);
}
if(key_pressed(KEY_A) and tts.rate>-10)
{
tts.rate=tts.rate-1;
speak("rate "+tts.rate,true,true);
}
if(key_pressed(KEY_D) and tts.rate<10)
{
tts.rate=tts.rate+1;
speak("rate "+tts.rate,true,true);
}
if(key_pressed(KEY_ESCAPE))break;
if(key_pressed(KEY_RETURN))
{
sapivoice=vcounter;
sapirate=tts.rate;
sapipitch=tts.pitch;
configure_tts();
speak("Saved TTS settings",true,true);
addprefs();
if (called_from_form) return;
prefsmenu();
}
}
tts.rate=sapirate;
tts.pitch=sapipitch;
tts.set_current_voice(sapivoice);
configure_tts();
if (called_from_form) return;
prefsmenu();
}
void selectkbmenu(bool called_from_form = false)
{
setupmenu(false);
m.add_item_tts("keyboard1 (default)","keyboard1");
