void langmenu(bool called_from_form = false)
{
setupmenu(false);
string[]langs=find_files("translations/*.txt");
if(langs.length()==0)
{
alert("Error","There were no language files detected. If you believe this is an error please redownload the game. Using English for now.");
language="English";
return;
}
m.add_item_tts("English (default)","English");
for(uint i=0; i<langs.length(); i++)
{
m.add_item_tts(langs[i],string_replace(langs[i],".txt","",false));
}
mres=m.run("Select the language file to use, or choose English to use no language file.",true);
string ln=m.get_item_name(mres);
if(ln!="")
{
language=ln;
dlg("You are now using "+language+" as the game's default language.");
addprefs();
return;
}
else
if(language==""){ 
alert("Error!","You need to pick a language!");
exit();
}
else{ 
speak("Language unchanged.");
if (called_from_form) return;
prefsmenu();
}
}
void invmenu()
{
if(gameinv.items.length()==0)
{
speak("No items");
return;
}
m.reset(true);
m.enable_up_and_down=true;
m.enable_home_and_end=true;
m.wrap=false;
m.enable_multi_letter_navigation=true;
m.allow_escape=true;
m.click_sound="invcycle.ogg";
m.enter_sound="invclose.ogg";
m.open_sound="invopen.ogg";
m.set_callback(searchcall,"");
for(uint i=0; i<gameinv.items.length(); i++)
{
m.add_item_tts(gameinv.items[i].name+": You have "+gameinv.items[i].amount+".",gameinv.items[i].name);
}
int mres=m.run("Inventory menu. You have "+gameinv.items.length()+" items.",true);
if(mres==0)
{
m.play_enter_sound();
return;
}
else
{
gameinv.invpos=gameinv.get_item_index(m.get_item_name(mres));
return;
}
}
void beaconmenu()
{
setupmenu(false);
m.set_callback(mcb,"");
for(uint i=0; i<beacons.length(); i++)
{
m.add_item_tts(beacons[i].text,beacons[i].text);
}
m.add_item_tts("Cancel","cancel");
mres=m.run("There are "+beacons.length()+" beacons on this map. Select the beacon to track.",true);
string b=m.get_item_name(mres);
if(b!="" and b!="cancel")
{
for(uint trk=0; trk<beacons.length(); trk++){
if(beacons[trk].text==b)
{
tb.x=round((beacons[trk].minx+beacons[trk].maxx)/2,0);
tb.y=round((beacons[trk].miny+beacons[trk].maxy)/2,0);
tb.z=round((beacons[trk].minz+beacons[trk].maxz)/2,0);

}
}
trackbeacon=true;
speak("Tracking");
}
else
if(trackbeacon){
speak("Stopped tracking");
tb.x=-1;
tb.y=-1;
tb.z=-1;
trackbeacon=false;
}
else speak("Canceled");
}
