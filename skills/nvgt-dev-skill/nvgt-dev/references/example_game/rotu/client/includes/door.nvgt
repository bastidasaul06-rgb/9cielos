bool doormove=false;
door@[]doors(0);
class door{
double startx,starty,startz;
double endx,endy,endz;
bool ismoving=false;
int dloop;
int mvloop;
string loopsound,movesound,opensound,closesound;
int speed;
timer movetimer;
door(double sx,double sy,double sz,double ex,double ey,double ez,int sp,string lsound,string mvsound,string osound,string csound)
{
startx=sx;
starty=sy;
startz=sz;
endx=ex;
endy=ey;
endz=ez;
speed=sp;
loopsound=lsound;
movesound=mvsound;
opensound=osound;
closesound=csound;
dloop=p.play_3d(loopsound,me.x,me.y,me.z,startx,starty,startz,dir,true);
}
}
void destroy_all_doors()
{
for(uint i=0; i<doors.length(); i++)
{
p.destroy_sound(doors[i].dloop);
}
doors.resize(0);
}
void create_door(double x,double y,double z,double x2,double y2,double z2,int speed,string loopsound,string movesound,string opensound,string closesound)
{
door door1(x,y,z,x2,y2,z2,speed,loopsound,movesound,opensound,closesound);
doors.insert_last(door1);
}
void doorcheck()
{
for(uint i=0; i<doors.length(); i++)
{
if(doors[i].startx==me.x and doors[i].starty==me.y and doors[i].startz==me.z)
{
if(spamdoortimer.elapsed<5000)
{
speak("You cannot activate doors right now. Wait 5 seconds.");
}
else
{
doormove=true;
doors[i].ismoving=true;
p.play_stationary(doors[i].opensound,false);
doors[i].mvloop=p.play_stationary(doors[i].movesound,true);
send("playmap "+string_replace(doors[i].opensound,".ogg","",true)+" "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
}
}
}
}
void doorloop()
{
for(uint i=0; i<doors.length(); i++)
{
if(doors[i].movetimer.elapsed>doors[i].speed and doors[i].ismoving)
{
doors[i].movetimer.restart();
if(doors[i].speed==-1)
{
me.x=doors[i].endx;
me.y=doors[i].endy;
me.z=doors[i].endz;
//send("move_to "+me.x+" "+me.y+" "+me.z,0);
}
if(me.x<doors[i].endx)
{
me.x++;
//send("move_to "+me.x+" "+me.y+" "+me.z,0);
}
if(me.x>doors[i].endx)
{
me.x--;
//send("move_to "+me.x+" "+me.y+" "+me.z,0);
}
if(me.y<doors[i].endy)
{
me.y++;
//send("move_to "+me.x+" "+me.y+" "+me.z,0);
}
if(me.y>doors[i].endy)
{
me.y--;
//send("move_to "+me.x+" "+me.y+" "+me.z,0);
}
if(me.z<doors[i].endz)
{
me.z++;
//send("move_to "+me.x+" "+me.y+" "+me.z,0);
}
if(me.z>doors[i].endz)
{
me.z--;
//send("move_to "+me.x+" "+me.y+" "+me.z,0);
}
if(me.x==doors[i].endx and me.y==doors[i].endy and me.z==doors[i].endz)
{
p.destroy_sound(doors[i].mvloop);
p.play_3d(doors[i].closesound,me.x,me.y,me.z,doors[i].endx,doors[i].endy,doors[i].endz,dir, false);
send("playmap "+string_replace(doors[i].closesound,".ogg","",true)+" "+me.x+" "+me.y+" "+me.z+" "+mapname,0);
send("move_to "+me.x+" "+me.y+" "+me.z,0);
doors[i].ismoving=false;
doormove=false;
spamdoortimer.restart();
}
}
}
}
