void server_maintenance_menu() {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        sm.add_item_tts("Reboot Server Immediately", "reboot");
        sm.add_item_tts("Shutdown Server Immediately", "shutdown");
        sm.add_item_tts("Reboot Server for Update (10s)", "update_reboot");
        sm.add_item_tts("Generate Performance Profile", "profile");
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Server Maintenance Menu", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        if (name == "reboot") {
            int confirm = yesno("Reboot the server now?", "Yes", "No");
            if (confirm == 1) {
                send(0, "/reboot", 1);
                break;
            }
        } else if (name == "shutdown") {
            int confirm = yesno("Shutdown the server now?", "Yes", "No");
            if (confirm == 1) {
                send(0, "/exit", 1);
                break;
            }
        } else if (name == "update_reboot") {
            int confirm = yesno("Reboot for update in 10 seconds?", "Yes", "No");
            if (confirm == 1) {
                send(0, "/update", 1);
                break;
            }
        } else if (name == "profile") {
            send(0, "/profile", 1);
            speak("Profile logging initiated.");
        }
    }
}

void builder_management_menu(bool is_dev, bool is_admin, bool is_builder) {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        sm.add_item_tts("Open Builder Configuration Menu", "builder_menu");
        sm.add_item_tts("List Loaded Maps", "maps_list");
        sm.add_item_tts("Copy Raw Map to Clipboard", "raw_map");
        sm.add_item_tts("Paste Raw Map from Clipboard", "raw_data");
        sm.add_item_tts("Promote Player to Builder", "promote_builder");
        sm.add_item_tts("Demote Builder to Player", "demote_builder");
        sm.add_item_tts("List Server Builders", "list_builders");
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Builder & Maps Menu", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        if (name == "builder_menu") {
            send("buildermenu", 0);
            break;
        } else if (name == "maps_list") {
            send(0, "/mapslist", 1);
            break;
        } else if (name == "raw_map") {
            send(0, "/rawmap", 1);
            break;
        } else if (name == "raw_data") {
            string raw = clipboard_read_text();
            if (raw == "") {
                speak("Clipboard is empty.");
                continue;
            }
            int confirm = yesno("Paste raw data from clipboard to overwrite map?", "Yes", "No");
            if (confirm == 1) {
                send(0, "/rawdata " + raw, 1);
                break;
            }
        } else if (name == "promote_builder") {
            string target = txt.input("Enter username to promote to builder:", false);
            if (target != "") send(0, "/builder " + target, 1);
        } else if (name == "demote_builder") {
            string target = txt.input("Enter username to demote from builder:", false);
            if (target != "") send(0, "/unbuilder " + target, 1);
        } else if (name == "list_builders") {
            send(0, "/builders", 1);
            break;
        }
    }
}

