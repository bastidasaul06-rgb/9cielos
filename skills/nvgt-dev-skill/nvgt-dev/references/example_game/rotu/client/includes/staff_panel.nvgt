// staff_panel.nvgt - Staff Control Panel Client Implementation
// Written for ROTU (NVGT)

string last_store_data = "";
string last_store_action_status = "";
string last_store_action_message = "";

string last_player_info_data = "";
string last_player_inventory_data = "";
string last_server_stats_data = "";
string last_server_banlist_data = "";
string last_tickets_data = "";
bool staff_is_invisible = false;
string last_staff_action_status = "";
string last_staff_action_message = "";

int staff_menu_callback(dynamic_menu_pro@ menu_handle, string data) {
    netloop();
    return 0;
}

// Show Gang Details Menu (shared utility)
void show_gang_details_menu(string gname, string gleader, string gslogan, string glevel, string gmembers) {
    while(true) {
        dynamic_menu_pro m;
        m.reset(false);
        m.click_sound = "menuclick.ogg";
        m.enter_sound = "menuenter.ogg";
        m.edge_sound = "menuedge.ogg";
        m.wrap_sound = "menuwrap.ogg";
        m.open_sound = "menuopen.ogg";
        m.enable_first_letter_navigation = true;
        m.enable_up_and_down = true;
        m.set_callback(staff_menu_callback, "");

        m.add_item_tts("Gang Name: " + gname, "gname");
        m.add_item_tts("Leader: " + gleader, "leader");
        m.add_item_tts("Level: " + glevel, "level");
        m.add_item_tts("Members Count: " + gmembers, "members");
        m.add_item_tts("Slogan: " + gslogan, "slogan");
        m.add_item_tts("Go Back", "back");

        int res = m.run("Gang Details for " + gname, true);
        string opt = m.get_item_name(res);
        if (opt == "back" or res <= 0) {
            break;
        }
    }
}

// Global function to trigger the staff panel
void open_staff_panel(bool is_dev, bool is_admin, bool is_mod, bool is_builder) {
    global_is_dev = is_dev;
    global_is_admin = is_admin;
    global_is_mod = is_mod;
    global_is_builder = is_builder;
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        if (is_dev || is_admin || is_mod) {
            sm.add_item_tts("Player Management", "player_mgmt");
            sm.add_item_tts("Gang Management", "gang_mgmt");
            sm.add_item_tts("Support Tickets Queue", "tickets_mgmt");
        }
        if (is_dev || is_admin) {
            sm.add_item_tts("Store Management", "store_mgmt");
        }
        sm.add_item_tts("Server Management", "server_mgmt");
        if (is_dev || is_admin || is_builder) {
            sm.add_item_tts("Builder & Maps", "builder_mgmt");
        }
        if (is_dev || is_admin) {
            sm.add_item_tts("Staff Tools", "staff_tools");
        }
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Staff Control Panel. Select a category.", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) {
            break;
        }
        else if (name == "player_mgmt") {
            player_management_menu(is_dev, is_admin, is_mod);
        }
        else if (name == "gang_mgmt") {
            gang_management_menu(is_dev, is_admin, is_mod);
        }
        else if (name == "tickets_mgmt") {
            tickets_management_menu(is_dev, is_admin, is_mod);
        }
        else if (name == "store_mgmt") {
            store_management_menu(is_dev, is_admin);
        }
        else if (name == "server_mgmt") {
            server_management_menu(is_dev, is_admin, is_mod);
        }
        else if (name == "builder_mgmt") {
            builder_management_menu(is_dev, is_admin, is_builder);
        }
        else if (name == "staff_tools") {
            staff_tools_menu(is_dev, is_admin);
        }
    }
    speak("Returning to game.");
}

void player_management_menu(bool is_dev, bool is_admin, bool is_mod) {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        sm.add_item_tts("Online Players List", "online_players");
        
        if (is_dev || is_admin) {
            sm.add_item_tts("Kick Player", "kick_manual");
            sm.add_item_tts("Ban Player (Online Ban)", "ban_manual");
            sm.add_item_tts("Offline Ban Player", "offline_ban");
            sm.add_item_tts("Temp Ban Player", "tempban_manual");
            sm.add_item_tts("Unban Player", "unban");
            sm.add_item_tts("Jail Player", "jail_manual");
            sm.add_item_tts("Unjail Player", "unjail");
            sm.add_item_tts("Warn Player", "warn_manual");
            sm.add_item_tts("Give Item to Player", "give_manual");
            sm.add_item_tts("Set Player Health", "sethealth_manual");
            sm.add_item_tts("Reset Password", "reset_pass");
            sm.add_item_tts("Delete Account", "delete_acc");
        }
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Player Management Menu", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        if (name == "online_players") {
            online_players_menu(is_dev, is_admin, is_mod);
        } else if (name == "kick_manual") {
            string target = txt.input("Enter player username to kick:", false);
            if (target != "") kick_player_form(target);
        } else if (name == "ban_manual") {
            string target = txt.input("Enter player username to ban:", false);
            if (target != "") {
                int confirm = yesno("Are you sure you want to ban " + target + " from the server?", "Yes", "No");
                if (confirm == 1) send(0, "/ban " + target, 1);
            }
        } else if (name == "offline_ban") {
            offline_ban_form();
        } else if (name == "tempban_manual") {
            string target = txt.input("Enter player username to temp ban:", false);
            if (target != "") tempban_player_form(target);
        } else if (name == "unban") {
            unban_form();
        } else if (name == "jail_manual") {
            string target = txt.input("Enter player username to jail:", false);
            if (target != "") jail_player_form(target);
        } else if (name == "unjail") {
            unjail_form();
        } else if (name == "warn_manual") {
            string target = txt.input("Enter player username to warn:", false);
            if (target != "") warn_player_form(target);
        } else if (name == "give_manual") {
            string target = txt.input("Enter player username to give item:", false);
            if (target != "") give_item_form(target);
        } else if (name == "sethealth_manual") {
            string target = txt.input("Enter player username to set health:", false);
            if (target != "") sethealth_player_form(target);
        } else if (name == "reset_pass") {
            reset_pass_form();
        } else if (name == "delete_acc") {
            delete_account_form();
        }
    }
}

bool array_contains_nocase(string[]@ arr, string val) {
    for (uint i = 0; i < arr.length(); i++) {
        if (string_to_lower_case(arr[i]) == string_to_lower_case(val)) {
            return true;
        }
    }
    return false;
}

void online_players_menu(bool is_dev, bool is_admin, bool is_mod) {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        string[] added_names;
        sm.add_item_tts(username + " (You)", username);
        added_names.insert_last(username);
        for(uint i = 0; i < players.length(); i++) {
            string p_name = players[i].name;
            if (string_to_lower_case(p_name) == string_to_lower_case(username) || array_contains_nocase(added_names, p_name)) {
                continue;
            }
            sm.add_item_tts(p_name, p_name);
            added_names.insert_last(p_name);
        }
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Select a player to manage", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        single_player_actions_menu(name, is_dev, is_admin, is_mod);
    }
}

void single_player_actions_menu(string target, bool is_dev, bool is_admin, bool is_mod) {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        if (target != username) {
            if (is_dev || is_admin) {
                sm.add_item_tts("Kick Player", "kick");
                sm.add_item_tts("Ban Computer (Online Ban)", "ban");
                sm.add_item_tts("Temp Ban Player", "tempban");
            }
            if (is_dev || is_admin) {
                sm.add_item_tts("Jail Player", "jail");
                sm.add_item_tts("Warn Player", "warn");
            }
            if (is_dev || is_admin || is_mod) {
                sm.add_item_tts("Give Item", "give");
                sm.add_item_tts("View email address", "view_email");
                sm.add_item_tts("Inspect Player Stats", "inspect_stats");
                sm.add_item_tts("Inspect & Edit Player Inventory", "inspect_inv");
            }
            if (is_dev || is_admin) {
                sm.add_item_tts("Goto Player", "goto");
                sm.add_item_tts("Summon Player", "summon");
                sm.add_item_tts("Set Health", "sethealth");
                sm.add_item_tts("Spectate Player (Invisible Mode)", "spectate");
            }
        } else {
            sm.add_item_tts("You cannot perform staff actions on yourself.", "self_info");
        }
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Actions for " + target, true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        if (name == "kick") {
            kick_player_form(target);
        } else if (name == "ban") {
            int confirm = yesno("Are you sure you want to ban " + target + " from the server?", "Yes", "No");
            if (confirm == 1) {
                send(0, "/ban " + target, 1);
                break;
            }
        } else if (name == "tempban") {
            tempban_player_form(target);
        } else if (name == "jail") {
            jail_player_form(target);
        } else if (name == "warn") {
            warn_player_form(target);
        } else if (name == "give") {
            give_item_form(target);
        } else if (name == "inspect_stats") {
            inspect_player_stats_menu(target);
        } else if (name == "inspect_inv") {
            inspect_player_inventory_menu(target);
        } else if (name == "spectate") {
            send(0, "staff_toggle_invis", 0);
            send(0, "/gotoplayer " + target, 1);
            break;
        } else if (name == "goto") {
            send(0, "/gotoplayer " + target, 1);
            break;
        } else if (name == "summon") {
            send(0, "/moveplayer " + target + " " + username, 1);
            break;
        } else if (name == "sethealth") {
            sethealth_player_form(target);
        } else if (name == "view_email") {
            send(0, "/get_email " + target, 1);
        }
    }
}

void server_management_menu(bool is_dev, bool is_admin, bool is_mod) {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        if (is_dev || is_admin) {
            sm.add_item_tts("View Live Server Stats", "live_stats");
            sm.add_item_tts("IP/Comp Ban List Manager", "ban_manager");
            sm.add_item_tts("Weather Control Panel", "weather_ctrl");
            sm.add_item_tts("Garbage Collector (Free RAM)", "garbage");
            sm.add_item_tts("Clear Server Objects (Reduce Lag)", "clear_server");
            sm.add_item_tts("Spam Kill Undeads", "spam_kill");
            sm.add_item_tts("Backup Player Database", "backup_db");
            sm.add_item_tts("Modify Server MOTD", "modify_motd");
        }
        if (is_dev) {
            sm.add_item_tts("Toggle Game Running State", "toggle_game");
            sm.add_item_tts("Toggle Server Voice Chat", "toggle_vc");
            sm.add_item_tts("Server Maintenance Options", "maintenance");
        }
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Server Management Menu", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        if (name == "live_stats") {
            view_live_server_stats_menu();
        } else if (name == "ban_manager") {
            ban_list_manager_menu();
        } else if (name == "weather_ctrl") {
            weather_control_menu();
        } else if (name == "garbage") {
            send(0, "/garbage", 1);
            speak("Garbage collection request sent.");
        } else if (name == "clear_server") {
            int confirm = yesno("Clear all undead, bullets, and items from the server?", "Yes", "No");
            if (confirm == 1) {
                send(0, "/serverclear", 1);
            }
        } else if (name == "spam_kill") {
            send(0, "/spamkill", 1);
            speak("Spam kill request sent.");
        } else if (name == "backup_db") {
            send(0, "/playerbackup", 1);
            speak("Database backup request sent.");
        } else if (name == "toggle_game") {
            send(0, "/game", 1);
        } else if (name == "toggle_vc") {
            send(0, "/voicechat", 1);
        } else if (name == "modify_motd") {
            modify_motd_menu();
        } else if (name == "maintenance") {
            server_maintenance_menu();
        }
    }
}

