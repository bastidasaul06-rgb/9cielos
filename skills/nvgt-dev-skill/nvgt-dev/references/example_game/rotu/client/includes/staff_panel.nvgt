void coordinates_tools_menu() {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        sm.add_item_tts("Teleport to Target Map & Coords", "teleport_self");
        sm.add_item_tts("Move Player to Coords", "move_player_coords");
        sm.add_item_tts("Move Player to Player (Summon / Teleport)", "move_player_to_player");
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Teleport & Coordinates Tools", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        if (name == "teleport_self") {
            teleport_self_form();
        } else if (name == "move_player_coords") {
            move_player_coords_form();
        } else if (name == "move_player_to_player") {
            move_player_to_player_form();
        }
    }
}

void play_sounds_menu() {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        sm.add_item_tts("Play Sound to Channel Players", "play_normal");
        sm.add_item_tts("Play Sound with Pitch Adjust", "play_pitch");
        sm.add_item_tts("Select Sound from Server List", "playsvr");
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Server Sounds Menu", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        if (name == "play_normal") {
            play_sound_form();
        } else if (name == "play_pitch") {
            play_sound_pitch_form();
        } else if (name == "playsvr") {
            send(0, "/playsvr", 1);
            break;
        }
    }
}

// ================= FORM IMPLEMENTATIONS =================

void kick_player_form(string target) {
    audio_form f;
    f.create_window("Kick Player: " + target, false, true);
    int f_reason = f.create_input_box("Reason for kicking", "", "", 100);
    int f_ok = f.create_button("Kick", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_reason);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string reason = f.get_text(f_reason);
            if (reason == "") {
                speak("Please enter a reason.");
                f.focus(f_reason);
                continue;
            }
            send(0, "/kick " + target + " " + reason, 1);
            speak("Kick request sent.");
            break;
        }
    }
}

void tempban_player_form(string target) {
    audio_form f;
    f.create_window("Temp Ban Player: " + target, false, true);
    int f_mins = f.create_input_box("Minutes to ban", "60", "", 6);
    int f_ok = f.create_button("Temp Ban", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_mins);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string mins = f.get_text(f_mins);
            if (!mins.is_digits() || mins == "" || stn(mins) <= 0) {
                speak("Please enter a valid positive number of minutes.");
                f.focus(f_mins);
                continue;
            }
            send(0, "/tempban " + target + " " + mins, 1);
            speak("Temp ban request sent.");
            break;
        }
    }
}

void jail_player_form(string target) {
    audio_form f;
    f.create_window("Jail Player: " + target, false, true);
    int f_mins = f.create_input_box("Minutes in jail", "30", "", 6);
    int f_reason = f.create_input_box("Reason for jailing", "", "", 100);
    int f_ok = f.create_button("Send to Jail", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_mins);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string mins = f.get_text(f_mins);
            string reason = f.get_text(f_reason);
            if (!mins.is_digits() || mins == "" || stn(mins) <= 0) {
                speak("Please enter a valid positive number of minutes.");
                f.focus(f_mins);
                continue;
            }
            if (reason == "") {
                speak("Please enter a reason.");
                f.focus(f_reason);
                continue;
            }
            send(0, "/jail " + target + " " + mins + " " + reason, 1);
            speak("Jail request sent.");
            break;
        }
    }
}

void warn_player_form(string target) {
    audio_form f;
    f.create_window("Warn Player: " + target, false, true);
    
    int f_lvl = f.create_list("Warning Level");
    f.add_list_item(f_lvl, "Level 1 (Low)");
    f.add_list_item(f_lvl, "Level 2 (Medium)");
    f.add_list_item(f_lvl, "Level 3 (High)");
    
    int f_reason = f.create_input_box("Reason for warning", "", "", 100);
    int f_ok = f.create_button("Issue Warning", true);
    int f_cancel = f.create_button("Cancel", false, true);
    
    f.focus(f_lvl);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            int lvl = f.get_list_position(f_lvl) + 1;
            string reason = f.get_text(f_reason);
            if (reason == "") {
                speak("Please enter a reason.");
                f.focus(f_reason);
                continue;
            }
            send(0, "/warn " + target + " " + lvl + " " + reason, 1);
            speak("Warning issued.");
            break;
        }
    }
}

