void spawn_custom_undead_form() {
    audio_form f;
    f.create_window("Spawn Custom Undead", false, true);
    
    int f_type = f.create_list("Select Undead Type");
    f.add_list_item(f_type, "bear");
    f.add_list_item(f_type, "wolf");
    f.add_list_item(f_type, "lion");
    f.add_list_item(f_type, "key");
    f.add_list_item(f_type, "graven");
    f.add_list_item(f_type, "ghoul");
    f.add_list_item(f_type, "santa");
    
    int f_hp = f.create_input_box("Custom Health", "1000", "", 10);
    int f_speed = f.create_input_box("Custom Speed (lower is faster, e.g. 100)", "150", "", 5);
    
    int f_ok = f.create_button("Spawn Entity", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_type);
    
    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if(f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if(f.is_pressed(f_ok)) {
            int type_pos = f.get_list_position(f_type);
            string type = "giabear";
            if(type_pos == 0) type = "giabear";
            else if(type_pos == 1) type = "agawolf";
            else if(type_pos == 2) type = "gholion";
            else if(type_pos == 3) type = "ghostkey";
            else if(type_pos == 4) type = "graven";
            else if(type_pos == 5) type = "seaghoul";
            else if(type_pos == 6) type = "santa";
            
            string hp = f.get_text(f_hp);
            string speed = f.get_text(f_speed);
            
            if(!hp.is_digits() || hp == "" || stn(hp) <= 0) {
                speak("Please enter a valid health.");
                f.focus(f_hp);
                continue;
            }
            if(!speed.is_digits() || speed == "" || stn(speed) <= 0) {
                speak("Please enter a valid speed.");
                f.focus(f_speed);
                continue;
            }
            
            last_staff_action_status = "";
            send("staff_spawn_undead " + type + "|" + hp + "|" + speed, 0);
            timer t;
            t.restart();
            while(last_staff_action_status == "" and t.elapsed < 5000) { wait(5); netloop(); }
            break;
        }
    }
}
