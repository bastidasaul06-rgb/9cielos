void play_sound_form() {
    audio_form f;
    f.create_window("Play Sound to Channel Players", false, true);
    int f_sound = f.create_input_box("Sound filename (e.g. exploit.ogg)", "", "", 80);
    int f_ok = f.create_button("Play", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_sound);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string soundname = f.get_text(f_sound);
            if (soundname == "") {
                speak("Please enter a sound file name.");
                f.focus(f_sound);
                continue;
            }
            if (soundname.substr(soundname.length() - 4) == ".ogg") {
                soundname = soundname.substr(0, soundname.length() - 4);
            }
            send(0, "/play " + soundname, 1);
            speak("Play sound command sent.");
            break;
        }
    }
}

void play_sound_pitch_form() {
    audio_form f;
    f.create_window("Play Sound to Channel with Pitch", false, true);
    int f_sound = f.create_input_box("Sound filename", "", "", 80);
    int f_pitch = f.create_input_box("Pitch adjust (-100 to 100)", "0", "", 5);
    int f_ok = f.create_button("Play with Pitch", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_sound);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string soundname = f.get_text(f_sound);
            string pitch = f.get_text(f_pitch);
            if (soundname == "") {
                speak("Please enter a sound file name.");
                f.focus(f_sound);
                continue;
            }
            if (soundname.substr(soundname.length() - 4) == ".ogg") {
                soundname = soundname.substr(0, soundname.length() - 4);
            }
            int pitch_val = stn(pitch);
            if (pitch == "" || pitch_val < -100 || pitch_val > 100) {
                speak("Please enter a valid pitch between -100 and 100.");
                f.focus(f_pitch);
                continue;
            }
            send(0, "/play2 " + soundname + " " + pitch_val, 1);
            speak("Play sound request sent.");
            break;
        }
    }
}

void raw_packet_form() {
    audio_form f;
    f.create_window("Raw Packet Sender", false, true);
    int f_peer = f.create_input_box("Target Peer ID ('all' or numeric ID)", "all", "", 10);
    int f_chan = f.create_input_box("Network Channel", "0", "", 3);
    int f_mess = f.create_input_box("Raw message", "", "", 500);
    int f_ok = f.create_button("Send Packet", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_peer);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string peer = f.get_text(f_peer);
            string chan = f.get_text(f_chan);
            string mess = f.get_text(f_mess);
            if (peer == "") {
                speak("Please enter peer ID.");
                f.focus(f_peer);
                continue;
            }
            if (!chan.is_digits() || chan == "") {
                speak("Please enter network channel.");
                f.focus(f_chan);
                continue;
            }
            if (mess == "") {
                speak("Please enter raw message.");
                f.focus(f_mess);
                continue;
            }
            send(0, "/packet " + peer + " " + chan + " " + mess, 1);
            speak("Packet sent.");
            break;
        }
    }
}

