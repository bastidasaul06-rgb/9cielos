void delete_account_form() {
    audio_form f;
    f.create_window("Delete Player Account", false, true);
    int f_name = f.create_input_box("Username to delete", "", "", 30);
    int f_ok = f.create_button("DELETE ACCOUNT", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_name);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string name = f.get_text(f_name);
            if (name == "") {
                speak("Please enter a username.");
                f.focus(f_name);
                continue;
            }
            int confirm = yesno("Are you absolutely sure you want to PERMANENTLY DELETE " + name + "'s account? This cannot be undone!", "Yes", "No");
            if (confirm == 1) {
                send(0, "/delete " + name, 1);
                speak("Delete command sent.");
                break;
            } else {
                speak("Canceled.");
                f.focus(f_name);
            }
        }
    }
}

