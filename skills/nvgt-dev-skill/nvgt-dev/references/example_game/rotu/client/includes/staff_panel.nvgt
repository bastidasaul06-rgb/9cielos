    audio_form f;
    f.create_window("Move Player to Player", false, true);
    int f_source = f.create_input_box("Source player (Who to move)", "", "", 30);
    int f_dest = f.create_input_box("Destination player (Move to who)", "", "", 30);
    int f_ok = f.create_button("Move", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_source);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string src_p = f.get_text(f_source);
            string dest_p = f.get_text(f_dest);
            if (src_p == "") {
                speak("Please enter source player username.");
                f.focus(f_source);
                continue;
            }
            if (dest_p == "") {
                speak("Please enter destination player username.");
                f.focus(f_dest);
                continue;
            }
            send(0, "/moveplayer " + src_p + " " + dest_p, 1);
            speak("Move player to player request sent.");
            break;
        }
    }
}

void gang_management_menu(bool is_dev, bool is_admin, bool is_mod) {
    while(true) {
        dynamic_menu_pro m;
        m.reset(false);
        m.click_sound = "menuclick.ogg";
        m.enter_sound = "menuenter.ogg";
        m.edge_sound = "menuedge.ogg";
        m.wrap_sound = "menuwrap.ogg";
        m.open_sound = "menuopen.ogg";
        m.enable_first_letter_navigation = true;
        m.enable_up_and_down = true;
        m.set_callback(staff_menu_callback, "");

        m.add_item_tts("View & Manage All Gangs", "list");
        m.add_item_tts("Force Disband Gang By Name", "force_disband");
        m.add_item_tts("Go Back", "back");

        int res = m.run("Gang Management. Select a category.", true);
        string name = m.get_item_name(res);
        if (name == "back" || res <= 0) {
            break;
        }
        else if (name == "list") {
            staff_gang_list_menu();
        }
        else if (name == "force_disband") {
            string gname = txt.input("Enter gang name to force disband", true);
            if (gname != "") {
                int yn = yesno_online("Are you sure you want to FORCE DISBAND the gang " + gname + "? This action will permanently delete this gang!", "Yes, disband", "Cancel");
                if (yn == 1) {
                    send("gang_admin_disband " + gname, 0);
                    wait(300);
                }
            }
        }
    }
}

void staff_gang_list_menu() {
    while(true) {
        string glist = get_gang_list_sync();
        if(glist.is_empty()) {
            dlg("There are no active gangs on the server.");
            break;
        }

        dynamic_menu_pro m;
        m.reset(false);
        m.click_sound = "menuclick.ogg";
        m.enter_sound = "menuenter.ogg";
        m.edge_sound = "menuedge.ogg";
        m.wrap_sound = "menuwrap.ogg";
        m.open_sound = "menuopen.ogg";
        m.enable_first_letter_navigation = true;
        m.enable_up_and_down = true;
        m.set_callback(staff_menu_callback, "");

        string[] gangs_raw = string_split(glist, "|", false);
        for(uint i = 0; i < gangs_raw.length(); i++) {
            string[] gparts = string_split(gangs_raw[i], ":", true);
            if(gparts.length() >= 4) {
                m.add_item_tts("Gang " + gparts[0] + " (Leader: " + gparts[1] + ", " + gparts[2] + " members, Level " + gparts[3] + ")", gangs_raw[i]);
            }
        }
        m.add_item_tts("Go Back", "back");

        int res = m.run("System gang list.", true);
        string name = m.get_item_name(res);
        if(name == "back" or res <= 0) {
            break;
        }

        string[] gparts = string_split(name, ":", true);
        string target_gang = gparts[0];
        string target_leader = gparts[1];
        string target_members = gparts[2];
        string target_level = gparts[3];
        string target_slogan = "";
        if(gparts.length() >= 5) target_slogan = gparts[4];

        dynamic_menu_pro sub;
        sub.reset(false);
        sub.click_sound = "menuclick.ogg";
        sub.enter_sound = "menuenter.ogg";
        sub.edge_sound = "menuedge.ogg";
        sub.wrap_sound = "menuwrap.ogg";
        sub.open_sound = "menuopen.ogg";
        sub.enable_first_letter_navigation = true;
        sub.enable_up_and_down = true;
        sub.set_callback(staff_menu_callback, "");

        sub.add_item_tts("View Details", "info");
        sub.add_item_tts("Assign New Leader", "change_leader");
        sub.add_item_tts("Force Change Slogan", "change_slogan");
        sub.add_item_tts("Force Disband Gang", "disband");
        sub.add_item_tts("Go Back", "back");

        int sub_res = sub.run("Administer gang " + target_gang, true);
        string sub_opt = sub.get_item_name(sub_res);
        if(sub_opt == "info") {
            show_gang_details_menu(target_gang, target_leader, target_slogan, target_level, target_members);
        }
        else if(sub_opt == "change_leader") {
            string new_leader = txt.input("Enter the username of the member you want to promote to the new Leader", true);
            if(new_leader != "") {
                send("gang_admin_leader " + target_gang + "|" + new_leader, 0);
                wait(300);
                break;
            }
        }
        else if(sub_opt == "change_slogan") {
            string new_slg = txt.input("Enter the new slogan to force for this gang", true);
            if(new_slg != "") {
                send("gang_admin_slogan " + target_gang + "|" + new_slg, 0);
                wait(300);
                break;
            }
        }
        else if(sub_opt == "disband") {
            int yn = yesno_online("Are you sure you want to FORCE DISBAND the gang " + target_gang + "?", "Yes, disband", "Cancel");
            if (yn == 1) {
                send("gang_admin_disband " + target_gang, 0);
                wait(300);
                break;
            }
        }
    }
}

void store_management_menu(bool is_dev, bool is_admin) {
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        sm.add_item_tts("List & Edit Store Items", "list_store");
        sm.add_item_tts("Add New Item to Store", "add_store");
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Store Management Menu", true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        if (name == "list_store") {
            list_store_items_menu();
        } else if (name == "add_store") {
            add_store_item_form();
        }
    }
}

void list_store_items_menu() {
    last_store_data = "";
    send("store_req_list", 0);
    
    speak("Loading store items, please wait...");
    timer load_timer;
    load_timer.restart();
    while(last_store_data == "" and load_timer.elapsed < 5000) {
        wait(5);
        netloop();
    }
    
    if(last_store_data == "") {
        speak("Failed to load store data from server. Timeout.");
        return;
    }
    
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        string[] items_raw = string_split(last_store_data, "|", false);
        for(uint i = 0; i < items_raw.length(); i++) {
            if(items_raw[i] == "") continue;
            string[] fields = string_split(items_raw[i], ":", false);
            if(fields.length() >= 4) {
                string name = fields[0];
                string price = fields[1];
                string desc = fields[2];
                string level = fields[3];
                string limit = (fields.length() >= 5) ? fields[4] : "";
                string display_text = name + " - Price: " + price + " Gold (Req Level: " + level + ")";
                if(limit == "*") display_text += " [Paid Only]";
                sm.add_item_tts(display_text, items_raw[i]);
            }
        }
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Select an item to manage", true);
        string select_data = sm.get_item_name(res);
        if (select_data == "back" || res <= 0) break;

        single_item_actions_menu(select_data);
        
        last_store_data = "";
        send("store_req_list", 0);
        load_timer.restart();
        while(last_store_data == "" and load_timer.elapsed < 5000) {
            wait(5);
            netloop();
        }
        if(last_store_data == "") {
            speak("Store data refresh failed.");
            break;
        }
    }
}

void single_item_actions_menu(string item_raw_data) {
    string[] fields = string_split(item_raw_data, ":", false);
    if(fields.length() < 4) return;
    
    string item_name = fields[0];
    string price = fields[1];
    string desc = fields[2];
    string level = fields[3];
    string limit = (fields.length() >= 5) ? fields[4] : "";
    
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        sm.add_item_tts("Edit Item Details", "edit");
        sm.add_item_tts("Delete Item from Store", "delete");
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Manage item: " + item_name, true);
        string opt = sm.get_item_name(res);
        if (opt == "back" || res <= 0) break;

        if (opt == "edit") {
            edit_store_item_form(item_name, price, desc, level, limit);
            break;
        } else if (opt == "delete") {
            int confirm = yesno("Are you sure you want to delete " + item_name + " from the store?", "Yes", "No");
            if (confirm == 1) {
                last_store_action_status = "";
                send("store_delete " + item_name, 0);
                timer act_timer;
                act_timer.restart();
                while(last_store_action_status == "" and act_timer.elapsed < 5000) {
                    wait(5);
                    netloop();
                }
                break;
            }
        }
    }
}

void add_store_item_form() {
    audio_form f;
    f.create_window("Add New Store Item", false, true);
    
    int f_name = f.create_input_box("Item Name (use underscores instead of spaces, e.g. sniper_ammo)", "", "", 50);
    int f_price = f.create_input_box("Price (Gold)", "10", "", 10);
    int f_desc = f.create_input_box("Description", "", "", 200);
    int f_level = f.create_input_box("Minimum Level Required", "1", "", 5);
    
    int f_limit = f.create_list("Paid Players Limit");
    f.add_list_item(f_limit, "No Limit (All Players)");
    f.add_list_item(f_limit, "Yes, Paid Players Only");
    
    int f_ok = f.create_button("Add Item", true);
    int f_cancel = f.create_button("Cancel", false, true);
    
    f.focus(f_name);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string name = f.get_text(f_name);
            string price = f.get_text(f_price);
            string desc = f.get_text(f_desc);
            string level = f.get_text(f_level);
            int limit_pos = f.get_list_position(f_limit);
            string limit = (limit_pos == 1) ? "*" : "";
            
            if (name == "") {
                speak("Please enter item name.");
                f.focus(f_name);
                continue;
            }
            if (string_contains(name, " ", 1) >= 0 || string_contains(name, ":", 1) >= 0) {
                speak("Item name cannot contain spaces or colons.");
                f.focus(f_name);
                continue;
            }
            if (!price.is_digits() || price == "" || stn(price) <= 0) {
                speak("Please enter a valid positive number for price.");
                f.focus(f_price);
                continue;
            }
            if (desc == "") {
                speak("Please enter item description.");
                f.focus(f_desc);
                continue;
            }
            if (string_contains(desc, ":", 1) >= 0 || string_contains(desc, "|", 1) >= 0) {
                speak("Description cannot contain colons or vertical bars.");
                f.focus(f_desc);
                continue;
            }
            if (!level.is_digits() || level == "" || stn(level) <= 0) {
                speak("Please enter a valid positive level.");
                f.focus(f_level);
                continue;
            }
            
            last_store_action_status = "";
            send("store_add " + name + ":" + price + ":" + desc + ":" + level + (limit == "*" ? ":*" : ""), 0);
            
            timer act_timer;
            act_timer.restart();
            while(last_store_action_status == "" and act_timer.elapsed < 5000) {
                wait(5);
                netloop();
            }
            break;
        }
    }
}

void edit_store_item_form(string old_name, string price, string desc, string level, string limit) {
    audio_form f;
    f.create_window("Edit Item: " + old_name, false, true);
    
    int f_name = f.create_input_box("Item Name", old_name, "", 50);
    int f_price = f.create_input_box("Price (Gold)", price, "", 10);
    int f_desc = f.create_input_box("Description", desc, "", 200);
    int f_level = f.create_input_box("Minimum Level Required", level, "", 5);
    
    int f_limit = f.create_list("Paid Players Limit");
    f.add_list_item(f_limit, "No Limit (All Players)");
    f.add_list_item(f_limit, "Yes, Paid Players Only");
    if(limit == "*") {
        f.set_list_position(f_limit, 1);
    }
    
    int f_ok = f.create_button("Save Changes", true);
    int f_cancel = f.create_button("Cancel", false, true);
    
    f.focus(f_name);

    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if (f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if (f.is_pressed(f_ok)) {
            string name = f.get_text(f_name);
            string new_price = f.get_text(f_price);
            string new_desc = f.get_text(f_desc);
            string new_level = f.get_text(f_level);
            int limit_pos = f.get_list_position(f_limit);
            string new_limit = (limit_pos == 1) ? "*" : "";
            
            if (name == "") {
                speak("Please enter item name.");
                f.focus(f_name);
                continue;
            }
            if (string_contains(name, " ", 1) >= 0 || string_contains(name, ":", 1) >= 0) {
                speak("Item name cannot contain spaces or colons.");
                f.focus(f_name);
                continue;
            }
            if (!new_price.is_digits() || new_price == "" || stn(new_price) <= 0) {
                speak("Please enter a valid positive number for price.");
                f.focus(f_price);
                continue;
            }
            if (new_desc == "") {
                speak("Please enter item description.");
                f.focus(f_desc);
                continue;
            }
            if (string_contains(new_desc, ":", 1) >= 0 || string_contains(new_desc, "|", 1) >= 0) {
                speak("Description cannot contain colons or vertical bars.");
                f.focus(f_desc);
                continue;
            }
            if (!new_level.is_digits() || new_level == "" || stn(new_level) <= 0) {
                speak("Please enter a valid positive level.");
                f.focus(f_level);
                continue;
            }
            
            last_store_action_status = "";
            send("store_edit " + old_name + "|" + name + ":" + new_price + ":" + new_desc + ":" + new_level + (new_limit == "*" ? ":*" : ""), 0);
            
            timer act_timer;
            act_timer.restart();
            while(last_store_action_status == "" and act_timer.elapsed < 5000) {
                wait(5);
                netloop();
            }
            break;
        }
    }
}

void tickets_management_menu(bool is_dev, bool is_admin, bool is_mod) {
    while(true) {
        last_tickets_data = "WAITING";
        send("ticket_req_list", 0);
        
        speak("Loading support tickets, please wait...");
        timer t;
        t.restart();
        while(last_tickets_data == "WAITING" and t.elapsed < 5000) {
            wait(5);
            netloop();
        }
        
        if(last_tickets_data == "WAITING") {
            speak("Failed to load tickets. Timeout.");
            return;
        }
        
        if(last_tickets_data == "EMPTY") {
            speak("There are no support tickets in the queue.");
            break;
        }
        
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");

        string[] t_raw = string_split(last_tickets_data, "|", false);
        int ticket_count = 0;
        for(uint i=0; i<t_raw.length(); i++) {
            if(t_raw[i] == "") continue;
            string[] parts = string_split(t_raw[i], ":", false);
            if(parts.length() >= 4) {
                string display = "Ticket #" + parts[0] + " from " + parts[1] + ": " + parts[2] + " [" + parts[3] + "]";
                sm.add_item_tts(display, t_raw[i]);
                ticket_count++;
            }
        }
        sm.add_item_tts("Go Back", "back");

        int res = sm.run("Support Tickets Queue. Active: " + ticket_count, true);
        string name = sm.get_item_name(res);
        if (name == "back" || res <= 0) break;

        string[] parts = string_split(name, ":", false);
        string t_id = parts[0];
        string t_user = parts[1];
        string t_msg = parts[2];
        string t_status = parts[3];
        
        dynamic_menu_pro opt;
        opt.reset(false);
        opt.click_sound = "menuclick.ogg";
        opt.enter_sound = "menuenter.ogg";
        opt.edge_sound = "menuedge.ogg";
        opt.wrap_sound = "menuwrap.ogg";
        opt.open_sound = "menuopen.ogg";
        opt.enable_first_letter_navigation = true;
        opt.enable_up_and_down = true;
        opt.set_callback(staff_menu_callback, "");
        
        opt.add_item_tts("Claim Ticket (Assign to yourself)", "claim");
        opt.add_item_tts("Teleport to Player (" + t_user + ")", "teleport");
        opt.add_item_tts("Close Ticket (Resolve)", "close");
        opt.add_item_tts("Go Back", "back");
        
        int opt_res = opt.run("Ticket #" + t_id + " actions", true);
        string opt_name = opt.get_item_name(opt_res);
        if(opt_name == "claim") {
            last_staff_action_status = "";
            send("ticket_claim " + t_id, 0);
            t.restart();
            while(last_staff_action_status == "" and t.elapsed < 5000) { wait(5); netloop(); }
        }
        else if(opt_name == "teleport") {
            send(0, "/gotoplayer " + t_user, 1);
            break;
        }
        else if(opt_name == "close") {
            last_staff_action_status = "";
            send("ticket_close " + t_id, 0);
            t.restart();
            while(last_staff_action_status == "" and t.elapsed < 5000) { wait(5); netloop(); }
        }
    }
}

void inspect_player_stats_menu(string target) {
    while(true) {
        last_player_info_data = "";
        send("player_req_info " + target, 0);
        
        speak("Requesting player data, please wait...");
        timer t;
        t.restart();
        while(last_player_info_data == "" and t.elapsed < 5000) {
            wait(5);
            netloop();
        }
        
        if(last_player_info_data == "") {
            speak("Failed to load player stats.");
            return;
        }
        
        string[] parts = string_split(last_player_info_data, "|", false);
        if(parts.length() < 11) {
            speak("Error parsing player data.");
            return;
        }
        
        string name = parts[0];
        string lvl = parts[1];
        string exp = parts[2];
        string gold = parts[3];
        string hp = parts[4];
        string map_val = parts[5];
        string x_val = parts[6];
        string y_val = parts[7];
        string z_val = parts[8];
        string ip_val = parts[9];
        string comp_val = parts[10];
        
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");
        
        sm.add_item_tts("Level: " + lvl + " (Press Enter to edit)", "lvl");
        sm.add_item_tts("XP: " + exp + " (Press Enter to edit)", "xp");
        sm.add_item_tts("Gold: " + gold + " (Press Enter to edit)", "gold");
        sm.add_item_tts("Health: " + hp + " (Press Enter to edit)", "hp");
        sm.add_item_tts("Location: Map " + map_val + ", Coordinates " + x_val + ", " + y_val + ", " + z_val, "loc");
        sm.add_item_tts("IP Address: " + ip_val, "ip");
        sm.add_item_tts("Computer ID: " + comp_val, "comp");
        sm.add_item_tts("Go Back", "back");
        
        int res = sm.run("Inspect " + name, true);
        string field = sm.get_item_name(res);
        if(field == "back" || res <= 0) break;
        
        if(field == "lvl") {
            edit_player_stat_form(name, "lvl", "Level", lvl);
        } else if(field == "xp") {
            edit_player_stat_form(name, "xp", "Experience", exp);
        } else if(field == "gold") {
            edit_player_stat_form(name, "gold", "Gold", gold);
        } else if(field == "hp") {
            edit_player_stat_form(name, "hp", "Health", hp);
        }
    }
}

void edit_player_stat_form(string target, string field, string field_display_name, string current_value) {
    audio_form f;
    f.create_window("Edit " + field_display_name + " for " + target, false, true);
    int f_val = f.create_input_box("Enter new " + field_display_name, current_value, "", 10);
    int f_ok = f.create_button("Save", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_val);
    
    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if(f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if(f.is_pressed(f_ok)) {
            string val = f.get_text(f_val);
            if(!val.is_digits() || val == "" || stn(val) < 0) {
                speak("Please enter a valid positive number.");
                f.focus(f_val);
                continue;
            }
            
            last_staff_action_status = "";
            send("player_update_stat " + target + "|" + field + "|" + val, 0);
            timer t;
            t.restart();
            while(last_staff_action_status == "" and t.elapsed < 5000) { wait(5); netloop(); }
            break;
        }
    }
}

void inspect_player_inventory_menu(string target) {
    while(true) {
        last_player_inventory_data = "";
        send("player_req_inv " + target, 0);
        
        speak("Requesting player inventory, please wait...");
        timer t;
        t.restart();
        while(last_player_inventory_data == "" and t.elapsed < 5000) {
            wait(5);
            netloop();
        }
        
        if(last_player_inventory_data == "") {
            speak("Failed to load inventory.");
            return;
        }
        
        string[] parts = string_split(last_player_inventory_data, "|", false);
        string name = parts[0];
        
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");
        
        sm.add_item_tts("Add New Item to " + name + "'s Inventory", "add_item");
        for(uint i=1; i<parts.length(); i++) {
            if(parts[i] == "") continue;
            string[] itm_fields = string_split(parts[i], "=", false);
            if(itm_fields.length() >= 2) {
                sm.add_item_tts(itm_fields[0] + " - Quantity: " + itm_fields[1], parts[i]);
            }
        }
        sm.add_item_tts("Go Back", "back");
        
        int res = sm.run(name + "'s Inventory. Select to edit.", true);
        string select_data = sm.get_item_name(res);
        if(select_data == "back" || res <= 0) break;
        
        if(select_data == "add_item") {
            add_player_item_form(name);
        } else {
            string[] itm_fields = string_split(select_data, "=", false);
            edit_player_item_form(name, itm_fields[0], itm_fields[1]);
        }
    }
}

void edit_player_item_form(string target, string item_name, string current_amount) {
    audio_form f;
    f.create_window("Edit item " + item_name + " for " + target, false, true);
    int f_amt = f.create_input_box("Enter new amount (0 to remove)", current_amount, "", 10);
    int f_ok = f.create_button("Save", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_amt);
    
    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if(f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if(f.is_pressed(f_ok)) {
            string val = f.get_text(f_amt);
            if(!val.is_digits() || val == "" || stn(val) < 0) {
                speak("Please enter a valid positive quantity.");
                f.focus(f_amt);
                continue;
            }
            
            last_staff_action_status = "";
            send("player_update_inv " + target + "|" + item_name + "|" + val, 0);
            timer t;
            t.restart();
            while(last_staff_action_status == "" and t.elapsed < 5000) { wait(5); netloop(); }
            break;
        }
    }
}

void add_player_item_form(string target) {
    audio_form f;
    f.create_window("Add item to " + target, false, true);
    int f_name = f.create_input_box("Item Name (e.g. rifle, gold)", "", "", 50);
    int f_amt = f.create_input_box("Quantity", "1", "", 10);
    int f_ok = f.create_button("Add", true);
    int f_cancel = f.create_button("Cancel", false, true);
    f.focus(f_name);
    
    while(f.active) {
        wait(5);
        netloop();
        f.monitor();
        if(f.is_pressed(f_cancel) || key_pressed(KEY_ESCAPE)) break;
        if(f.is_pressed(f_ok)) {
            string name = f.get_text(f_name);
            string val = f.get_text(f_amt);
            if(name == "") {
                speak("Please enter item name.");
                f.focus(f_name);
                continue;
            }
            if(!val.is_digits() || val == "" || stn(val) <= 0) {
                speak("Please enter a valid positive quantity.");
                f.focus(f_amt);
                continue;
            }
            
            last_staff_action_status = "";
            send("player_update_inv " + target + "|" + name + "|" + val, 0);
            timer t;
            t.restart();
            while(last_staff_action_status == "" and t.elapsed < 5000) { wait(5); netloop(); }
            break;
        }
    }
}

void view_live_server_stats_menu() {
    last_server_stats_data = "";
    send("svr_req_stats", 0);
    
    speak("Loading server stats, please wait...");
    timer t;
    t.restart();
    while(last_server_stats_data == "" and t.elapsed < 5000) {
        wait(5);
        netloop();
    }
    
    if(last_server_stats_data == "") {
        speak("Failed to load server stats.");
        return;
    }
    
    string[] parts = string_split(last_server_stats_data, "|", false);
    if(parts.length() < 8) return;
    
    while(true) {
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");
        
        sm.add_item_tts("Uptime: " + parts[0], "uptime");
        sm.add_item_tts("Peak Online Players: " + parts[1], "peak");
        sm.add_item_tts("Undead Animals active: " + parts[2], "undead");
        sm.add_item_tts("Active players online: " + parts[3], "players");
        sm.add_item_tts("Network: " + parts[4] + " connections, " + parts[5] + " disconnections", "net");
        sm.add_item_tts("Received: " + parts[6] + ", Sent: " + parts[7], "net_traffic");
        sm.add_item_tts("Go Back", "back");
        
        int res = sm.run("Live Server Monitor", true);
        string opt = sm.get_item_name(res);
        if(opt == "back" || res <= 0) break;
    }
}

void ban_list_manager_menu() {
    while(true) {
        last_server_banlist_data = "";
        send("svr_req_banlist", 0);
        
        speak("Loading ban lists, please wait...");
        timer t;
        t.restart();
        while(last_server_banlist_data == "" and t.elapsed < 5000) {
            wait(5);
            netloop();
        }
        
        if(last_server_banlist_data == "") {
            speak("Failed to load ban list.");
            return;
        }
        
        string[] parts = string_split(last_server_banlist_data, "|", true);
        if(parts.length() < 2) {
            speak("Error: Invalid ban list data format.");
            return;
        }
        string[] ips = string_split(parts[0], ",", false);
        string[] comps = string_split(parts[1], ",", false);
        
        dynamic_menu_pro sm;
        sm.reset(false);
        sm.click_sound = "menuclick.ogg";
        sm.enter_sound = "menuenter.ogg";
        sm.edge_sound = "menuedge.ogg";
        sm.wrap_sound = "menuwrap.ogg";
        sm.open_sound = "menuopen.ogg";
        sm.enable_first_letter_navigation = true;
        sm.enable_up_and_down = true;
        sm.set_callback(staff_menu_callback, "");
        
        sm.add_item_tts("--- Banned IP Addresses (" + (parts[0] == "" ? 0 : ips.length()) + ") ---", "header_ips");
        if(parts[0] != "") {
            for(uint i=0; i<ips.length(); i++) {
                if(ips[i] != "") sm.add_item_tts("IP: " + ips[i] + " (Press Enter to Unban)", "unban_ip|" + ips[i]);
            }
        }
        
        sm.add_item_tts("--- Banned Computer IDs (" + (parts[1] == "" ? 0 : comps.length()) + ") ---", "header_comps");
        if(parts[1] != "") {
            for(uint i=0; i<comps.length(); i++) {
                if(comps[i] != "") sm.add_item_tts("ID: " + comps[i] + " (Press Enter to Unban)", "unban_comp|" + comps[i]);
            }
        }
        sm.add_item_tts("Go Back", "back");
        
        int res = sm.run("IP & Comp ID Ban Manager", true);
        string opt = sm.get_item_name(res);
        if(opt == "back" || res <= 0) break;
        
        if(opt.substr(0, 8) == "unban_ip") {
            string target_ip = string_replace(opt, "unban_ip|", "", false);
            int yn = yesno("Are you sure you want to unban IP " + target_ip + "?", "Yes", "No");
            if(yn == 1) {
                last_staff_action_status = "";
                send("svr_unban_ip " + target_ip, 0);
                t.restart();
                while(last_staff_action_status == "" and t.elapsed < 5000) { wait(5); netloop(); }
            }
        }
        else if(opt.substr(0, 10) == "unban_comp") {
            string target_comp = string_replace(opt, "unban_comp|", "", false);
            int yn = yesno("Are you sure you want to unban Computer ID " + target_comp + "?", "Yes", "No");
            if(yn == 1) {
                last_staff_action_status = "";
                send("svr_unban_comp " + target_comp, 0);
                t.restart();
                while(last_staff_action_status == "" and t.elapsed < 5000) { wait(5); netloop(); }
            }
        }
    }
}

