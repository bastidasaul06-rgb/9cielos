fl.open(charfolder+"/trustlist.usr","w");
fl.write(players[ie].trusted);
fl.close();
fl.open(charfolder+"/mate.usr","w");
fl.write(players[ie].mate);
fl.close();
fl.open(charfolder+"/pallow1.usr","w");
fl.write(players[ie].pallow1);
fl.close();
