fl.write(players[ie].arenacount);
fl.close();
fl.open(charfolder+"/creaturearenacount.usr","wb");
fl.write(players[ie].creaturearenacount);
fl.close();
fl.open(charfolder+"/meleecount.usr","wb");
fl.write(players[ie].meleecount);
fl.close();
fl.open(charfolder+"/energycount.usr","wb");
fl.write(players[ie].energycount);
fl.close();
