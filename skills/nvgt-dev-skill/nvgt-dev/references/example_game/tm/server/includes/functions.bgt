for(uint i=0; i<stores.length(); i++)
{
for(int i2=0; i2<stores[i].item_names.length(); i2++)
{
printout+=stores[i].item_names[i2]+"="+stores[i].prices[i2]+"="+stores[i].descriptions[i2]+"="+stores[i].name+"\r\n";
}
}
fl.open("prefs/store.svr","wb");
fl.write(printout);
fl.close();
printout="";
