void checkma(player@ p=null)
{
	if(@p!=null) //idk how to fix this
	{
		string[] files=find_directories("chars/*");
		string data;
		string caught_str;
		string w;
		w="warning: "+p.name+" has these accounts: \r\n";
		for (uint i=0; i<files.length(); i++)
		{
			f.open("chars/"+files[i]+"/compid.usr", "rb");
			data=f.read();
			if(data==p.compid)
			{
				if(files[i]==p.name)
				{
					continue;
				}
				caught_str+=files[i]+". \r\n";
			}
			f.close();
		}
		if(caught_str.is_empty()) return;
		admintell(w+caught_str);
	}
}
