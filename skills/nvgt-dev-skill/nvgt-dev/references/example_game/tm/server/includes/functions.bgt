void creaturearenaloop() {
if(hunters<0) {
hunters=0;
admintell("Dibug alert! creaturearena hunters automatically reset to 0!");
}
if(hunting==true) {
//if(hunters==1) {
for(int i2=0; i2<players.length(); i2++) {
if(players[i2].map=="creature_arena" and players[i2].creaturehunted==true) {
players[i2].creaturearenacount++;
send(players[i2].peer_id,"you have gained one more resurrection, and your victory count has now been raised to "+players[i2].creaturearenacount+". Nice job!",2);
players[i2].on_creaturearena=false;
players[i2].creaturehunted=false;
move_player(players[i2],players[i2].oldmap,players[i2].oldx,players[i2].oldy,players[i2].oldz);
players[i2].re+=1;
send(0,"play_s notify_woosh.ogg",0);
players[i2].level=1;
players[i2].xp=0;
players[i2].xprequired=125;
players[i2].maxhealth+=1000000;
send(0,"alert! the player  "+players[i2].name+"! has reached level 1500 and has been resurrected! As a reward, his maximom health has been increased by 1000000, resulting in a total of "+players[i2].maxhealth+"!",2);
hunting=false;
send(0,"the player " +players[i2].name+" just slayed the eoraptor and completed the hunt! many many congratulations to them!",2);
send(0,"play_s arenawin.ogg",0);
hunters=0;
creaturearenastarted=true;
creaturearena_opend=false;
eoraptorsmash();
if(players[i2].creaturearenacount==10)
{
send(0,"the player "+players[i2].name+" just won ten times in the creaturearena. they now will get to claim one of the creaturearena gifts!",2);
 send(players[i2].peer_id,"arenagifts",0);
}
return;
}
}
if(hunting==true)
{
if(hunters<=0)
{
send(0,"oopsy! it seems nobody won. the eoraptor smashed everyone away, causing the hunt to come to a stop. better luck next time, hunters!",2);
hunting=false;
hunters=0;
creaturearena_opend=false;
eoraptorsmash();
creaturearenastarted=false;
return;
}
}
for(uint i4=0; i4<players.length(); i4++) {
if(players[i4].map=="creature_arena" and players[i4].x==50 and players[i4].y==50 and players[i4].z==10) {
move_player(players[i4],players[i4].oldmap,players[i4].oldx,players[i4].oldy,players[i4].oldz);
send(players[i4].peer_id,"startmoving",0);
return;
}
}
}
if(creaturearenastarted==true)
{
for(uint i5=0; i5<players.length(); i5++)
{
if(players[i5].map=="creature_arena")
{
move_player(players[i5],players[i5].oldmap,players[i5].oldx,players[i5].oldy,players[i5].oldz);
creaturearenastarted=false;
players[i5].on_creaturearena=false;
hunting=false;
hunters=0;
creaturearena_opend=false;
eoraptorsmash();
players[i5].creaturehunted=false;
}
}
}
if(creaturearena_opend==true) {
huntstarted=true;
if(hunttimer.elapsed>=50000) {
if(ftime==false)
{
send(0,"attention! You have 10 seconds left to join!",2);
send(0,"play_s 22.ogg",0);
ftime=true;
}
}
if(hunttimer.elapsed>60000) {
hunttimer.restart();
hunting=true;
if (hunting==true) {
if(hunters==1) {
for(uint i3=0; i3<players.length(); i3++) {
if(players[i3].map=="creature_arena_wait") {
move_player(players[i3],players[i3].oldmap,players[i3].oldx,players[i3].oldy,players[i3].oldz);
players[i3].on_creaturearena=false;
send(players[i3].peer_id,"startmoving",0);
hunting=false;
huntstarted=false;
creaturearena_opend=false;
hunters=0;
send(0,"not enough players",2);
send(0,"play_s arenaclose.ogg",0);
players[i3].creaturehunted=false;
creaturearenastarted=false;
return;
}
}
}
if(hunters==0) {
hunting=false;
huntstarted=false;
creaturearena_opend=false;
send(0,"not enough players to hunt",2);
send(0,"play_s arenaclose.ogg",0);
creaturearenastarted=false;
return;
}
else
{
huntstarted=false;
creaturearenatimer.restart();
send(0,"The hunt has begun! good luck to all the players!",2);
send(0,"play_s arenastart.ogg",0);
eoraptorsmash();
spawn_eoraptor(50,50,0,"creature_arena");
for(uint i=0; i<players.length(); i++) {
if(players[i].map=="creature_arena_wait") {
players[i].creaturehunted=false;
creaturearenastarted=false;
move_player(players[i],"creature_arena",random(0,100),random(0,100),0);
send(players[i].peer_id,"startmoving",0);
creaturearena_opend=false;
}
}
}
}
}
}
}
