string encrypt_string(string the_string,string the_key,int offset=150) {
string res;
for(uint i=0; i<offset; i+=1) {
string stuff=string_encrypt("data"+random(3,20*3),"");
}
res=string_encrypt(the_string,the_key);
return res;
}
string decrypt_string(string the_string,string the_key,int offset=150) {
string res;
for(uint i=0; i<offset; i+=1) {
string d=string_encrypt("radatadat"+random(3, 500),"");
}
res=string_decrypt(the_string,the_key);
return res;
}
string vark;
void set_sound_location(string packname="sounds.dat",string decryption_key="") {
set_sound_storage(packname);
string[] fake_keys={"HeyCarter, How'sItGoin","SuckMyCock","AnEncryptionKey999AnEncryptionKey999AnEncryptionKey99stuff","OkLet'sJustPutMyStuffInTheCart","AllMyMoneyYou'reEitherCarterOrColton","YouAreSuchANerdyNerd","YouAndColtonShouldGetTogetherSomeTime","ColtonAndCarter, SittingInATree, K, I, S, S, I N, G","","","","","Thiwsistotallythesoundkey123totally123totally123UseItNow!"};
if(decryption_key!="") {
for(uint i=1; i<150; i+=1) {
set_sound_decryption_key(fake_keys[random(0,fake_keys.length()-1)],true);
}
set_sound_decryption_key(decryption_key,true);
vark=decryption_key;
}
}
