void autobackup()
{
if(autotimer.elapsed>=900000)
{
autotimer.restart();
directory_delete("backup");
send(0,"an automatic backup system just arrived to take all the backups of the alliances, shelters, as well as players! this might take a few seconds, please cooperate.",2);
send(0,"play_s notify1.ogg",0);
if(butimer.elapsed>5000)
{
butimer.restart();
backup();
}
}
}
void use_dollar(string p1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string items=players[index].get_inv();
string []parameters;
string[] list;
double dollar=0;
string []pr=string_split(p1, "@", true);
string []pr1=string_split(p1, "@", true);
string []r;
string []p;
while(true)
{
netloop();
wait(5);
for(int i=0; i<pr1.length(); i++) {
r=string_split(pr1[i], ":", true);
dollar+=stn(r[2]);
}
if(inv_item_number(items,"dollar")<dollar or dollar <0)
//if(players[index].inv_item_number("dollar")<dollar or dollar<0)
{
send(players[index].peer_id, "you don't have enough money. better come back later.", 2);
return;
}
for(int i=0; i<pr.length(); i++) {
netloop();
p=string_split(pr[i], ":", true);
players[index].give(p[0],stn(p[2])); players[index].give("dollar",-stn(p[1]));
if(stn(p[2])>0) list.insert_last(stn(p[2])+" "+p[0]);
}
if(list.length()>0)
{
send(players[index].peer_id, "purchase completed successfully", 2);
send(players[index].peer_id,"You bought "+convert_to_list(list),2);
}
else send(players[index].peer_id, "The transaction was canceled, your shopping cart is empty", 2);
break;
}
}
}
