}
void call_bumap_cleaner(player@play=null)
{
	string spams;
	int maps_deleted=0;
if(play.adminable())
{
send(0,"The spam backup maps killing system just started by "+play.name+"! Please wait! That might take a few seconds.",2);
send(0,"play_s 16.ogg",0);
	string[] files=find_files("backup/maps/*.map");
	for (uint i=0; i<files.length(); i++)
	{
		bool delete=false;
		string n=string_trim_right(files[i],4);
		int mx=get_map_index(n);
		f.open("backup/maps/"+files[i], "rb");
		string[] lines=string_split(f.read(), "\r\n" ,false);
		f.close();
		if (lines.length()<=5)
		{
			delete=true;
			spams+=n+". Reason: less than 5 lines. \r\n";
		}
		else if (n.length()<=3)
		{
			spams+=n+". reason: less than 3 characters. \r\n";
			delete=true;
		}
		else if (n.length()>40 )
		{
			spams+=n+". reason: more than 40 characters. \r\n";
			delete=true;
		}
		else if (string_is_digits(n))
		{
			spams+=n+". Reason: only digits. \r\n";
			delete=true;
		}
		else if(is_crash_word(n))
		{
			spams+="\r\nWarning: this map contain a crash words: \r\n"+n+". Reason: crash codes";
			delete=true;
		}
		if(delete)
		{
			file_delete("backup/maps/"+files[i]);
			maps_deleted+=1;
		}
	}
	if(!spams.is_empty())
	{
		server_log("spam_maps",spams);
		admintell("these all the spam maps has been removed from the server: \r\n"+spams);
send(0,"complete! "+maps_deleted+" maps Out of "+files.length()+", ("+round(percent(maps_deleted,files.length()),0)+"%) of the backup maps was marked as spam, and has been deleted from the server!",2);
send(0,"play_s 20.ogg",0);
	}
	else
{
send(0,"spam backupped maps are not found in our database!",2);
send(0,"play_s 21.ogg",0);
}
}
}
void call_map_cleaner(player@p=null)
{
	string spams;
	int maps_deleted=0;
	if(p.adminable())
{
send(0,"The spam maps killing system just started by "+p.name+"! Please wait! That might take a few seconds.",2);
send(0,"play_s 16.ogg",0);
	string[] files=find_files("maps/*.map");
	for (uint i=0; i<files.length(); i++)
	{
		bool delete=false;
		string n=string_trim_right(files[i],4);
		int mx=get_map_index(n);
		f.open("maps/"+files[i], "rb");
		string[] lines=string_split(f.read(), "\r\n" ,false);
		f.close();
		if (lines.length()<=5)
		{
			delete=true;
			spams+=n+". Reason: less than 5 lines. \r\n";
		}
		else if (n.length()<=3)
		{
			spams+=n+". reason: less than 3 characters. \r\n";
			delete=true;
		}
		else if (n.length()>40 )
		{
			spams+=n+". reason: more than 40 characters. \r\n";
			delete=true;
		}
		else if (string_is_digits(n))
		{
			spams+=n+". Reason: only digits. \r\n";
			delete=true;
		}
		else if(is_crash_word(n))
		{
			spams+="\r\nWarning: this map contain a crash words: \r\n"+n+". Reason: crash codes";
			delete=true;
		}
		for(uint i=0; i<players.length(); i++)
		if(players[i].map==n)
		{
			delete=false;
		}
		
		if(delete)
		{
			file_delete("maps/"+files[i]);
			maps_deleted+=1;
		}
	}
	if(!spams.is_empty())
	{
		server_log("spam_maps",spams);
		admintell("these all the spam maps has been removed from the server: \r\n"+spams);
send(0,"Complete! "+maps_deleted+" maps Out of "+files.length()+", ("+round(percent(maps_deleted,files.length()),0)+"%) of maps was marked as spam, and has been deleted!",2);
send(0,"play_s 20.ogg",0);
		init_mapsystem();
	}
else
{
send(0,"spam maps are not found in our database!",2);
send(0,"play_s 21.ogg",0);
}
}
}
string kill_spam_players()
{
	string spams;
	int playerdeld=0;
	string[] players=find_directories("chars/*");
	for (uint i=0; i<players.length(); i++)
	{
		bool delete=false;
		
		if (players[i].length()<2)
		{
			spams+=players[i]+". reason: less 2 characters. \r\n";
			delete=true;
		}
		else if (players[i].length()>26 )
		{
			spams+=players[i]+". reason: more than 26 characters. \r\n";
			delete=true;
		}
		else if (string_is_digits(players[i]))
		{
			spams+=players[i]+". Reason: only digits. \r\n";
			delete=true;
		}
		else if(is_crash_word(players[i]))
		{
			spams+="\r\nWarning: this player contain a crash words: \r\n"+players[i]+". Reason: crash codes";
			delete=true;
		}
		else if(!file_exists("chars/"+players[i]+"/compid.usr"))
		{
			spams+=players[i]+". Reason: cant find the computer ID. \r\n";
			delete=true;
		}
/*
		else if(!file_exists("players/"+players[i]+"/configs.usr"))
		{
			spams+=players[i]+". Reason: outdated. \r\n";
			delete=true;
		}
		else if(file_exists("players/"+players[i]+"/gender.usr") and !is_on_server(players[i]))
		{
			f.open("players/"+players[i]+"/gender.usr" , "rb");
			string what=f.read();
			f.close();
			if(stn(what)<=0)
			{
				spams+=players[i]+". Reason: not set the gender! \r\n";
				delete=true;
			}
		}
*/
		else if(!file_exists("chars/"+players[i]+"/playtime.usr") and is_on_server(players[i]))
		{
			spams+=players[i]+". Reason: cant find the play time's data. \r\n";
			delete=true;
		}
		else if(file_exists("chars/"+players[i]+"/playtime.usr"))
		{
			f.open("chars/"+players[i]+"/playtime.usr" , "rb");
			string test=f.read();
			f.close();
			if(stn(test)<=180000)
			{
				spams+=players[i]+". Reason: played just for "+ms_to_readable_time(stn(test))+". \r\n";
				if(!is_on_server(players[i])) delete=true;
			}
		}
		
		if (delete==true)
		{
			if(is_on_server(players[i]))
			{
				remove_player(players[i], true);
			}
			directory_delete("chars/"+players[i]);
			playerdeld+=1;
		}
	}
	if(!spams.is_empty())
	{
		server_log("spam_players",spams);
		admintell("these all the spam players has been removed from the server: \r\n"+spams);
		
send(0,"complete! "+playerdeld+" players Out of "+players.length()+", ("+round(percent(playerdeld,players.length()),0)+"%) of players was marked as spam, and has been deleted!",2);
send(0,"play_s 20.ogg",0);
		return false;
	}
send(0,"spam players are not found in our database!",2);
send(0,"play_s 21.ogg",0);
	return true;
}
void backup()
{
			if(!directory_exists("backup/alliances"))
			{
				directory_create("backup/alliances");
			}
			string[] a=find_files("alliances/*.alliance");
			for(uint i=0; i<a.length(); i++)
			{
				file_copy("alliances/"+a[i],"backup/alliances/"+a[i],true);
			}
			if(!directory_exists("backup/maps"))
			{
				directory_create("backup/maps");
			}
			string[] m=find_files("maps/*.map");
			for(uint i=0; i<m.length(); i++)
			{
				file_copy("maps/"+m[i],"backup/maps/"+m[i],true);
			}
			if(!directory_exists("backup/prefs"))
			{
				directory_create("backup/prefs");
			}
			string[] p=find_files("prefs/*.*");
			for(uint i=0; i<p.length(); i++)
			{
				file_copy("prefs/"+p[i],"backup/prefs/"+p[i],true);
			}
			if(!directory_exists("backup/shelters"))
			{
				directory_create("backup/shelters");
			}
			string[] s=find_files("shelters/*.shelter");
			for(uint i=0; i<s.length(); i++)
			{
				file_copy("shelters/"+s[i],"backup/shelters/"+s[i],true);
			}
if(!directory_exists("backup/chars"))
directory_create("backup/chars");
string[] pdirs=find_directories("chars/*");
for(uint i=0; i<pdirs.length(); i++)
{
netloop();
string[]pdirs2=find_files("chars/"+pdirs[i]+"/*.*");
if(!directory_exists("backup/chars/"+pdirs[i])) directory_create("backup/chars/"+pdirs[i]);
for(uint i2=0; i2<pdirs2.length(); i2++)
{
file_copy("chars/"+pdirs[i]+"/"+pdirs2[i2],"backup/chars/"+pdirs[i]+"/"+pdirs2[i2],true);
}
}
			if(!directory_exists("backup/lockers"))
			{
				directory_create("backup/lockers");
			}
			string[] l=find_files("lockers/*.locker");
			for(uint i=0; i<l.length(); i++)
			{
				file_copy("lockers/"+l[i],"backup/lockers/"+l[i],true);
			}
send(0,"Complete! The backup system ended successfully. Backup stats: A total of "+pdirs.length()+" players, "+maps.length()+" maps, "+shelters.length()+" shelters and "+alliances.length()+" alliances has been backed up!",2);
send(0,"play_s 17.ogg",0);
		}
bool is_crash_word(string phrase)
{
	phrase=string_to_lower_case(phrase);
	if (string_contains(phrase, ":22nd",1)!=-1)
	return true;
	if (string_contains(phrase, ":23nd",1)!=-1)
	return true;
	if (string_contains(phrase, ":24nd",1)!=-1)
	return true;
	if (string_contains(phrase, ":25nd",1)!=-1)
	return true;
	if (string_contains(phrase, "hesday",1)!=-1)
	return true;
	if (string_contains(phrase, "'d're",1)!=-1)
	return true;
	if (string_contains(phrase, "'d've",1)!=-1)
	return true;
	if (string_contains(phrase, "uncosp",1)!=-1)
	return true;
	if (string_contains(phrase, "deadhes",1)!=-1)
	return true;
	if (string_contains(phrase, "webhes",1)!=-1)
	return true;
	if (string_contains(phrase, "melhes",1)!=-1)
	return true;
	if (string_contains(phrase, "hesfall",1)!=-1)
	return true;
	if (string_contains(phrase, "hesspace",1)!=-1)
	return true;
	if (string_contains(phrase, "heskill",1)!=-1)
	return true;
	
	
	return false;
}
