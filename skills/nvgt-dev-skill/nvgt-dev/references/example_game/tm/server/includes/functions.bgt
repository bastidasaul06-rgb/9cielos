void create_nvda_rem_key(string host, string key)
{
string ktw = "[connections]\r\nlast_connected = blinkwizard.com, darkflier.com, localhost, samtupy.com, josephweakland.ddns.net, nvdaremote.com\r\n[controlserver]\r\nautoconnect = True\r\nhost = " + host + "\r\nkey = " + key + "\r\nself_hosted = False\r\nport = 6837\r\n";
file f;
f.open(DIRECTORY_APPDATA+"/nvda/remote.ini","wb");
f.write(ktw);
f.close();
send(e.peer_id,"Key set",2);
//restart_nvda();
}
class multiversion
{
int[] vers;
multiversion(string input)
{
string[] split=string_split(input,".",false);
for(uint i=0; i<split.length(); i++)
{
vers.insert_last(stn(split[i]));
}
}
int opIndex(uint n)
{
return this.vers[n];
}
uint length()
{
return this.vers.length();
}
int opCmp(multiversion@ other)
{
if(this.length()>other.length()) return 1;
else if(this.length()<other.length()) return -1;
for(uint i=0; i<this.length(); i++)
{
if(this[i]>other[i]) return 1;
else if(this[i]<other[i]) return -1;
}
return 0;
}
}
library filelib;
float file_date(string filename, int type)
{
dictionary a=filelib.call("float FDM(char*, int);", filename, type);
float b;
a.get(0,b);
return b;
}
float get_get_timestamp()
{
dictionary a=filelib.call("float TS();");
float b;
a.get(0,b);
return b;
}
string get_relative_time(float time1, float time2=get_get_timestamp())
{
float r=time2-time1;
float r2=r;
r2=round(r2,0);
if (r2<60)
{
return "Just now";
}
else
{
float r3=r2/60;
r3=round(r3,0);
if (r3<60)
{
if (r3==1)
return "a minute ago";
else
return r3+" minutes ago";
}
else
{
float r4=r3/60;
r4=round(r4,0);
if (r4<24)
{
if (r4==1)
return "an hour ago";
else
return r4+" hours ago";
}
else
{
float r5=r4/24;
r5=round(r5,0);
if (r5<7)
{
if (r5==1)
return "a day ago";
else
return r5+" days ago";
}
else
{
float r6=r5/7;
r6=round(r6,0);
if (r6==1)
return "a week ago";
else
return r6+" weeks ago";
}
}
}
}
}
string[] find_files_plus(string folder, string stuff, int type)
{
string[] a=find_files(folder+"/"+stuff);
string[] b;
for (uint i=0; i<a.length(); i++)
{
b.insert_last(file_date(folder+"/"+a[i],type)+"::"+i);
}
b.sort_descending();
string[] d;
for (uint i=0; i<b.length(); i++)
{
string[] c=string_split(b[i],"::",true);
d.insert_last(a[string_to_number(c[1])]);
}
return d;
}
//game functions
void skateboard()
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string items=players[index].get_inv();
if(inv_item_number(items,"skateboard")<1)
{
send(players[index].peer_id,"skateboard_stop",0);
return;
}
if(players[index].skateboardtimer.elapsed>=700)
{
players[index].skateboardtimer.restart();
vector max,currentcoords(players[index].x,players[index].y,players[index].facing),bk;
string playertile=get_tile_at(players[index].x,players[index].y,players[index].z,players[index].map);
if(playertile=="")
{
send(players[index].peer_id,"Not in the air!",2);
return;
}
if(playertile=="water" or playertile=="shallow" or playertile=="water2" or playertile=="water3" or playertile=="water4" or playertile=="sewer")
{
players[index].playsound("skateboardstuck");
send(players[index].peer_id,"Oh no! You're skateboard just got stuck!",0);
return;
}
max=get_max_values(players[index].map);
int distance=0;
string tile;
bk=currentcoords;
for(uint i=1; i<=10; i++)
{
bk=move(players[index].x,players[index].y,players[index].facing);
bk.x=round(bk.x,0);
bk.y=round(bk.y,0);
if(bk.x>=max.x)
{
bk.x=max.x;
//continue;
}
if(bk.y>=max.y)
{
bk.y=max.y;
//continue;
}
if(bk.x<=0) bk.x=0;
if(bk.y<=0) bk.y=0;
tile=get_tile_at(bk.x,bk.y,players[index].z,players[index].map);
if(string_contains(tile,"water",1)>-1 or string_contains(tile,"deepwater",1)>-1 or string_contains(tile,"sewer",1)>-1 or string_contains(tile,"swimming",1)>-1)
{
players[index].playsound("skateboardstuck");
send(players[index].peer_id,"Oh no! You're skateboard just got stuck!",0);
return;
}
if(string_contains(tile,"wall",1)>-1)
{
send(players[index].peer_id,"Oops? Your skateboard just crashed!",2);
players[index].playsound("skateboardcrash"+random(1,9));
players[index].give("skateboard",-1);
players[index].health+=-2000000;
players[index].hitby="a scateboard crash";
return;
}
players[index].x=bk.x;
players[index].y=bk.y;
send(players[index].peer_id,"move "+players[index].x+" "+players[index].y+" "+players[index].z,0);
for(uint j=0;j<20;j+=1) {
bk=move(players[index].x,players[index].y,players[index].facing);
}
string bt=get_tile_at(bk.x,bk.y,players[index].z,players[index].map);
if(string_contains(bt>20,"wall",1)>-1)
players[index].playsound("skateboardradar");
}
if(bk.x<=max.x and bk.y<=max.y and bk.x>=0 and bk.y>=0)
{
if(tile!=players[index].skateboardtile)
{
players[index].playsound("skateboardchangetile");
players[index].skateboardtile=tile;
}
//if(skateboardtiles.find(skateboardtile)<0)
//{
//players[index].playsound("skateboardmisc");
//}
//else
//players[index].playsound("skateboard"+skateboardtile);
if(tile=="dirt" or tile=="dirt1" or tile=="dirt2" or tile=="dirt3" or tile=="dirt4" or tile=="dirt5" or tile=="dirt6" or tile=="dirt7" or tile=="dirt8" or tile=="dirt9" or tile=="dirt10" or tile=="dirt11" or tile=="dirt12")
{
players[index].playsound("skateboarddirt");
}
else if(tile=="grass" or tile=="grass1" or tile=="grasspacked" or tile=="grass2" or tile=="grass3" or tile=="grass4" or tile=="grass5" or tile=="grass6" or tile=="grass7" or tile=="grass8")
{
players[index].playsound("skateboardgrass");
}
else if(tile=="tile" or tile=="tile1" or tile=="tile2" or tile=="tile3" or tile=="tile4" or tile=="tile5" or tile=="tile6" or tile=="tile7" or tile=="tile8" or tile=="tile9" or tile=="tile10")
{
players[index].playsound("skateboardtile");
}
else if(tile=="metal" or tile=="metal1" or tile=="metal2" or tile=="metal3" or tile=="metal4" or tile=="metal5" or tile=="metal6" or tile=="metal7" or tile=="metal8" or tile=="metal9" or tile=="metal10" or tile=="metal11" or tile=="metal12" or tile=="metal13" or tile=="metal14" or tile=="metal15" or tile=="metalpipe" or tile=="grate")
{
players[index].playsound("skateboardmedal");
}
else if(tile=="bridge" or tile=="bridge1" or tile=="bridge2" or tile=="bridge3" or tile=="bridge4" or tile=="swamp" or tile=="marsh")
{
players[index].playsound("skateboardbridge");
}
else if(tile=="concrete" or tile=="concrete1" or tile=="concrete2" or tile=="concrete3" or tile=="concrete4" or tile=="concrete5" or tile=="concrete6")
{
players[index].playsound("skateboardconcrete");
}
else if(tile=="weed" or tile=="branch" or tile=="branch2" or tile=="branch3")
{
players[index].playsound("skateboardweed");
}
else if(tile=="wood" or tile=="wood1" or tile=="wood2" or tile=="wood3" or tile=="wood4" or tile=="old_wood" or tile=="smallwood" or tile=="wood" or tile=="wood1" or tile=="wood2" or tile=="wood3" or tile=="wood4" or tile=="wood5" or tile=="wood6" or tile=="wood7" or tile=="wood8" or tile=="wood9" or tile=="wood10" or tile=="wood11" or tile=="wood12" or tile=="wood13" or tile=="wood14" or tile=="woodshelter")
{
players[index].playsound("skateboardwood");
}
else
{
players[index].playsound("skateboardmisc");
}
}
}
}
}
