wand_blocker@[] wand_blockers(0);
class wand_blocker
{
string owner;
timer explodetimer;
int z;
string map;
int x, y;
wand_blocker(int tx,int ty,int tz, string tmap, string towner)
{
owner=towner;
x=tx;
y=ty;
z=tz;
map=tmap;
play("wand_blockerplace",x,y,z,map);
}
}
void wand_blockerloop()
{
for (uint i=0; i<wand_blockers.length(); i++)
{
if(wand_blockers[i].explodetimer.elapsed>=6000)
{
wand_blockers[i].explodetimer.restart();
//play("stungrenade",wand_blockers[i].x,wand_blockers[i].y,wand_blockers[i].z,wand_blockers[i].map);
send(0,"distsound wand_blocker "+wand_blockers[i].x+" "+wand_blockers[i].y+" "+wand_blockers[i].z+" "+wand_blockers[i].map,0);
for (uint i2=0; i2<players.length(); i2++)
{
if(players[i2].invinsible==true || players[i2].is_protected==true || players[i2].robotmode==true || players[i2].newb==1 || players[i2].is_dead==true||in_vehicle(players[i2].name)>-1) continue;
if (get_3d_distance(wand_blockers[i].x,wand_blockers[i].y,wand_blockers[i].z,players[i2].x,players[i2].y,players[i2].z)<=50 and players[i2].map==wand_blockers[i].map)
{
if(wand_blockers[i].owner==players[i2].name) continue;
if(are_allianceed(wand_blockers[i].owner,players[i2].name)) continue;
players[i2].hit(5000000,5000000);
players[i2].blocked=true;
players[i2].should_subtract=true;
players[i2].hitby=wand_blockers[i].owner+"'s wand blocker";
players[i2].playsound("hit"+random(1,7));
players[i2].playsound("wand_blocker");
}
}
for(uint v=0; v<vs.length(); v++)
{
if(get_3d_distance(wand_blockers[i].x,wand_blockers[i].y,wand_blockers[i].z,vs[v].x,vs[v].y,vs[v].z)<=50&&vs[v].map==wand_blockers[i].map)
vs[v].hit(random(5000000,5000000),wand_blockers[i].owner+"'s wand blocker");
}
@wand_blockers[i]=null;
wand_blockers.remove_at(i);
}
}
}
void placewand_blocker(int x,int y, int z, string map,string owner)
{
wand_blocker bomb1(x,y,z,map,owner);
wand_blockers.insert_last(bomb1);
}
void destroy_all_wand_blockers()
{
wand_blockers.resize(0);
}
time_bender@[] time_benders(0);
class time_bender
{
string owner;
timer explodetimer;
int z;
string map;
int x, y;
time_bender(int tx,int ty,int tz, string tmap, string towner)
{
owner=towner;
x=tx;
y=ty;
z=tz;
map=tmap;
play("crono_cut",x,y,z,map);
} // constructor.
} // class.time_bender.

void time_benderloop()
{
for (uint i=0; i<time_benders.length(); i++)
{
if(time_benders[i].explodetimer.elapsed>=9026)
{
time_benders[i].explodetimer.restart();
//play("megabombhit",time_benders[i].x,time_benders[i].y,time_benders[i].z,time_benders[i].map);
send(0,"distsound crono_cut "+time_benders[i].x+" "+time_benders[i].y+" "+time_benders[i].z+" "+time_benders[i].map,0);
for(uint i2=0; i2<impact_bombs.length(); i2++)
if(get_3d_distance(impact_bombs[i2].x,impact_bombs[i2].y,impact_bombs[i2].z,time_benders[i].x,time_benders[i].y,time_benders[i].z)<=20 and impact_bombs[i2].map==time_benders[i].map)
impact_bombs[i2].health-=random(500000,500000000);
for (uint i2=0; i2<players.length(); i2++)
{
if(players[i2].invinsible==true || players[i2].is_protected==true || players[i2].robotmode==true || players[i2].newb==1 || players[i2].is_dead==true||in_vehicle(players[i2].name)>-1) continue;
if (get_3d_distance(time_benders[i].x,time_benders[i].y,time_benders[i].z,players[i2].x,players[i2].y,players[i2].z)<=250 and players[i2].map==time_benders[i].map)
{
if(time_benders[i].owner==players[i2].name) continue;
//players[i2].hit(50000000,50000000);
players[i2].benttimer.restart();
players[i2].energytimer.restart();
players[i2].bent=true;
send(players[i2].peer_id,"timebend",0);
players[i2].should_subtract=true;
players[i2].hitby=time_benders[i].owner+"'s crono cut";
//players[i].playsound("megabombhit");
players[i2].playsound("crono_cut");
}
}
for (uint i2=0; i2<objs.length(); i2++)
{
if (get_3d_distance(time_benders[i].x,time_benders[i].y,time_benders[i].z,objs[i2].x,objs[i2].y,objs[i2].z)<=20 and objs[i2].map==time_benders[i].map)
{
play("obj_break"+random(1,3),objs[i2].x,objs[i2].y,objs[i2].z,objs[i2].map);
objs.remove_at(i2);
}
}
for (uint i2=0; i2<remguns.length(); i2++)
{
if (get_3d_distance(time_benders[i].x,time_benders[i].y,time_benders[i].z,remguns[i2].x,remguns[i2].y,remguns[i2].z)<=20 and remguns[i2].map==time_benders[i].map)
{
remguns[i2].health-=random(5000000, 500000000);
remguns[i2].hitby=time_benders[i].owner+"'s aura blast";
play("remgunhit"+random(1, 3),remguns[i2].x,remguns[i2].y,remguns[i2].z,remguns[i2].map);
}
}
for(uint v=0; v<vs.length(); v++)
{
if(get_3d_distance(time_benders[i].x,time_benders[i].y,time_benders[i].z,vs[v].x,vs[v].y,vs[v].z)<=1000000&&vs[v].map==time_benders[i].map)
vs[v].hit(random(500000000,500000000),time_benders[i].owner+"'s cosmic bomb");
}
@time_benders[i]=null;
time_benders.remove_at(i);
}
}
}
void placetime_bender(int x,int y, int z, string map,string owner)
{
time_bender bomb1(x,y,z,map,owner);
time_benders.insert_last(bomb1);
}
void destroy_all_time_benders()
{
time_benders.resize(0);
}
thunder_bomb@[] thunder_bombs(0);
class thunder_bomb
{
string owner;
timer explodetimer;
int z;
string map;
int x, y;
thunder_bomb(int tx,int ty,int tz, string tmap, string towner)
{
owner=towner;
x=tx;
y=ty;
z=tz;
map=tmap;
play("thunder_bombplace"+random(1,4),x,y,z,map);
} // constructor.
} // class.thunder_bomb.

void thunder_bombloop()
{
for (uint i=0; i<thunder_bombs.length(); i++)
{
if(thunder_bombs[i].explodetimer.elapsed>=5705)
{
thunder_bombs[i].explodetimer.restart();
//play("thunderbombhit",thunder_bombs[i].x,thunder_bombs[i].y,thunder_bombs[i].z,thunder_bombs[i].map);
send(0,"distsound thunderbombdist "+thunder_bombs[i].x+" "+thunder_bombs[i].y+" "+thunder_bombs[i].z+" "+thunder_bombs[i].map,0);
for(uint i2=0; i2<impact_bombs.length(); i2++)
if(get_3d_distance(impact_bombs[i2].x,impact_bombs[i2].y,impact_bombs[i2].z,thunder_bombs[i].x,thunder_bombs[i].y,thunder_bombs[i].z)<=20 and impact_bombs[i2].map==thunder_bombs[i].map)
impact_bombs[i2].health-=random(500000,500000000);
for (uint i2=0; i2<players.length(); i2++)
{
if(players[i2].invinsible==true || players[i2].is_protected==true || players[i2].robotmode==true || players[i2].newb==1 || players[i2].is_dead==true||in_vehicle(players[i2].name)>-1) continue;
if (get_3d_distance(thunder_bombs[i].x,thunder_bombs[i].y,thunder_bombs[i].z,players[i2].x,players[i2].y,players[i2].z)<=5000 and players[i2].map==thunder_bombs[i].map)
{
if(thunder_bombs[i].owner==players[i2].name) continue;
if(are_allianceed(thunder_bombs[i].owner,players[i2].name)) continue;
players[i2].hit(15000000,15000000);
players[i2].should_subtract=true;
players[i2].hitby=thunder_bombs[i].owner+"'s thunderstorm";
players[i2].playsound("hit"+random(1,7));
players[i2].playsound("thunderbombhit");
}
}
for (uint i2=0; i2<objs.length(); i2++)
{
if (get_3d_distance(thunder_bombs[i].x,thunder_bombs[i].y,thunder_bombs[i].z,objs[i2].x,objs[i2].y,objs[i2].z)<=20 and objs[i2].map==thunder_bombs[i].map)
{
play("obj_break"+random(1,3),objs[i2].x,objs[i2].y,objs[i2].z,objs[i2].map);
objs.remove_at(i2);
}
}
for (uint i2=0; i2<remguns.length(); i2++)
{
if (get_3d_distance(thunder_bombs[i].x,thunder_bombs[i].y,thunder_bombs[i].z,remguns[i2].x,remguns[i2].y,remguns[i2].z)<=20 and remguns[i2].map==thunder_bombs[i].map)
{
remguns[i2].health-=random(5000000, 500000000);
remguns[i2].hitby=thunder_bombs[i].owner+"'s aura blast";
play("remgunhit"+random(1, 3),remguns[i2].x,remguns[i2].y,remguns[i2].z,remguns[i2].map);
}
}
for(uint v=0; v<vs.length(); v++)
{
if(get_3d_distance(thunder_bombs[i].x,thunder_bombs[i].y,thunder_bombs[i].z,vs[v].x,vs[v].y,vs[v].z)<=5000&&vs[v].map==thunder_bombs[i].map)
vs[v].hit(random(15000000,15000000),thunder_bombs[i].owner+"'s thunderstorm");
}
@thunder_bombs[i]=null;
thunder_bombs.remove_at(i);
}
}
}
