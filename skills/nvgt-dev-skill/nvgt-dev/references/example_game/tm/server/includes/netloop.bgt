{
send(players[index].peer_id,"error with input",0);
send(players[index].peer_id,"play_s lockererror.ogg",0);
return;
}
int c=stn(parsed[1]);
int l=get_locker_at(players[index].x,players[index].y,players[index].z,players[index].map);
if(l>-1)
{
if(lockers[l].code==c)
{
