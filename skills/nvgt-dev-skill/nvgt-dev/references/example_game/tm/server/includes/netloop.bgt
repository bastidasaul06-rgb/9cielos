else if(parsed[0]=="/t" and parsed.length()>1)
{
int t=is_in_alliance(players[index].name);
if(t>-1)
{
alliances[t].transmit(players[index].nickname+" alliance coms: "+string_trim_left(get_event_message(),3),true);
server_log("eventstream","in alliance "+alliances[t].alliancename+", "+players[index].nickname+" ("+players[index].name+") said "+string_trim_left(get_event_message(),3));
}
else
{
send(players[index].peer_id,"You are not in a alliance",0);
return;
}
}
else if(parsed[0]=="/deletealliances"&&players[index].dev)
{
file f;
if(directory_exists("alliances"))
{
directory_delete("alliances");
}
}
else if(parsed[0]=="/alliances")
{
string mess;
mess+="There are "+alliances.length()+" alliances. ";
for(uint i=0; i<alliances.length(); i++)
{
mess+=alliances[i].alliancename+" with "+(alliances[i].alliancemembers.length()+alliances[i].buffermembers.length())+" members and "+alliances[i].alliancekills+" kills and "+alliances[i].points+" points, leader "+cn2n(alliances[i].allianceleader)+". ";
}
send(players[index].peer_id, mess, 2);
}
else if(parsed[0]=="/members")
{
int ist=is_in_alliance(players[index].name);
if(ist>-1)
{
send(players[index].peer_id,alliances[ist].list_members(),2);
}
else
{
send(players[index].peer_id,"You are not in a alliance",0);
return;
}
}
else if(parsed[0]=="/allianceshelters")
{
int t=is_in_alliance(players[index].name);
if(t>-1)
{
string[] outa;
for(uint i=0; i<shelters.length(); i++)
{
if(shelters[i].alliancename==alliances[t].alliancename) outa.insert_last(shelters[i].sheltername+", on "+shelters[i].map+" at "+shelters[i].x+", "+shelters[i].y+", "+shelters[i].z+", owned by "+shelters[i].owner+".");
}
string s;
if(outa.length()==0) s="your alliance doesn't own any shelters";
else if(outa.length()==1) s="your alliance owns 1 shelter: "+outa[0];
else
{
s="your alliance owns "+outa.length()+" shelters: ";
for(uint i=0; i<(outa.length()-1); i++)
{
s+=outa[i]+" ";
}
s+="and "+outa[(outa.length()-1)];
}
send(players[index].peer_id,s,2);
}
else send(players[index].peer_id,"you are not in a alliance",2);
}
else if(parsed[0]=="/alliancecancel")
{
int t=get_alliance_index(players[index].alliancename);
if(t<0)
{
send(players[index].peer_id,"You are not in a alliance",0);
return;
}
else
{
if(alliances[t].allianceleader==players[index].name)
{
send(players[index].peer_id,"Your alliance has been canceled",2);
alliances[t].destruct();
}
else send(players[index].peer_id, "you aren't the leader of this alliance", 0);
return;
}
}
else if(parsed[0]=="/alliancedestroy"&&parsed.length()>1&&players[index].adminable())
{
int t=get_alliance_index(parsed[1]);
if(t<0)
{
send(players[index].peer_id,"invalid alliance",2);
return;
}
else
{
send(players[index].peer_id,"this alliance has been canceled",2);
alliances[t].destruct();
}
}
else if(parsed[0]=="/alliancedestroyold"&&players[index].adminable())
{
uint counter=0;
for(uint i=0; i<alliances.length(); i++)
{
if(alliances[i].alliancemembers.length()<=0)
{
alliances[i].destruct(false);
counter++;
}
}
send(players[index].peer_id,"there were "+counter+" old alliances destroyed",2);
}
else if(parsed[0]=="/alliancepass" and parsed.length()>1)
{
int t=is_in_alliance(players[index].name);
if(t<0)
{
send(players[index].peer_id,"You are not in a alliance",2);
return;
}
if(alliances[t].allianceleader==players[index].name)
{
alliances[t].password=parsed[1];
send(players[index].peer_id,"Your alliance password has been updated to "+alliances[t].password,2);
}
else
{
send(players[index].peer_id,"You are not leader of this alliance. Please tell your alliance leader ("+alliances[t].allianceleader+") to update the password.",2);
return;
}
}
else if(parsed[0]=="/joinalliance" and parsed.length()>2)
{
int stuff=is_in_alliance(players[index].name);
if(stuff>-1)
{
send(players[index].peer_id,"You are already in a alliance",0);
return;
}
else
{
int index2=get_alliance_index(parsed[1]);
if(index2>-1)
{
if(alliances[index2].passcheck(parsed[2])==false) { send(players[index].peer_id,"Incorrect password",0); return; }
if(alliances[index2].is_member(players[index].name)==true)
{
send(players[index].peer_id,"Um, you can't join this alliance. You are already in it!",0);
}
if(alliances[index2].buffermembers.length()+alliances[index2].alliancemembers.length()>=alliances[index2].maxmembers)
{
send(players[index].peer_id,"Sorry, this alliance is full",0);
return;
}
else alliances[index2].add_member(players[index].name);
}
else
{
send(players[index].peer_id,"That alliance does not exist",2);
return;
}
}
}
else if(parsed[0]=="/allianceremove" and parsed.length()>1)
{
int stuff=is_in_alliance(players[index].name);
if(stuff<0)
{
send(players[index].peer_id,"You are not in a alliance",0);
return;
}
else
{
if(alliances[stuff].allianceleader==players[index].name)
{
bool success=alliances[stuff].remove_member(string_trim_left(get_event_message(),12));
if(!success)
{
send(players[index].peer_id, "error removing a alliance member.", 0);
return;
}
}
}
}
else if(parsed[0]=="/allianceleave")
{
int s=is_in_alliance(players[index].name);
if(s<0)
{
send(players[index].peer_id,"You are not in a alliance",0);
return;
}
else
{
if(alliances[s].allianceleader==players[index].name)
{
send(players[index].peer_id,"You can not leave your alliance",0);
return;
}
else
{
send(players[index].peer_id,"you left the alliance!",2);
alliances[s].leave(players[index].name);
}
}
}
else if(parsed[0]=="/alliancecreate")
{
int i=is_in_alliance(players[index].name);
if(i<0)
{
send_serverbox(players[index].peer_id,1,2,1,10,"alliancecreate","Enter the name of your alliance. No spaces. Your alliance can only be up to 10 letters long!");
}
else
{
send(players[index].peer_id,"Uh...you are already in a alliance!",0);
return;
}
}
else if(parsed[0]=="/alliance" and parsed.length()==2 and players[index].adminable())
{
int p = is_in_alliance(parsed[1]);
if(p>-1)
{
send(players[index].peer_id, "the player "+parsed[1]+" is in alliance "+players[index].alliancename,2);
