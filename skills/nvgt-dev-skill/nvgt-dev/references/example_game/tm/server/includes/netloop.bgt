}
}
else if(parsed[0]=="/nickfind" and parsed.length()>1)
{
string nick=string_to_lower_case(string_trim_left(get_event_message(),10));
send(players[index].peer_id,"begin matches for "+nick,2);
for(uint i=0; i<players.length(); i++)
{
if(string_contains(string_to_lower_case(players[i].nickname),nick,1)>-1&&players[i].hidden==0) send(players[index].peer_id,players[i].name,2);
}
send(players[index].peer_id,"end matches for "+nick,2);
}
else if(parsed[0]=="/setstatus")
{
if( parsed.length()<=1)
{
if(players[index].status=="")
{
send(players[index].peer_id,"Your status message was empty already.",2);
return;
}
send(players[index].peer_id,"Your status message has been cleared.",2);
//write_to(players[index].name,"status.usr","");
players[index].status="";
return;
}
if(parsed.length()>1)
{
string newstat=string_replace(get_event_message(),"/setstatus ","",true);
if(string_len(newstat)>500)
{
send(players[index].peer_id,"This status message is too long. Maximum length is 500 characters.",2);
return;
}
send(players[index].peer_id,"your status message has been changed to: "+newstat,2);
players[index].status=newstat;
}
}
else if(parsed[0]=="/clearstatus" and parsed.length()>1)
{
if(players[index].adminable())
{
int index2=get_player_index_from(parsed[1]);
if(index2<0)
{
send(players[index].peer_id,"Player not found.",0);
return;
}
if(players[index2].status=="")
{
send(players[index].peer_id,players[index2].name+"'s status message was empty already.",2);
return;
}
send(players[index].peer_id,players[index2].name+"'s status message has been cleared.",2);
//write_to(players[index2].name,"status.usr","");
players[index2].status="";
}
}
else if(parsed[0]=="/viewstatus" and parsed.length()>1)
{
int index2=get_player_index_from(parsed[1]);
if(index2<0)
{
send(players[index].peer_id,"Player "+parsed[1]+" not found.",0);
return;
}
if(players[index2].status=="")
{
send(players[index].peer_id,"Status message for "+players[index2].name+" is currently empty.",2);
return;
}
send(players[index].peer_id,""+players[index2].name+"'s current status: "+players[index2].status,2);
}

else if(parsed[0]=="/resetnickname" and parsed.length()>1)
{
