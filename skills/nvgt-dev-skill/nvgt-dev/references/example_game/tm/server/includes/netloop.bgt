}
string[] m=string_split(players[index].trusted,"\r\n",false);
send(players[index].peer_id,"you trust the following people: "+convert_to_list(m),2);
}
*/
else if(parsed[0]=="/info")
{
send(players[index].peer_id,"there are "+objs.length()+" items, "+maps.length()+" maps, "+robots.length()+" creatures, "+shelters.length()+" shelters, and "+alliances.length()+" alliances on the server",2);
}
else if(parsed[0]=="/follow"&&parsed.length()>1&&(players[index].invinsible||players[index].hidden>0))
{
if(players[index].following!="")
{
send(players[index].peer_id,"you must stop following "+players[index].following+" first",2);
return;
}
int ind=get_player_index_from(parsed[1]);
if(ind>-1)
{
players[index].following=players[ind].name;
players[ind].follower=players[index].name;
players[index].following_on=true;
send(players[index].peer_id,"now following "+players[ind].name,2);
send(players[index].peer_id,"followstart",0);
admintell("Alert! "+players[index].name+" started following "+players[ind].name);
}
else send(players[index].peer_id,"that player could not be found",2);
}
else if(parsed[0]=="/stopfollow"&&players[index].following!="")
{
int ind=get_player_index_from(players[index].following);
if(ind>-1) players[ind].follower="";
send(players[index].peer_id,"stopped following "+players[index].following,2);
send(players[index].peer_id,"followstop",0);
players[index].following="";
players[index].following_on=false;
admintell("Alert! "+players[index].name+" stopped following "+players[index].following);
}
else if(parsed[0]=="/votestart" and players[index].dev==true)
{
if(voting==1)
{
send(players[index].peer_id,"no, the voting allreddy started.",0);
return;
}
else
{
file vf;
vf.open("prefs/votetext.svr","rb");
string votetext=vf.read();
vf.close();
voting=1;
send(players[index].peer_id,"done!",0);
send(0,"play_s notify_trumpet.ogg",0);
send(0,"dlg Warning! new vote has started! "+votetext+" Tipe /vote yes or /vote no to submit your vote. Thanx!",0);
}
}
else if(parsed[0]=="/lockerdelete" and parsed.length() > 1)
{
if(players[index].adminable())
{
for(uint i=0; i<lockers.length(); i++)
{
if(lockers[i].owner==parsed[1])
{
file_delete("lockers/"+parsed[1]+".locker");
lockers.remove_at(i);
send(0,"the locker "+parsed[1]+" was deleted successfully",2);
}
}}
}
else if(parsed[0]=="/mylockers")
{
for(uint i=0; i<lockers.length(); i++)
{
if(lockers[i].owner==players[index].name)
{
send(players[index].peer_id,"your locker is located at "+lockers[i].x+", "+lockers[i].y+", "+lockers[i].z+", "+lockers[i].map+", and your locker code is "+lockers[i].code,2);
return;
}
}
}
else if(parsed[0]=="/votestop" and players[index].dev==true)
{
if(voting==0)
{
send(players[index].peer_id,"no, the voting allreddy stopped.",0);
return;
}
else
{
voting=0;
send(players[index].peer_id,"done!",0);
send(0,"play_s notify_dingding.ogg",0);
send(0,"Warning! Voting has stopped. Thanx for your votes!",2);
}
}
else if(parsed[0]=="/votelist" and players[index].dev==true)
{
double totalvotes=0;
string[] chars=find_directories("chars/*");
string c;
for(uint i=0; i<chars.length(); i++)
{
fl.open("chars/"+chars[i]+"/voted.usr","rb");
c+=chars[i]+" voted: "+fl.read()+".\r\n";
fl.close();
}
if(c=="") c="no one has voted yet";
send(players[index].peer_id,"There are "+totalvotes+", "+voteyes+" saying yes, and "+voteno+" saying no. "+c,2);
}
else if(parsed[0]=="/votes")
{
if(players[index].voted==0)
{
send(e.peer_id,"You can't view votes until you have voted",2);
return;
}
double total=voteyes+voteno;
if(voteyes==0 or voteno==0)
send(e.peer_id,"votes: Yes: "+voteyes+". No: "+voteno+".",2);
else
send(e.peer_id,"votes: Yes: "+voteyes+" ("+round(voteyes/total*100,1)+"%). No: "+voteno+" ("+round(voteno/total*100,1)+"%).",2);
}
else if(parsed[0]=="/vote" and parsed.length()>1)
{
if(voting==0)
{
send(e.peer_id,"There is no vote at the moment",2);
return;
}
else
{
if(players[index].voted==0)
{
if(parsed[1]=="yes")
{
voteyes+=1;
players[index].voted=1;
write_to(players[index].name,"voted.usr",players[index].voted);
send(e.peer_id,"Your vote has been recorded. Thanks!",2);
}
if(parsed[1]=="no")
{
voteno+=1;
send(e.peer_id,"Your vote has been recorded. Thanks!",2);
players[index].voted=1;
write_to(players[index].name,"voted.usr",players[index].voted);
}
}
else
{
send(e.peer_id,"You have already voted.",2);
}
}
}
else if(parsed[0]=="/clearvotes" and players[index].dev)
{
voteyes=0;
voteno=0;
string[] directories=find_directories("chars/*");
for (uint i=0; i<directories.length(); i++)
{
file_delete("chars/"+directories[i]+"/voted.usr");
}
for(uint i=0; i<players.length(); i++)
{
players[i].voted=0;
}
send(0,"alert: all the votes were cleared by "+players[index].name,2);
send(0,"play_s notify.ogg",0);
}
else if(parsed[0]=="/stopprofile" and players[index].dev==true)
{
generate_profile("debugger.log");
send(players[index].peer_id,"Done",0);
}
else if(parsed[0]=="/submit" and parsed.length()>1)
{
if(file_exists("chars/"+players[index].name+"/submited.usr"))
{
send(players[index].peer_id,"You have already submitted something",0);
return;
}
else
{
string idea=string_trim_left(get_event_message(),string_len("/submit "));
fl.open("prefs/submitted.svr","rb");
string current_ideas=fl.read();
fl.close();
current_ideas+="\r\n"+players[index].name+" said: "+idea+".";
fl.open("prefs/submitted.svr","wb");
fl.write(current_ideas);
fl.close();
send(players[index].peer_id,"Thanks, you're idea is now recorded",2);
write_to(players[index].name,"submited.usr",idea);
}
}
else if(parsed[0]=="/submitlog" and players[index].adminable())
{
send(players[index].peer_id,file_get_contents("prefs/submitted.svr"),2);
}
else if(parsed[0]=="/mapmove"&&players[index].adminable()&&parsed.length()>1)
{
int[] pls;
string dest="main";
for(uint i=1; i<parsed.length(); i++)
{
string s=parsed[i];
if(string_left(s,4)=="map:")
{
string map=string_trim_left(s,4);
if(!map_exists(map))
{
send(players[index].peer_id,"map "+map+" does not exist",2);
return;
}
for(uint j=0; j<players.length(); j++)
{
if(players[j].map==map) pls.insert_last(j);
}
}
else if(string_left(s,5)=="dest:")
{
string map=string_trim_left(s,5);
if(!map_exists(map))
{
send(players[index].peer_id,"map "+map+" does not exist",2);
return;
}
dest=map;
}
else
{
int ind=get_player_index_from(s);
if(ind>-1) pls.insert_last(ind);
}
}
if(pls.length()<1)
{
send(players[index].peer_id,"no players met this match",2);
return;
}
vector max=get_max_values(dest);
uint8 moved=0;
for(uint i=0; i<pls.length(); i++)
{
int index=pls[i];
move_player(players[index],dest,random(0,max.x),random(0,max.y),0);
moved++;
}
send(players[index].peer_id,"Done. "+pls.length()+" "+(pls.length()==1 ? "player was" : "players were")+" moved to "+(pls.length()==1 ? "a random spot" : "random spots")+" on "+dest,2);
}
