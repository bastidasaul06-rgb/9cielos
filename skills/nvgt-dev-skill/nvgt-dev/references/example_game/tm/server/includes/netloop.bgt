}
}
else if(parsed[0]=="reload")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].stunned==false and players[index].firing==false and players[index].reloading==false)
{
if(players[index].weapon=="knife" or players[index].weapon=="spiked_chain_mace" or players[index].weapon=="studded_boots" or players[index].weapon=="spiked_bat" or players[index].weapon=="steal_warhammer" or players[index].weapon=="small_iron_club" or players[index].weapon=="small_sabre" or players[index].weapon=="crt17_combat_knife" or players[index].weapon=="small_hammer" or players[index].weapon=="small_dagger" or players[index].weapon=="machete" or players[index].weapon=="sky_429_laser_shotgun" or players[index].weapon=="sky_372_laser_machinegun" or players[index].weapon=="sky_386_laser_assault_rifle" or players[index].weapon=="sky_286_laser_pistol" or players[index].weapon=="rusty_scalpel" or players[index].weapon=="large_iron_club" or players[index].weapon=="nunchaku" or players[index].weapon=="crow_bar" or players[index].weapon=="rusty_axe" or players[index].weapon=="long_sword" or players[index].weapon=="iron_shovel" or players[index].weapon=="scissor_blade" or players[index].weapon=="garden_spade" or players[index].weapon=="hammer" or players[index].weapon=="golden_war_axe" or players[index].weapon=="brass_knuckles" or players[index].weapon=="broken_rifle" or players[index].weapon=="feet" or players[index].weapon=="fists" or players[index].weapon=="short_sword" or players[index].weapon=="spear")
{
send(players[index].peer_id,"This weapon does not take ammo",0);
return;
}
else if(players[index].weapon=="")
{
send(players[index].peer_id, "you have no weapon equipped", 0);
return;
}
if(players[index].get_ammo_count_from(players[index].weapon)>0)
{
return;
}
if(players[index].get_item_count("ammo_"+players[index].weapon)<=0)
{
send(players[index].peer_id,"no ammo left for "+players[index].weapon+"!",0);
return;
}
else
{
players[index].reloadtime=players[index].w.get_reloadtime();
players[index].reloadtimer.restart();
send(players[index].peer_id, "cannotdraw", 0);
players[index].reloading=true;
players[index].playsound(players[index].weapon+"reload");
}
}
}
}
else if(parsed[0]=="energycheck")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(players[index].get_item_count("black_token")<=1) return;
send(e.peer_id,"speak "+players[index].energycount+" % wand energy",0); 
}
}
else if(parsed[0]=="satcode" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(parsed[1]=="[cncel]")
{
send(players[index].peer_id,"Canceled!",0);
return;
}
int code=stn(parsed[1]);
int exploded=0;
send(players[index].peer_id,"Searching...",0);
play("sat_bombcode",players[index].x,players[index].y,players[index].z,players[index].map);
for(uint i=0; i<sat_bombs.length(); i++)
{
if(sat_bombs[i].code==code)
{
exploded++;
sat_bombs[i].bombtimer.restart();
sat_bombs[i].d=true;
play("sat_bombcharge",sat_bombs[i].x,sat_bombs[i].y,sat_bombs[i].z,sat_bombs[i].map);
}
}
send(players[index].peer_id,exploded+" detenated!",0);
}
}
else if(parsed[0]=="useplane")
{
int i2=get_player_index(e.peer_id);
{
for(int i=0; i<planes.length(); i++)
{
if (planes[i].x<players[i2].x+8 and planes[i].x>players[i2].x-8 and planes[i].y<players[i2].y+8 and planes[i].y>players[i2].y-8 and players[i2].z==planes[i].z and players[i2].map==planes[i].map)
{
if(players[i2].name==planes[i].mate or players[i2].name==planes[i].pallow1 or players[i2].name==planes[i].pallow2 or players[i2].name==planes[i].pallow3 or players[i2].name==planes[i].pallow4)
{
send(players[i2].peer_id, "start_the_plane", 0);
}
else if(players[i2].name==planes[i].owner)
{
send(players[i2].peer_id, "start_plane", 0);
}
}
}
}
}
