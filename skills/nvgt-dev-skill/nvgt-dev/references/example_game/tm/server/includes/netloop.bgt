else if(shelters[shind].owner!=players[index].name)
send(players[index].peer_id,"you cannot get or set permissions on a shelter you do not own",2);
else
{
if(parsed.length()==1)
{
if(shelters[shind].alliancename=="") send(players[index].peer_id,"this shelter doesn't belong to a alliance",2);
else
{
int tin=get_alliance_index(shelters[shind].alliancename);
if(tin<0)
{
shelters[shind].alliancename="";
send(players[index].peer_id,"this shelter was in a alliance, but that alliance no longer exists.",2);
}
else
{
send(players[index].peer_id,"this shelter belongs to the "+shelters[shind].alliancename+" alliance",2);
}
}
}
else if(parsed.length()>1&&parsed[1]=="set")
{
int tin=get_alliance_index(players[index].alliancename);
if(tin<0) send(players[index].peer_id,"you are not in a alliance to give this shelter to",0);
else
{
shelters[shind].alliancename=alliances[tin].alliancename;
alliances[tin].transmit("play_s allianceadd.ogg",false,0);
alliances[tin].transmit("The "+shelters[shind].sheltername+" shelter now belongs to this alliance! It is located on "+shelters[shind].map+" at "+shelters[shind].x+", "+shelters[shind].y+", "+shelters[shind].z);
}
}
else if(parsed.length()>1 and parsed[1]=="remove")
{
if(shelters[shind].alliancename=="") send(players[index].peer_id,"this shelter doesn't belong to a alliance",2);
else
{
int tin=get_alliance_index(shelters[shind].alliancename);
if(tin<0)
{
shelters[shind].alliancename="";
send(players[index].peer_id,"this shelter was in a alliance, but that alliance no longer exists.",2);
}
else
{
shelters[shind].alliancename="";
alliances[tin].transmit("play_s allianceremove.ogg",false,0);
alliances[tin].transmit("the "+shelters[shind].sheltername+" shelter no longer belongs to this alliance!");
}
}
}
else send(players[index].peer_id,"invalid parameter. Valid formats are /shalliance, /shalliance set and /shalliance remove",2);
}
}
else if(parsed[0]=="/shremove"&&parsed.length()>1)
{
