players[index].playsound("objdrop");
players[index].give(parsed[1],-1);
}
}
else if(parsed[0]=="focus" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string[] items=players[index].inventory.get_keys();
for(int i=0; i<items.length(); i++)
{
if(items[i]==parsed[1])
players[index].invpos=i;
}
}
}
else if(parsed[0]=="use" and parsed.length()>1)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(parsed[1]=="apex912fighter_plane")
{
bool can_spawn=true;
for(int i=0; i<planes.length(); i++)
{
if(players[index].name==planes[i].owner or players[index].name==planes[i].mate or players[index].name==planes[i].pallow1 or players[index].name==planes[i].pallow2 or players[index].name==planes[i].pallow3 or players[index].name==planes[i].pallow4) 
{
can_spawn=false;
}
else
can_spawn=true;
}
if(can_spawn==true)
{
spawn_plane(players[index].x,players[index].y, players[index].z,players[index].map,players[index].name);
players[index].give("apex912fighter_plane",-1);
}
else
send(players[index].peer_id, "one of your crue members have already started a plane. no point in  is_using your own now is there?",2);
return;
}
if(players[index].map=="jail" or players[index].stunned or players[index].is_dead or players[index].warping or players[index].newb==1 and !players[index].newbuseable(parsed[1]) and players[index].is_food(parsed[1])==false)
{
return;
}
if (players[index].inventory.get_keys().length()>0 and players[index].get_item_count(parsed[1])>0 and players[index].is_using==false)
{
string wname=parsed[1];
players[index].add_log_entry("use","used a "+wname);
bool takeobj=true;
players[index].is_using=true;
if(players[index].get_item_count(wname)<0)
{
takeobj=false;
players[index].give(wname,(0-players[index].get_item_count(wname)));
}
if(string_right(wname,9)=="ammo_pack")
{
string[] p=string_split(wname,"_",false);
int h;
if(players[index].is_paid())
h=random(20,60);
else h=random(10,15);
players[index].playsound("ammo_box");
send(players[index].peer_id,"The pack contained "+h+" "+p[0]+" ammo!",2);
players[index].give("ammo_"+p[0],h);
players[index].give("empty_pack", 1);
}
if(string_left(wname,5)=="ammo_") return;
if(string_contains(wname,"\"",1)>-1)
{
players[index].hitby="Very bad admin abuse";
players[index].health=-1;
}
if(players[index].is_food(parsed[1]))
{
takeobj=false;
if(players[index].eattimer.elapsed<10000)
{
send(players[index].peer_id,"Can't eat yet",0);
return;
}
else {
takeobj=true;
players[index].eat(parsed[1]);
}
}
if(can_spawn_item_at(players[index].x,players[index].y,players[index].z,players[index].map,wname)==false)
{
send(players[index].peer_id,"Can not use this item at this location!",0);
return;
}
if(wname=="locker_security_booster")
{
takeobj=false;
int l=get_locker_at(players[index].x,players[index].y,players[index].z,players[index].map);
if(l<0){
send(players[index].peer_id,"You must be standing on a locker to use this item",0);
return;
}
else
{
if(lockers[l].security_boosts>=560) //security limit
{
send(players[index].peer_id,"This locker is security enough",0);
return;
}
takeobj=true;
lockers[l].security_boosts+=random(3, 25);
lockers[l].lockplay("security_booster");
players[index].stun(720,false,false);
}
}
if(wname=="item_grabber" and in_vehicle(players[index].name)<0)
{
takeobj=false;
if(players[index].itemgrabbing==true)
{
send(players[index].peer_id,"Because you honestly think you can use a item grabber while is_using an item grabber...",0);
return;
}
players[index].itemgrabbingtimer.restart();
send(players[index].peer_id, "stopmoving",0);
players[index].itemgrabbing=true;
players[index].give("item_grabber",-1);
play("itemgrabberstart", players[index].x, players[index].y, players[index].z, players[index].map, index, false);
send(0, players[index].name+" just started is_using an item grabber! ", 2);
}
if(wname=="bluebox")
{
takeobj=false;
int l=get_locker_at(players[index].x,players[index].y,players[index].z,players[index].map);
if(l<0)
{
send(players[index].peer_id,"You must be standing on a locker tile to use this item",0);
return;
}
if(lockers[l].hacking==true)
{
send(players[index].peer_id,"This locker is under a hack attempt",0);
return;
}
takeobj=true;
lockers[l].hacktimer.restart();
string hacksound;
int r=random(-25, 100);
if(r>75+lockers[l].security_boosts)
{
hacksound="locker_hackstart";
lockers[l].hackmode=1;
lockers[l].hacktime=hack_successtime;
}
else
{
hacksound="locker_hackstop";
lockers[l].hackmode=0;
lockers[l].hacktime=hack_failedtime;
}
players[index].playsound(hacksound);
send(players[index].peer_id,"stopmoving",0);
lockers[l].hacktimer.restart();
lockers[l].hacker=players[index].name;
lockers[l].hacking=true;
}
if(string_contains(wname, "bag_", 1)>-1)
{
open_corpse(string_replace(wname, "bag_", "", true), index);
players[index].playsound("corpse_open");
players[index].give(wname,-1);
}
if(string_contains(wname, "corpse_", 1)>-1)
{
takeobj=false;
}
if(string_left(wname,9)=="shipment_")
{
string s=string_trim_left(wname,9);
int sid=get_shipment_item_index_from(s);
if(sid<0)
{
send(players[index].peer_id,"Invalid shipment ID!",2);
players[index].give(wname,-1);
return;
}
string psend="Shipment contains "+shipment_items[sid].list_contents();
shipment_items[sid].give_to(players[index].name);
players[index].give(wname,-1);
players[index].give("empty_pack", 1);
players[index].playsound("packopen");
send(players[index].peer_id, psend, 2);
}
if(string_left(wname,8)=="pack_of_")
{
string s=string_trim_left(wname,8); //remove this, we dont' need it.
string[] p=string_split(s,"_",false);
players[index].give(string_replace(s,p[0]+"_","",false),stn(p[0]));
players[index].give("empty_pack", 1);
players[index].playsound("packopen");
}
if(wname=="locker_pack")
{
takeobj=false;
