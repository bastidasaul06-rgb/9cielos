else if(parsed[0]=="/items")
{
send(players[index].peer_id,objs.length()+" items are currently spawned.",2);
}
else if(parsed[0]=="/robots" and(players[index].builder()))
{
				string[] rs=find_files("robots/*.txt");
				server_menu m;
				m.initial_packet="mreturn";
				m.intro="Robots list. There are currently "+rs.length()+" robots";
