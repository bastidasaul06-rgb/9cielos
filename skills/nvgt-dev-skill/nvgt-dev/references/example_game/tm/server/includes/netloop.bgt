else if(parsed[0]=="enter")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
if(((players[index].afk==true or players[index].is_dead==true)&&players[index].hidden==0)||players[index].stunned==true||players[index].sbombplacing||players[index].helicopterspawning||players[index].turretspawning||players[index].robocopspawning||players[index].enemyspawning||players[index].bulletbombplacing||players[index].bbombplacing||players[index].remconnecting||players[index].ultrabombplacing)
return;
if(round(players[index].x,0)==0 and round(players[index].y,0)==0 and players[index].z==0 and in_shelter(players[index].name)>-1)
{
int s=in_shelter(players[index].name);
if(shelters[s].on==false)
{
send(players[index].peer_id,"The computer is off",0);
return;
}
send_serverbox(players[index].peer_id,0,-1,1,1,"shcommand","what would you like to do. Press H to see help");
}
else if(round(players[index].x,0)==20 and round(players[index].y,0)==0 and players[index].z==0 and in_shelter(players[index].name)>-1)
{
int s=in_shelter(players[index].name);
shelters[s].on=int_to_bool(toggle(bool_to_int(shelters[s].on)));
if(shelters[s].on==true)
{
shelters[s].compplay("shelter_computeron");
shelters[s].compsound=spawn_moving_sound("shelter_computerloop.ogg",0,0,0,shelters[s].sheltername);
play("shelter_poweron",20,0,0,shelters[s].sheltername);
shelters[s].soundloop=spawn_moving_sound("shelter_generator.ogg",shelters[s].x,shelters[s].y,shelters[s].z,shelters[s].map);
play("shelter_generatorstart",shelters[s].x,shelters[s].y,shelters[s].z,shelters[s].map);
}
else
{
shelters[s].compplay("shelter_computeroff");
destroy_moving_sound(shelters[s].compsound);
play("shelter_poweroff",20,0,0,shelters[s].sheltername);
destroy_moving_sound(shelters[s].soundloop);
play("shelter_generatoroff",shelters[s].x,shelters[s].y,shelters[s].z,shelters[s].map);
}
}
int l=get_locker_at(players[index].x, players[index].y, players[index].z, players[index].map);
if(l>-1)
{
send_serverbox(players[index].peer_id, 2, 4, 1, -1, "lockcode", "Enter locker code");
}
else if(round(players[index].x,0)==10 and round(players[index].y,0)==5 and players[index].z==0 and players[index].map=="store")
{
send(players[index].peer_id,"skateboard_stop",0);
}
else if(round(players[index].x,0)==100 and round(players[index].y,0)==100 and players[index].z==0 and players[index].map=="stun")
{
players[index].give("dollar",30000);
send(0,"Player "+players[index].nickname+" just stamped the stun grenade map, Congratulations.!",2);
send(0, "play_s autonotify.ogg", 0);
}
else if(round(players[index].x,0)==2 and round(players[index].y,0)==0 and players[index].z==0 and players[index].map=="challengemaps")
{
send(players[index].peer_id,"dlg Welcome, dear player, to this map. Here you are waiting for 3 levels, each with its own reward. Try to reach the end. Good luck!",0);
move_player(players[index],"weapon",0,0,0);
send(players[index].peer_id,"skateboard_stop",0);
send(0, "play_s notify_beepup.ogg", 0);
send(0,"The player "+players[index].nickname+" Went to the challenge map, weapon challenge. We wish him good luck!",2);
}
else if(round(players[index].x,0)==3 and round(players[index].y,0)==0 and players[index].z==0 and players[index].map=="challengemaps")
{
send(players[index].peer_id,"dlg Welcome, dear player, to the laberint of death! In this laberint you are waiting for different traps: Teleporters that will move you to the very beginning of the laberint, and stun grenades. At the end, you will receive a reward, from 100000 to 150000 dollars! Good luck!",0);
move_player(players[index],"laberinths",0,0,0);
send(players[index].peer_id,"skateboard_stop",0);
send(0, "play_s notify_beepup.ogg", 0);
send(0,"The player "+players[index].nickname+" Went to the challenge map, laberint of death. We wish him good luck!",2);
}
else if(round(players[index].x,0)==4 and round(players[index].y,0)==0 and players[index].z==0 and players[index].map=="challengemaps")
{
send(players[index].peer_id,"dlg welcome to a dangerous place! Here you will find alot of dangers, and three levels, for this you will get a storm_sniper and the_legendary_sword! Good luck!",0);
move_player(players[index],"dangerous_place",0,0,0);
send(players[index].peer_id,"skateboard_stop",0);
send(0, "play_s notify_beepup.ogg", 0);
send(0,"The player "+players[index].nickname+" Went to the challenge map, dangerous place. We wish him good luck!",2);
}
else if(round(players[index].x,0)==5 and round(players[index].y,0)==0 and players[index].z==0 and players[index].map=="challengemaps")
{
send(players[index].peer_id,"dlg Welcome to this map! Here you need to climb the mountain, bypassing and jumping obstacles. At the end, you will get from 400000 to 600000 dollars! Good luck!",0);
move_player(players[index],"challenge4",0,0,0);
send(players[index].peer_id,"skateboard_stop",0);
send(0, "play_s notify_beepup.ogg", 0);
send(0,"The player "+players[index].nickname+" Went to the challenge map, snow mountain. We wish him good luck!",2);
}
else if(round(players[index].x,0)==6 and round(players[index].y,0)==0 and players[index].z==0 and players[index].map=="challengemaps")
{
send(players[index].peer_id,"dlg Welcome to the Terrible Map! After compleation, you will get a good reward! Good luck!",0);
move_player(players[index],"challenge",0,0,0);
send(players[index].peer_id,"skateboard_stop",0);
send(0, "play_s notify_beepup.ogg", 0);
send(0,"The player "+players[index].nickname+" Went to the challenge map, the terrible map. We wish him good luck!",2);
}
else if(round(players[index].x,0)==7 and round(players[index].y,0)==0 and players[index].z==0 and players[index].map=="challengemaps")
{
send(players[index].peer_id,"dlg Well, it's time for another challenge. Go through a minefield full of traps and at the end get your reward, pack_of_500_sky_436_mine! Good luck!",0);
move_player(players[index],"skymine_field",0,0,0);
send(players[index].peer_id,"skateboard_stop",0);
send(0, "play_s notify_beepup.ogg", 0);
send(0,"The player "+players[index].nickname+" Went to the challenge map, skymine_field. We wish him good luck!",2);
}
else if(round(players[index].x,0)==10 and round(players[index].y,0)==10 and players[index].z==0 and players[index].map=="memories_of_prehistory")
{
if(players[index].get_item_count("blue_token")>=1)
{
send(players[index].peer_id,"you have already completed this quest",0);
}
else
{
send(players[index].peer_id,"dlg this? this is what we get as our saviour? you're just a kid... you don't even look strong. either way... we'll take what we get. you want to help kid? go to the library first, located in crystal city. read something for a change. you'll find a scroll in the library. read it. memorize it. when you're done come back here. I'll give you a more important task then.",0);
}
}
else if(round(players[index].x,0)==50 and round(players[index].y,0)==50 and players[index].z==0 and players[index].map=="memories_of_prehistory")
{
if(players[index].get_item_count("silver_token")>=1)
{
send(players[index].peer_id,"you have already completed this quest",0);
return;
}
if(players[index].get_item_count("red_token")<1)
{
send(players[index].peer_id,"you first need to complete the previous quests.",0);
}
else
{
send(players[index].peer_id,"dlg we have a major problem on our hands. the guy you brought in, we questioned him. what he revealed is...terifying to say the least. to unseel the creatures, the unseelers intend to attack the land itself. they are going to place a huge amount of explosive devices in close proximity. when these devices explode they will tear the land asunder. the creatures will be set free, and noone will be safe. our sources have informed us that the unseelers have collected all the explosive devices, and are on their way to give them to their leader. they will be going through the abandoned factory. you must stop them at all causts. it is all in your hands now. you must go to the abandoned factory and defeat them, and bring here the breefcase which holds the explosive devices.",0);
}
}
else if(round(players[index].x,0)==80 and round(players[index].y,0)==80 and players[index].z==0 and players[index].map=="memories_of_prehistory")
{
if(players[index].get_item_count("gold_token")>=1)
{
send(players[index].peer_id,"you have already completed this quest",0);
return;
}
if(players[index].get_item_count("silver_token")<1)
{
send(players[index].peer_id,"you first need to complete the previous quests.",0);
}
else
{
send(players[index].peer_id,"dlg I hate to tell you this, but our efforts were in vane. the breefcase you acquired by defeating the agent is a fake one. somehow they realised our plan and switch the breefcases. the real one is still with the unseelers. we can still  bounce back from this though. to get it to their leader the unseelers will have to cross the magical forest. if you get there in time and defeat them once in for all all of this will be over. I'm counting on you...don't fail us. you're the only one who can protect us now.",0);
}
}
//quests
else if(round(players[index].x,0)==30 and round(players[index].y,0)==15 and players[index].z==0 and players[index].map=="evermore_forest")
{
if(players[index].level>=75)
{
send(players[index].peer_id,"your level is too high for this quest.",2);
return;
}
else
{
send(players[index].peer_id,"play_s signpress.ogg",0);
send(players[index].peer_id,"dlg Hey. you seem to have the beginnings of a great hunter. would you mind helping me out? my brother and I need the corpses of some animals which we are going to transfer to crystal city. problem is, neither he nor I are great hunters. if you could kill hundred animals in this forest and report to my brother, the two of uss will collect their corpses, and give you five millian dollars. if you want to help us out go kill the animals, then find my brother in the forest to collect your reward.",0);
}
}
else if(round(players[index].x,0)==200 and round(players[index].y,0)==200 and players[index].z==0 and players[index].map=="evermore_forest")
{
if(players[index].level>=75)
{
send(players[index].peer_id,"your level is too high for this quest.",2);
return;
}
if(players[index].junglecount<=100)
{
send(players[index].peer_id,"you have killed "+players[index].junglecount+" animals. keep going!",2);
return;
}
else if(players[index].junglecount>=100)
{
players[index].junglecount=0;
players[index].give("dollar",5000000);
send(players[index].peer_id,"dlg thankyou for your help! here is your reward. five millian dollars as promised. thanks once again!",0);
send(players[index].peer_id,"play_s eventnotify.ogg",0);
}
}
else if(round(players[index].x,0)==25 and round(players[index].y,0)==25 and players[index].z==0 and players[index].map=="the_dangerous_forest")
