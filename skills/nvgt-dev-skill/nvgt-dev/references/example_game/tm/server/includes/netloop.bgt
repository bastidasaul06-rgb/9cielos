int currentammo=players[index].get_item_count("ammo_"+parsed[1]);
send(players[index].peer_id,"You have "+loadedammo+" of "+players[index].w.get_max_ammo()+" ammo in your "+parsed[1]+", and you have "+currentammo+" bullets remaining",2);
}
