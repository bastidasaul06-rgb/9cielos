{
send(players[index].peer_id,"At least 1 item must be deposited!",0);
return;
}
int has=players[index].get_item_count(players[index].shitem);
if(has<amount)
{
send(players[index].peer_id,"Error: You do not have enough "+players[index].shitem+"s!",0);
return;
}
else
{
players[index].give(players[index].shitem,-amount);
