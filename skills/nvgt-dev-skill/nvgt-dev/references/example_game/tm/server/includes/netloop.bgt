for(uint i=0; i<players.length(); i++)
{
if(players[i].hidden>0) continue;
if(players[i].adminable())
{
adminlist.insert_last(players[i].title+" "+players[i].name);
}
}
if(adminlist.is_empty())
{
txt="No admins currently";
send(players[index].peer_id,txt,2);
return;
}
if(adminlist.length()==1)
txt="there's just one admin online. "+adminlist[adminlist.length()-1];
else
{
txt="There are currently "+adminlist.length()+" admins currently connected to the server. They are: ";
for(uint x=0; x<adminlist.length(); x++)
{
if(x==adminlist.length()-1)
txt+=" and "+adminlist[x];
else
txt+=adminlist[x]+", ";
}
}
send(players[index].peer_id,txt,2);
}
else if(parsed[0]=="/staff") {
