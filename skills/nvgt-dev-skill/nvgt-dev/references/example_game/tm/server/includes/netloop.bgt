void netloop()
{
weaponloop();
if(players.length()>peak)
{
peak=players.length();
send(0,"we have reached a new peak of "+peak+" players!",0);
send(0,"play_s notify_bigbang.ogg",0);
peakreached=get_date(true,false)+" at "+get_time();
}
if(players.length()>9 and players.length()<15)
{
if(double_xp==0) { send(0,"play_s double.ogg",0); send(0,"double experience points enabled. Enjoy!",2); double_xp=1; }
writedata();
}
if(players.length()>14)
{
if(custom_xp==0) { send(0,"play_s double.ogg",0); send(0,"super experience points enabled. Enjoy!",2); custom_xp=1; double_xp=0; }
writedata();
}
if(players.length()<15 and players.length()>9)
{
if(custom_xp==1) { send(0,"play_s double.ogg",0); send(0,"super experience points turned off. It will be active again soon!",2); custom_xp=0; double_xp=1; }
writedata();
}
if(players.length()<10)
{
if(double_xp==1) { send(0,"play_s double.ogg",0); send(0,"double experience points turned off. It will be active again soon!",2); double_xp=0; }
writedata();
}
if(updatingsvr==true) updateloop();
e=n.request();
if (auctiontimer.elapsed>=auctiontime and auction==true)
{
if (auctionbidder==false)
{
auction=false;
auctionitem="";
auctionbidder=false;
auctionamount=0;
auctionbid=0;
auctionbidtemp=0;
auctionwho="";
auctionwho2="";
auctionwhotemp="";
send(0,"Auction ended. Item returned to user.",2);
}
else
{
int index1=get_player_index_from(auctionwho);
int index2=get_player_index_from(auctionwho2);
if (index1==-1 or index2==-1)
{
send(0,"Auction reset. 1 or more required players have gone offline.",2);
auction=false;
auctionitem="";
auctionbidder=false;
auctionamount=0;
auctionbid=0;
auctionbidtemp=0;
auctionwho="";
auctionwho2="";
auctionwhotemp="";
}
else
{
if (players[index1].get_item_count(auctionitem)<auctionamount)
{
auction=false;
auctionitem="";
auctionbidder=false;
auctionamount=0;
auctionbid=0;
auctionwho="";
auctionwho2="";
send(0,"Auction reset. The auctioner no longer has the item.",2);
}
else
{
players[index2].give("dollar",-auctionbid);
players[index2].give(auctionitem,auctionamount);
players[index1].give(auctionitem,-auctionamount);
players[index1].give("dollar",auctionbid);
auction=false;
auctionitem="";
auctionbidder=false;
auctionamount=0;
auctionbid=0;
auctionwho="";
auctionwho2="";
send(0,"play_s auctionwon.ogg",0);
send(0,"Auction finished! Item sold to "+players[index2].nickname,2);
}
}
}
}
if(e.type==event_disconnect)
{
int index=get_player_index(e.peer_id);
if(index > -1&&!players[index].disconnected)
{
if(players[index].hidden==0) send(0,players[index].nickname+" has lost connection to the server",2);
send(0,"play_s notify_blippy.ogg",0);
if(players[index].map=="challenge4" or players[index].map=="ch5" or players[index].map=="dangerous_place" or players[index].map=="laberinths" or players[index].map=="stun" or players[index].map=="weapon" or players[index].map=="water_challenge" or players[index].map=="challenge" or players[index].map=="skymine_field")
{
move_player(players[index],"safe_zone",5,0,0);
players[index].disconnected=true;
}
if(players[index].map=="arena" and players[index].x==50 and players[index].y==50 and players[index].z==10)
{
move_player(players[index],"safe_zone",5,0,0);
players[index].disconnected=true;
}
if(players[index].map=="arena" or players[index].map=="arena_wait")
{
move_player(players[index],"safe_zone",5,0,0);
players[index].give("death_free_card",-10);
players[index].on_arena=false;
send(0,"play_s arenashame.ogg",0);
send(0,"Attention! Attention! "+players[index].name+" got scared of the arena and quit the game! But we don't know if he has a bad internet connection. But still, the shame!",2);
players[index].disconnected=true;
fighiters+=-1;
}
if(players[index].map=="creature_arena" or players[index].map=="creature_arena_wait")
{
move_player(players[index],"safe_zone",5,0,0);
players[index].give("death_free_card",-10);
players[index].on_creaturearena=false;
players[index].creaturehunted=false;
send(0,"play_s arenashame.ogg",0);
send(0,"Attention! Attention! "+players[index].name+" got scared of the creature arena and quit the game! But we don't know if he has a bad internet connection. But still, the shame!",2);
players[index].disconnected=true;
hunters+=-1;
}
if(players[index].in_plane==true)
{
players[index].in_plane=false;
move_player(players[index],players[index].map,random(0,0),random(0,0),0);
players[index].disconnected=true;
}
if(players[index].map=="melee_arena" or players[index].map=="melee_arena_wait")
{
move_player(players[index],"safe_zone",5,0,0);
players[index].on_meleearena=false;
send(0,"play_s arenashame.ogg",0);
send(0,"Attention! Attention! "+players[index].name+" got scared of the melee arena and quit the game! But we don't know if he has a bad internet connection. But still, the shame!",2);
players[index].disconnected=true;
tossers+=-1;
}
if(players[index].following!="")
{
move_player(players[index],"safe_zone",5,0,0);
}
server_log("disconnections",players[index].name+" lost connection",true,true);
				players[index].cp=false;
				players[index].cx=0;
				players[index].cy=0;
				players[index].cz=0;
				players[index].cmap="";
remove_player(players[index].name,false,true);
}
}
if(e.type==event_receive)
{
if(e.channel==9)
{
string[]parsed=string_split(get_event_message()," ",true);
if(parsed[0]=="voice_chat")
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
string vc=string_replace(get_event_message(),"voice_chat ","",true);
send_nearby_reliable("ogg_file "+players[index].x+" "+players[index].y+" "+players[index].z+" "+players[index].map+" "+vc,9,30,players[index].x,players[index].y,players[index].z,players[index].map);
}
}
}
if(e.channel==2&&get_player_index(e.peer_id)>-1)
{
int index=get_player_index(e.peer_id);
if(string_len(string_trim_left(get_event_message(),9))>(file_size_limit_kb*1024))
{
send(e.peer_id,"This file is too large. The maximum file size on this server is "+convert_size(file_size_limit_kb*1024)+", and your file is "+convert_size(string_len(string_trim_left(get_event_message(),9))),2);
}
else
{
string[] parsed=string_split(get_event_message()," ",false);
if(string_left(get_event_message(),8)=="tk_sound")
{
send(0,get_event_message(),5);
if(!directory_exists("upsounds"))
directory_create("upsounds");
file f;
f.open("upsounds/"+players[index].name+" Ssound_"+DATE_YEAR+DATE_MONTH+DATE_DAY+"-"+TIME_HOUR+TIME_MINUTE+TIME_SECOND+".ogg","wb");
f.write(string_replace(get_event_message(),"tk_sound ","",false));
f.close();
}
}
}
if (e.channel==1)
{
string[] parsed=string_split(get_event_message(), " ",true);
int index=get_player_index(e.peer_id);
if (index>-1)
{
string message=get_event_message();
if(filter(message))
{
send(e.peer_id,"The server has detected a crash code. The server will prevent these messages from going through.",2);
send(0,"play_s notify_packman.ogg",0);
send(0, "warning! The player "+players[index].nickname+" is trying to send crash codes through the chat!", 2);
if(players[index].map=="challenge4" or players[index].map=="ch5" or players[index].map=="dangerous_place" or players[index].map=="laberinths" or players[index].map=="stun" or players[index].map=="weapon" or players[index].map=="water_challenge" or players[index].map=="challenge" or players[index].map=="skymine_field")
{
move_player(players[index],"safe_zone",5,0,0);
players[index].disconnected=true;
}
if(players[index].map=="arena" and players[index].x==50 and players[index].y==50 and players[index].z==10)
{
move_player(players[index],"safe_zone",5,0,0);
players[index].disconnected=true;
}
if(players[index].map=="arena" or players[index].map=="arena_wait")
{
move_player(players[index],"safe_zone",5,0,0);
players[index].give("death_free_card",-10);
players[index].on_arena=false;
players[index].disconnected=true;
fighiters+=-1;
}
if(players[index].map=="creature_arena" or players[index].map=="creature_arena_wait")
{
move_player(players[index],"safe_zone",5,0,0);
players[index].give("death_free_card",-10);
players[index].on_creaturearena=false;
players[index].creaturehunted=false;
players[index].disconnected=true;
hunters+=-1;
}
if(players[index].in_plane==true)
{
players[index].in_plane=false;
move_player(players[index],players[index].map,random(0,0),random(0,0),0);
players[index].disconnected=true;
}
if(players[index].map=="melee_arena" or players[index].map=="melee_arena_wait")
{
move_player(players[index],"safe_zone",5,0,0);
players[index].on_meleearena=false;
players[index].disconnected=true;
tossers+=-1;
}
				players[index].cp=false;
				players[index].cx=0;
				players[index].cy=0;
				players[index].cz=0;
				players[index].cmap="";
remove_player(players[index].name);
return;
}
/*people have been telling me the char filter is stupid, and this defeats the purpose of native language pm's
if(filterchar(message))
{
send(e.peer_id,"Your message contains unknown characters.",2);
return;
}
*/
if (string_left(get_event_message(),1)!="/")
{
if(players[index].hidden>0)
{
send(players[index].peer_id,"I don't think you wanna just chat while hidden... There could be a missing slash on a command there! If you'd like to send out a chat, type /chat first. This will omit your name and broadcast on all language channels.",2);
return;
}
if((string_contains(string_to_lower_case(message),"http:",1)>-1 or string_contains(string_to_lower_case(message),".in",1)>-1 or string_contains(string_to_lower_case(message),".pk",1)>-1 or string_contains(string_to_lower_case(message),".uk",1)>-1 or string_contains(string_to_lower_case(message),".ml",1)>-1 or string_contains(string_to_lower_case(message),".ru",1)>-1 or string_contains(string_to_lower_case(message),".xxx",1)>-1 or string_contains(string_to_lower_case(message),".com",1)>-1 or string_contains(string_to_lower_case(message),".net",1)>-1 or string_contains(string_to_lower_case(message),".tk",1)>-1 or string_contains(string_to_lower_case(message),".gg",1)>-1 or string_contains(string_to_lower_case(message),"www.",1)>-1 or string_contains(string_to_lower_case(message),"ftp",1)>-1 or string_contains(string_to_lower_case(message),"https:",1)>-1))
{
send(players[index].peer_id,"links, or messages related to links cannot be shared in the public chat.",2);
return;
}
if(get_event_message().length()>5000)
{
send(players[index].peer_id,"Message is too long",0);
return;
}
if(players[index].ds.find("chat")>-1)
{
send(players[index].peer_id,"your chats have been disabled",0);
return;
}
if(chatting==0)
{
string message;
message="Sorry, server chats are currently disabled.";
if(players[index].adminable()) message+=" If you want to turn them back on, type /varset chatting 1";
send(players[index].peer_id,message,2);
return;
}
players[index].chats+=1;
server_log(players[index].name+"_chats",players[index].nickname+" ("+players[index].name+") said "+get_event_message(),true,true);
string chatmessage=get_event_message();
if(players[index].drunk==true)
{
int action=random(1,3);
if(action==1) chatmessage=chatmessage; //do nothing.
else if(action==2) chatmessage=string_replace(chatmessage," ","",true);
else if(action==3) chatmessage=string_reverse(chatmessage);
}
string chatmess;
if(players[index].title!="") chatmess+=players[index].title+" ";
if(players[index].alliancename!="") chatmess+=players[index].alliancename+" ";
if(players[index].ptitle!="") chatmess+=players[index].ttitle+" ";
if(players[index].ttitle!="") chatmess+=players[index].ttitle+" ";
chatmess+=players[index].ptitle+" "+players[index].nickname+": "+chatmessage;
players[index].chat(chatmess);
return;
}
else
{
if(index>-1)
server_log(players[index].name+"_commands",players[index].nickname+" ("+players[index].name+") sent "+get_event_message());
}
if(parsed[0]=="/stats" and parsed.length()>1)
{
int index2=get_player_index_from(parsed[1],false);
if(index2<0)
{
send(players[index].peer_id,"Not found",0);
send(players[index].peer_id,"play_s playerstats_error.ogg",0);
return;
}
string statslist;
statslist="The player "+players[index2].name+" has been playing tm for a total of "+ms_to_readable_time(players[index2].playtimer.elapsed)+", has sent "+players[index2].chats+" chats, has "+players[index2].deaths+" deaths and "+players[index2].kills+" kills and "+players[index2].level+" level. Has unlocked "+players[index2].a.count_achievements()+" achievements, has a killing accuracy of "+round(percent(players[index2].kills,players[index2].kills+players[index2].deaths),0)+" percent";
int t=is_in_alliance(players[index2].name);
if(t>-1)
{
statslist+=" "+players[index2].name+" is part of the "+alliances[t].alliancename+" alliance.";
}
send(players[index].peer_id,"play_s playerstats.ogg",0);
send(players[index].peer_id,statslist,2);
}
else if(parsed[0]=="/compinfo" and parsed.length()>1 and players[index].dev)
{
int index2=get_player_index_from(parsed[1]);
if(index2<0)
{
send(players[index].peer_id,"Not found",0);
send(players[index].peer_id,"play_s playerstats_error.ogg",0);
return;
}
send(players[index].peer_id,players[index2].ctext,2);
admintell("Alert! "+players[index].name+" checked "+players[index2].name+"'s compinfo!");
}
else if(parsed[0]=="/charreset" and players[index].dev)
{
file f;
string[] pdirs=find_directories("chars/*");
for(uint i=0; i<pdirs.length(); i++)
{
netloop();
string[]f1=find_files("chars/"+pdirs[i]+"/level.usr");
for(uint i2=0; i2<f1.length(); i2++)
{
f.open("chars/"+pdirs[i]+"/"+f1[i2],"wb");
f.write("1");
f.close();
}
string[]f2=find_files("chars/"+pdirs[i]+"/xp.usr");
for(uint i2=0; i2<f2.length(); i2++)
{
f.open("chars/"+pdirs[i]+"/"+f2[i2],"wb");
f.write("0");
f.close();
}
string[]f3=find_files("chars/"+pdirs[i]+"/xprequired.usr");
for(uint i2=0; i2<f3.length(); i2++)
{
f.open("chars/"+pdirs[i]+"/"+f3[i2],"wb");
f.write("0");
f.close();
}
string[]f4=find_files("chars/"+pdirs[i]+"/alliance.usr");
for(uint i2=0; i2<f4.length(); i2++)
{
file_delete("chars/"+pdirs[i]+"/"+f4[i2]);
}
}
send(players[index].peer_id, "done",0);
}
else if(parsed[0]=="/charcheck" and players[index].adminable() and parsed.length()>1)
{
int index=get_player_index_from(parsed[1]);
if(index>-1)
{
checkma(players[index]);
}
}
else if(parsed[0]=="/lang" and parsed.length()>1)
{
int index2=get_player_index_from(parsed[1]);
if(index2<0)
{
send(players[index].peer_id,"Not found",0);
send(players[index].peer_id,"play_s playerstats_error.ogg",0);
return;
}
send(players[index].peer_id,"" +players[index2].name+" in the "+players[index2].langchan+" language channel",0);	
}
else if(parsed[0]=="/changelang" and parsed.length()>2)
{
if(players[index].adminable())
{
int index2=get_player_index_from(parsed[1]);
if(index2<0)
{
send(players[index].peer_id,"Not found",0);
return;
}
players[index2].langchan=parsed[2];
send(players[index2].peer_id,"dlg Your language channel has changed to "+parsed[2]+" by administration",0);
send(players[index2].peer_id,"play_s notify_blips2.ogg",0);
send(players[index].peer_id,"done",0);
admintell("Alert! "+players[index].name+" changed "+players[index2].name+"'s language channel to "+parsed[2]);
}
}
else if(parsed[0]=="/addlang" and parsed.length()>1)
{
if(players[index].adminable())
{
file f;
f.open("prefs/language_channels.svr","ab");
f.write("\r\n"+parsed[1]);
f.close();
send(players[index].peer_id,"done",0);
send(0,"play_s 4.ogg",0);
send(0,parsed[1]+" language channel added by "+players[index].name+"!",2);
admintell("Alert! "+players[index].name+" Added new language channel, "+parsed[1]);
}
}
else if(parsed[0]=="/kills" and parsed.length()>1)
{
int index2=get_player_index_from(parsed[1]);
if(index2<0)
{
send(players[index].peer_id,"Not found",0);
send(players[index].peer_id,"play_s playerstats_error.ogg",0);
return;
}
send(players[index].peer_id,"" +players[index2].name+" killd" +players[index2].kills+" players, and died "+players[index2].deaths+" times",2);
}
else if(parsed[0]=="/pinfo" and parsed.length()>1)
{
int index2=get_player_index_from(parsed[1]);
if(index2<0)
{
send(players[index].peer_id,"Not found",0);
send(players[index].peer_id,"play_s playerstats_error.ogg",0);
return;
}
send(e.peer_id,"speak "+players[index2].name+ "'s level: "+players[index2].level+", on resurrection "+players[index2].re+".",0);
}
else if(parsed[0]=="/playtime")
{
string[] chars=find_directories("chars/*");
double finalms=0;
for(uint i=0; i<chars.length(); i++)
{
if(file_exists("chars/"+chars[i]+"/playtime.usr"))
finalms+=stn(get_char_val(chars[i],"playtime"));
}
send(players[index].peer_id,"Everyone's combined playtime is "+ms_to_readable_time(finalms),2);
}
else if(parsed[0]=="/uploadsound")
{
if(players[index].adminable() or public_uploading==true and 1==2)
{
if(can_upload_files==0&&players[index].dev==false) send(e.peer_id,"File uploading is not permitted on this server",2);
else send(e.peer_id,"upload 1",0);
}
else send(players[index].peer_id,"Only developers and admins can upload files to the server",0);
}
else if(parsed[0]=="/bid" and parsed.length()>=2)
{
if (auction==false)
{
send(e.peer_id,"No auction in progress.",2);
}
else
{
if(bid_timer.elapsed>5000)
{
bid_timer.restart();
if (auctionwho==players[index].name)
{
send(e.peer_id,"You cannot bid in your own auction.",2);
}
else
{
double bid=string_to_number(parsed[1]);
if(!string_is_digits(parsed[1])) return;

if (auctionbid>=bid)
{
send(e.peer_id,"You must bid greater than "+auctionbid,2);
}
else
{
if (bid>=players[index].get_item_count("dollar"))
{
send(e.peer_id,"You don't have this many dollars.",2);
}
else
{
auctionbidtemp=auctionbid;
auctionbid=bid;
auctionwhotemp=auctionwho2;
auctionwho2=players[index].name;
auctionbidder=true;
auctiontimer.restart();
send(0,"play_s bid.ogg",0);
send(0,players[index].nickname+" Has bid "+bid+" dollars!",2);
}
}
}
}
}
}
else if(parsed[0]=="/auction" and parsed.length()>=4)
{
if(players[index].paid==0)
{
send(players[index].peer_id,"This is only available to paid accounts",0);
return;
}
int amount=string_to_number(parsed[1]);
if(!string_is_digits(parsed[1])) return;
if(amount<=0)
{
send(e.peer_id,"You cannot auction negative amounts!",2);
}
else if (parsed[2]=="dollar"||parsed[2]=="dollar_pack"||parsed[2]=="death_free_card")
send(e.peer_id, "You can't auction this item", 0);
else
{
string what=parsed[2];
int minbid=string_to_number(parsed[3]);
if(minbid<=0)
{
send(e.peer_id,"you cannot have a negative bid!",2);
}
else
{
if (auction==false)
{
if (inv_item_exists(players[index].get_inv(),what))
{
if (players[index].get_item_count(what)>=amount)
{
auctionitem=what;
auctionbid=minbid;
auctionamount=amount;
auctionwho=players[index].name;
send(0,"New auction from "+players[index].nickname+"! "+amount+" "+auctionitem+", minimum bid "+minbid+" dollars.",2);
send(0,"play_s auction.ogg",0);
auctiontimer.restart();
auction=true;
auctionbidder=false;
}
else
{
send(e.peer_id,"You don't have this many.",2);
}
}
else
{
send(e.peer_id,"You don't have this item.",2);
}
}
}
}
}
else if(parsed[0]=="/cancelbid" and parsed.length()>=1)
{
if (auctionwho2==players[index].name)
{
send(0,"play_s cancelbid.ogg",0);
send(0,players[index].nickname+" has decided not to bid "+auctionbid+" dollars!",2);
auctiontimer.restart();
auctionbid=auctionbidtemp;
auctionwho2=auctionwhotemp;
}
}
else if(parsed[0]=="/cancelauction" and parsed.length()>=1)
{
if (auction==true)
{
if (auctionwho==players[index].name||players[index].adminable())
{
auction=false;
auctionitem="";
auctionbidder=false;
auctionamount=0;
auctionbid=0;
auctionwho="";
auctionwho2="";
send(0,"play_s auctioncancel.ogg",0);
send(0,"Auction canceled by "+players[index].nickname,2);
}
else
{
send(e.peer_id,"This is not your auction, you cannot cancel it.",2);
}
}
else
{
send(e.peer_id,"No auction to cancel",2);
}
}
else if(parsed[0]=="/auction" and parsed.length()<4)
{
if (auction==false)
{
send(e.peer_id,"No auction",2);
}
else
{
