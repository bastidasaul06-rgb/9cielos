if(players[i].name!=players[x].name)
{
send(players[x].peer_id,string_replace(parsed[1],".ogg","",true)+" "+px+" "+y+" "+z+" "+map,3);
}
}
}
}
else if(parsed[0]=="updatezone" and parsed.length()>1)
