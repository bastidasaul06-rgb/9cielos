if(l>-1)
{
send(players[index].peer_id,"You already have a locker!",0);
return;
}
if(can_spawn_locker_at(players[index].x,players[index].y,players[index].z,players[index].map)==false)
{
send(players[index].peer_id,"Can not build lockers here",0);
return;
}
if(get_locker_at(players[index].x,players[index].y,players[index].z,players[index].map)>-1)
{
send(players[index].peer_id,"There is already a locker here!",0);
return;
}
if(players[index].map!="locker")
{
send(players[index].peer_id,"Lockers can only be built in the lockers place",0);
return;
}
else
{
takeobj=true;
players[index].lockerplacetimer.restart();
players[index].lockerplacing=true;
send(players[index].peer_id,"stopmoving",0);
players[index].playsound("locker_placing");
}
