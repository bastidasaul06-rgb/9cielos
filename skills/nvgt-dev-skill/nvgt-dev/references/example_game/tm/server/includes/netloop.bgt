if(p>-1)
{
int p2 = get_player_index_from(parsed[1]);
alliances[p].leave(players[p2].name);
send(players[p2].peer_id, "your alliance was been reset",2);
send(players[index].peer_id, parsed[1]+"'s alliance was been reset", 2);
}
else
{
send(players[index].peer_id, "that player is not in any alliance", 2);
}
}
else if(parsed[0]=="/shelterview" and parsed.length()>1 and players[index].adminable())
