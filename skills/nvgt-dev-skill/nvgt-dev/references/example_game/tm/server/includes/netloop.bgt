{
send(players[index].peer_id,"the fight is already going on",0);
return;
}
if(players[index].following!="")
{
send(players[index].peer_id,"can't join the arena while watching someone.",2);
return;
}
if(players[index].map=="arena_wait")
{
send(players[index].peer_id,"you are already in the arena",0);
return;
}
if(players[index].map=="event" or players[index].map=="event2")
{
send(players[index].peer_id,"No! You on the event map",0);
return;
}
if(players[index].map=="jail")
{
send(players[index].peer_id,"You are in jail",0);
return;
}
if(players[index].afk==true)
{
send(players[index].peer_id,"Can't fight while is_using away mode",0);
return;
}
if(players[index].invinsible==true)
{
send(players[index].peer_id,"As long as you are pacifist, you will not be able to enter the arena",0);
return;
}
if(players[index].robotmode==true)
{
send(players[index].peer_id,"can't join with creature mode enabled",2);
return;
}
if(inv_item_number(items,"dollar")<10000)
{
send(players[index].peer_id,"you don't have enough money to fight",0);
return;
}
else
{
players[index].oldx=players[index].x;
players[index].oldy=players[index].y;
players[index].oldz=players[index].z;
players[index].oldmap=players[index].map;
				players[index].cp=false;
				players[index].cx=0;
				players[index].cy=0;
				players[index].cz=0;
				players[index].cmap="";
