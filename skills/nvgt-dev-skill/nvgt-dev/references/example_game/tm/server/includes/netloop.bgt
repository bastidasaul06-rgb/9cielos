{
int index=get_player_index(e.peer_id);
if(index<0) return;
string item=players[index].sellitem;
double amount=stn(parsed[1]);
if(amount<=0) return;
if(players[index].get_item_count(item)<amount)
{
send(players[index].peer_id,"you don't have "+amount+" "+item+"s. You only have "+players[index].get_item_count(item)+".",2);
return;
}
double itemprice;
sellitems.get(item,itemprice);
double totalprice=itemprice*amount;
totalprice=round((totalprice*0.75),0);
players[index].give(item,-amount);
players[index].give("dollar",totalprice);
players[index].sellitem="";
players[index].playsound("store_purchase_success"+random(1,6));
send(players[index].peer_id,"you have received "+totalprice+" dollars in return for your contribution",2);
}
else if(parsed[0]=="alliancecreate" and parsed.length()>1)
