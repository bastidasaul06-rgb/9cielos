string[] requests=string_split(r.read(),"\r\n",true);
r.close();
string stext="There are "+requests.length()+" requests.";
for(uint i=0; i<requests.length(); i++)
{
stext+=" request "+i+": "+requests[i]+"\r\n";
}
send(e.peer_id,stext,2);
}
