players[index].give("dollar",-10000);
send(players[index].peer_id,"You paid 10000 dollars and participated in battles",2);
send(0,players[index].name+" participated in battles and will fight in the arena!",2);
send(0,"play_s arenajoin.ogg",0);
move_player(players[index],"arena_wait",0,0,0);
fighiters+=1;
}
}
