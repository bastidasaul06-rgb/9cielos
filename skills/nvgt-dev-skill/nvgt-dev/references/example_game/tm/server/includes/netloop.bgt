{
place_mine(random(0,max.x),0,random(0,max.z),players[index].map,players[index].name);
}
send(players[index].peer_id,"done",0);
}
else if(parsed[0]=="/skyminesweeper" and players[index].dev)
{
vector max=get_max_values(players[index].map);
for(uint i=0; i<500; i++)
{
place_sky_mine(random(0,max.x),random(0,max.y),random(0,max.z),players[index].map,players[index].name);
}
send(players[index].peer_id,"done",0);
}
else if(parsed[0]=="/spawn_fire" and players[index].dev)
{
vector max=get_max_values(players[index].map);
for(uint i=0; i<10; i++)
{
spawn_fire(random(0,max.x),random(0,max.y),0,players[index].map,random(400,700));
}
send(players[index].peer_id,"done",0);
