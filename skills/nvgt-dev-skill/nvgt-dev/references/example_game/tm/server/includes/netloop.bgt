else if(parsed[0]=="/intmaps"&&players[index].adminable())
{
string msg=""+maps.length()+" internally loaded maps:";
for(uint i=0; i<maps.length(); i++)
{
if(i==(maps.length()-1)) msg+=" and "+maps[i].name;
else msg+=" "+maps[i].name+",";
}
send(players[index].peer_id,"play_s dev.ogg",0);
send(players[index].peer_id,msg,2);
}
else if(parsed[0]=="/rawmap")
{
int s=in_shelter(players[index].name);
if(players[index].adminable()||players[index].is_builder||beta/*||s>-1 and shelters[s].is_allowed(players[index].name)*/)
{
string mapname=players[index].map;
send(e.peer_id,"clip "+get_map_text(mapname),0);
send(e.peer_id,"speak the data of "+mapname+" has been copied to your clipboard",0);
admintell("Alert! "+players[index].name+" copied "+mapname+"'s data!");
}
else
{
send(players[index].peer_id,"unable to edit this map",0);
}
}
else if(parsed[0]=="/rawdata")
{
int s=in_shelter(players[index].name);
if(players[index].adminable()||players[index].is_builder||beta==true&&players[index].map!="main")
{
string mapname=players[index].map;
string mapdata=string_trim_left(get_event_message(),9);
string[] lines=string_split(mapdata,"\r\n",false);
for(uint i=0; i<lines.length(); i++)
{
string[] ld=string_split(lines[i],":",false);
if(ld.length()<2)
{
send(e.peer_id,"update error: all map commands take at least one argument",2);
return;
}
else if(ld[0]=="mapname"&&ld[1]!=mapname)
{
send(e.peer_id,"update error: map names do not match",2);
return;
}
else if(s>-1&&ld[0]=="ispawn"&&ld.length()>8)
{
send(e.peer_id,"update error: item spawning is not permitted in shelters",2);
return;
}
else if(s>-1&&ld[0]=="vending_machine"&&ld.length()>3)
{
send(e.peer_id,"update error: vending machines are not permitted in shelters",2);
return;
}
else if(ld[0]=="ispawn" and ld.length()<9)
{
send(e.peer_id,"update error: item spawn declaration on line "+i+" has too few arguments. Syntax is ispawn:minx:maxx:miny:maxy:minz:maxz:time:maxobjs, got "+lines[i],2);
return;
}
else if(!players[index].adminable()&&!players[index].is_builder&&ld[0]=="travelpoint"&&ld.length()>11&&s>-1&&shelters[s].is_allowed(players[index].name))
{
send(e.peer_id,"update error: travelpoints are not allowed in shelters",2);
return;
}
else if(ld[0]=="travelpoint" and ld.length()<12)
{
send(e.peer_id,"update error: travelpoint declaration on line "+i+" has too few arguments. Syntax is travelpoint:minx:maxx:miny:maxy:minz:maxz:newmap:newx:newy:newz:text, got "+lines[i],2);
return;
}
else if(ld[0]=="tile" and ld.length()<8)
{
send(e.peer_id,"update error: declaration of tile on line "+i+" has too few arguments. Syntax is tile:minx:maxx:miny:maxy:minz:maxz:type, got "+lines[i],2);
return;
}
else if(ld[0]=="zone" and ld.length()<8)
{
send(e.peer_id,"update error: declaration of zone on line "+i+" has too few arguments. Syntax is zone:minx:maxx:miny:maxy:minz:maxz:text[:trackme], got "+lines[i],2);
return;
}
else if(ld[0]=="door" and ld.length()<14)
{
send(e.peer_id,"update error: declaration of door on line "+i+" has too few arguments. Syntax is door:minx:maxx:miny:maxy:minz:maxz:fx:fy:fz:speed:loop:moveloop:opensound:closesound, got "+lines[i],2);
return;
}
else if(ld[0]=="auto_moover" and ld.length()<12)
{
send(e.peer_id,"update error: declaration of auto_moover on line "+i+" has too few arguments. Syntax is auto_moover:x:y:z:fx:fy:fz:speed:loop:moveloop:opensound:closesound, got "+lines[i],2);
return;
}
else if(ld[0]=="src" and ld.length()<8)
{
send(e.peer_id,"update error: declaration of source on line "+i+" has too few arguments. Syntax is src:minx:maxx:miny:maxy:minz:maxz:loop.ogg[:id], got "+lines[i],2);
return;
}
else if(ld[0]=="src" and ld.length()>=8 and string_right(ld[7],4)!=".ogg")
{
send(e.peer_id,"update error: declaration of source on line "+i+" missing file extension. Please use "+ld[7]+".ogg",2);
return;
}
else if(ld[0]=="amb" and ld.length()<8)
{
send(e.peer_id,"update error: declaration of ambience on line "+i+" has too few arguments. Syntax is amb:minx:maxx:miny:maxy:minz:maxz:loop.ogg, got "+lines[i],2);
return;
}
else if(ld[0]=="cmusic" and ld.length()<8)
{
send(e.peer_id,"update error: declaration of source on line "+i+" has too few arguments. Syntax is cmusic:minx:maxx:miny:maxy:minz:maxz:loop.ogg[:id], got "+lines[i],2);
return;
}
else if(ld[0]=="cmusic" and ld.length()>=8 and string_right(ld[7],4)!=".ogg")
{
send(e.peer_id,"update error: declaration of source on line "+i+" missing file extension. Please use "+ld[7]+".ogg",2);
return;
}
else if(ld[0]=="amb" and ld.length()>=8 and string_right(ld[7],4)!=".ogg")
{
send(e.peer_id,"update error: declaration of ambience on line "+i+" missing file extension. Please use "+ld[7]+".ogg",2);
return;
}
}

file f;
f.open("maps/"+mapname+".map","wb");
f.write(mapdata);
f.close();
mapupdate(mapname);
send(players[index].peer_id,"Map updated",0);
admintell("Alert! "+players[index].name+" updated "+mapname+"'s data!");
}
else
send(players[index].peer_id,"unable to edit this map",0);
}
else if(parsed[0]=="/last_runtime" and players[index].dev)
{
