send(players[index2].peer_id,"play_s notify_trust.ogg",0);
}
}
else if(parsed[0]=="/untrust" and parsed.length()>1)
{
int index2=get_player_index_from(parsed[1]);
if(index2>-1)
{
if(players[index].untrust(parsed[1])==false)
{
