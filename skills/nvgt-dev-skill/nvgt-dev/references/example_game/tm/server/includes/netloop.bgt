else if(shelters[shind].owner!=players[index].name)
send(players[index].peer_id,"you cannot get or set permissions on a shelter you do not own",2);
else if(parsed[1]==shelters[shind].owner) send(players[index].peer_id,"you can always enter your own shelter, so no point in adding yourself to your permissions list.",2);
else if(get_player_index_from(parsed[1])<0) send(players[index].peer_id,"player not found",2);
else
{
int s=shelters[shind].add_allowed_player(parsed[1]);
if(s==0) send(players[index].peer_id,"player "+parsed[1]+" can now enter the "+shelters[shind].sheltername+" shelter",2);
else if(s==1) send(players[index].peer_id,"player "+parsed[1]+" not found",2);
