{
spawn_impact_bomb(random(0,max.x),random(0,max.y),0,players[index].map,players[index].name);
}
send(players[index].peer_id,"done",0);
}
else if(parsed[0]=="/bullet_dotty" and players[index].dev)
{
vector max=get_max_values(players[index].map);
for(uint i=0; i<100; i++)
{
spawn_bullet_bomb(random(0,max.x),random(0,max.y),0,players[index].map,players[index].name);
}
send(players[index].peer_id,"done",0);
}
