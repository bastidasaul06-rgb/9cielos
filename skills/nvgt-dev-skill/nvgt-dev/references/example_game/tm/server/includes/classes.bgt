demon_king@[] demon_kings(0);
const int INT_MAX = 2000000000;
class demon_king
{
int x;
int y;
int z;
string map;
string zone;
string mid;
string owner;
string teamname;
timer stimer;
timer mtimer;
int mtime=300;
timer xtimer;
int health=random(100000000,100000000);
int id=random(1,100);
string hitby;
demon_king(int sx,int sy,int sz,string smap,string soner)
{
x=sx;
y=sy;
z=sz;
map=smap;
owner=soner;
mid=spawn_moving_sound("demon_king_step1.ogg",x,y,z,map);
}
}
void demon_kingloop()
{
    for(uint i = 0; i < demon_kings.length(); i++)
    {
if(demon_kings[i].xtimer.elapsed>30000000)
{
destroy_moving_sound(demon_kings[i].mid);
demon_kings[i].health=-1;
demon_kings[i].hitby="sunlight";
demon_kings.remove_at(i);
i--;
continue;
}
else if(demon_kings[i].map=="safe_zone")
{
demon_kings[i].health=-1;
demon_kings[i].hitby="cheating detecter";
demon_kings.remove_at(i);
i--;
continue;
}
        int oindex = get_player_index_from(demon_kings[i].owner);
        if (oindex < 0)
        {
            destroy_moving_sound(demon_kings[i].mid);
            demon_kings.remove_at(i);
            i--;
            continue;
        }
        if (demon_kings[i].health < 0)
        {
            play("demon_kingkill", demon_kings[i].x, demon_kings[i].y, demon_kings[i].z, demon_kings[i].map);
            send(0, "play_s robotkillalert.ogg", 0);
            send(0, "playerdeath " + killmsg(demon_kings[i].owner+"'s demon_king " + demon_kings[i].id, demon_kings[i].hitby, demon_kings[i].map), 0);
            destroy_moving_sound(demon_kings[i].mid);
            demon_kings.remove_at(i);
            i--;
            continue;
        }
        
        // Check for nearby demon_kings and players
        int index = get_nearest_player(demon_kings[i].x, demon_kings[i].y, demon_kings[i].z, demon_kings[i].map, oindex);
int demonIndex = get_nearest_demon_king(demon_kings[i].x, demon_kings[i].y, demon_kings[i].z, demon_kings[i].map, demon_kings[i].owner);        
        if (index > -1 || demonIndex > -1)
        {
            int miss = random(1, 30);
            int dist = (index > -1) ? get_3d_distance(demon_kings[i].x, demon_kings[i].y, demon_kings[i].z, players[index].x, players[index].y, players[index].z) : INT_MAX;
            int hDist = (demonIndex > -1) ? get_3d_distance(demon_kings[i].x, demon_kings[i].y, demon_kings[i].z, demon_kings[demonIndex].x, demon_kings[demonIndex].y, demon_kings[demonIndex].z) : INT_MAX;
            
            // Randomly choose to attack a player or another demon_king
            if (dist < hDist || (dist == hDist && random(0, 1) == 0))
            {
                // Attack the player
if(in_vehicle(players[index].name)>-1 or players[index].newb==1 or players[index].is_protected==true or players[index].is_dead or players[index].invinsible) continue;
                if (dist < 40 && demon_kings[i].stimer.elapsed > 5000 && index != oindex && players[index].z == demon_kings[i].z)
                {
                    demon_kings[i].stimer.restart();
play("demon_king_hit",demon_kings[i].x,demon_kings[i].y,demon_kings[i].z,demon_kings[i].map);
send(0,"distsound demon_king_hit "+demon_kings[i].x+" "+demon_kings[i].y+" "+demon_kings[i].z+" "+demon_kings[i].map,0);
                    if (miss < 30)
                    {
                        if (players[index].shielded)
                        {
                            players[index].playsound("shieldhit" + random(1, 4));
                            players[index].shieldshots -= random(10000, 10000);
                        }
                        else
                        {
players[index].hit(4000000,5000000);
                            players[index].hitby = demon_kings[i].owner + "'s demon_king " + demon_kings[i].id;
players[index].playsound("demon_king_hit");
                        }
                    }

                }
                // Move towards the player
                if (demon_kings[i].mtimer.elapsed > demon_kings[i].mtime)
                {
                    demon_kings[i].mtimer.restart();
                    if (players[index].x <= demon_kings[i].x)
                        demon_kings[i].x--;
                    else if (players[index].x > demon_kings[i].x)
                        demon_kings[i].x++;
                    if (players[index].y <= demon_kings[i].y)
                        demon_kings[i].y--;
                    else if (players[index].y > demon_kings[i].y)
                        demon_kings[i].y++;
                    if (players[index].z <= demon_kings[i].z)
                        demon_kings[i].z--;
                    else if (players[index].z > demon_kings[i].z)
                        demon_kings[i].z++;
                    update_moving_sound(demon_kings[i].mid, demon_kings[i].x, demon_kings[i].y, demon_kings[i].z);
                }
            }
            else
            {
        // Attack the other demon_king
        if (hDist < 40 && demon_kings[i].stimer.elapsed > 300)
        {
demon_kings[i].stimer.restart();
players[index].playsound("demon_king_hit");
                    send(0, "distsound demon_king_hit " + demon_kings[i].x + " " + demon_kings[i].y + " " + demon_kings[i].z + " " + demon_kings[i].map, 0);
if(miss < 30)
{
            demon_kings[demonIndex].health -= random(4000000,5000000); // You can adjust the damage as needed
            demon_kings[demonIndex].hitby = demon_kings[i].owner + "'s demon_king " + demon_kings[i].id;
players[index].playsound("demon_king_hit");
}
        }
// Move towards the target (player or another demon_king)
if (demon_kings[i].mtimer.elapsed > demon_kings[i].mtime)
{
    demon_kings[i].mtimer.restart();

    int deltaX, deltaY, deltaZ;

    if (dist < hDist || (dist == hDist && random(0, 1) == 0))
    {
        // Move towards the player
        deltaX = players[index].x - demon_kings[i].x;
        deltaY = players[index].y - demon_kings[i].y;
        deltaZ = players[index].z - demon_kings[i].z;
    }
    else
    {
        // Move towards the other demon_king
        deltaX = demon_kings[demonIndex].x - demon_kings[i].x;
        deltaY = demon_kings[demonIndex].y - demon_kings[i].y;
        deltaZ = demon_kings[demonIndex].z - demon_kings[i].z;
    }

    // Introduce some random movement
    int randomMoveX = random(-1, 1);
    int randomMoveY = random(-1, 1);
    int randomMoveZ = random(-1, 1);

    // Adjust x, y, and z values based on direction and random movement
    demon_kings[i].x += (deltaX > 0) ? 1 + randomMoveX : ((deltaX < 0) ? -1 + randomMoveX : randomMoveX);
    demon_kings[i].y += (deltaY > 0) ? 1 + randomMoveY : ((deltaY < 0) ? -1 + randomMoveY : randomMoveY);
    demon_kings[i].z += (deltaZ > 0) ? 1 + randomMoveZ : ((deltaZ < 0) ? -1 + randomMoveZ : randomMoveZ);

    // Ensure the demon_king stays within the map boundaries
    vector maxv = get_max_values(demon_kings[i].map);
    
    demon_kings[i].x = (demon_kings[i].x < 0) ? 0 : (demon_kings[i].x > maxv.x) ? maxv.x : demon_kings[i].x;
    demon_kings[i].y = (demon_kings[i].y < 0) ? 0 : (demon_kings[i].y > maxv.y) ? maxv.y : demon_kings[i].y;
    demon_kings[i].z = (demon_kings[i].z < 0) ? 0 : (demon_kings[i].z > maxv.z) ? maxv.z : demon_kings[i].z;

    update_moving_sound(demon_kings[i].mid, demon_kings[i].x, demon_kings[i].y, demon_kings[i].z);
}

            }
        }
    }
}
int get_nearest_demon_king(int hx, int hy, int hz, string hmap, string howner)
{
    int current_distance = -1;
    int final_index = -1;

    for (uint i = 0; i < demon_kings.length(); i++)
    {
        if (demon_kings[i].map != hmap || demon_kings[i].owner == howner || demon_kings[i].health < 0)
        {
            continue;
        }

        int dist = get_3d_distance(hx, hy, hz, demon_kings[i].x, demon_kings[i].y, demon_kings[i].z);

        if (current_distance == -1)
        {
            current_distance = dist;
            final_index = i;
        }
        else
        {
            if (dist < current_distance)
            {
                current_distance = dist;
                final_index = i;
            }
        }
    }

    return final_index;
}

void spawn_demon_king(int x,int y,int z,string map,string owner)
{
demon_king s(x,y,z,map,owner);
demon_kings.insert_last(s);
}
