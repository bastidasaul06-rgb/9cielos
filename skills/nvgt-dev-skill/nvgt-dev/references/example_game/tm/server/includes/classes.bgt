class achievements
{
string achieve;
int count_achievements()
{
int ret=0;
if(achieve=="")
return ret;
string[]  ac=string_split(achieve,"+",false);
return ac.length();
}
bool add(string name)
{
if (!achievement_exists(name))
{
achieve+="+"+name;
return true;
}
return false;
}
string[] list_achievements()
{
string[] a=string_split(achieve,"+",true);
if (achieve=="")
a.insert_last("No achievements");
return a;
}
bool achievement_exists(string name)
{
string[] s=list_achievements();
for (uint i=0; i<s.length(); i++)
{
if (s[i]==name)
{
return true;
}
}
return false;
}
}
bodyfall@[] bodyfalls(0);
class bodyfall
{
int btime=3000;
int x, y, z;
int pindex=-1;
string map;
timer btimer;
bodyfall(int bx, int by, int bz, string bmap, int bodytime=3000,int pbindex=-1)
{
x=bx;
y=by;
z=bz;
map=bmap;
btime=bodytime;
if(pbindex>-1) pindex=pbindex;
}
}
void bodyfallloop()
{
for (uint i=0; i<bodyfalls.length(); i++)
{
if (bodyfalls[i].btimer.elapsed>=bodyfalls[i].btime)
{
play(get_tile_at(bodyfalls[i].x,bodyfalls[i].y,bodyfalls[i].z,bodyfalls[i].map)+"hardland", bodyfalls[i].x, bodyfalls[i].y, bodyfalls[i].z, bodyfalls[i].map);
if(bodyfalls[i].pindex>-1)
{
int px=bodyfalls[i].pindex;
if(px>-1)
players[px].sitting=1;
send(players[px].peer_id,"sitstart",0);
}
@bodyfalls[i]=null;
bodyfalls.remove_at(i);
continue;
}
}
}
void spawn_bodyfall(int x, int y, int z, string map, int time=4000,int index=-1)
{
bodyfall b1(x,y,z,map, time,index);
bodyfalls.insert_last(b1);
}
corpse@[] corpses(0);
string chars="1234567890";
class corpse
{
string id;

dictionary inv;
dictionary ammo;
int x;int y;int z;string map;
corpse(dictionary ammo, dictionary inv, int x, int y, int z, string map)
{
this.ammo=ammo;
this.inv=inv;
this.x=x;
this.y=y;
this.z=z;
this.map=map;

id=generate_id();
//end constructor
}
//end class
}
string generate_id()
{
string vreturn="c";
for(uint i=0; i<10; i++)
{
if(i==2 or i==5 or i==8)
vreturn+="-";
else
vreturn+=chars[random(0,chars.length()-1)];
}
return vreturn;
}
void spawn_corpse(int x, int y, int z, string map, dictionary inv, dictionary ammo, int per=80)
{
if(random(1,100)<=per)
{
corpse tc(ammo, inv, x, y, z, map);
corpses.insert_last(tc);
spawn_obj(x, y, z, map, "bag_"+tc.id);
}
}
void open_corpse(string id, int index)
{
string final="you get the bag of a corpse and open it, the bag contains ";
for(uint i=0; i<corpses.length(); i++)
{
if(corpses[i].id==id)
{
string[] keys;
for(int x=0; x<2; x++)
{
if(x==0)
{
keys=corpses[i].inv.get_keys();
final+="the following items: ";
}
if(x==1)
{
keys=corpses[i].ammo.get_keys();
}
for(uint i2=0; i2<keys.length(); i2++)
{
double amount;
if(x==0)
{
corpses[i].inv.get(keys[i2], amount);
players[index].give(keys[i2], amount);
final+=amount+" "+keys[i2];
if(i2==keys.length()-1)
final+=". ";
else
final+=", ";
}
if(x==1)
{
corpses[i].ammo.get(keys[i2], amount);
players[index].ammo_give(keys[i2], amount);
final+=amount+" "+keys[i2];
if(i2==keys.length()-1)
final+=".";
else
final+=", ";
}
}
}
send(players[index].peer_id, final, 0);
corpses.remove_at(i);
}
}
}

void save_corpses()
{
string final;
for(uint i=0; i<corpses.length(); i++)
{
final+=corpses[i].id+"[]""+corpses[i].inv+";
}
fl.open("prefs/corpses.svr","wb");
fl.write(final);
fl.close();
}
