{
drinkitems.insert_last(item);
drinkprices.insert_last(amount);
}
class siren
{
string id,soundloop,map,owner;
int x,y,z;
siren(string i, string l, int c1, int c2,int c3,string cm,string own=)
{
id=i;
soundloop=l;
x=c1;
y=c2;
z=c3;
map=cm;
owner=own;
}
void updateme(int c1, int c2, int c3)
{
x=c1;
y=c2;
z=c3;
}
