store@[] stores;
class store
{
string [] item_names, descriptions;
double[] prices;
double x, y, z;
string map, name;
string owner;
int health=5000;
double mode=0;
store(double sx, double sy, double sz, string sm, string n)
{
x=sx;
y=sy;
z=sz;
map=sm;
name=n;
}
void add(string item_name, string description, double price)
{
item_names.insert_last(item_name);
descriptions.insert_last(description);
prices.insert_last(price);
}
void storesend(double peer, string packet="buysomething", bool shelter=false)
{
if(item_names.length()==0)
{
send(peer, "this store has no items. sorry.", 0);
return;
}
double index=get_player_index(peer);
if(index>-1)
{
double s=in_shelter(players[index].name);
string items;
double p, canbuy;
for(double i=0; i<item_names.length(); i++)
{
if(shelter and s>-1)
{
p=prices[i];
canbuy=shelters[s].dollars/p;
}
else
{
p=prices[i];
canbuy=players[index].get_item_count("dollar")/p;
}
items+=string_replace(item_names[i], "_", " ", true)+". costs "+p+" dollars. description. "+descriptions[i]+":"+item_names[i]+"[]";
}
send_menu(peer, string_replace(name, "_", " ", true), packet, items);
}
}
double get_item_index(string name)
{
for(double i=0; i<item_names.length(); i++)
{
if(item_names[i]==name) return i;
}
return -1;
}
}

void create_store(double x, double y, double z, string map, string intro)
{
store s(x, y, z, map, intro);
stores.insert_last(s);
}

double get_store_index(double x, double y, double z, string map)
{
for(double i=0; i<stores.length(); i++)
{
if(stores[i].x==x and stores[i].y==y and stores[i].z==z and stores[i].map==map) return i;
}
return -1;
}
double get_store_index_from(string name)
{
for(double i=0; i<stores.length(); i++)
{
if(stores[i].name==name) return i;
}
return -1;
}
void add_to_store(string item, string description, double price, string storename="misc_store")
{
bool added=true;
double index=get_store_index_from(storename);
if(index>-1)
{
string[] tempitems=stores[index].item_names;
for(double i=0; i<tempitems.length(); i++)
{
if(tempitems[i]==item) added=false;
}
}
else added=false;
if(added) stores[index].add(item, description, price);
else
{
return;
}
}

double get_shelter_price(string itemname, double amount)
{
double[] prices=get_amounts();
double i=get_item_index(itemname);
if(i>-1)
{
return prices[i]*amount-(prices[i]*amount)*0.25;
}
return 0;
}
void reset_stores()
{
for(double i=0; i<stores.length(); i++)
{
stores[i].item_names.resize(0);
stores[i].descriptions.resize(0);
stores[i].prices.resize(0);
}
}
alliance@[]alliances(0);
class alliance
{
string[] alliancemembers,buffermembers;
string alliancename;
int maxmembers=5;
double alliancekills=0;
double points=10000;
string allianceleader;
string password;
savedata tempsd("");
alliance(string tn, string tl, string tpw=randomstring(4))
{
alliancename=tn;
allianceleader=tl;
password=tpw;
int index=get_player_index_from(allianceleader);
if(index>-1)
players[index].alliancename=tn;
alliancemembers.insert_last(allianceleader);
tempsd.fn="alliances/"+alliancename+".alliance";
tempsd.key="hvr_alliance";
}
void buffercheck()
{
for(int j=0; j<alliancemembers.length(); j++)
{
if(!is_on_server(alliancemembers[j]))
{
if(buffermembers.find(alliancemembers[j])<0)
buffermembers.insert_last(alliancemembers[j]);
alliancemembers.remove_at(j);
j--;
continue;
}
}
for(int i=0; i<buffermembers.length(); i++)
{
if(is_on_server(buffermembers[i]))
{
if(alliancemembers.find(buffermembers[i]) <0) alliancemembers.insert_last(buffermembers[i]);
buffermembers.remove_at(i);
i--;
continue;
}
}
}

bool passcheck(string pass)
{
if(password==pass)
{
return true;
}
return false;
}
string list_members()
{
string final;
final="There are "+alliancemembers.length()+" online members in your alliance and there are "+buffermembers.length()+" offline members. ";
if(alliancemembers.length()>0)
{
final+="online members: ";
for(uint i=0; i<alliancemembers.length()-1; i++)
{
final+=alliancemembers[i]+", ";
}
final+=" and "+alliancemembers[alliancemembers.length()-1];
}
final+=". ";
if(buffermembers.length()>0)
{
 final+="offline members: ";
for(int i=0; i<buffermembers.length()-1; i++)
{
final+=buffermembers[i]+", ";
}
final+="and "+buffermembers[buffermembers.length()-1];
}
return final;
}
bool is_member(string name)
{
return (alliancemembers.find(name)>-1 or buffermembers.find(name)>-1);
}
bool remove_member(string name,bool r=true,bool message=true)
{
if(alliancemembers.find(name)<0 and buffermembers.find(name)<0) return false;
int index=get_player_index_from(name);
for(uint t=0; t<alliancemembers.length(); t++)
{
if(alliancemembers[t]==name)
{
alliancemembers.remove_at(t);
if(index>-1)
{
players[index].alliancename="";
}
if(r==false) buffermembers.insert_last(name);
if(r==true)
{
write_to(name,"alliance.usr","");
for(uint x=0; x<security_bombs.length(); x++)
{
if(security_bombs[x].owner==name)
security_bombs[x].alliancename="";
}
}
}
}
if(message )
{
transmit(name+" was just removed from the alliance!");
transmit("play_s allianceremove.ogg",false,0);
}
if(r==true)
{
if(buffermembers.find(name)>-1) buffermembers.remove_at(buffermembers.find(name));
write_to(name,"alliance.usr","");
for(uint x=0; x<security_bombs.length(); x++)
{
if(security_bombs[x].owner==name)
security_bombs[x].alliancename="";
}
}
return true;
}
bool leave(string name)
{
int index=get_player_index(e.peer_id);
if(index>-1)
{
for(uint t=0; t<alliancemembers.length(); t++)
{
if(alliancemembers[t]==name) 
{
alliancemembers.remove_at(t);
int bufferIndex=buffermembers.find(name);
while (bufferIndex>-1)
{
buffermembers.remove_at(bufferIndex);
bufferIndex=buffermembers.find(name);
}
transmit(name+" left the alliance!");
transmit("play_s allianceleave.ogg",false,0);
players[index].alliancename="";
write_to(players[index].name,"alliance.usr",players[index].alliancename);
for(uint x=0; x<security_bombs.length(); x++)
{
if(security_bombs[x].owner==players[index].name)
security_bombs[x].alliancename="";
}
return true;
}
}
}
return false;
}
void alliance_save()
{
if(directory_exists("alliances")==false)
directory_create("alliances");
tempsd.add("leader",allianceleader);
tempsd.add("alliancename",alliancename);
tempsd.add("alliancepoints",points);
tempsd.add("maxmembers",maxmembers);
tempsd.add("alliancemembers",linear(alliancemembers));
tempsd.add("buffermembers",linear(buffermembers));
tempsd.add("alliancepassword",password);
tempsd.add("alliancekills",alliancekills);
tempsd.save();
}
void transmit(string t, bool chat=false, int channel=2)
{
for(uint i=0; i<alliancemembers.length(); i++)
{
int dex=get_player_index_from(alliancemembers[i]);
if(dex>-1)
{
if(chat==true)
{
send(players[dex].peer_id,"alliancemessage "+t,1);
}
else
send(players[dex].peer_id,t,channel);
}
}
}
void add_member(string name,bool message=true)
{
int index=get_player_index_from(name);
if(index>-1)
{
players[index].alliancename=alliancename;
if(message)
{
transmit("play_s allianceadd.ogg",false,0);
transmit(name+" was added to your alliance!");
send(players[index].peer_id,"You have been added to the "+alliancename+" alliance!",2);
send(players[index].peer_id,"play_s alliancewelcome.ogg",0);
}
for(uint x=0; x<security_bombs.length(); x++)
{
if(security_bombs[x].owner==players[index].name)
{
security_bombs[x].alliancename=players[index].alliancename;
}
}
write_to(players[index].name,"alliance.usr",players[index].alliancename);
if(buffermembers.find(name)>-1) buffermembers.remove_at(buffermembers.find(name));
if(!is_member(name)) alliancemembers.insert_last(name);
}
}
void destruct(bool message=true)
{
if(message)
{
transmit("play_s alliancekicked.ogg",false,0);
transmit("this alliance has been canceled!");
}
if(alliancemembers.length()>0)
{
do
{
remove_member(alliancemembers[0],true,false);
}
while(alliancemembers.length()>0);
}
for(uint i=0; i<buffermembers.length(); i++)
{
file_delete("chars/"+buffermembers[i]+"/alliance.usr");
}
buffermembers.resize(0);
}
}
void allianceloop()
{
for(uint i=0; i<alliances.length(); i++)
{
if(alliances[i].points<=0)
{
alliances[i].transmit("This alliance has ran out of points and is now being canceled");
alliances[i].destruct(false);
send(0,"The "+alliances[i].alliancename+" alliance ran out of points and has been canceled!",2);
}
if(alliances[i].alliancemembers.length()<=0&&alliances[i].buffermembers.length()<=0)
{
file_delete("alliances/"+alliances[i].alliancename+".alliance");
@alliances[i]=null;
alliances.remove_at(i);
return;
}
alliances[i].buffercheck();
}
}
int is_in_alliance(string n)
{
for(uint t=0; t<alliances.length(); t++)
{
if(alliances[t].alliancemembers.find(n)>-1 or alliances[t].buffermembers.find(n)>-1) return t;
}
return -1;
}
void create_alliance(string t, string tl)
{
alliance t1(t, tl);
alliances.insert_last(t1);
}
int get_alliance_index(string name)
{
for(uint i=0; i<alliances.length(); i++)
{
if(alliances[i].alliancename==name)
return i;
}
return -1;
}
bool alliance_exists(string t)
{
for(uint i=0; i<alliances.length(); i++)
{
if(alliances[i].alliancename==t)
{
return true;
}
}
return false;
}
void load_alliance(string t)
{
string tl,tpw,tm,bm;
double points;
double kls,mxm;
savedata tsd("alliances/"+t+".alliance","hvr_alliance");
tsd.load();
if(tsd.d.exists("leader"))
tl=tsd.read("leader");
if(tsd.d.exists("alliancepassword"))
tpw=tsd.read("alliancepassword");
if(tsd.d.exists("alliancepoints"))
points=tsd.readn("alliancepoints");
if(tsd.d.exists("maxmembers"))
mxm=tsd.readn("maxmembers");
if(tsd.d.exists("alliancemembers"))
tm=tsd.read("alliancemembers");
if(tsd.d.exists("buffermembers"))
bm=tsd.read("buffermembers");
if(tsd.d.exists("alliancekills"))
kls=tsd.readn("alliancekills");
create_alliance(t,tl);
int x=get_alliance_index(t);
alliances[x].allianceleader=tl;
alliances[x].alliancemembers=delinear(tm);
for(uint i=0; i<alliances[x].alliancemembers.length(); i++)
{
if(alliances[x].alliancemembers[i]=="" or alliances[x].alliancemembers[i]==" ") alliances[x].alliancemembers.remove_at(i);
}
alliances[x].maxmembers=mxm;
alliances[x].points=points;
alliances[x].buffermembers=delinear(bm);
for(uint i=0; i<alliances[x].buffermembers.length(); i++)
{
if(alliances[x].buffermembers[i]=="" or alliances[x].buffermembers[i]==" ") alliances[x].buffermembers.remove_at(i);
}
alliances[x].password=tpw;
alliances[x].buffercheck();
alliances[x].alliancekills=kls;
}
void load_all_alliances()
{
string[] alliancefiles=find_files("alliances/*.alliance");
for(uint i=0; i<alliancefiles.length(); i++)
{
load_alliance(string_trim_right(alliancefiles[i],9));
}
}
bool is_part_of_alliance(string playername, string alliancename)
{
int ti=get_alliance_index(alliancename);
if(ti<0) return false;
int pi=get_player_index_from(playername);
if(pi<0) return false;
return alliances[ti].is_member(playername);
}
tempban@[]tempbans(0);
class tempban
{
int mins=5;
int ms;
timer tempbantimer;
string username;
tempban(string un,int min)
{
username=un;
mins=min;
ms=mins*60000;
}
}
void tempbanloop()
{
for(uint i=0; i<tempbans.length(); i++)
{
if(tempbans[i].tempbantimer.elapsed>tempbans[i].ms)
{
send(0,"notify "+tempbans[i].username+"'s temp ban has expired!",0);
@tempbans[i]=null;
tempbans.remove_at(i);
continue;
}
}
}
void create_temp_ban(string user,int minutes=5, double elapsed=0)
{
tempban tb1(user,minutes);
tb1.tempbantimer.force(elapsed);
tempbans.insert_last(tb1);
}
bool tempbancheck(string u)
{
for(uint i=0; i<tempbans.length(); i++)
{
if(tempbans[i].username==u)
return true;
}
return false;
}
bool untempban(string u,string me) {
int i=get_tempban_index(u);
if(i<0) return false;
send(0,"play_s notify_trumpet.ogg",0);
send(0," "+tempbans[i].username+"'s "+ms_to_readable_time(tempbans[i].ms)+" temp ban has been revoked by "+me+"!",0);
tempbans.remove_at(i);
writedata();
return true;
}
int get_tempban_index(string user)
{
for(uint i=0; i<tempbans.length(); i++)
{
if(tempbans[i].username==user) {
return i;
}
}
return -1;
}

void save_tempbans()
{
string final;
for(uint i=0; i<tempbans.length(); i++)
{
final+=tempbans[i].username+"="+tempbans[i].mins+"="+tempbans[i].tempbantimer.elapsed+"\r\n";
}
file_put_contents("prefs/tempbans.svr",final,250);
}

void load_all_tempbans()
{
file tb;
if(!tb.open("prefs/tempbans.svr", "rb"))
{
return;
}
string tbdata=tb.read();
tb.close();
if(tbdata=="")
{
return;
}
string[] tbans=string_split(tbdata, "\r\n", false);
for(uint i=0; i<tbans.length(); i++)
{
string[] parsed=string_split(tbans[i], "=", false);
create_temp_ban(parsed[0], stn(parsed[1]),stn(parsed[2]));
}
}
