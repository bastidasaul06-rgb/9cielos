int beeptime;
timer beeptimer, bombtimer;
int rseconds;
demention_bomb(int tx,int ty,int tz, string tmap, string towner, int trseconds)
{
owner=towner;
x=tx;
y=ty;
z=tz;
map=tmap;
rseconds=trseconds;
} // constructor.
} // class.demention_bomb.
void demention_bombloop()
{
for (uint i=0; i<demention_bombs.length(); i++)
{
demention_bombs[i].seconds=demention_bombs[i].rseconds-demention_bombs[i].bombtimer.elapsed;
demention_bombs[i].beeptime=demention_bombs[i].seconds/5+50;
if (demention_bombs[i].beeptimer.elapsed>=demention_bombs[i].beeptime)
{
demention_bombs[i].beeptimer.restart();
play("demention_bombbeep",demention_bombs[i].x,demention_bombs[i].y,demention_bombs[i].z,demention_bombs[i].map,-1,true,false);
}
if (demention_bombs[i].seconds<=0)
{
send(0, demention_bombs[i].owner+"'s demention bomb just exploded! ", 2);
send(0,"play_s dementionbomb.ogg",0);
send(0,"distsound dementionbomb "+demention_bombs[i].x+" "+demention_bombs[i].y+" "+demention_bombs[i].z+" "+demention_bombs[i].map,0);
for(uint r=0; r<robots.length(); r++)
{
robots[r].hit(random(1000000000,1000000000),demention_bombs[i].owner);
}
for(uint i2=0; i2<impact_bombs.length(); i2++)
{
impact_bombs[i2].health=-1;
play("ibombhit"+random(1,3),impact_bombs[i2].x,impact_bombs[i2].y,impact_bombs[i2].z,impact_bombs[i2].map);
}
for(uint i2=0; i2<bullet_bombs.length(); i2++)
{
bullet_bombs[i2].health=-1;
play("bullet_bombimpact",bullet_bombs[i2].x,bullet_bombs[i2].y,bullet_bombs[i2].z,bullet_bombs[i2].map);
send(0,"distsound bullet_bombimpactdist "+bullet_bombs[i2].x+" "+bullet_bombs[i2].y+" "+bullet_bombs[i2].z+" "+bullet_bombs[i2].map,0);
}
for (uint i2=0; i2<players.length(); i2++)
{
if(players[i2].invinsible==true || players[i2].is_protected==true || players[i2].robotmode==true || players[i2].newb==1 || players[i2].is_dead==true||in_vehicle(players[i2].name)>-1) continue;
if(in_vehicle(players[i2].name)>-1 or players[i2].newb==1 or players[i2].is_dead or players[i2].invinsible or players[i2].map=="melee_arena" or players[i2].map=="melee_arena_wait" or players[i2].map=="jail" or players[i2].map=="arena" or players[i2].map=="arena_wait") continue;
{
players[i2].hit(1000000000,1000000000);
//players[i2].health=-1;
players[i2].should_subtract=true;
players[i2].hitby=demention_bombs[i].owner+"'s demention bomb";
players[i2].playsound("dementionhit");
}
for (uint i2=0; i2<demon_kings.length(); i2++)
{
if (get_3d_distance(demention_bombs[i].x,demention_bombs[i].y,demention_bombs[i].z,demon_kings[i2].x,demon_kings[i2].y,demon_kings[i2].z)<=5000 and demon_kings[i2].map==demention_bombs[i].map)
{
if(demention_bombs[i].owner==demon_kings[i2].owner) continue;
demon_kings[i2].health=0;
demon_kings[i2].hitby=demention_bombs[i].owner+"'s demention bomb";
//demon_kings[i].playsound("megabombhit");
}
}
for (uint i2=0; i2<objs.length(); i2++)
{
play("obj_break"+random(1,3),objs[i2].x,objs[i2].y,objs[i2].z,objs[i2].map);
objs.remove_at(i2);
continue;
}
for (uint i2=0; i2<remguns.length(); i2++)
{
remguns[i2].health=-1;
remguns[i2].hitby=demention_bombs[i].owner+"'s demention bomb";
play("remgunhit"+random(1, 3),remguns[i2].x,remguns[i2].y,remguns[i2].z,remguns[i2].map);
}
for(uint v=0; v<vs.length(); v++)
{
vs[v].hit(random(1000000000,1000000000),demention_bombs[i].owner+"'s demention bomb");
}
}
@demention_bombs[i]=null;
demention_bombs.remove_at(i);
}
}
}
void placedemention_bomb(int x,int y, int z, string map,string owner, int rseconds)
{
demention_bomb bomb1(x,y,z,map,owner,rseconds);
demention_bombs.insert_last(bomb1);
}
void destroy_all_demention_bombs()
{
demention_bombs.resize(0);
}

