impact_bombs[x].health-=random(grenades[j].mindammage,grenades[j].maxdammage);
}
}
for(uint x=0; x<bullet_bombs.length(); x++)
{
if(get_3d_distance(grenades[j].x,grenades[j].y,grenades[j].z,bullet_bombs[x].x,bullet_bombs[x].y,bullet_bombs[x].z)<=20 and grenades[j].map==bullet_bombs[x].map)
{
