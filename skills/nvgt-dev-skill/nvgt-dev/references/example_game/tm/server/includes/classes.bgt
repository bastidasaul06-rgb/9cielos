} // constructor.
} // class.bottle_bomb.

void bottle_bombloop()
{
for(uint j=0; j<bottle_bombs.length(); j++)
{
if(bottle_bombs[j].explodetimer.elapsed>=3000)
{
bottle_bombs[j].explodetimer.restart();
play("bottlebomb",bottle_bombs[j].x,bottle_bombs[j].y,bottle_bombs[j].z,bottle_bombs[j].map);
send(0,"distsound bottlebombdist "+bottle_bombs[j].x+" "+bottle_bombs[j].y+" "+bottle_bombs[j].z+" "+bottle_bombs[j].map,0);
for(uint r=0; r<robots.length(); r++)
{
if(get_3d_distance(bottle_bombs[j].x,bottle_bombs[j].y,bottle_bombs[j].z,robots[r].x,robots[r].y,robots[r].z)<=bottle_bombs[j].range&&robots[r].map==bottle_bombs[j].map)
robots[r].hit(random(bottle_bombs[j].mindammage,bottle_bombs[j].maxdammage),"bottle bomb",bottle_bombs[j].owner);
}
for(uint s=0; s<shelters.length(); s++)
{
if(get_3d_distance(bottle_bombs[j].x,bottle_bombs[j].y,bottle_bombs[j].z,shelters[s].x,shelters[s].y,shelters[s].z)<=bottle_bombs[j].range&&shelters[s].map==bottle_bombs[j].map)
shelters[s].hit(random(3000,6000),bottle_bombs[j].owner+"'s bottle_bomb","bottle bomb");
}
for(uint x=0; x<players.length(); x++)
{
if(in_vehicle(players[x].name)>-1 or players[x].newb==1 or players[x].afk or players[x].is_dead or players[x].invinsible) continue;
if(get_3d_distance(bottle_bombs[j].x,bottle_bombs[j].y,bottle_bombs[j].z,players[x].x,players[x].y,players[x].z)<=bottle_bombs[j].range and players[x].map==bottle_bombs[j].map)
{
