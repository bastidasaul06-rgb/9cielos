} // class.sky_mine.
void sky_mineloop()
{
for (uint i=0; i<sky_mines.length(); i++)
{
if(sky_mines[i].d==false)
{
for(uint v=0; v<vs.length(); v++)
{
if(vs[v].x==sky_mines[i].x and vs[v].y==sky_mines[i].y and vs[v].z==sky_mines[i].z and vs[v].map==sky_mines[i].map and vs[v].owner!=sky_mines[i].owner)
{
sky_mines[i].d=true;
}
}
for(uint px=0; px<players.length(); px++)
{
if(in_vehicle(players[px].name)>-1 or players[px].newb==1 or players[px].afk or players[px].is_dead or players[px].invinsible) continue;
if(get_3d_distance(sky_mines[i].x,sky_mines[i].y,sky_mines[i].z,players[px].x,players[px].y,players[px].z)<=7 and players[px].map==sky_mines[i].map)
{
sky_mines[i].d=true;
}
}
}
if(sky_mines[i].lifetimer.elapsed>=60000000&&sky_mines[i].d==false) sky_mines[i].d=true;
if(sky_mines[i].d==true)
{
play("sky_436",sky_mines[i].x,sky_mines[i].y,sky_mines[i].z,sky_mines[i].map);
send(0,"distsound sky_436_dist "+sky_mines[i].x+" "+sky_mines[i].y+" "+sky_mines[i].z+" "+sky_mines[i].map,0);
for(uint r=0; r<robots.length(); r++)
{
