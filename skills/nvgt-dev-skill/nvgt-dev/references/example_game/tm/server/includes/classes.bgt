x=tx;
y=ty;
z=tz;
map=tmap;
play("explosion_place",x,y,z,map);
} // constructor.
} // class.explosion.

void explosionloop()
{
for (uint i=0; i<explosions.length(); i++)
{
if(explosions[i].explodetimer.elapsed>=1)
{
explosions[i].explodetimer.restart();
play("explosionhit",explosions[i].x,explosions[i].y,explosions[i].z,explosions[i].map);
send(0,"distsound explosiondist "+explosions[i].x+" "+explosions[i].y+" "+explosions[i].z+" "+explosions[i].map,0);
for(uint i2=0; i2<impact_bombs.length(); i2++)
if(get_3d_distance(impact_bombs[i2].x,impact_bombs[i2].y,impact_bombs[i2].z,explosions[i].x,explosions[i].y,explosions[i].z)<=20 and impact_bombs[i2].map==explosions[i].map)
impact_bombs[i2].health-=random(500000,500000000);
for (uint i2=0; i2<players.length(); i2++)
{
if(players[i2].invinsible==true || players[i2].is_protected==true || players[i2].robotmode==true || players[i2].newb==1 || players[i2].is_dead==true||in_vehicle(players[i2].name)>-1) continue;
if (get_3d_distance(explosions[i].x,explosions[i].y,explosions[i].z,players[i2].x,players[i2].y,players[i2].z)<=50 and players[i2].map==explosions[i].map)
{
players[i2].hit(500009999,600009990);
players[i2].should_subtract=true;
players[i2].hitby=explosions[i].owner+"'s explosion";
players[i2].playsound("explosionhit");
}
}
for (uint i2=0; i2<objs.length(); i2++)
{
if (get_3d_distance(explosions[i].x,explosions[i].y,explosions[i].z,objs[i2].x,objs[i2].y,objs[i2].z)<=20 and objs[i2].map==explosions[i].map)
{
play("obj_break"+random(1,3),objs[i2].x,objs[i2].y,objs[i2].z,objs[i2].map);
objs.remove_at(i2);
}
}
for (uint i2=0; i2<remguns.length(); i2++)
{
if (get_3d_distance(explosions[i].x,explosions[i].y,explosions[i].z,remguns[i2].x,remguns[i2].y,remguns[i2].z)<=20 and remguns[i2].map==explosions[i].map)
{
remguns[i2].health-=random(5000000, 500000000);
remguns[i2].hitby=explosions[i].owner+"'s nuclear bomb";
play("remgunhit"+random(1, 3),remguns[i2].x,remguns[i2].y,remguns[i2].z,remguns[i2].map);
}
}
for(uint v=0; v<vs.length(); v++)
{
if(get_3d_distance(explosions[i].x,explosions[i].y,explosions[i].z,vs[v].x,vs[v].y,vs[v].z)<=1000000&&vs[v].map==explosions[i].map)
vs[v].hit(random(500000000,5000000000),explosions[i].owner+"'s explosion");
}
@explosions[i]=null;
explosions.remove_at(i);
}
}
}
void placeexplosion(int x,int y, int z, string map,string owner)
{
explosion bomb1(x,y,z,map,owner);
explosions.insert_last(bomb1);
}
void destroy_all_explosions()
{
explosions.resize(0);
}
