for(uint x=0; x<impact_bombs.length(); x++)
{
if(get_3d_distance(rpgs[j].x,rpgs[j].y,rpgs[j].z,impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z)<=20 and rpgs[j].map==impact_bombs[x].map)
{
play("ibombhit"+random(1,3),impact_bombs[x].x,impact_bombs[x].y,impact_bombs[x].z,impact_bombs[x].map);
impact_bombs[x].health-=random(rpgs[j].mindammage,rpgs[j].maxdammage);
}
}
for(uint x=0; x<bullet_bombs.length(); x++)
{
if(get_3d_distance(rpgs[j].x,rpgs[j].y,rpgs[j].z,bullet_bombs[x].x,bullet_bombs[x].y,bullet_bombs[x].z)<=20 and rpgs[j].map==bullet_bombs[x].map)
{
play("bullet_bombimpact",bullet_bombs[x].x,bullet_bombs[x].y,bullet_bombs[x].z,bullet_bombs[x].map);
send(0,"distsound bullet_bombimpactdist "+bullet_bombs[x].x+" "+bullet_bombs[x].y+" "+bullet_bombs[x].z+" "+bullet_bombs[x].map,0);
bullet_bombs[x].health-=random(rpgs[j].mindammage,rpgs[j].maxdammage);
}
}
@rpgs[j]=null;
rpgs.remove_at(j);
continue;
}
}
}
void spawn_rpg(double x, double y, double z, double dir, string map, string owner)
{
rpg f1(x, y, z, dir, map, owner);
rpgs.insert_last(f1);
}
stun_grenade@[] stun_grenades(0);
class stun_grenade
{
string owner;
timer explodetimer;
int z;
string map;
int x, y;
stun_grenade(int tx,int ty,int tz, string tmap, string towner)
{
owner=towner;
x=tx;
y=ty;
z=tz;
map=tmap;
play("stungrenadestart",x,y,z,map);
}
}
void stun_grenadeloop()
{
for (uint i=0; i<stun_grenades.length(); i++)
{
if(stun_grenades[i].explodetimer.elapsed>=5000)
{
stun_grenades[i].explodetimer.restart();
play("stungrenade",stun_grenades[i].x,stun_grenades[i].y,stun_grenades[i].z,stun_grenades[i].map);
send(0,"distsound stungrenadedist "+stun_grenades[i].x+" "+stun_grenades[i].y+" "+stun_grenades[i].z+" "+stun_grenades[i].map,0);
for (uint i2=0; i2<players.length(); i2++)
{
if(in_vehicle(players[i2].name)>-1 or players[i2].newb==1 or players[i2].afk or players[i2].is_dead or players[i2].invinsible) continue;
if (get_3d_distance(stun_grenades[i].x,stun_grenades[i].y,stun_grenades[i].z,players[i2].x,players[i2].y,players[i2].z)<=25 and players[i2].map==stun_grenades[i].map)
{
players[i2].stun(15000,true,true);
players[i2].hit(10,1000);
players[i2].should_subtract=true;
players[i2].playsound("stun_darthit");
}
}
for(uint v=0; v<vs.length(); v++)
{
if(get_3d_distance(stun_grenades[i].x,stun_grenades[i].y,stun_grenades[i].z,vs[v].x,vs[v].y,vs[v].z)<=30&&vs[v].map==stun_grenades[i].map)
vs[v].hit(random(500,1500),stun_grenades[i].owner+"'s stun grenade");
}
@stun_grenades[i]=null;
stun_grenades.remove_at(i);
}
}
}
void placestun_grenade(int x,int y, int z, string map,string owner)
{
stun_grenade bomb1(x,y,z,map,owner);
stun_grenades.insert_last(bomb1);
}
void destroy_all_stun_grenades()
{
stun_grenades.resize(0);
}
turret@[] turrets(0);
class turret
{
int x;
int y;
int z;
string map;
string loop;
string zone;
string owner;
string hitby;
string alliancename;
timer firetimer;
timer deadtimer;
int health=(5000000);
int id=random(1,1000);
turret(int sx,int sy,int sz,string smap,string soner)
{
x=sx;
y=sy;
z=sz;
map=smap;
owner=soner;
loop=spawn_moving_sound("tloop.ogg",x,y,z,map);
}
}
void turretloop()
{
for(uint i=0; i<turrets.length(); i++)
{
if(turrets[i].deadtimer.elapsed>600000)
{
destroy_moving_sound(turrets[i].loop);
turrets[i].health=-1;
turrets[i].hitby="dead battery";
}
int oindex=get_player_index_from(turrets[i].owner);
if(oindex<0)
{
destroy_moving_sound(turrets[i].loop);
turrets[i].health=-1;
turrets[i].hitby="dead battery";
}
if(turrets[i].health<0)
{
play("texpl",turrets[i].x,turrets[i].y,turrets[i].z,turrets[i].map);
send(0,"distsound tbexpl3.ogg "+turrets[i].x+" "+turrets[i].y+" "+turrets[i].z+" "+turrets[i].map,0);
send(0,"playerdeath "+killmsg(turrets[i].owner+"'s turret "+turrets[i].id,turrets[i].hitby,turrets[i].map),0);
destroy_moving_sound(turrets[i].loop);
turrets.remove_at(i);
i--;
continue;
}
int index=get_nearest_player(turrets[i].x,turrets[i].y,turrets[i].z,turrets[i].map,oindex);
if(index>-1)
{
if(players[index].newb==1 or players[index].afk or players[index].is_dead or players[index].invinsible or are_allianceed(turrets[i].owner,players[index].name)) continue;
int v=in_vehicle(players[index].name);
int miss=random(1,10);
int dist=get_2d_distance(turrets[i].x,turrets[i].y,players[index].x,players[index].y);
if(dist<15 and turrets[i].firetimer.elapsed>500 and index!=oindex and players[index].z==turrets[i].z)
{
turrets[i].firetimer.restart();
play("tfire",turrets[i].x,turrets[i].y,turrets[i].z,turrets[i].map);
send(0,"distsound shotgundist "+turrets[i].x+" "+turrets[i].y+" "+turrets[i].z+" "+turrets[i].map,0);
if(miss<10)
{
if(v>-1) {
vs[v].hit(random(20000,120000),turrets[i].owner+"'s turret"+turrets[i].id,"turret");
}
else
if(in_vehicle(players[index].name)>-1)
{
continue;
}
else
{
if(players[index].shielded)
{
players[index].playsound("shieldhit"+random(1,12));
players[index].shieldshots-=random(1,300);
}
else
{
players[index].hit(10000,100000);
players[index].hitby=turrets[i].owner+"'s turret "+turrets[i].id;
players[index].playsound("thit"+random(1,3));
send(players[oindex].peer_id, "hit "+players[index].name+", health "+players[index].health, 2);
}
}
}
}
}
}
}
void spawn_turret(int x,int y,int z,string map,string owner)
{
turret s(x,y,z,map,owner);
turrets.insert_last(s);
}