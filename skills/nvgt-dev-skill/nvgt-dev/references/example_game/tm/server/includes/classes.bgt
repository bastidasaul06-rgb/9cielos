robots[r].hit(random(2000,800000),"sky 436 mine",sky_mines[i].owner);
}
for (uint i2=0; i2<players.length(); i2++)
{
if(in_vehicle(players[i2].name)>-1 or players[i2].newb==1 or players[i2].afk or players[i2].is_dead or players[i2].invinsible) continue;
if (get_3d_distance(sky_mines[i].x,sky_mines[i].y,sky_mines[i].z,players[i2].x,players[i2].y,players[i2].z)<=20 and players[i2].map==sky_mines[i].map)
{
players[i2].hit(2000,200000);
players[i2].should_subtract=false;
players[i2].hitby=sky_mines[i].owner+"'s sky 436 mine";
players[i2].playsound("sky_436_hit");
play("hit"+random(1,5),players[i2].x,players[i2].y,players[i2].z,players[i2].map);
}
}
for (uint i2=0; i2<objs.length(); i2++)
{
if (get_3d_distance(sky_mines[i].x,sky_mines[i].y,sky_mines[i].z,objs[i2].x,objs[i2].y,objs[i2].z)<=100 and objs[i2].map==sky_mines[i].map)
{
play("obj_break"+random(1,3),objs[i2].x,objs[i2].y,objs[i2].z,objs[i2].map);
objs.remove_at(i2);
}
}
for (uint i2=0; i2<impact_bombs.length(); i2++)
{
if (get_3d_distance(sky_mines[i].x,sky_mines[i].y,sky_mines[i].z,impact_bombs[i2].x,impact_bombs[i2].y,impact_bombs[i2].z)<=20 and impact_bombs[i2].map==sky_mines[i].map)
{
impact_bombs[i2].health-=random(2000,80000);
play("ibombhit"+random(1, 3),impact_bombs[i2].x,impact_bombs[i2].y,impact_bombs[i2].z,impact_bombs[i2].map);
}
}
for (uint i2=0; i2<bullet_bombs.length(); i2++)
{
if (get_3d_distance(sky_mines[i].x,sky_mines[i].y,sky_mines[i].z,bullet_bombs[i2].x,bullet_bombs[i2].y,bullet_bombs[i2].z)<=20 and bullet_bombs[i2].map==sky_mines[i].map)
{
bullet_bombs[i2].health-=random(1000,80000);
play("bullet_bombimpact",bullet_bombs[i2].x,bullet_bombs[i2].y,bullet_bombs[i2].z,bullet_bombs[i2].map);
send(0,"distsound bullet_bombimpactdist "+bullet_bombs[i2].x+" "+bullet_bombs[i2].y+" "+bullet_bombs[i2].z+" "+bullet_bombs[i2].map,0);
}
}
for (uint i2=0; i2<remguns.length(); i2++)
{
if (get_3d_distance(sky_mines[i].x,sky_mines[i].y,sky_mines[i].z,remguns[i2].x,remguns[i2].y,remguns[i2].z)<=30 and remguns[i2].map==sky_mines[i].map)
{
remguns[i2].health-=random(2000,80000);
remguns[i2].hitby=sky_mines[i].owner+"'s sky 436 mine";
play("remgunhit"+random(1, 3),remguns[i2].x,remguns[i2].y,remguns[i2].z,remguns[i2].map);
}
}
for(uint v=0; v<vs.length(); v++)
{
if(get_3d_distance(sky_mines[i].x,sky_mines[i].y,sky_mines[i].z,vs[v].x,vs[v].y,vs[v].z)<=30&&vs[v].map==sky_mines[i].map)
vs[v].hit(random(2000,80000),sky_mines[i].owner+"'s sky 436 mine");
}
sky_mines.remove_at(i);
continue;
}
}
}
