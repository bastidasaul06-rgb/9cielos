send(0,"distsound bullet_bombimpactdist "+bullet_bombs[x].x+" "+bullet_bombs[x].y+" "+bullet_bombs[x].z+" "+bullet_bombs[x].map,0);
bullet_bombs[x].health-=random(grenades[j].mindammage,grenades[j].maxdammage);
}
}
@grenades[j]=null;
grenades.remove_at(j);
continue;
}
}
}
