volcano@[] volcanos(0);
class volcano
{
string owner;
int z;
string map;
int x, y;
int seconds=30000;
int beeptime;
timer beeptimer, bombtimer;
int rseconds;
volcano(int tx,int ty,int tz, string tmap, int trseconds)
{
x=tx;
y=ty;
z=tz;
map=tmap;
rseconds=trseconds;
} // constructor.
} // class.volcano.
void volcanoloop()
{
for (uint i=0; i<volcanos.length(); i++)
{
volcanos[i].seconds=volcanos[i].rseconds-volcanos[i].bombtimer.elapsed;
volcanos[i].beeptime=volcanos[i].seconds/5+50;
if (volcanos[i].beeptimer.elapsed>=volcanos[i].beeptime)
{
volcanos[i].beeptimer.restart();
play("volcanobeep",volcanos[i].x,volcanos[i].y,volcanos[i].z,volcanos[i].map,-1,true,false);
}
if (volcanos[i].seconds<=0)
{
send(0, "run for your lives! the volcano has arrived!", 2);
//send(0,"play_s veruption.ogg",0);
send(0,"distsound veruption "+volcanos[i].x+" "+volcanos[i].y+" "+volcanos[i].z+" "+volcanos[i].map,0);
for(uint i2=0; i2<impact_bombs.length(); i2++)
{
impact_bombs[i2].health=-1;
play("ibombhit"+random(1,3),impact_bombs[i2].x,impact_bombs[i2].y,impact_bombs[i2].z,impact_bombs[i2].map);
}
for(uint i2=0; i2<bullet_bombs.length(); i2++)
{
bullet_bombs[i2].health=-1;
play("bullet_bombimpact",bullet_bombs[i2].x,bullet_bombs[i2].y,bullet_bombs[i2].z,bullet_bombs[i2].map);
send(0,"distsound bullet_bombimpactdist "+bullet_bombs[i2].x+" "+bullet_bombs[i2].y+" "+bullet_bombs[i2].z+" "+bullet_bombs[i2].map,0);
}
for (uint i2=0; i2<players.length(); i2++)
{
if(in_vehicle(players[i2].name)>-1 or players[i2].newb==1 or players[i2].is_dead or players[i2].invinsible or players[i].in_plane or players[i2].map=="safe_zone" or players[i2].map=="jail" or players[i2].map=="arena" or players[i2].map=="arena_wait" or players[i2].level<=75) continue;
{
if(players[i2].map=="crystal_city" or players[i2].map=="fishingspot" or players[i2].map=="the_frozen_forest" or players[i2].map=="the_sellers_corner" or players[i2].map=="the_road_of_nightmares" or players[i2].map=="crystal_mall" or players[i2].map=="the_library" or players[i2].map=="the_unseelers_base" or players[i2].map=="unseelers_base_first_floor" or players[i2].map=="unseelers_base_second_floor" or players[i2].map=="unseelers_base_third_floor" or players[i2].map=="unseelers_base_last_floor" or players[i2].map=="the_riddlers_maze" or players[i2].map=="crystal_train_station" or players[i2].map=="the_abandoned_factory" or players[i2].map=="the_abandoned_factory_northeast_side" or players[i2].map=="magical_forest" or players[i2].map=="forest_exit" or players[i2].map=="the_tower" or players[i2].map=="tower_second_floor" or players[i2].map=="tower_third_floor" or players[i2].map=="tower_last_floor" or players[i2].map=="crystal_superstore" or players[i2].map=="inferno_challenge" or players[i2].map=="arrival_platform")
{
players[i2].hitby="volcano eruption";
players[i2].playsound("veruption");
players[i2].give("aura",-100000);
send(players[i2].peer_id,"you died in the eruption, and lost one hundred thousand aura.",2);
players[i2].health=-1;
players[i2].should_subtract=true;
continue;
}
}
for (uint i2=0; i2<objs.length(); i2++)
{
play("obj_break"+random(1,3),objs[i2].x,objs[i2].y,objs[i2].z,objs[i2].map);
objs.remove_at(i2);
continue;
}
for (uint i2=0; i2<remguns.length(); i2++)
{
remguns[i2].health=-1;
remguns[i2].hitby="volcano";
play("remgunhit"+random(1, 3),remguns[i2].x,remguns[i2].y,remguns[i2].z,remguns[i2].map);
}
for(uint v=0; v<vs.length(); v++)
{
vs[v].hit(random(1000000000,1000000000),"volcano eruption");
}
}
@volcanos[i]=null;
volcanos.remove_at(i);
}
}
}
void placevolcano(int x,int y, int z, string map, int rseconds)
{
volcano bomb1(x,y,z,map,rseconds);
volcanos.insert_last(bomb1);
}
void destroy_all_volcanos()
{
volcanos.resize(0);
}

