player(int px, int py, int pz, string pmap, string pname, int ppeer_id, string cid, string pver, string pip, string compt,int phid, bool player_have_client=true)
{
x=px;y=py;z=pz;map=pmap;
name=pname;
peer_id=ppeer_id;
compid=cid;
version=pver;
ip=pip;
ctext=compt;
