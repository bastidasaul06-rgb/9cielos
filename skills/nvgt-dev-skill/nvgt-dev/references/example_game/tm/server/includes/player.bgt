{
int chance=0;
playsound("hit"+random(1,9));
playsound("blood"+random(5,15));
if(lowhealth==true)
{
playsound("blood"+random(1,4));
}
if(antibioticed==false) this.health-=random(mindamage,maxdamage);
else this.health-=random(round(mindamage*antibiotic_hit_factor,0),round(maxdamage*antibiotic_hit_factor,0));
//this.bone_level+=(random(mindamage,maxdamage)/300);
//chance+=random(1, maxdamage/2000);
//if(chance>=5)
//{
//this.can_break_bones=true;
//chance=0;
