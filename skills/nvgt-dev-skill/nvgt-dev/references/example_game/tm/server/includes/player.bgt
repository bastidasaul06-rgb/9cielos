if(players[i].jumpd1timer.elapsed>=90000)
{
players[i].jumpd=false;
players[i].playsound("ai1kiling3");
send(players[i].peer_id, "jumpstop",0);
}
if(players[i].jumpdtimer.elapsed>=500)
{
players[i].jumpdtimer.restart();
}
}
if(players[i].energy_charge==true and players[i].counttimer.elapsed>=5000)
{
players[i].counttimer.restart();
players[i].energycount++;
if(players[i].energycount>=100)
{
players[i].energycount=100;
}
}
if(players[i].blocked==true and players[i].blocktimer.elapsed>=300000)
{
players[i].blocktimer.restart();
players[i].blocked=false;
players[i].playsound("ultimate_health");
send(players[i].peer_id,"your wand is able to be used again!",2);
}
if(players[i].bent==true)
{
if(players[i].benttimer.elapsed>=90000)
{
players[i].bent=false;
//players[i].playsound("ai1kiling3");
send(players[i].peer_id, "timeresume",0);
}
if(players[i].energytimer.elapsed>=500)
{
players[i].energytimer.restart();
}
}
if(players[i].energyd==true)
{
if(players[i].energy1timer.elapsed>=90000)
{
players[i].energyd=false;
players[i].playsound("ai1kiling3");
send(players[i].peer_id, "energystop",0);
}
if(players[i].energytimer.elapsed>=500)
{
players[i].energytimer.restart();
}
}
for (uint i=0; i<planes.length(); i++)
{
if(players[i].automatic==true and players[i].autotimer.elapsed>=150)
{
players[i].autotimer.restart();
players[i].autocount++;
players[i].x=planes[i].x;
players[i].y=planes[i].y;
players[i].z=planes[i].z;
send(players[i].peer_id,"move "+players[i].x+" "+players[i].y+" "+players[i].z,0);
if(planes[i].automatic==false)
{
players[i].automatic=false;
players[i].autocount=0;
}
}
}
for (uint i=0; i<planes.length(); i++)
{
if(players[i].autoland==true and players[i].landtimer.elapsed>=150)
{
players[i].landtimer.restart();
players[i].landcount++;
players[i].x=planes[i].x;
players[i].y=planes[i].y;
players[i].z=planes[i].z;
send(players[i].peer_id,"move "+players[i].x+" "+players[i].y+" "+players[i].z,0);
if(planes[i].autoland==false)
{
players[i].autoland=false;
players[i].landcount=0;
}
}
}
if(players[i].sourcererstatus==1)
{
players[i].wandoff=false;
}
if(players[i].poisoned==true and players[i].poisontimer.elapsed>=1000)
{
players[i].poisontimer.restart();
players[i].health-=random(1000000, 2000000);
play("poisonhit",players[i].x,players[i].y,players[i].z,players[i].map);
//send(players[i].peer_id,"poisoned!",0);
players[i].poisonlosses++;
if(players[i].poisonlosses>30000000)
{
players[i].poisoned=false;
play("poisonstop",players[i].x,players[i].y,players[i].z,players[i].map);
players[i].poisonlosses=0;
}
}
if(players[i].afkseconds>0 and players[i].afk_starting==true)
{
if(players[i].afktimer.elapsed>=1000)
{
if(in_vehicle(players[i].name)>-1 or players[i].bulletbombplacing==true or players[i].shelter_building==true or players[i].ultrabombplacing==true or players[i].bbombplacing==true or players[i].stunned==true or players[i].helicopterspawning==true or players[i].enemyspawning==true or players[i].sbombplacing==true)
{
players[i].health=-1;
players[i].hitby="big boss";
send(0, players[i].name+" is a cheater! ", 2);
}
players[i].afktimer.restart();
if(players[i].afkseconds!=0)
play("afktimer",players[i].x,players[i].y,players[i].z,players[i].map);
players[i].afkseconds--;
}
}
if(players[i].afkseconds<=0 and players[i].afk_starting==true)
{
players[i].afk_starting=false;
players[i].afkseconds=5;
players[i].afk=true;
send(players[i].peer_id,"stopmoving",0);
send(0, players[i].name+" is now AFK! ", 2);
send(0,"play_s afkon.ogg",0);
}
if(players[i].shieldshots>players[i].maxshields)
{
players[i].shieldshots=players[i].maxshields;
}
if(players[i].shieldshots>0)
{
players[i].shielded=true;
}
if(players[i].shielded==true)
{
if(players[i].shieldshots<=0)
{
players[i].shielded=false;
play("shieldbreak"+random(1,3),players[i].x,players[i].y,players[i].z,players[i].map);
}
}
if(players[i].health>players[i].maxhealth)
{
players[i].health=players[i].maxhealth;
players[i].oldhealth=players[i].maxhealth;
if(players[i].antibioticed)
{
players[i].antibioticed=false;
send(players[i].peer_id,"you are at max health and you can't go any higher!",0);
}
}
if(players[i].shelter_building==true and players[i].map!="store")
{
if(players[i].buildtimer.elapsed>=7660)
{
send(players[i].peer_id,"startmoving",0);
build_shelter(players[i].x,players[i].y,players[i].z,players[i].map,players[i].name,players[i].sheltername);
send(0,"The "+players[i].sheltername+" shelter has been created!",2);
server_log("eventstream","server notification: The "+players[i].sheltername+" shelter has been created!");
send(players[i].peer_id,"Shelter created!",2);
players[i].shelter_building=false;
}
}
if(players[i].lockerplacing==true and players[i].lockerplacetimer.elapsed>=players[i].lockerplacetime)
{
players[i].lockerplacing=false;
string newid=randomstring(6);
int newcode=stn(randomstring(4, 2));
send(players[i].peer_id,"startmoving",0);
create_new_locker(players[i].x, players[i].y, players[i].z, players[i].map, players[i].name, newcode, newid);
send(players[i].peer_id,"Your locker has been created. Your access code is "+newcode+"",2);
}
if(players[i].stunned==true&&players[i].stuntimer.elapsed>=players[i].stuntime)
{
send(players[i].peer_id,"startmoving",0);
if(players[i].unstunplay==true) 
{
players[i].playsound("stun_dartstop");
}
players[i].stunned=false;
}
if(players[i].remconnecting==true and players[i].rmtimer.elapsed>=6343 and players[i].map!="store")
{
placeremgun(players[i].x,players[i].y,players[i].z,players[i].map,players[i].name);
players[i].remconnecting=false;
send(players[i].peer_id,"startmoving",0);
}
if(players[i].interceptortimer.elapsed>=775 and players[i].intercepting==true)
{
players[i].intercepting=false;
send(players[i].peer_id,"startmoving",0);
intercept(players[i].x,players[i].y,players[i].z,players[i].map,i);
}
if(players[i].invisibilitytimer.elapsed>=30000 and players[i].invisible==true)
{
players[i].invisible=false;
play("invisibility_stop",players[i].x,players[i].y,players[i].z,players[i].map);
players[i].invisibilitytimer.restart();
players[i].invisibilitytimer.pause();
}
if(players[i].frequencyscramblertimer.elapsed>=60000 and players[i].frequency==true)
{
players[i].frequency=false;
play("frequency_scrambleroff",players[i].x,players[i].y,players[i].z,players[i].map);
players[i].frequencyscramblertimer.restart();
players[i].frequencyscramblertimer.pause();
}
if(players[i].aura_shield==true and players[i].auratimer.elapsed>=60000)
