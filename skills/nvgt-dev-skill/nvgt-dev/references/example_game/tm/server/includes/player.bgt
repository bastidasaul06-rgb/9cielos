bool sheltercheck()
{
bool ret=false;
for(uint i=0; i<shelters.length(); i++)
{
ret= (shelters[i].aplayers.find(name)>-1||name==shelters[i].owner||(shelters[i].alliancename!=""&&is_part_of_alliance(name,shelters[i].alliancename)));
}
return ret;
}
void generate_unb_bones()
{
this.unb_bones.resize(0);
for(int i=0; i<this.bones.length(); i++)
{
if(this.broken_bones.find(this.bones[i])<0)
{
this.unb_bones.resize(i+1);
this.unb_bones.insert_last(this.bones[i]);
}
else
{
continue;
}
}
}
bool adminable()
{
return (this.is_admin or this.master or this.dev);
}
bool builder() {
return (this.is_admin or this.dev or this.master or this.is_builder); }
bool is_master()
{
return (this.master or this.dev);
}
int distancecheck(double xx,double yy,double zz)
{
return get_3d_distance(x,y,z,xx,yy,zz);
}
int warpdist=0;
int warpmoved=0;
vector max,warp;
void warpcheck()
{
if(warpstage==0 and warptimer.elapsed>=2460)
{
send(peer_id,"freezestart",0);
invinsible=true;
playsound("wpvanish");
send_plus(this.peer_id,"distsound wpvanishdist "+x+" "+y+" "+z+" "+map,0);
z+=1000;
warpstage=1;
warpdist=random(100,150);
max=get_max_values(map);
warp.x=x;
warp.y=y;
warp.z=z;
send(peer_id,"play_s wpmid.ogg",0);
warptimer.restart();
}
if(warpstage==1 and warpmoved<warpdist and warptimer.elapsed<2000)
{
warp=move(warp.x,warp.y,facing);
warpmoved++;
if(warp.x>=max.x)
{
warp.x=max.x;
}
if(warp.y>=max.y)
{
warp.y=max.y;
}
if(warp.x<=0) warp.x=0;
if(warp.y<=0) warp.y=0;
}
if(warpstage==1 and warptimer.elapsed>=2000)
{
if(warpmoved<warpdist)
{
do
{
warp=move(warp.x,warp.y,facing);
warpmoved++;
if(warp.x>=max.x)
{
warp.x=max.x;
}
if(warp.y>=max.y)
{
warp.y=max.y;
}
if(warp.x<=0) warp.x=0;
if(warp.y<=0) warp.y=0;
}
while(warpmoved<warpdist);
}
warpstage=0;warpdist=0;warpmoved=0;
warping=false;
warp.x=round(warp.x,0);
warp.y=round(warp.y,0);
x=warp.x;y=warp.y;z-=1000;
send(peer_id,"move "+x+" "+y+" "+z,0);
invinsible=false;
send(peer_id,"freezestop",0);
send(peer_id,"startmoving",0);
playsound("wpappear");
send_plus(this.peer_id,"distsound wpappeardist "+x+" "+y+" "+z+" "+map,0);
}
}
int skateboarddist=0;
int skateboardmoved=0;
vector maxb,skateboard;
void skateboardcheck()
{
if(skateboardstage==0 and skateboardtimer.elapsed>=1)
{
invinsible=false;
z=0;
skateboardstage=1;
skateboarddist=5;
max=get_max_values(map);
skateboard.x=x;
skateboard.y=y;
skateboard.z=z;
skateboardtimer.restart();
}
if(skateboardstage==1 and skateboardmoved<skateboarddist and skateboardtimer.elapsed<400)
{
skateboard=move(skateboard.x,skateboard.y,facing);
skateboardmoved++;
if(skateboard.x>=max.x)
{
skateboard.x=max.x;
}
if(skateboard.y>=max.y)
{
skateboard.y=max.y;
}
if(skateboard.x<=0) skateboard.x=0;
if(skateboard.y<=0) skateboard.y=0;
}
if(skateboardstage==1 and skateboardtimer.elapsed>=400)
{
if(skateboardmoved<skateboarddist)
{
do
{
skateboard=move(skateboard.x,skateboard.y,facing);
skateboardmoved++;
if(skateboard.x>=max.x)
{
skateboard.x=max.x;
}
if(skateboard.y>=max.y)
{
skateboard.y=max.y;
}
if(skateboard.x<=0) skateboard.x=0;
if(skateboard.y<=0) skateboard.y=0;
}
while(skateboardmoved<skateboarddist);
}
skateboardstage=0;skateboarddist=0;skateboardmoved=0;
skateboardusage=false;
skateboard.x=round(skateboard.x,0);
skateboard.y=round(skateboard.y,0);
x=skateboard.x;y=skateboard.y;z-=0;
send(peer_id,"move "+x+" "+y+" "+z,0);
invinsible=false;
}
}
vector get_coords()
{
vector ret;
ret.x=x;
ret.y=y;
ret.z=z;
return ret;
}
void sendpacket(string packet,int chan=2,bool reliable=true)
{
if(reliable) send(peer_id,packet,chan);
else send_u(peer_id,packet,chan);
}
void add_log_entry(string n,string w)
{
server_log(name+"_"+n,name+"("+nickname+") "+w);
}
void playobjs()
{
for(uint i=0; i<objs.length(); i++)
{
if(objs[i].map==map and distancecheck(objs[i].x,objs[i].y,objs[i].z)<=20)
{
sendint("obj "+objs[i].x+" "+objs[i].y+" "+objs[i].z+" "+objs[i].map,name);
}
}
}
void vo(string a)
{
send(this.peer_id,"play_s speaker_"+a+".ogg",0);
}
void playsound(string sound, bool include_me=true)
{
if(include_me) send(peer_id,"play_s "+sound+".ogg",0);
send_plus(peer_id, sound+" "+x+" "+y+" "+z+" "+map, 3);
}
bool is_muted(string name)
{
string[] t=string_split(muted,"\r\n",false);
for (uint i=0; i<t.length(); i++)
{
if (t[i]==name)
{
return true;
}
}
return false;
}
void mute(string name)
{
muted+="\r\n"+name;
}
bool unmute(string name)
{
string[] t=string_split(muted,"\r\n",false);
string newmuted;
bool succeeded=false;
for (uint i=0; i<t.length(); i++)
{
if (t[i]!=name)
newmuted+="\r\n"+t[i];
else
succeeded=true;
}
muted=newmuted;
return succeeded;
}
bool is_paid()
{
return true;
}
bool is_alliancemember(string n)
{
if(is_in_alliance(name)>-1 and n==alliancename) return true;
return false;
}
double invpos;
dictionary ammo;
dictionary inv;
int get_ammo_count_from(string we)
{
int amount=0;
for (uint i=0; i<ammo.get_keys().length(); i++)
{
int a=0;
if (ammo.get_keys()[i]==we)
ammo.get(we,a);
amount+=a;
}
return amount;
}
void ammo_give(string we, int amount)
{
int a;
if (!ammo.exists(we))
{
ammo.set(we,amount);
}
else
{
ammo.get(we,a);
if (a+amount<=0)
ammo.delete(we);
else
{
int b=(a+amount);
ammo.delete(we);
ammo.set(we,b);
}
}
}
dictionary inventory;
bool newbuseable(string item)
{
if(newbitems.find(item)>-1)
return true;
return false;
}
bool is_food(string what)
{
if(snackitems.find(what)>-1)
return true;
return false;
}
void chat(string message)
{
spammedmsgs++;
for(uint i=0; i<players.length(); i++)
{
if(players[i].langchan==langchan and players[i].is_muted(name)==false)
{
send(players[i].peer_id,"chat "+message,1);
send(0,"play_s chat"+random(1,21)+".ogg",0);
}
}
}
string get_inv(bool showall=true)
{
string ss;
string[] ds;
if(inventory.get_size()==0) return "";
ds=inventory.get_keys();
for(uint i=0; i<ds.length(); i++)
{
if(!showall&&string_left(ds[i],5)=="ammo_") continue;
double val;
inventory.get(ds[i],val);
ss+=ds[i]+"="+val+"\r\n";
}
return ss;
}
void send_inv()
{
string charfolder="chars/"+name;
if(file_exists(charfolder+"/inv.usr")==false and !sheltercheck() and has_locker(this.name)==-1)
file_copy("prefs/default_inv.svr",charfolder+"/inv.usr",true);
file f;
f.open(charfolder+"/inv.usr","rb");
string inv=f.read();
f.close();
if(inv=="" and !sheltercheck() and has_locker(this.name)==-1)
{
f.open("prefs/default_inv.svr","rb");
inv=f.read();
f.close();
f.open(charfolder+"/inv.usr","wb");
f.write(inv);
f.close();
}
if(inv=="") return;
string[] invvalues=string_split(inv,"\r\n",false);
for(uint i=0; i<invvalues.length(); i++)
{
string[] invparser=string_split(invvalues[i],"=",false);
if(invparser.length()>1)
give(invparser[0],stn(invparser[1]));
}
}
void send_negated_inv()
{
inventory.delete_all();
}
void give(string item, double amount,bool singlegive=true)
{
double a;
if (!inventory.exists(item))
{
inventory.set(item,amount);
}
else
{
inventory.get(item,a);
if (a+amount<=0)
inventory.delete(item);
else
{
double b=(a+amount);
inventory.set(item,b);
}
}
this.neg_inv_check();
if(singlegive) send(this.peer_id,"invstring "+string_compress(this.get_inv(false)),0);
}
void neg_inv_check()
{
string[] k=inventory.get_keys();
for(uint i=0; i<k.length(); i++)
{
double v;
inventory.get(k[i],v);
if(v<=0) inventory.delete(k[i]);
}
}
void cycle_inv(int dir)
{
if (dir==1)
invpos+=1;
else
invpos-=1;
if (invpos>=inventory.get_keys().length())
{
invpos=0;
}
else if (invpos<0)
{
invpos=inventory.get_keys().length()-1;
}
if (inventory.get_size()==0)
{
send(peer_id,"No items",0);
}
else
{
double a;
inventory.get(inventory.get_keys()[invpos],a);
if(a==1)
send(peer_id,string_replace(inventory.get_keys()[invpos],"_"," ",true)+". "+(invpos+1)+" of "+inventory.get_keys().length(),0);
else
send(peer_id,string_replace(inventory.get_keys()[invpos], "_", " ", true)+": you have "+a+". "+(invpos+1)+" of "+inventory.get_keys().length(),0);
send(e.peer_id,"invitem "+inventory.get_keys()[invpos],0);
}
}
double count_total_items()
{
double amount=0;
for (uint i=0; i<inventory.get_keys().length(); i++)
{
double a;
inventory.get(inventory.get_keys()[i],a);
amount+=a;
}
return amount;
}
double get_item_count(string item)
{
double amount=0;
if(inventory.exists(item)==false) return 0;
else
{
inventory.get(item,amount);
return amount;
}
}
void stun(int ms,bool playafter=false,bool fall=false,int cooldown=0)
{
if(this.stunagaintimer.elapsed<=this.stunagaintime)
{
return;
}
else
{
this.stunagaintime=0;
this.stunagaintimer.restart();
}
send(peer_id,"stopmoving",0);
stunned=true;
stuntime=ms;
stuntimer.restart();
this.stunagaintime=ms+cooldown;
unstunplay=playafter;
if(fall==true) {
vo("standup");
spawn_bodyfall(x,y,z,map,500,get_player_index_from(name));
}
}
void fire_auto()
{
firing=true;
}
void speak_inv()
{
double a;
inventory.get(inventory.get_keys()[invpos],a);
if(a==1)
send(peer_id,string_replace(inventory.get_keys()[invpos],"_"," ",true)+". "+(invpos+1)+" of "+inventory.get_keys().length(),0);
else
send(peer_id,a+" "+string_replace(inventory.get_keys()[invpos], "_", " ", true)+"s. "+(invpos+1)+" of "+inventory.get_keys().length(),0);
}
}
void playerloop()
{
for(uint i=0; i<players.length(); i++)
{
if(file_exists("chars/"+players[i].name+"/bones.usr"))
{
file f;
f.open("chars/"+players[i].name+"/bones.usr", "rb");
players[i].bone_status=f.read();
f.close();
}
if(players[i].broken_bones.length()==0 and players[i].unb_bones.length()==0)
{
players[i].generate_unb_bones();
}
if(players[i].broken_bones.length()>0 and players[i].broken_bones.length()<players[i].bones.length())
{
players[i].generate_unb_bones();
}
if(players[i].bone_level>=players[i].maxbone_level and players[i].broken_bones.length()>0)
{
file f;
players[i].playsound("deathbone");
players[i].health=0;
players[i].broken_bones.resize(0);
players[i].unb_bones.resize(0);
players[i].generate_unb_bones();
players[i].bone_level=0;
f.open("chars/"+players[i].name+"/bones.usr", "wb");
f.write("none");
players[i].bone_status=f.read();
f.close();
}
if(players[i].bone_level<1 and players[i].broken_bones.length()>0)
{
file f;
players[i].playsound("bonefix");
players[i].bone_level=0;
players[i].broken_bones.resize(0);
send(players[i].peer_id,"Your bones are healled!",2);
players[i].bone_healling=0;
players[i].unb_bones.resize(0);
for(int i2=0; i2<players[i].bones.length(); i2++)
{
players[i].unb_bones.insert_last(players[i].bones[i2]);
}
f.open("chars/"+players[i].name+"/bones.usr", "wb");
f.write("none");
players[i].bone_status=f.read();
f.close();
}
if(players[i].bone_level>1 and players[i].unb_bones.length()>0 and players[i].can_break_bones==true)
{
for(int i2=0; i2<=floor(players[i].bone_level/100); i2++)
{
if(i2>=players[i].unb_bones.length() or players[i].unb_bones.length()==0)
{
break;
}
string wtb=players[i].unb_bones[random(0, players[i].unb_bones.length()-1)];
if(players[i].bones.find(wtb)<0)
{
continue;
}
players[i].unb_bones.remove_at(players[i].unb_bones.find(wtb));
players[i].broken_bones.insert_last(wtb);
file f;
f.open("chars/"+players[i].name+"/bones.usr","rb");
players[i].ob=f.read();
f.close();
if(players[i].ob!="none")
{
f.open("chars/"+players[i].name+"/bones.usr","ab");
if(floor(players[i].bone_level/100)-i2==0)
{
f.write(players[i].bones.find(wtb));
}
else
{
if(players[i].ob[players[i].ob.length()-1]!=":")
{
f.write(":");
}
f.write(players[i].bones.find(wtb)+":");
}
f.close();
}
else
{
f.open("chars/"+players[i].name+"/bones.usr","wb");
f.write(players[i].bones.find(wtb)+":");
}
f.close();
send(players[i].peer_id,"start_bone",0);
send(players[i].peer_id,"You hear the crunch and the crack of the bone, Your "+wtb+" has broken!",2);
players[i].playsound("bonebreak"+random(1,5));
}
players[i].can_break_bones=false;
}
if(players[i].bone_healling==1)
{
if(players[i].boneheallingtimer.elapsed>=players[i].bonehealltime and players[i].is_dead==false and players[i].afk==false)
{
players[i].boneheallingtimer.restart();
players[i].bone_level-=random(10,100);
}
}
if(players[i].level>=1500)
{
players[i].re+=1;
//players[i].give("nuclear_bomb",1);
//players[i].give("dollar",100000);
//players[i].give("gift",10);
send(0,"play_s notify_woosh.ogg",0);
players[i].level=1;
players[i].xp=0;
players[i].xprequired=125;
players[i].maxhealth+=1000000;
send(0,"alert! the player  "+players[i].name+"! has reached level 1500 and has been resurrected! As a reward, his maximom health has been increased by 1000000, resulting in a total of "+players[i].maxhealth+"!",2);
}
if(players[i].super=="no")
{
if (players[i].xp>=players[i].xprequired)
{
players[i].nlcounter++;
players[i].level++;
double extradollars=10;
players[i].give("dollar",extradollars*players[i].level**2);
players[i].xprequired=(25*(players[i].level*(players[i].level*5)));
}
else
{
if(players[i].nlcounter>0)
{
players[i].glm=false;
send(0,"levelup "+players[i].name+" got "+players[i].nlcounter+" levels, and now their level is "+players[i].level,0);
players[i].glm=true;
players[i].nlcounter=0;
}
}
}
if(players[i].disconnected==true&&players[i].persisttimer.elapsed>=players[i].persisttime)
{
remove_player(players[i].name);
continue;
}
if(players[i].falling==true and players[i].falltimer.elapsed>50)
{
players[i].falltimer.restart();
if(players[i].z>0) players[i].z--;
}
if(players[i].spamtimer.elapsed>5000 and players[i].spammedmsgs>0)
{
players[i].spamtimer.restart();
players[i].spammedmsgs=0;
}
if(players[i].spammedmsgs>=10)
{
players[i].ds.insert_last("chat");
send(players[i].peer_id,"You're chat feature has just been disabled! Please contact an administrator!",2);
write_to(players[i].name,"disabled.usr",getdisables(players[i].ds));
send(0,players[i].name+" was just caught spamming and can no longer send any messages",2);
players[i].spammedmsgs=0;
/*
if(players[i].storetimer.elapsed>4*60000 and players[i].storestage==1 and players[i].map=="store" and players[i].hidden==0)
{
players[i].storetimer.restart();
players[i].storestage=2;
players[i].playsound("storewarning");
send(players[i].peer_id,"alert! You will be moved out of the store in the next 60 seconds. Please finish any remaining purchases!",2);
}
if(players[i].storetimer.elapsed>60000 and players[i].storestage==2 and players[i].map=="store")
{
vector max=get_max_values(players[i].map);
move_player(players[i],"main",random(0,max.x),random(0,max.y),0);
players[i].storestage=3;
}
if(players[i].storestage==0 and players[i].storetimer.elapsed>5*60000 and players[i].map!="store")
{
players[i].storestage=1;*/
}
if(players[i].unstuntrys>30 and players[i].stunned==true)
{
players[i].unstuntrys=0;
players[i].stuntimer.force(players[i].stuntime);
}
if(players[i].unstuntrytimer.elapsed>700 and players[i].unstuntrys>0)
{
players[i].unstuntrytimer.restart();
players[i].unstuntrys-=1;
}
if(players[i].reloading)
{
if(players[i].reloadtimer.elapsed>players[i].reloadtime)
{
players[i].reloading=false;
players[i].w.reload();
send(players[i].peer_id, "candraw", 0);
}
}
if(players[i].beerswigs>5)
{
players[i].give("open_beer_bottle",-1);
players[i].give("empty_beer_bottle",1);
players[i].playsound("beerbottlesmash");
players[i].beerswigs=0;
}
if(players[i].drunkstage>49 and players[i].drunk==false)
{
players[i].drunktimer.restart();
players[i].drunkacttimer.restart();
players[i].drunkacttime=random(15000, 25000);
players[i].drunk=true;
send(players[i].peer_id,"Your head is spinning, you suddenly lose balance, you start to feel extremely dizzy and you suddenly have an urge to vomet!",0);
spawn_bodyfall(players[i].x,players[i].y,players[i].z,players[i].map,0,i);
}
if(players[i].level<=50000)
{
players[i].super="no";
}
else if(players[i].level>=50000)
{
players[i].super="true";
send(0,"play_s super.ogg",0);
send(0,players[i].name+" He has sealed the level system, and now he's considered a super, and he's going to deal with a point system instead of levels, congratulations",2);
}
if(players[i].level>=1 and players[i].level<=50000)
{
players[i].super="no";
}
if(players[i].drunk==true)
{
if(players[i].drunkacttimer.elapsed>=players[i].drunkacttime)
{
players[i].drunkacttime=random(8000, 13000);
players[i].drunkacttimer.restart();
int action=random(1,7);
if(action==1)
{
players[i].chat(players[i].title+" "+players[i].alliancename+" "+players[i].nickname+": "+random_string_from_array(drunkmsglist));
}
else if(action==2)
{
send(players[i].peer_id,"You feel so dizzy you lose your balance again!",2);
spawn_bodyfall(players[i].x,players[i].y,players[i].z,players[i].map,0,i);
}
else if(action==3)
{
send(players[i].peer_id,"You grab your stomach and bend over, suddenly you throw up!",2);
players[i].playsound("vomit");
players[i].vomited=true;
}
else if(action==4)
{
string sf=random_string_from_array(randsounds);
send(players[i].peer_id,"play_s "+sf+".ogg",0);
}
else if(action==5)
{
send(players[i].peer_id,"You hug your rumbling belly and moan, bitch! How it hurts!",2);
players[i].playsound("s41");
}
else if(action==6)
{
send(players[i].peer_id,"You are so drunk that you suddenly want to vomit, you strain, and accidentally vomit blood!",2);
players[i].playsound("s24");
}
else if(action==7)
{
send(players[i].peer_id,"Suddenly you want to burp. You belch without calculating the force, and your belch is spread all over the map!",2);
players[i].playsound("s47");
}
}
if(players[i].drunktimer.elapsed>120000)
{
send(players[i].peer_id,"Things finally start getting back to normal!",0);
players[i].drunkstage=0;
players[i].drunk=false;
}
}
if(players[i].mask==1)
{
if(players[i].airtimer.elapsed>=3500)
{
players[i].airtimer.restart();
if(players[i].air>0)
{
players[i].air--;
players[i].playsound("gas_mask_breathe");
players[i].cyanide=false;
}
else
{
send(players[i].peer_id,"You need air!",0);
players[i].hitby="suffocation";
players[i].health-=random(1000000,10000000);
}
}
}
if(players[i].underwater==true and players[i].mask==0)
{
if(players[i].airwarntimer.elapsed>=15000)
{
players[i].airwarntimer.restart();
send(players[i].peer_id,"You need to breathe!",0);
}
if(players[i].airlifetimer.elapsed>=60015)
{
players[i].airlifetimer.restart();
players[i].hitby="internal:drown";
players[i].health=0;
}
}
if(players[i].cheater==1 and players[i].cheatertimer.elapsed>=30000)
{
players[i].statchangetimer.restart();
players[i].cheater=0;
players[i].cheatertimer.restart();
send(players[i].peer_id,"You may now play again",0);
players[i].playsound("confirmation");
send(players[i].peer_id,"startmoving",0);
file_delete("chars/"+players[i].name+"/cheater.usr");
file_delete("chars/"+players[i].name+"/cheater.usr");
}
if(players[i].firetimer.elapsed>=players[i].firetime and players[i].firing==true and players[i].weapon!="" and players[i].newb==0 and automatic(players[i].weapon)==true and players[i].get_ammo_count(players[i].weapon)>0)
{
if(players[i].weapon=="ak47" and players[i].cooling==true)
{
return;
}
if(players[i].weapon=="ak48" and players[i].akcooling==true) return;
if(players[i].weapon=="hk_machinegun" and players[i].hkcooling==true) return;
if(players[i].weapon=="combat_machinegun" and players[i].ccooling==true) return;
if(players[i].weapon=="p90compact_machinegun" and players[i].pcooling==true) return;
if(players[i].weapon=="b96machinegun" and players[i].bcooling==true) return;
players[i].firetimer.restart();
send(players[i].peer_id,"play_s "+players[i].weapon+".ogg",0);
players[i].playsound(players[i].weapon, false);
send_x(0,"distsound "+players[i].weapon+"dist "+players[i].x+" "+players[i].y+" "+players[i].z+" "+players[i].map,0,players[i].x,players[i].y,players[i].z,players[i].map,100);
if(hasammo(players[i].weapon)==true)
{
players[i].ammo_give(players[i].weapon,-1);
if(players[i].get_ammo_count(players[i].weapon)<=0) players[i].vo("reload");
}
if(players[i].weapon=="ak47")
{
players[i].cooldown-=2;
spawn_weapon(players[i].x, players[i].y, players[i].z, players[i].facing, players[i].weapon, players[i].map, players[i]);
}
if(players[i].weapon=="ak48")
{
players[i].akcooldown-=2;
spawn_weapon(players[i].x, players[i].y, players[i].z, players[i].facing, players[i].weapon, players[i].map, players[i]);
}
if(players[i].weapon=="hk_machinegun")
{
players[i].hkcooldown-=2;
spawn_weapon(players[i].x, players[i].y, players[i].z, players[i].facing, players[i].weapon, players[i].map, players[i]);
}
if(players[i].weapon=="combat_machinegun")
{
players[i].ccooldown-=2;
spawn_weapon(players[i].x, players[i].y, players[i].z, players[i].facing, players[i].weapon, players[i].map, players[i]);
}
if(players[i].weapon=="b96machinegun")
{
players[i].bcooldown-=2;
spawn_weapon(players[i].x, players[i].y, players[i].z, players[i].facing, players[i].weapon, players[i].map, players[i]);
}
if(players[i].weapon=="p90compact_machinegun")
{
players[i].pcooldown-=2;
}
else
spawn_weapon(players[i].x, players[i].y, players[i].z, players[i].facing, players[i].weapon, players[i].map, players[i]);
}
if(i>=players.length()) return;
if(players[i].warping) players[i].warpcheck();
if(players[i].skateboardusage) players[i].skateboardcheck();
if(players[i].cremguns&&has_remgun(players[i].name)==false)
{
players[i].cremguns=false;
send(players[i].peer_id,"remdisconnect",0);
send(players[i].peer_id,"all your remote guns have disconnected!",2);
}
if(players[i].health<5000 and players[i].lowhealth==false)
{
players[i].lowhealth=true;
send(players[i].peer_id,"lowhealth "+players[i].health,0);
players[i].bleedsound=spawn_moving_sound("bleeding.ogg",players[i].x,players[i].y,players[i].z,players[i].map);
players[i].bleeding=true;
}
if(players[i].health>=5000 and players[i].lowhealth==true)
{
players[i].lowhealth=false;
send(players[i].peer_id,"goodhealth",0);
destroy_moving_sound(players[i].bleedsound);
players[i].bleedsound="";
players[i].bleeding=false;
}
if(players[i].newb==1 and players[i].newbtimer.elapsed>=20*60000)
{
players[i].newbtimer.restart();
send(players[i].peer_id,"Time's up!",0);
players[i].newb=2;
}
if(players[i].newb==2 and players[i].newbtimer.elapsed>=3000)
{
players[i].newb=0;
players[i].newbtimer.restart();
send(players[i].peer_id,"Your newbie flag has been disabled!",0);
send(0,"notify "+players[i].nickname+" is no longer a newbie!",0);
server_log("eventstream","server notification: "+players[i].nickname+" is no longer a newbie!");
file_delete("chars/"+players[i].name+"/newb.usr");
}
if(players[i].following!="")
{
int ind=get_player_index_from(players[i].following);
if(players[i].following_on&&ind<0)
{
players[i].following_on=false;
send(players[i].peer_id,"the player you were watching has gone offline. You now are not watching anyone.",2);
send(players[i].peer_id,"followstop",0);
move_player(players[i],players[i].oldmap,players[i].oldx,players[i].oldy,players[i].oldz);
players[i].following="";
}
if(players[i].following_on==false&&ind>-1)
{
players[i].following_on=true;
players[ind].follower=players[i].name;
send(players[i].peer_id,"your followed link has returned. You are now following them again.",2);
send(players[i].peer_id,"followstart",0);
}
}
if(players[i].follower!="")
{
int j=get_player_index_from(players[i].follower);
if(j<0)
{
players[i].follower="";
return;
}
if(players[j].map!=players[i].map)
{
if(in_shelter(players[i].name)<0) move_player(players[j],players[i].map,players[i].x,players[i].y,players[i].z,false);
else move_player(players[j],players[i].map,players[i].x,players[i].y,players[i].z,false,false,in_shelter(players[i].name));
}
else
{
if(players[j].x!=players[i].x or players[j].y!=players[i].y or players[j].z!=players[i].z)
{
players[j].x=players[i].x;players[j].y=players[i].y;players[j].z=players[i].z;
send(players[j].peer_id,"move "+players[j].x+" "+players[j].y+" "+players[j].z,0);
}
}
}
