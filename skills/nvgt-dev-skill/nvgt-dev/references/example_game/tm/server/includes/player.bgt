players[i].y=0;
players[i].z=0;
return;
}
else if(players[i].map=="jail")
{
players[i].map="jail";
players[i].x=0;
players[i].y=0;
players[i].z=0;
return;
}
else
players[i].storetimer.restart();
players[i].storestage=1;
players[i].map="safe_zone";
vector max=get_max_values(players[i].map);
players[i].x=random(0,30);
players[i].y=random(0,30);
players[i].z=0;
send(players[i].peer_id, "entershelter 0 100 0 main", 0);
}
if(players[i].hitby=="a fire") add_achievement("it burns",i,"20 fire_extinguisher",true);
string hb;
if(string_contains(players[i].hitby,"'",1)>-1)
{
string[] parsed_data=string_split(players[i].hitby,"'",false);
hb=parsed_data[0];
}
else
hb=players[i].hitby;
int k=get_player_index_from(hb);
if(k>-1)
{
achloop(k,i);
if(players[k].name!=players[i].name)
{
if(string_contains(players[i].hitby,"bomb",1)<0)
{
double extradollars=random(1,10000);
players[k].give("dollar",extradollars);
send(players[k].peer_id,"You get "+extradollars+"extra dollars! Nice job!",2);
}
players[k].kills+=1;
if(players[k].super=="no")
if(players[k].level>=1 and players[i].level<=99) players[k].xp+=random(100,500);
if(players[k].level>=100 and players[i].level<=199) players[k].xp+=random(500,1000);
if(players[k].level>=200 and players[i].level<=299) players[k].xp+=random(1000,1500);
if(players[k].level>=300 and players[i].level<=399) players[k].xp+=random(1500,2000);
if(players[k].level>=400 and players[i].level<=499) players[k].xp+=random(2000,2500);
if(players[k].level>=500 and players[k].level<=599) players[k].xp+=random(2500,3000);
if(players[k].level>=600 and players[k].level<=700) players[k].xp+=random(3000,3500);
if(players[k].level>=700 and players[k].level<=799) players[k].xp+=random(3500,4000);
if(players[k].level>=800 and players[k].level<=899) players[k].xp+=random(4000,4500);
if(players[k].level>=900 and players[k].level<=999) players[k].xp+=random(4500,5000);
if(double_xp==1)
{
if(players[k].level>=1 and players[i].level<=99) players[k].xp+=random(100,500)*2;
if(players[k].level>=100 and players[i].level<=199) players[k].xp+=random(500,1000)*2;
if(players[k].level>=200 and players[i].level<=299) players[k].xp+=random(1000,1500)*2;
if(players[k].level>=300 and players[i].level<=399) players[k].xp+=random(1500,2000)*2;
if(players[k].level>=400 and players[i].level<=499) players[k].xp+=random(2000,2500)*2;
if(players[k].level>=500 and players[k].level<=599) players[k].xp+=random(2500,3000)*2;
if(players[k].level>=600 and players[k].level<=700) players[k].xp+=random(3000,3500)*2;
if(players[k].level>=700 and players[k].level<=799) players[k].xp+=random(3500,4000)*2;
if(players[k].level>=800 and players[k].level<=899) players[k].xp+=random(4000,4500)*2;
if(players[k].level>=900 and players[k].level<=999) players[k].xp+=random(4500,5000)*2;
}
if(custom_xp==1)
{
if(players[k].level>=1 and players[i].level<=99) players[k].xp+=random(100,500)*10;
if(players[k].level>=100 and players[i].level<=199) players[k].xp+=random(500,1000)*10;
if(players[k].level>=200 and players[i].level<=299) players[k].xp+=random(1000,1500)*10;
if(players[k].level>=300 and players[i].level<=399) players[k].xp+=random(1500,2000)*10;
if(players[k].level>=400 and players[i].level<=499) players[k].xp+=random(2000,2500)*10;
if(players[k].level>=500 and players[k].level<=599) players[k].xp+=random(2500,3000)*10;
if(players[k].level>=600 and players[k].level<=700) players[k].xp+=random(3000,3500)*10;
if(players[k].level>=700 and players[k].level<=799) players[k].xp+=random(3500,4000)*10;
if(players[k].level>=800 and players[k].level<=899) players[k].xp+=random(4000,4500)*10;
if(players[k].level>=900 and players[k].level<=999) players[k].xp+=random(4500,5000)*10;
}
if(players[k].super=="true")
players[k].points+=random(1,15);
int tm=is_in_alliance(players[k].name);
if(tm>-1 and !are_allianceed(players[i].name, players[k].name)) {
int l=random(500,1500);
alliances[tm].points+=l;
alliances[tm].transmit("This alliance just got "+l+" extra points!");
alliances[tm].alliancekills+=1;
}
if(players[i].stunned)
{
send(players[i].peer_id,"startmoving",0);
players[i].stunned=false;
}
}
}
scd(i);
}
if( players[i].beacontimer.elapsed>=players[i].beacontime and players[i].disappear==false and players[i].invisible==false and players[i].is_dead==false and players[i].afk==false and players[i].invinsible==false and players[i].hidden==0)
{
players[i].beacontimer.restart();
for(uint pl=0; pl<players.length(); pl++)
{
if(pl>(players.length()-1) or i>(players.length()-1)) return;
if(players[pl].name!=players[i].name and players[pl].beacon>0 and players[i].distancecheck(players[pl].x,players[pl].y,players[pl].z)<=50 and players[i].map==players[pl].map)
{
if(are_allianceed(players[i].name,players[pl].name)) send_u(players[pl].peer_id,"invsecond "+players[i].x+" "+players[i].y+" "+players[i].z+" "+players[i].map,3);
else send_u(players[pl].peer_id,"beacon "+players[i].x+" "+players[i].y+" "+players[i].z+" "+players[i].map,3);
netloop();
}
}
}
}
}
void spawn_player(int x, int y, int z, string map, string name,int pi, string cid, string ip, string ver, string ctext,int hid, bool bot=false)
{
player p1(x,y,z,map,name,pi,cid,ip,ver,ctext,hid,bot);
players.insert_last(p1);
int index=get_player_index_from(name);
players[index].statchangetimer.force(100000);
if(hid==0)
send(0, "online "+random(1,19) +x+" "+y+" "+z+" "+name+" "+map,0);
connections++;
}
bool is_on_server(string playername)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].name==playername)
{
return true;
}
}
return false;
}
int get_nearest_player(int px, int py, int pz, string pmap, int pindex=-1)
{
int current_distance=-1;
int final_index=-1;
for(uint i=0; i<players.length(); i++)
{
if(players[i].map!=pmap or i==pindex or players[i].invisible or players[i].disappear or players[i].afk or players[i].invinsible or players[i].is_dead and players[i].hidden!=0)
{
continue;
}
int dist=get_3d_distance(px, py, pz, players[i].x, players[i].y, players[i].z);
if(current_distance==-1)
{
current_distance=dist;
final_index=i;
}
else
{
if(dist<current_distance)
{
current_distance=dist;
final_index=i;
}
}
}
return final_index;
}
int get_gnwinner()
{
if(guessthenumber_guesses.is_empty()) return -1;
int[] guesses=guessthenumber_guesses;
int winnum=get_closest_value(gntarget,guesses);
int final_index=-1;
for(uint i=0; i<players.length(); i++) {
if(players[i].gnplaying==0) continue;
if(players[i].guessnum==winnum) final_index=i;
}
return final_index;
}
//function to see if a number is already there in guess the number.
bool num_is_active(int num)
{
bool active=false;
for(uint i=0; i<players.length(); i++)
{
if(players[i].gnplaying==0) continue;
if(players[i].guessnum==num) active=true;
}
return active;
}
int get_best_player()
{
int current_killcount=-1;
int final_index=-1;
for(uint i=0; i<players.length(); i++)
{
int count=players[i].kills;
if(current_killcount==-1)
{
current_killcount=count;
final_index=i;
}
else
{
if(count>current_killcount)
{
current_killcount=count;
final_index=i;
}
}
}
return final_index;
}
void remove_player(string name,bool got_kicked=false, bool lost=false)
{
for(uint i=0; i<players.length(); i++)
{
if(players[i].name==name)
{
if(players[i].map=="arena" or players[i].map=="arena_wait")
{
players[i].on_arena=false;
fighiters+=-1;
}
if(players[i].map=="creature_arena" or players[i].map=="creature_arena_wait")
{
players[i].on_creaturearena=false;
hunters+=-1;
players[i].creaturehunted=false;

}
if(players[i].map=="melee_arena" or players[i].map=="melee_arena_wait")
{
players[i].on_meleearena=false;
tossers+=-1;
}
int e=is_part_of_event(name);
if(e>-1)
{
events[e].leave(players[i],true,true);
}
int allianceindex=is_in_alliance(name);
if(allianceindex>-1)
alliances[allianceindex].remove_member(name,false,false);
uint oldid=(players[i].disconnected ? 4294967294 : players[i].peer_id);
if(got_kicked==true)
{
send(0,players[i].name+" was kicked from the server",2);
server_log("eventstream",players[i].name+" was kicked from the server");
}
if(players[i].following!="")
{
int ind=get_player_index_from(players[i].following);
if(ind>-1) players[ind].following="";
}
disconnections++;
for(uint j=0; j<guns.length(); j++)
{
int a=players[i].get_ammo_count_from(guns[j]);
if(a>0)
{
players[i].give("ammo_"+guns[j],a);
}
}
scd(i);
if(players[i].hidden==0) send(0, "offline "+random(1,19) +players[i].x+" "+players[i].y+" "+players[i].z+" "+players[i].name+" "+players[i].map, 0);
else
{
if(!players[i].disconnected)
send(players[i].peer_id, "offline "+random(1,19) +players[i].x+" "+players[i].y+" "+players[i].z+" "+players[i].name+" "+players[i].map, 0);
}
@players[i]=null;
players.remove_at(i);
if(oldid!=4294967294) send(oldid,"killclient",0);
continue;
}
}
}
class pld
{
double tx,ty,tz;
double sx,sy,sz;
double dist;
int index;
pld(player@ p1, player@ p2)
{
sx=p1.x;sy=p1.y;sz=p1.z;
tx=p2.x;ty=p2.y;tz=p2.z;
index=get_player_index_from(p2.name);
dist=get_3d_distance(sx,sy,sz,tx,ty,tz);
}
int opCmp(pld@ o)
{
if(o.dist<dist) return -1;
if(o.dist>dist) return 1;
return 0;
}
}
string[] nearest_player_sorted_array(player@ p)
{
pld@[] t;
for(uint i=0; i<players.length(); i++)
{
if(players[i].name==p.name||players[i].is_dead||players[i].afk||players[i].invinsible||p.map!=players[i].map||players[i].hidden==1 or players[i].newb==1) continue;
pld temp(p,players[i]);
t.insert_last(temp);
}
string[] blankret;
if(t.is_empty()) return blankret;
t.sort_descending();
string[] names;
for(uint i=0; i<t.length(); i++)
{
names.insert_last(players[t[i].index].name);
}
return names;
}
string cn2n(string pname,bool vi=false)
{
string ret=pname;
for(uint i=0; i<players.length(); i++)
{
if(players[i].name==pname)
{
ret=players[i].nickname;
if(vi)
{
for(uint v=0; v<vs.length(); v++)
{
if(vs[v].owner==pname) ret+="'s "+vs[v].type;
}
}
}
}
if(ret==pname&&file_exists("chars/"+pname+"/nickname.usr"))
{
ret=get_char_val(pname,"nickname");
}
return ret;
}
bool are_allianceed(string pn1, string pn2)
{
int x1=get_player_index_from(pn1);
int x2=get_player_index_from(pn2);
if(x1==-1||x2==-1) return false;
int tx1=is_in_alliance(pn1);
int tx2=is_in_alliance(pn2);
if(tx1==-1||tx2==-1) return false;
if(tx1==tx2 or alliances[tx1].is_member(pn2) or alliances[tx2].is_member(pn1)) return true;
return false;
}
string getdisables(string[] f)
{
dictionary temp;
for(uint i=0; i<f.length(); i++)
{
temp.set(f[i],"d");
}
return serialize(temp);
}
string[] setdisables(string temp)
{
dictionary t=deserialize(temp);
return t.get_keys();
}
bool cheatercheck(int index, bool excludepaid=false)
{
if(index<0) return false;
if(file_exists("chars/"+players[index].name+"/cheater.usr")) return false; //server already caught it in reception of close
bool missilesnear=false;
for(uint i=0; i<missiles.length(); i++)
{
int missiledist=players[index].distancecheck(missiles[i].x,missiles[i].y,missiles[i].z);
if(missiledist<=30 and missiles[i].map==players[index].map and players[index].name==missiles[i].targetname)
{
missilesnear=true;
}
}
bool near_ultrabomb=false;
for(int i=0; i<ultrabombs.length(); i++)
{
int distance=players[index].distancecheck(ultrabombs[i].x, ultrabombs[i].y, ultrabombs[i].z);
if(distance<80 and players[index].map==ultrabombs[i].map and ultrabombs[i].d==true) near_ultrabomb=true;
}
if((players[index].statchangetimer.elapsed<15000||missilesnear==true || near_ultrabomb==true))
{
if(!excludepaid) return true;
else if(excludepaid&&players[index].paid==0) return true;
}
return false;
}
int antibiotic(int ch)
{
double limit=80000,scaler=100;
if(ch<=5000&&ch>=3500) 
{
scaler=70;
limit=40000;
}
else if(ch<3500&&ch>=2000)
{
scaler=50;
limit=30000;
}
else if(ch<2000&&ch>1000)
{
scaler=25;
limit=20000;
}
else if(ch<=1000)
{
scaler=15;
limit=15000;
}
if(ch==0) return 10000;
else ch+=floor((limit/ch)*scaler);
return ch;
}
class chartime
{
string name,extrainfo;
float lastlog;
chartime(string name, float lastlog)
{
this.name=name;
this.lastlog=lastlog;
}
int opCmp(chartime@ otherlog)
{
if(this.lastlog==otherlog.lastlog) return 0;
else if(this.lastlog<otherlog.lastlog) return -1;
else return 1;

}
}
player@[] get_paid_online()
{
player@[] ret;
for(int i=0; i<players.length(); i++)
{
if(players[i].is_paid()&&players[i].hidden==0)
ret.insert_last(players[i]);
}
return ret;
}