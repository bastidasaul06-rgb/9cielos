void dlg(string message, bool in_game=false,string dlgalert="",string dlgdismiss="")
{
if(dlgalert!="") p.play_stationary(dlgalert,false);
speak(message);
while(true)
{
if(in_game) main_loop();
if(speed_stop_is_hacking(200)==true)
killbitch();
if (key_pressed(KEY_LEFT) or key_pressed(KEY_RIGHT) or key_pressed(KEY_UP) or key_pressed(KEY_DOWN))
{
speak(message);
}
if (key_pressed(KEY_RETURN) or key_pressed(KEY_ESCAPE))
{
break;
}
wait(5);
}
if(dlgdismiss!="") p.play_stationary(dlgdismiss,false);
}

void dlg_send(string message, string return_packet="dlg_reply",bool in_game=false)
{
speak(message);
while(true)
{
if(in_game) main_loop();
if(speed_stop_is_hacking(200)==true)
killbitch();
if (key_pressed(KEY_LEFT) or key_pressed(KEY_RIGHT) or key_pressed(KEY_UP) or key_pressed(KEY_DOWN))
{
speak(message);
}
if (key_pressed(KEY_RETURN) or key_pressed(KEY_ESCAPE))
{
send(0,return_packet+" "+keys_pressed()[0],0);
break;
}
wait(5);
}
}

void dlg_wait(string message, int waittime)
{
speak(message);
timer d;
speed_stop_reset(true);
while(true)
{
e=n.request();
if(speed_stop_is_hacking(200)==true)
killbitch();
if (key_pressed(KEY_LEFT) or key_pressed(KEY_RIGHT) or key_pressed(KEY_UP) or key_pressed(KEY_DOWN))
{
speak(message);
}
if(d.elapsed>=waittime)
{
break;
}
wait(5);
}
}
sound dlgaudio;
void dlgplay(string dlgsound, bool dlgfade=false, int fadespeed=30, bool is_file=true)
{
if(is_file)
dlgaudio.load(dlgsound);
else
dlgaudio.load(dlgsound);
dlgaudio.play();
while(dlgaudio.playing)
{
wait(5);
if(speed_stop_is_hacking(200)==true)
killbitch();
if(key_pressed(KEY_RETURN))
{
if (dlgfade==true)
{
fade(dlgaudio, -80, fadespeed);
}
dlgaudio.stop();
break;
}
}
}
