int capmode=1;
class input_handle
{
bool retreev=true;
string caption;
string text;
string password_mask;
string highlight_selection_speech_text="selected";
string highlight_unselection_speech_text="unselected";
string delete_speech_text="";
int sel_start;
int sel_highlight;
int sel_length;
int max_length;
uint minvalue=0;
uint maxvalue=100;
bool read_only;
bool multiline;
bool overwrite=false;
string char;
bool valid=true;
string tc;
void check()
{
bool temp=false;
tc=get_characters();
char=retreev==true?tc:"";
if(temp==false and retreev==false)
{
temp=true;
retreev=true;
}
if(valid)
{
if(!read_only)
{
if(char!="")
{
if(overwrite)
{
edit(char);
}
else
{
add(char);
}
}
}
if(!read_only)
{
if (key_pressed(KEY_F3)) {
if (capmode==0) {
capmode=1;
speak("Say cap");
p.play_stationary("wpingon.ogg",false);
}
else {
capmode=0;
speak("No capitals.");
p.play_stationary("wpingoff.ogg",false);
}
}
if(key_pressed(KEY_F1) and SCRIPT_COMPILED==false)
speak("sel_start: "+sel_start+"; sel_highlight: "+sel_highlight+"; sel_length: "+sel_length+".");
if (key_pressed(KEY_F2))
{
if (charrepeat==1)
{
p.play_stationary("wpingoff.ogg",false);
speak("character repeat off");
charrepeat=0;
}
else
{
p.play_stationary("wpingon.ogg",false);
speak("character repeat on");
charrepeat=1;
}
}
if (key_pressed(KEY_F4))
{
if (styping==1)
{
p.play_stationary("wpingoff.ogg",false);
speak("stereo typing has been disabled");
styping=0;
}
else
{
p.play_stationary("wpingon.ogg",false);
speak("stereo typing has been enabled");
styping=1;
}
}
if(((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL)))&&(key_pressed(KEY_X)))
{
cut_highlighted();
}
if(((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL)))&&(key_pressed(KEY_V)))
{
paste_text();
}
if(key_pressed(KEY_BACK))
{
delete_highlighted();
}
if(key_pressed(KEY_DELETE))
{
delete_highlighted(1);
}
if(key_down(KEY_LSHIFT) and key_pressed(KEY_RETURN) or key_down(KEY_RSHIFT) and key_pressed(KEY_RETURN) and multiline==true)
{
add_new_line();
}
}
}
if(((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL)))&&(key_pressed(KEY_A)))
{
highlight_all();
}
if(((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL)))&&(key_pressed(KEY_C)))
{
copy_highlighted();
}
if((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL)))
{
if(key_pressed(KEY_LEFT))
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) highlight_to_word_start();
else move_word_left();
return;
}
if(key_pressed(KEY_RIGHT))
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) highlight_to_word_end();
else move_word_right();
return;
}
}
if(key_pressed(KEY_LEFT))
{
if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT)))
{
highlight_left();
return;
}
else move_left();
}
if(key_pressed(KEY_RIGHT))
{
if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT)))
{
highlight_right();
return;
}
else move_right();
}
if(key_pressed(KEY_UP))
{
if(multiline==false)
{
if(text!="")
speak(text);
else
speak("blank");
return;
}
if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT)))
{
highlight_up();
}
else
{
previous_line();
}
}
if(key_pressed(KEY_DOWN))
{
if(multiline==false)
{
if(text!="")
speak(text);
else
speak("blank");
return;
}
if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT)))
{
highlight_down();
}
else
{
next_line();
}
}
if(key_pressed(KEY_HOME))
{
if(multiline)
{
if(key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL))
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
highlight_to_field_start();
else
field_start();
}
else
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
highlight_to_line_start();
else
line_start();
}
}
else
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
highlight_to_field_start();
else
field_start();
}
}
if(key_pressed(KEY_END))
{
if(multiline)
{
if(key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL))
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
highlight_to_field_end();
else
field_end();
}
else
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
highlight_to_line_end();
else
line_end();
}
}
else
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
highlight_to_field_end();
else
field_end();
}
}
}
void highlight_left()
{
int orig_sel_length=sel_length;
if(sel_start<=0)
{
return;
}
if(sel_length==0)
{
sel_highlight=sel_start;
}
sel_start--;
if(sel_highlight>sel_start)
{
sel_length=sel_highlight-sel_start;
}
else
{
sel_length=sel_start-sel_highlight;
}
if(orig_sel_length>=sel_length)
{
//sel_start--;
speak(input_box_speak(find_appropriate_character(text[sel_start]), true)+" "+highlight_unselection_speech_text);
}
else
{
//sel_start--;
speak(input_box_speak(find_appropriate_character(text[sel_start]), true)+" "+highlight_selection_speech_text);
}
}
void highlight_right()
{
int orig_sel_length=sel_length;
if(sel_start==text.length())
{
return;
}
if(sel_length==0)
{
sel_highlight=sel_start;
}
sel_start++;
if(sel_highlight>sel_start)
{
sel_length=sel_highlight-sel_start;
}
else
{
sel_length=sel_start-sel_highlight;
}
if(sel_start==text.length())
{
speak("Blank");
}
else
{
if(orig_sel_length>=sel_length)
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true)+" "+highlight_unselection_speech_text);
//sel_start++;
}
else
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true)+" "+highlight_selection_speech_text);
//sel_start++;
}
}
}
void next_line()
{
if(sel_start==text.length())
{
return;
}
for(int counter=sel_start; counter<text.length(); counter++)
{
if(counter<0)
{
continue;
}
if(text[counter]!="\n")
{
continue;
}
sel_start=counter+1;
speak(read_line(sel_start));
break;
}
}
void previous_line()
{
bool found_end=false;
int counter;
int start;
int end;
if(sel_start<=0)
{
return;
}
for(counter=sel_start-1; counter>=0; counter--)
{
if(counter==text.length())
{
continue;
}
if(counter>text.length())
{
sel_start=0;
speak(read_line(sel_start));
break;
}
if((counter==0)||(counter>text.length()))
{
sel_start=0;
speak(read_line(sel_start));
break;
}
if(text[counter]!="\r")
{
continue;
}
if(text[counter]=="\r")
{
if(!found_end)
{
end=counter-1;
found_end=true;
}
else
{
sel_start=counter+2;
speak(read_line(sel_start));
break;
}
}
}
}
void highlight_all()
{
sel_start=text.length();
sel_highlight=0;
sel_length=text.length();
speak(text+" "+highlight_selection_speech_text);
}
void add(string character)
{
if(styping==1) spool.play_stationary_extended("key"+random(1, 3)+".ogg", false, 0, random(-30, 30), 0, 100);
else spool.play_stationary("key"+random(1, 3)+".ogg", false);
string new_text="";
if((max_length>0)&&(text.length()>=max_length))
{
return;
}
if(sel_start==-1)
{
sel_start=0;
}
for(int counter=0; counter<sel_start; counter++)
{
new_text+=text[counter];
}
new_text+=character;
for(int counter=sel_start; counter<text.length(); counter++)
{
new_text+=text[counter];
}
if(read_only==false)
{
text=new_text;
sel_start++;
sel_highlight=sel_start;
}
if (charrepeat==1) speak(input_box_speak(find_appropriate_character(character)));
}
void edit(string character)
{
if((max_length>0)&&(text.length()>max_length))
{
return;
}
if(text.length()==0)
{
return;
}
if(sel_start>=text.length())
{
return;
}
if(sel_start==-1)
{
sel_start=0;
}
if(read_only==false)
{
text[sel_start]=character;
}
speak(input_box_speak(find_appropriate_character(character)));
}
bool add_silent(string content, int position)
{
string new_text="";
if((position<0)||(position>text.length()))
{
return false;
}
if(position==text.length())
{
new_text=text+content;
if((max_length>0)&&(new_text.length()>max_length))
{
return false;
}
text=new_text;
return true;
}
for(int counter=0; counter<position; counter++)
{
new_text+=text[counter];
}
new_text+=content;
for(int counter=position; counter<text.length(); counter++)
{
new_text+=text[counter];
}
if((max_length>0)&&(new_text.length()>max_length))
{
return false;
}
text=new_text;
return true;
}
bool edit_silent(string content, int position, int edit_mode)
{
if(edit_mode==edit_mode_replace)
{
return replace_text(content, position);
}
if(edit_mode==edit_mode_trim_to_length)
{
return trim_to_length(content, position);
}
if(edit_mode==edit_mode_append_to_end)
{
return append_text(content, position);
}
return false;
}
bool replace_text(string content, int position)
{
if(position>=text.length())
{
return false;
}
if(position==0)
{
if((max_length>0)&&(content.length()>max_length))
{
return false;
}
text=content;
return true;
}
string new_text=string_left(text, position);
new_text+=content;
if((max_length>0)&&(new_text.length()>max_length))
{
return false;
}
text=new_text;
return true;
}
bool trim_to_length(string content, int position)
{
if(position>=text.length())
{
return false;
}
for(int counter=position; counter<text.length(); counter++)
{
if(content=="")
{
break;
}
text[counter]=content[0];
content=string_trim_left(content, 1);
}
return true;
}
bool append_text(string content, int position)
{
if(position>=text.length())
{
return false;
}
if((position==0)&&(content.length()>text.length()))
{
if((max_length>0)&&(content.length()>max_length))
{
return false;
}
text=content;
return true;
}
string new_text=text;
for(int counter=position; counter<new_text.length(); counter++)
{
if(content=="")
{
break;
}
new_text[counter]=content[0];
content=string_trim_left(content, 1);
}
new_text+=content;
if((max_length>0)&&(new_text.length()>max_length))
{
return false;
}
text=new_text;
return true;
}
void copy_highlighted()
{
string copy_text="";
if(sel_length==0)
{
speak("Nothing selected");
return;
}
if(sel_highlight>sel_start)
{
for(int counter=sel_start; counter<=sel_highlight; counter++)
{
if(counter==text.length())
{
continue;
}
copy_text+=text[counter];
}
}
else
{
for(int counter=sel_highlight; counter<=sel_start; counter++)
{
if(counter==text.length())
{
continue;
}
copy_text+=text[counter];
}
}
speak("Copied: "+copy_text);
clipboard_copy_text(copy_text);
}
void cut_highlighted()
{
string copy_text="";
if(read_only==true)
{
speak("Cannot cut from a read only edit box.");
return;
}
if(sel_length==0)
{
speak("Nothing selected");
return;
}
if(sel_highlight>sel_start)
{
for(int counter=sel_start; counter<=sel_highlight; counter++)
{
if(counter==text.length())
{
continue;
}
copy_text+=text[counter];
}
}
else
{
for(int counter=sel_highlight; counter<=sel_start; counter++)
{
if(counter==text.length())
{
continue;
}
copy_text+=text[counter];
}
}
speak("Cut: "+copy_text);
clipboard_copy_text(copy_text);
delete_highlighted(0, false);
}
void paste_text()
{
string paste=clipboard_read_text();
string[]@ paste_single=string_split(paste, "\r\n", false);
if(!multiline)
{
paste=paste_single[0];
}
string new_text="";
if(paste=="")
{
speak("There is nothing in the clipboard to paste.");
return;
}
if(sel_start<=0)
{
sel_start=0;
text=paste+text;
speak("Pasted: "+text);
return;
}
if(sel_start>=text.length())
{
text+=paste;
speak("Pasted: "+text);
return;
}
for(int counter=0; counter<sel_start; counter++)
{
new_text+=text[counter];
}
new_text+=paste;
for(int counter=sel_start; counter<text.length(); counter++)
{
new_text+=text[counter];
}
sel_start=0;
text=new_text;
speak("Pasted: "+paste);
}
void delete_highlighted()
{
delete_highlighted(0);
}
void delete_highlighted(int from_start)
{
delete_highlighted(from_start,true);
}
void delete_highlighted(int from_start, bool speak_deleted)
{
if(styping==1) spool.play_stationary_extended("keydelete.ogg", false, 0, random(-30, 30), 0, 100);
else spool.play_stationary("keydelete.ogg", false);
if((text=="")||(read_only==true))
{
return;
}
string new_text="";
string delete_text="";
int delete_start;
int delete_end;
if(sel_length==0)
{
if(from_start==0)
{
delete_start=sel_start-1;
}
else
{
delete_start=sel_start;
}
if((delete_start<0)||(delete_start>=text.length()))
{
return;
}
//if((text[delete_start]!="\r")&&(text[delete_start]!="\n"))
//{
delete_end=delete_start;
//}
//if(text[delete_start]=="\r")
//{
//delete_end=delete_start+1;
//}
//if(text[delete_start]=="\n")
//{
//delete_start--;
//delete_end=delete_start+1;
//}
}
else
{
if(sel_highlight>sel_start)
{
delete_start=sel_start;
delete_end=sel_highlight;
}
else
{
delete_start=sel_highlight;
delete_end=sel_start;
}
}
for(int counter=0; counter<text.length(); counter++)
{
if((counter>=delete_start)&&(counter<=delete_end))
{
delete_text+=text[counter];
continue;
}
new_text+=text[counter];
}
if(speak_deleted==true)
{
if((delete_text.length()==1)||(delete_text=="\r\n"))
{
speak(input_box_speak(find_appropriate_character(delete_text))+" "+delete_speech_text);
}
else
{
speak(delete_text+" "+delete_speech_text);
}
}
text=new_text;
if(from_start==0)
{
sel_start-=(sel_length+1);
sel_highlight=sel_start;
sel_length=0;
}
if(sel_start>text.length())
{
sel_start=text.length();
}
if(sel_start<=-1) sel_start=0;
}
void move_left()
{
sel_length=0;
if(sel_start<=0)
{
return;
}
sel_start--;
sel_highlight=sel_start;
if(text[sel_start]=="\r")
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
//sel_start--;
sel_highlight=sel_start;
}
if(text[sel_start]=="\n")
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
//sel_start--;
sel_highlight=sel_start;
}
else
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
}
}
void move_right()
{
sel_length=0;
if(sel_start==text.length())
{
return;
}
sel_start++;
sel_highlight=sel_start;
if(sel_start==text.length())
{
speak("Blank");
}
else
{
if(text[sel_start]=="\n")
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
//sel_start++;
sel_highlight=sel_start;
}
if(sel_start<text.length()&&text[sel_start]=="\r")
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
//sel_start++;
sel_highlight=sel_start;
}
else if(sel_start<text.length())
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
//sel_start++;
sel_highlight=sel_start;
}
else if(text[sel_start]=="\r")
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
//sel_start++;
sel_highlight=sel_start;
}
}
}
void add_new_line()
{
if(multiline==false)
{
return;
}
add("\r\n");
sel_start+=1;
speak("New Line");
}
string input_box_speak(string character)
{
return input_box_speak(character, false);
}
string input_box_speak(string character, bool ignore_echo_flag)
{
if(character==" ")
{
return "Space";
}
if(character=="\r\n")
{
return "Carriage Return";
}
if(character=="\n")
{
return "Carriage Return";
}
if(character=="\r")
{
return "Line Feed";
}
if(character=="-")
{
return "Dash";
}
if(character==".")
{
return "Dot";
}
if(character==",")
{
return "Comma";
}
if(character=="@")
{
return "At";
}
if(character==">")
{
return "Greater";
}
if(character==";")
{
return "Semi";
}
if(character==":")
{
return "Colon";
}
if(character=="'")
{
return "Tick";
}
if(character=="<")
{
return "Less";
}
if(character=="_")
{
return "Line";
}
if(character=="+")
{
return "Plus";
}
if(character=="=")
{
return "Equals";
}
if(character=="!")
{
return "Bang";
}
if(character=="\"")
{
return "Quote";
}
if(character=="\\")
{
return "Backslash";
}
if(character=="/")
{
return "Slash";
}
if(character=="£")
{
return "Pound";
}
if(character=="$")
{
return "Dollar";
}
if(character=="%")
{
return "Percent";
}
if(character=="^")
{
return "Caret";
}
if(character=="&")
{
return "And";
}
if(character=="*")
{
return "Star";
}
if(character=="(")
{
return "Left Paren";
}
if(character==")")
{
return "Right Paren";
}
if(character=="")
{
return "Blank";
}
if(character=="\n")
{
return "Carriage Return";
}
if(character=="[")
{
return "Left Bracket";
}
if(character=="]")
{
return "Right Bracket";
}
if(character=="{")
{
return "Left Brace";
}
if(character=="}")
{
return "Right Brace";
}
if(character=="|")
{
return "Bar";
}
if(character=="?")
{
return "Question";
}
if(character=="`")
{
return "Grave";
}
if(character=="¬")
{
return "Not";
}
if(character=="#")
{
return"Number";
}
if(character=="~")
{
return "Tilda";
}
if(string_is_alphanumeric(character))
{
if(string_is_upper_case(character))
{
if(capmode==1) return "Cap "+character;
}
else
{
return character;
}
}
return character;
}
string find_appropriate_character(string original_character)
{
if(password_mask=="")
{
return original_character;
}
else
{
return password_mask;
}
}
void line_start()
{
if(text.length()>0)
{
string read_text="";
bool spoken=false;
if(sel_start>=text.length())
sel_start=text.length();
for(int i=sel_start; i>=0; i--)
{
//read_text=text[i];
if(i>=text.length())
{
continue;
}
if(i<=0)
{
i=0;
sel_start=i;
speak(input_box_speak(find_appropriate_character(text[sel_start]),true));
break;
}
sel_start=i;
if(text[sel_start]=="\n")
{
sel_start++;
if(sel_start>=text.length())
{
sel_start=text.length();
speak("Blank");
break;
}
else
{
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
break;
}
}
}
}
}
void line_end()
{
bool spoken=false;
if(text.length()>0)
{
string read_text="";
for(int i=sel_start; i<text.length(); i++)
{
read_text=text[i];
sel_start=i;
if(text[sel_start]=="\r")
{
speak("carriage return");
spoken=true;
break;
}
}
if(!spoken)
{
sel_start=text.length();
speak("Blank");
}
}
}
void move_word_left()
{
bool found_end=false;
int counter;
int start;
int end;
if(text=="")
{
return;
}
if(sel_start<=0)
{
return;
}
for(counter=sel_start; counter>=0; counter--)
{
if(counter==text.length())
{
continue;
}
if(counter>text.length())
{
break;
}
if((text[counter]!=" ")&&(text[counter]!="\n"))
{
continue;
}
if(text[counter]==" ")
{
if(found_end==false)
{
end=counter-1;
found_end=true;
}
else
{
sel_start=counter+1;
speak(read_word_from_position(sel_start));
break;
}
}
if(text[counter]=="\n")
{
if(found_end==false)
{
end=counter-2;
found_end=true;
}
else
{
sel_start=counter+2;
speak(read_word_from_position(sel_start));
break;
}
}
}
if((counter==0)||(counter>text.length()))
{
sel_start=0;
speak(read_word_from_position(sel_start));
}
}
void move_word_right()
{
int counter;
if(text=="")
{
return;
}
if((sel_start<0)||(sel_start>=text.length()))
{
return;
}
for(counter=sel_start; counter<text.length(); counter++)
{
if((text[counter]!=" ")&&(text[counter]!="\r"))
{
continue;
}
if(text[counter]==" ")
{
sel_start=counter+1;
speak(read_word_from_position(sel_start));
break;
}
if(text[counter]=="\r")
{
sel_start=counter+2;
speak(read_word_from_position(sel_start));
break;
}
}
if(counter==text.length()-1)
{
sel_start=text.length();
speak("Blank");
}
}
void field_start()
{
sel_start=0;
if(text.length()==0)
{
return;
}
if(!multiline)
speak(input_box_speak(find_appropriate_character(text[sel_start]), true));
else
speak(read_line(sel_start));
}
void field_end()
{
if(text.length()==0)
{
return;
}
sel_start=text.length();
if(!multiline)
speak("Blank");
else
speak(read_line(sel_start));
}
string read_word_from_position(int position)
{
string temp="";
for(int counter=position; counter<text.length(); counter++)
{
if((text[counter]!=" ")&&(text[counter]!="\r"))
{
temp+=text[counter];
}
else
{
break;
}
}
return temp;
}
void highlight_to_field_start()
{
string hl_text="";
if((sel_start<=0)||(sel_start>text.length()))
{
return;
}
for(int counter=sel_start; counter>=0; counter--)
{
if(counter>text.length())
{
break;
}
if(counter==text.length())
{
continue;
}
hl_text+=text[counter];
}
sel_highlight=sel_start;
sel_start=0;
sel_length=sel_start+1;
speak(string_reverse(hl_text)+" "+highlight_selection_speech_text);
}
void highlight_to_field_end()
{
string hl_text="";
if(sel_start==text.length())
{
return;
}
for(int counter=sel_start; counter<text.length(); counter++)
{
hl_text+=text[counter];
}
sel_highlight=sel_start;
sel_start=text.length();
sel_length=sel_start-sel_highlight;
speak(hl_text+" "+highlight_selection_speech_text);
}
void highlight_to_word_start()
{
bool found_end=false;
int counter;
int start=sel_start;
int end;
if(text=="")
{
return;
}
if(sel_start<=0)
{
return;
}
for(counter=sel_start; counter>=0; counter--)
{
if(counter==text.length())
{
continue;
}
if(counter>text.length())
{
break;
}
if((text[counter]!=" ")&&(text[counter]!="\n"))
{
continue;
}
if(text[counter]==" ")
{
if(found_end==false)
{
end=counter-1;
found_end=true;
}
else
{
sel_start=counter+1;
speak(read_word_from_position(sel_start)+" selected");
highlight_by_position(start, end);
break;
}
}
if(text[counter]=="\n")
{
if(found_end==false)
{
end=counter-2;
found_end=true;
}
else
{
sel_start=counter+2;
speak(read_word_from_position(sel_start)+ "selected");
highlight_by_position(start, end);
break;
}
}
}
if((counter==0)||(counter>text.length()))
{
sel_start=0;

speak(read_word_from_position(sel_start)+" selected");
highlight_by_position(start, end);
}
}
void highlight_to_word_end()
{
int counter;
if(text=="")
{
return;
}
if((sel_start<0)||(sel_start>=text.length()))
{
return;
}
for(counter=sel_start; counter<text.length(); counter++)
{
if((text[counter]!=" ")&&(text[counter]!="\r"))
{
continue;
}
if(text[counter]==" ")
{
sel_start=counter+1;
speak(read_word_from_position(sel_start)+" selected");
int end=sel_start;
while(end!=" ")
{
end++;
if(end>text.length())
{
end=text.length()-1;
break;
}
}
highlight_by_position(sel_start, end);
break;
}
if(text[counter]=="\r")
{
sel_start=counter+2;
speak(read_word_from_position(sel_start)+" selected");
int end=sel_start;
while(end!=" ")
{
end++;
if(end>text.length())
{
end=text.length()-1;
break;
}

}
highlight_by_position(sel_start, end);
break;
}
}
if(counter==text.length()-1)
{
sel_start=text.length();
speak("Blank");
}
}
void highlight_to_line_start()
{
if(text.length()>0)
{
int start=sel_start;
string read_text="";
if(sel_start>=text.length())
{
//speak("Blank",true);
sel_start=text.length()-1;
//return;
}
for(int i=sel_start; i>=0; --i)
{
if(i>=text.length())
{
continue;
}
if(i<=0)
{
i=0;
sel_start=i;
speak(input_box_speak(find_appropriate_character(text[sel_start]),true));
break;
}
read_text+=text[i];
sel_start=i;
if(text[sel_start]=="\n")
{
sel_start++;
if(sel_start>text.length())
{
sel_start=text.length();
speak("Blank");
break;
}
else
{
speak(string_reverse(read_text)+" selected");
highlight_by_position(start, sel_start);
break;
}
}
//if(!spoken)
//{
//speak(string_reverse(read_text)+" selected",true);
//highlight_by_position(start, sel_start);
//}
}
}
}
void highlight_to_line_end()
{
if(text.length()>0)
{
int start=sel_start;
string read_text="";
bool spoken=false;
for(int i=sel_start; i<text.length(); i++)
{
read_text+=text[i];
sel_start=i;
if(text[sel_start]=="\n")
{
speak(read_text+" selected");
highlight_by_position(start, sel_start);
spoken=true;
break;
}
}
if(!spoken)
{
speak(read_text+" selected");
highlight_by_position(start, sel_start);
}
}
}
void highlight_up()
{
bool found_end=false;
int counter;
int start;
int end;
int old=sel_start;
if(sel_start<=0)
{
return;
}
for(counter=sel_start-1; counter>=0; counter--)
{
if(counter==text.length())
{
continue;
}
if(counter>text.length())
{
sel_start=0;

speak(read_line(sel_start)+" selected");
highlight_by_position(old, sel_start);
break;
}
if((counter==0)||(counter>text.length()))
{
sel_start=0;

speak(read_line(sel_start)+" selected");
highlight_by_position(old, sel_start);
break;
}
if(text[counter]!="\r")
{
continue;
}
if(text[counter]=="\r")
{
if(!found_end)
{
end=counter-1;
found_end=true;
}
else
{
sel_start=counter+2;

speak(read_line(sel_start)+" selected");
highlight_by_position(sel_start, end);
break;
}
}
}
}
void highlight_down()
{
int old=sel_start;
if(sel_start==text.length())
{
return;
}
for(int counter=sel_start; counter<text.length(); counter++)
{
if(counter<0)
{
continue;
}
if(text[counter]!="\n")
{
continue;
}
sel_start=counter+1;
int end=sel_start;
while(true)
{
end++;
if(end>text.length())
{
end=text.length()-1;
break;
}
if(end=="\r")
{
end--;
break;
}
}
bool temp=false;
//end++;
//if(end>=text.length()) end=text.length()-1;

speak(read_line(sel_start)+" selected");
highlight_by_position(sel_start, end);
break;
}
}
void highlight_by_position(int start, int end)
{
//if(sel_start<sel_highlight) sel_start=sel_highlight;
if(sel_length==0)
{
sel_highlight=sel_start;
}
sel_start=end;
//if(sel_start>sel_highlight) sel_start=sel_highlight;
if(sel_highlight<0) sel_highlight=0;
if(sel_start<0) sel_start=0;
if(sel_highlight>=text.length()) sel_highlight=text.length()-1;
if(sel_start>=text.length()) sel_start=text.length()-1;
if(sel_highlight>sel_start)
{
sel_length=sel_highlight-sel_start;
}
else
{
sel_length=sel_start-sel_highlight;
}
}
string read_line(int position)
{
string temp="";
for(int counter=position; counter<text.length(); counter++)
{
if(text[counter]!="\r")
{
temp+=text[counter];
}
else
{
break;
}
}
if(temp=="")
{
return "Blank";
}
return temp;
}
}
string input(string caption, string default_text="", string password_mask="", int maximum_length=0, bool read_only=false, bool multiline=true)
{
input_handle temp;
temp.caption=caption;
temp.char="";
if((maximum_length>0)&&(default_text.length()>maximum_length))
{
default_text=string_left(default_text, maximum_length);
}
temp.text=default_text;
if(read_only) temp.sel_start=0;
else temp.sel_start=-1;
temp.sel_length=0;
temp.max_length=maximum_length;
temp.password_mask=string_left(password_mask, 1);
temp.read_only=read_only;
temp.multiline=multiline;
temp.char="";
temp.retreev=false;
if(read_only)
{
if(default_text!="")
{
string[] texts=string_split(default_text,"\r\n",false);
speak(caption+" read only edit: "+texts[0]);
}
else speak(caption+" read only edit: Blank");
}
else
{
if(default_text!="") speak(caption+" edit: "+default_text);
else speak(caption+" edit: Blank");
}
bool emptyed=false;
while(true)
{
switch_layout_monitor();
main_loop();
if(emptyed==false)
{
temp.char="";
emptyed=true;
}
if(key_pressed(KEY_ESCAPE))
{
if(!read_only) speak("canceled");
return "";
}
temp.check();
if(key_pressed(KEY_RETURN))
{
if(!read_only)
{
spool.play_stationary("keyreturn.ogg",false);
return temp.text;
}
}
}
return "";
}
