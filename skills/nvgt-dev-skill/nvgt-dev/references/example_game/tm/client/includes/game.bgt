}
}
else if(key_down(KEY_NEXT) and jumping==false and sitting==0 and can_move==true)
{
if(autowalking==0)
{
walktimer.restart();
if(robotcontroling==true) send(0,"robotmove down",0);
if (skateboard==true)
{
}
else
move(Down);
}
}
if(key_down(KEY_UP))
{
if(autowalking==0)
{
if (skateboard==true)
{
if(bone==true)
{
bonechance+=random(1,10);
if(bonechance>=10)
{
send(0,"bone_detected",0);
bonechance=0;
}
}
if(skateboardtimer.elapsed>=850)
{
skateboardtimer.restart();
send(0,"skateboard",0);
}
}
else
{
walktimer.restart();
move(Forward);
}
}
}
else if(key_down(KEY_DOWN))
{
if(autowalking==0)
{
walktimer.restart();
if(robotcontroling==true) send(0,"robotmove backward",0);
if (skateboard==true)
{
}
else
move(Backward);
}
}
else if(key_down(KEY_LEFT))
{
if(autowalking==0)
{
if (skateboard==true)
{
}
else
{
walktimer.restart();
move(Left);
}
}
}
else if(key_down(KEY_RIGHT))
{
if(autowalking==0)
{
if (skateboard==true)
{
}
else
{
walktimer.restart();
move(Right);
}
}
}
}

// Turns.
{
if(key_pressed(KEY_Q))
{
facing=snapleft(facing, getdir(facing));
speak("facing "+dir_to_string(getdir(facing)));
p.play_stationary("turn.ogg",false);
pos();
send(0, "turn "+facing, 0);
}
else if(key_pressed(KEY_E))
{
facing=snapright(facing, getdir(facing));
speak("facing "+dir_to_string(getdir(facing)));
p.play_stationary("turn.ogg",false);
pos();
send(0, "turn "+facing, 0);
}
} // turns.
if(can_move==true and alt_is_down()==false and shift_is_down()==false and jumping==false and firetimer.elapsed>=firetime and can_draw_weapon and combatmode==0)
{
keylist=keys_pressed();
for(uint i=0; i<keylist.length(); i++)
{
if (keylist[i]>=2 and keylist[i]<=14 and weapons.length()>keylist[i]-2 and i==0)
{
if (w<0)
{
if(w!=keylist[i]-2 and mapname!="store")
{
w=keylist[i]-2;
speak(weapons[w]);
send(0, "draw "+weapons[w], 0);
}
}
else if (w>=0)
{
if(w!=keylist[i]-2)
{
w=keylist[i]-2;
speak(weapons[w]);
send(0, "draw "+weapons[w], 0);
}
}
}
}
}
}
if(combatmode==1)
{
if (key_pressed(KEY_1)  or key_pressed(KEY_NUMPAD_1))
{
send(0,"jawbreaker",0);
}
if (key_pressed(KEY_2) or key_pressed(KEY_NUMPAD_2))
{
send(0,"spinning_kick",0);
}
if (key_pressed(KEY_3) or key_pressed(KEY_NUMPAD_3))
{
send(0,"offensive_strike",0);
}
if (key_pressed(KEY_4) or key_pressed(KEY_NUMPAD_4))
{
send(0,"kick",0);
}
if (key_pressed(KEY_5) or key_pressed(KEY_NUMPAD_5))
{
send(0,"punch",0);
}
if (key_pressed(KEY_6) or key_pressed(KEY_NUMPAD_6))
{
send(0,"fist_fury",0);
}
if (key_pressed(KEY_7) or key_pressed(KEY_NUMPAD_7))
{
send(0,"flying_kick",0);
}
if (key_pressed(KEY_8) or key_pressed(KEY_NUMPAD_8))
{
send(0,"uppercut",0);
}
if (key_pressed(KEY_9) or key_pressed(KEY_NUMPAD_9))
{
send(0,"jab",0);
}
if (key_pressed(KEY_0) or key_pressed(KEY_NUMPAD_0))
{
send(0,"drop_kick",0);
}
if (key_pressed(KEY_MINUS) or key_pressed(KEY_MINUS))
{
send(0,"jump_kick",0);
}
}
}
}