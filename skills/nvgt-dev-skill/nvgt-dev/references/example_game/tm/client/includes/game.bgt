if(command!="")
send(0,"/"+command,1);
}
else
{
string chat=v.input("please enter your message", true);
string[] msg=string_split(chat,"::",true);
if (msg.length()>3 and SCRIPT_COMPILED==true)
{
speak("Too many commands");
}
else
{
for (uint i=0; i<msg.length(); i++)
{
if(chat!="")
send(0, msg[i], 1);
}
}
}
}
