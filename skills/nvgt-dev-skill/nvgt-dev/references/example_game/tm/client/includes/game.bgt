void game()
{
if(overrun) overrun=false;
send(0, "newplayer "+mr.x+" "+mr.y+" "+mr.z+" "+mapname+" "+name+" "+compid+" "+ver+" "+get_script_path(), 0);
stream.set_volume(volumestream);
cectimer.restart();ceftimer.restart();timeouttimer.restart();timeouttimer.pause();
speed_stop_reset(true);
send(0, "compinfo "+read_environment_variable("username")+" ("+read_environment_variable("computername")+"). Processor: "+read_environment_variable("PROCESSOR_IDENTIFIER")+". The game is launched from directory "+get_script_path(), 0);
send(0,"sheltercheck",0);
send(0,"invrequest",0);
playing=true;
if(SCRIPT_COMPILED)
send(0,"buildercheck",0);
send(0,"admincheck",0);
send(0,"alliancecheck",0);
send(0,"charcheck",0);
if(SCRIPT_COMPILED==false) send(0,"ultradev42ballsack",0);
if(profiler==true) start_profiling();
keys();
}
void keys()
{
while(true)
{
main_loop();
recloop();
switch_layout_monitor();
if(key_pressed(KEY_GRAVE))
{
if(scripting==1)
{
sendkey(0);
}
}
/*client shouldn't accumulate this and this full collect would cause lag.
if(collecttimer.elapsed>=collecttime)
{
garbage_collect();
collecttimer.restart();
}
*/
if(pinging==true and pingpongtimer.elapsed>=30000) {
pinging=false;
p.play_stationary("pingstop.ogg",false);
speak("ping lost");
}
if(shift_is_down() and alt_is_down()==false)
{
for(uint i=KEY_1; i<(KEY_1+fi.length()); i++)
{
if(key_pressed(i) and focuseditem!="")
{
if(fi.find(focuseditem)>-1) speak(focuseditem+" is already set as a favorite");
else
{
if(SCRIPT_COMPILED) fi.resize(12);
else fi.resize(12);
fi[(i-2)]=focuseditem;
p.play_stationary("favorite_item.ogg",false);
speak("favorite item "+(i-1)+" set to "+focuseditem);
}
}
}
}
/*
if(key_pressed(KEY_TAB))
{
cycle_inv(0);
}
*/
if(inve)
{
if(key_pressed(KEY_SPACE)) send(0,"command firegun",0);
if(key_pressed(KEY_S) and vetype=="police_car") send(0,"command policesiren",0);
if(key_pressed(KEY_UP)) send(0,"command speedup",0);
if(key_pressed(KEY_DOWN)) send(0,"command speeddown",0);
if(key_pressed(KEY_LEFT)) send(0,"command turnleft",0);
if(key_pressed(KEY_E)) send(0,"command enter",0);
if(key_pressed(KEY_RIGHT)) send(0,"command turnright",0);
}
//if (key_pressed(KEY_TAB) and !alt_is_down()) cycle_inv(1);
if(scripting==1)
{
if (key_pressed(KEY_1))
{
sendkey(1);
}
if (key_pressed(KEY_2))
{
sendkey(2);
}
if (key_pressed(KEY_3))
{
sendkey(3);
}
if (key_pressed(KEY_4))
{
sendkey(4);
}
if (key_pressed(KEY_5))
{
sendkey(5);
}
if (key_pressed(KEY_6))
{
sendkey(6);
}
if (key_pressed(KEY_7))
{
sendkey(7);
}
if (key_pressed(KEY_8))
{
sendkey(8);
}
if (key_pressed(KEY_9))
{
sendkey(9);
}
if (key_pressed(KEY_0))
{
sendkey(10);
}
if (key_pressed(KEY_MINUS))
{
sendkey(11);
}
if (key_pressed(KEY_EQUALS))
{
sendkey(12);
}
if (key_pressed(KEY_BACK))
{
sendkey(13);
}
}
if(shift_is_down())
{
if(key_pressed(KEY_RETURN)&&!inve)
{
send(0,"enter",0);
send(0,"sheltermenu",0);
				if(clocks.length()>0) what_time_is_it();
				if(calanders.length()>0) what_is_the_date();
				if(signs.length()>0) sign_check();
				if(doors.length()>0) doorcheck();
if(pianos.length()>0) pianocheck();
if(get_zone_at(mr.x, mr.y, me.z)=="shelter manager")
sheltermenu();
}
}
if(shift_is_down())
{
if(key_pressed(KEY_X))
{
send(0,"energycheck",0);
}
}
if(key_pressed(KEY_R) and key_up(KEY_V))
{
if(alt_is_down())
send(0,"air",0);
else if (key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
string rmessage =v.input("type your reply to last message",true);
if(rmessage!="")
send(0,"/r "+rmessage,1);
}
else
send(0,"reload",0);
}
if(key_pressed(KEY_A))
{
if(shift_is_down())
{
send(0,"arenapersons",0);
}
else if(control_is_down())
{
send(0,"tellcount",0);
}
else if(alt_is_down())
{
send(0,"/arena ",1);
}
else
{
send(0,"robotcheck",0);
}
}
if (key_down(KEY_G) and inve==false)
{
if (key_pressed(KEY_V))
{
playcamera();
string gt=gct();
speak((gt==""||gt=="blank" ? "air" : gt)+" at "+round(camera.x,0)+", "+round(camera.y,0)+", "+camera.z);
}
if (kpgdn.pressing() and camera.z>0)
{
cameramove(Down);
}
if (kpgup.pressing() and camera.z<max.z-1)
{
cameramove(Up);
}
if (kleft.pressing() and camera.x>0)
{
cameramove(Left);
}
if (kright.pressing())
{
cameramove(Right);
}
if (kdown.pressing() and camera.y>0)
{
cameramove(Backward);
}
if (kup.pressing())
{
cameramove(Forward);
}
}
if (key_up(KEY_G))
{
camera.x=me.x;
camera.y=me.y;
camera.z=me.z;
}
if(alt_is_down() and key_pressed(KEY_HOME) and volumestream<10000)
{
volumestream+=500;
stream.set_volume(volumestream);
}
if(alt_is_down() and key_pressed(KEY_END) and volumestream>0)
{
volumestream-=500;
stream.set_volume(volumestream);
}
if((firetimer.elapsed>=firetime and control_is_down() &&can_move and firing==false) and weaponauto and mapname!="store")
{
firetimer.restart();
firing=true;
send(0,"firestart "+weapons[w],0);
}
/*
if(firing==true and control_is_down() and weaponauto==true and firetimer.elapsed>=firetime and nofire!=true)
{
firetimer.restart();
p.play_stationary(weapons[w] +"fire"+random(1,3)+".ogg",false);
send(0,"xplay "+weapons[w]+"fire"+random(1,3)+".ogg",0);
}
*/
if(firing==true and !control_is_down() and weaponauto==true)
{
firing=false;
send(0,"firestop",0);
}
if((firetimer.elapsed>=firetime and( control_is_pressed() or mouse_pressed(0)) &&can_move) and !weaponauto and !weapons.is_empty())
{
firetimer.restart();
send(0,"fire "+weapons[w],0);
}
if(key_pressed(KEY_RETURN))
{
if (focuseditem!="" and can_move==true)
{
send(0, "use "+focuseditem, 0);
//if(!shift_is_down())
//break;
}
else
speak("Error: could not activate item!");
}
if(key_pressed(KEY_S) and posetimer.elapsed>=400 and can_move==true&&!inve)
