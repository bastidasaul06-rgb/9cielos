class virtualizer
{
int capmode=1;
string[] ms={""};;
int cursor=0;
string input(string text, bool connected=true, bool secure_input=false)
{
string message;
speak(text);
cursor=0;
get_characters();
while(true)
{
wait(5);
switch_layout_monitor();
if(speed_stop_is_hacking(200)==true)
killbitch();
if(connected==true)
{
if(!following&&!frozen&&!inve)
{
fallloop();
fallcheck();
fallingloop();
}
msoundcheckloop();
healthloop();
netloop();
vanishing_loop();
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
}
check_for_empties();
string char=get_characters();
if(key_pressed(KEY_TAB)) speak(text);
if(shift_is_down() and key_pressed(KEY_BACK)) { 
speak("cleared");
if(styping==1) spool.play_stationary_extended("keydelete.ogg", false, 0, random(-30, 30), 0, 100);
else spool.play_stationary("keydelete.ogg", false);
ms.resize(0);
cursor=0;
}
if (key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL))
{
if (key_pressed(KEY_V))
{
speak("text pasted");
string cl=clipboard_read_text();
for (uint i=0; i<cl.length(); i++)
{
ms.insert_at(cursor,cl[i]);
cursor+=1;
}
}
if (key_pressed(KEY_C) and secure_input==false)
{
string a;
for (uint i=0; i<ms.length(); i++)
{
a+=ms[i];
}
speak("text copied");
clipboard_copy_text(a);
}
if(key_pressed(KEY_LEFT))
{
prevword();
}
if(key_pressed(KEY_RIGHT))
{
nextword();
}
}
if (key_pressed(KEY_F3)) {
if (capmode==0) {
capmode=1;
speak("Say cap");
p.play_stationary("wpingon.ogg",false);
}
else {
capmode=0;
speak("No capitals.");
p.play_stationary("wpingoff.ogg",false);
}
}
if (key_pressed(KEY_F2))
{
if (charrepeat==1)
{
p.play_stationary("wpingoff.ogg",false);
speak("character repeat off");
charrepeat=0;
}
else
{
p.play_stationary("wpingon.ogg",false);
speak("character repeat on");
charrepeat=1;
}
}
if (key_pressed(KEY_F4))
{
if (styping==1)
{
p.play_stationary("wpingoff.ogg",false);
speak("stereo typing has been disabled");
styping=0;
}
else
{
p.play_stationary("wpingon.ogg",false);
speak("stereo typing has been enabled");
styping=1;
}
}
if(char!="")
{
if (charrepeat==1 and char!=" ")
{
string spoken_feedback;
if (string_is_upper_case(char)) {
if (capmode==1)
spoken_feedback+="Cap "+char;
else
spoken_feedback+=char;
}
else
spoken_feedback=char;
if(secure_input==true)
{
p.play_stationary("secure_input.ogg",false);
speak("*");
}
else
speak(spoken_feedback);
}
if(char.length()>1)
{
string to_write=char;
char=get_characters();
for(int i=0; i<to_write.length(); i++)
{
cursor++;
ms.resize(ms.length()+to_write.length());
ms.insert_at(cursor, to_write[i]);
if(styping==1) spool.play_stationary_extended("key"+random(1, 3)+".ogg", false, 0, random(-30, 30), 0, 100);
else spool.play_stationary("key"+random(1, 3)+".ogg", false);
}
to_write="";
check_for_empties();
}
else if(char.length()==1)
{
ms.insert_at(cursor,char);
cursor+=1;
if(styping==1) spool.play_stationary_extended("key"+random(1, 3)+".ogg", false, 0, random(-30, 30), 0, 100);
else spool.play_stationary("key"+random(1, 3)+".ogg", false);
}
}
if(key_pressed(KEY_BACK) and ms.length() > 0 and cursor>=1)
{
string char=ms[cursor-1];
if (char==" ")
speak("space");
else {
if (string_is_upper_case(char)) {
if (capmode==1)
speak("Cap "+char);
else
speak(char);
}
else
speak(char);
}
ms.remove_at(cursor-1);
cursor-=1;
if(styping==1) spool.play_stationary_extended("keydelete.ogg", false, 0, random(-30, 30), 0, 100);
else spool.play_stationary("keydelete.ogg", false);
}
if(key_pressed(KEY_DELETE) and ms.length() > 0 and cursor>0 and cursor<ms.length())
{
string char=ms[cursor+1];
if (char==" ")
speak("space");
else {
if (string_is_upper_case(char)) {
if (capmode==1)
speak("Cap "+char);
else
speak(char);
}
else
speak(char);
}
ms.remove_at(cursor+1);
if(styping==1) spool.play_stationary_extended("keydelete.ogg", false, 0, random(-30, 30), 0, 100);
else spool.play_stationary("keydelete.ogg", false);
}
if(key_pressed(KEY_DOWN) or key_pressed(KEY_UP))
{
string a;
for (uint i=0; i<ms.length(); i++)
{
a+=ms[i];
}
speak(a);
}
if(key_pressed(KEY_LEFT) and cursor>0)
{
if(ms.length()>0)
{
cursor-=1;
if (cursor>=ms.length())
{
speak("Blank");
}
else if (ms[cursor]==" ")
speak("space");
else
{
if (string_is_upper_case(ms[cursor])) {
if (capmode==1)
speak("Cap "+ms[cursor]);
else
speak(ms[cursor]);
}
else
speak(ms[cursor]);
}
}
else
speak("blank");
}
if(key_pressed(KEY_RIGHT) and cursor<ms.length())
{
if(ms.length() > 0)
{
cursor+=1;
if (cursor>=ms.length())
speak("Blank");
else if (ms[cursor]==" ")
speak("space");
else
{
if (string_is_upper_case(ms[cursor])) {
if (capmode==1)
speak("Cap "+ms[cursor]);
else
speak(ms[cursor]);
}
else
speak(ms[cursor]);
}
}
else
speak("blank");
}
if(key_pressed(KEY_HOME))
{
if(ms.length() > 0)
{
cursor=0;
if (cursor>=ms.length())
speak("Blank");
else if (ms[cursor]==" ")
speak("space");
else
{
if (string_is_upper_case(ms[cursor])) {
if (capmode==1)
speak("Cap "+ms[cursor]);
else
speak(ms[cursor]);
}
else
speak(ms[cursor]);
}
}
else
speak("blank");
}
if(key_pressed(KEY_END))
{
if(ms.length() > 0)
{
cursor=ms.length()-1;
if (cursor>=ms.length())
speak("Blank");
else if (ms[cursor]==" ")
speak("space");
else
{
if (string_is_upper_case(ms[cursor])) {
if (capmode==1)
speak("Cap "+ms[cursor]);
else
speak(ms[cursor]);
}
else
speak(ms[cursor]);
}
}
else
speak("blank");
}
if(key_pressed(KEY_ESCAPE))
{
speak("Cancel.");
reset();
return "";
}
else if(key_pressed(KEY_RETURN))
{
if (ms.length() > 0)
{
spool.play_stationary_extended("keyreturn.ogg", false, 0, 0, 0, 100);
for (uint i=0; i<ms.length(); i++)
{
if(string_is_upper_case(ms[i]))
{
message+=string_to_upper_case(ms[i]);
continue;
}
else
{
message+=ms[i];
}
}
keys_pressed();
reset();
return message;
}
else if (ms.length()==0)
{
speak("Cancel.");
keys_pressed();
return "";
}
ms.resize(0);
cursor=0;
}
}
return "";
}
void prevword()
{
bool found_end=false;
int counter;
int start;
int end;
if(ms.length()==0)
{
return;
}
if(cursor<=0)
{
return;
}
for(counter=cursor; counter>=0; counter--)
{
if(counter==ms.length())
{
continue;
}
if(counter>ms.length())
{
break;
}
if((ms[counter]!=" ")&&(ms[counter]!="\n"))
{
continue;
}
if(ms[counter]==" ")
{
if(found_end==false)
{
end=counter-1;
found_end=true;
}
else
{
cursor=counter+1;
speak(speak_word(cursor));
break;
}
}
if(ms[counter]=="\n")
{
if(found_end==false)
{
end=counter-2;
found_end=true;
}
else
{
cursor=counter+2;
speak(speak_word(cursor));
break;
}
}
}
if((counter<=0)||(counter>ms.length()))
{
cursor=0;
speak(speak_word(cursor));
}
}
string speak_word(int p)
{
string word;
for(uint i=p; i<ms.length(); i++)
{
if(ms[i]!=" ") word+=ms[i];
else break;
}
return word;
}
void nextword()
{
int counter;
if(ms.length()==0)
{
return;
}
if((cursor<0)||(cursor>=ms.length()))
{
return;
}
for(counter=cursor; counter<ms.length(); counter++)
{
if((ms[counter]!=" ")&&(ms[counter]!="\r"))
{
continue;
}
if(ms[counter]==" ")
{
cursor=counter+1;
speak(speak_word(cursor));
break;
}
if(ms[counter]=="\r")
{
cursor=counter+2;
speak(speak_word(cursor));
break;
}
}
if(counter==ms.length()-1)
{
cursor=ms.length();
speak("Blank");
}
}
void check_for_empties()
{
if(ms.length()>0)
{
for(int i=0; i<ms.length(); i++)
{
if(ms[i]=="")
{
ms.remove_at(i);
}
else
{
continue;
}
}
}
else
{
return;
}
}
void reset()
{
ms.resize(0);
cursor=0;
}
}
