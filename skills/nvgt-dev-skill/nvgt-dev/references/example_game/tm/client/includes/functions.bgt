bool open_sound_device(int8 dev = -1) { return true; }
bool keys_up() { return true; }

string number_to_hex_string(int64 val) { return "" + val; }
string[] list_sound_devices() { string[] s; return s; }
void force_key_down(int k) {}

void exitgame(bool return_to_menu=true)
{
stream.stop(streamurl);
		if(signs.length()<0) kill_all_signs();
		if(vanishing_platforms.length()>0) destroy_v();
		if(cppoints.length()>0) fuck_cppoints();
		if(clocks.length()<0) kill_all_clocks();
		if(clocks.length()>0) kill_all_clocks();
		if(calanders.length()>0) kill_all_calanders();
falling=false;
me.x=0;me.z=0;
vesound.stop();
velfsound.stop();
music.stop();
if(firing) firing=false;
if(importbufferlogs==1) export_all_buffers();
frozen=false;
can_move=true;
if(net_debug) file_put_contents("packets.log",packetlog,255);
fade_all(p,distpool,shdistpool,mpool,sourcepool,cmusicpool);
destroy_all_msounds();
destroy_all_sirens();
p.destroy_all();
distpool.destroy_all();
destroy_all_cmusics();
destroy_all_sources();
x=false;
in_map=false;
focuseditem="";
reset_network();
		garbage_collect();
if(profiler) generate_profile("profile.log");
if(return_to_menu==true)
mainmenu();
players.resize(0);
}
void fallloop()
{
if(jumptimer.elapsed > jumptime and jumping==true)
{
jumptimer.restart();
if(jumpup==1)
{
if(kangaroo==true and me.z <=jumplandz+10)
{
me.z++;
send(0, "move_to "+me.x+" "+me.y+" "+me.z, 0);
if((get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="land") and me.z==jumplandz+11)
{
jumpup=0;
jumplandz=me.z;
}
}
else if(me.z <=jumplandz+5)
{
me.z++;
send(0, "move_to "+me.x+" "+me.y+" "+me.z, 0);
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank")
{
jumpup=0;
jumplandz=me.z;
}
}
else
{
jumpup=0;
}
}
else if(jumpup==0)
{
if(me.z > jumplandz)
{
me.z--;
send(0, "move_to "+me.x+" "+me.y+" "+me.z, 0);
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank")
{
if(skateboard==true)
{
p.play_stationary("skateboardjump.ogg", false);
send(0, "land", 0);
jumping=false;
}
else
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send(0, "land", 0);
jumping=false;
}
}
else
{
if(get_tile_at(mr.x, mr.y, me.z)=="" or get_tile_at(mr.x, mr.y, me.z)=="blank" and in_plane==false)
{
falling=true;
falldistance=0;
falltimer.restart();
jumping=false;
return;
}
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send(0, "land", 0);
jumping=false;
}
}
}
}
void fallcheck()
{
if(in_plane==false and get_tile_at(mr.x, mr.y, me.z)=="" and falling==false and playing==true and jumping==false and playing==true or get_tile_at(mr.x, mr.y, me.z)=="blank" and falling==false and jumping==false and playing==true and in_plane==false or get_tile_at(mr.x, mr.y, me.z)=="air" and falling==false and jumping==false and playing==true and in_plane==false)
{
falling=true;
falldistance=0;
falltimer.restart();
p.play_stationary("fall"+random(1,6)+".ogg",false);
send(0, "fallstart", 0);
send(0,"fall",0);
}
}
void fallingloop()
{
if(falling==true and falltimer.elapsed > falltime and in_plane==false)
{
if(get_tile_at(mr.x, mr.y, me.z)!="" and get_tile_at(mr.x, mr.y, me.z)!="blank" and get_tile_at(mr.x, mr.y, me.z)!="air" or me.z==0)
{
falling=false;
if(falldistance < 15)
{
send(0,"fallstop",0);
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"land.ogg", false);
send(0, "land", 0);
falling=false;
}
else
{
send(0,"fallstop",0);
p.play_stationary(get_tile_at(mr.x, mr.y, me.z)+"fall"+random(1, 3)+".ogg", false);
send(0, "hardland "+falldistance, 0);
falling=false;
}
return;
}
falltimer.restart();
falldistance++;
me.z--;
if(me.z<0)
{
me.z=1;
falling=false;
}
send(0, "move_to "+me.x+" "+me.y+" "+me.z, 0);
}
}
void main_loop()
{
wait(5);
netloop();
doorcheckloop();
playerloop();
if(lowhealth) healthloop();
checkloc();
msoundcheckloop();
			if(vanishing_platforms.length()>0 and in_map) vanishing_loop();
			if(cppoints.length()>0 and in_map) checkpointloop();
			if(signs.length()>0 and in_map) sloop();
sirencheckloop();
cmusiccheckloop();
sourcecheckloop();
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
sourcepool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
cmusicpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
mpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
distpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
mr.x=round(me.x,0);
mr.y=round(me.y,0);
if(speed_stop_is_hacking(200)==true)
// killbitch();
if(ereboot==true and reboottimer.elapsed>=1000)
{
if(!SCRIPT_COMPILED)
{
file f;
f.open(DIRECTORY_TEMP+"/tmr.dat","wb");
f.write("this file is used for uncompiled scripts to also be able to reboot and reconnect upon server flashes");
f.close();
run("c:\\windows\\explorer.exe","\""+get_script_path()+"\"",false,false);
}
else
run(get_script_path(),"-u",false,false);
exit();
}
if(trackx!=-1 and tracky!=-1 and trackz!=-1 and tracking!="")
{
if(trackingtimer.elapsed>700)
{
trackingtimer.restart();
p.play_3d("loctrack.ogg", me.x, me.y, me.z, trackx, tracky, trackz, calculate_theta(facing), false);
}
if(mr.x==trackx and mr.y==tracky and me.z==trackz)
{
p.play_stationary("loctracked.ogg",false);
trackx=-1; tracky=-1; trackz=-1; tracking="";
}
}
if (jumping==true)
{
movetime=airtime;
}
else
{
movetime=walktime;
}
if(in_map&&!following&&!frozen&&playing&&!inve)
{
fallloop();
fallcheck();
fallingloop();
}
}
bool is_sound_number(string t)
{
t=string_replace(t, ".", "", true);
t=string_replace(t, "-", "", true);
if(string_is_digits(t))
return true;
return false;
}
double stn(string n)
{
return string_to_number(n);
}
void killbitch()
{
// Speedhack check completely muted
}
void sendkey(int number)
{
string[] keys;
file f;
f.open(skp,"rb");
keys=string_split(f.read(),"\r\n",false);
f.close();
if ((keys.length()-1)>=number)
{
string[] stuff=string_split(keys[number],"::",true);
for(uint i=0; i<stuff.length(); i++)
{
send(1,stuff[i],1);
}
}
else
{
speak("Script key not assigned.");
}
}
