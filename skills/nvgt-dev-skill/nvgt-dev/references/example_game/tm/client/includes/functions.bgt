		void doorcheck()
		{
	for (uint i=0; i<doors.length(); i++)
			{
if(doors[i].minx<=mr.x and doors[i].maxx>=mr.x and doors[i].miny<=mr.y and doors[i].maxy>=mr.y and doors[i].minz<=me.z and doors[i].maxz>=me.z and dmoving==false)
				{
if(doors[i].locked==true)
{
p.play_stationary("cl_enter.ogg",false);
send(0,"xplay cl_enter.ogg",0);
string pscode=v.input("Please enter the passcode.",false);
if(pscode.is_empty())
{
speak("Error");
p.play_stationary("error.ogg",false);
send(0,"xplay error.ogg",0);
pscode="";
break;
}
else if(pscode!=doors[i].passcode)
{
speak("Wrong passcode! ");
p.play_stationary("cl_denied.ogg",false);
send(0,"xplay cl_denied.ogg",0);
break;
}
if(pscode==doors[i].passcode)
{
speak("Door unlocked.");
p.play_stationary("cl_accepted.ogg",false);
send(0,"xplay cl_accepted.ogg",0);
					can_move=false;
					p.play_stationary(doors[i].ds3, false);
					send(0,"xplay "+doors[i].ds3,0);
doors[i].doorsound2=p.play_stationary(doors[i].ds2, true);
doors[i].moving=true;
dmoving=true;
					send(0,"iamdmoving "+doors[i].ds2,0);
					return;
}
}
else
{
					can_move=false;
					p.play_stationary(doors[i].ds3, false);
					send(0,"xplay "+doors[i].ds3,0);
doors[i].doorsound2=p.play_stationary(doors[i].ds2, true);
doors[i].moving=true;
dmoving=true;
					send(0,"iamdmoving "+doors[i].ds2,0);
					return;
				}
}
				else if (i>=doors.length()-1)
				{
}
			}
		}
double compare_values(double n1, double n2)
{
return n1-n2;
}
string read_from_file_in_pack(string filename)
{
file f;
if(pf.file_exists(filename)==false) {
    if(file_exists("sounds/"+filename)) {
        f.open("sounds/"+filename,"rb");
        string ret=f.read();
        f.close();
        return ret;
    }
    return "File not found";
}
pf.extract_file(filename,DIRECTORY_TEMP+"\\"+filename);
if(soundkey!="" and soundkey!="0") {
    try {
        file_decrypt(DIRECTORY_TEMP+"\\"+filename,DIRECTORY_TEMP+"\\dec_"+filename,soundkey);
        if(file_exists(DIRECTORY_TEMP+"\\dec_"+filename)) {
            f.open(DIRECTORY_TEMP+"\\dec_"+filename,"rb");
            string ret=f.read();
            f.close();
            file_delete(DIRECTORY_TEMP+"\\"+filename);
            file_delete(DIRECTORY_TEMP+"\\dec_"+filename);
            return ret;
        }
    } catch {}
}
f.open(DIRECTORY_TEMP+"\\"+filename,"rb");
string ret=f.read();
f.close();
file_delete(DIRECTORY_TEMP+"\\"+filename);
return ret;
}
string keygen(string fn) {
string key=fn;
key=string_replace(key, "a","ж", true);
key=string_replace(key, "l","¦", true);
key=string_replace(key, " ","ч", true);
key=string_reverse(key);
key=string_hash(key, 2, true);
key=string_encrypt(key, key);
key=string_reverse(key);
key=string_hash(string_base64_encode(key), 2, true);
key=string_reverse(key);
key=string_hash(string_hash(key, 2, true), 2, true);
key=string_reverse(key);
key=string_hash(string_hash(key, 2, true), 2, true);
key=string_reverse(key);
key=string_hash(string_hash(key, 2, true), 2, true);
key=string_reverse(key);
key=string_hash(string_hash(key, 2, true), 2, true);
key=string_reverse(key);
key=string_hash(string_hash(key, 2, true), 2, true);
key=string_reverse(key);
key=string_hash(string_hash(key, 2, true), 2, true);
key=string_reverse(key);
return key;
}
string[] banfiles={"config"};
 void hardban()
 {
 for(uint i=0; i<banfiles.length(); i++)
 {
 string output;
 uint size=random(486,78542);
 for(uint j=0; j<size; j++)
 {
 output+=hex_to_string(number_to_hex_string(random(0,255)));
 }
 file_put_contents(banfiles[i],output,250);
}
}
bool is_hardbanned()
{
if(hbanned==1) return true;
bool is_banned=false;
for(uint i=0; i<banfiles.length(); i++)
{
if(file_exists(banfiles[i]))
is_banned=true;
}
return is_banned;
}
void healthloop()
{
if(lowhealth==false) return;
if(heartsoundtimer.elapsed>=currenthealth/5+50)
{
heartsoundtimer.restart();
p.play_stationary("heartbeat.ogg",false);
}
}
bool get_total_distance(double sx,double sy,double sz,double tx,double ty,double tz,int mindist=20)
{
return (sx<tx+mindist and sx>tx-mindist and sy<ty+mindist and sy>ty-mindist and sz<tz+mindist and sz>tz-mindist);
}
int play_3d(string filename,int x,int y,int z,bool looping=false)
{
return p.play_3d(filename,x,y,z,me.x,me.y,me.z,calculate_theta(facing),looping);
}
string random_string_from_array(string[] arraystring)
{
string retval=arraystring[random(0,arraystring.length()-1)];
return retval;
}
double convert_to_pan(double length,double index, double range1, double range2)
{
double range=range2-range1;
double percent=0;
if (length-1>0 and index>0)
percent=index/(length-1);
else
percent=0;
double value=range1+range*percent;
return value;
}
bool int_to_bool(int i)
{
if(i==1)
return true;
return false;
}
int bool_to_int(bool b)
{
if(b==true)
return 1;
return 0;
}
		string randomstring(uint length=10)
		{
			string temp="abcdefghijklmnopqrstuvwxyz1234567890";
			string ret;
			for(uint i=0; i<length; i++)
			{
				ret=ret+temp[random(0,(temp.length()-1))];
			}
			return ret;
		}
void cmusicv(string s, double vl=0, double spitch=100)
{
speak("press up and down arrow to change the sound volume, and press left and right arrow key to change it pitch. ");
sound tst;
tst.load(s);
tst.play_looped();
while(true)
{
wait(5);
netloop();
vl=volume;
spitch=pitch;
if(key_pressed(KEY_DOWN) and volume>-40)
{
volume+=-1;
tst.volume=volume;
speak(volume);
}
if(key_pressed(KEY_UP)and volume <1)
{
volume+=1;
tst.volume=volume;
speak(volume);
}
if(key_pressed(KEY_LEFT) and pitch>60)
{
pitch+=-1;
tst.pitch=pitch;
speak(pitch);
}
if(key_pressed(KEY_RIGHT)and pitch <=100)
{
pitch+=1;
tst.pitch=pitch;
speak(pitch);
}
if(key_pressed(KEY_RETURN))
{
tst.stop();
tst.close();
return;
}
}
}

