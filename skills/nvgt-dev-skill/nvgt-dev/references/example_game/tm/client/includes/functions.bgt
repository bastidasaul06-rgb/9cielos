void reboot()
{
speak("The game is now restarting, please wait.");
wait(1500);
run("tm.exe","",false,false);
exit();
}
string get_from_url(string url)
{
http httpn;
httpn.user_agent="TMGame/"+ver;
string what=httpn.get(url);
while(httpn.progress > 0)
{
what+=httpn.request();
wait(5);
} return what;
}
void recloop()
{
if(key_down(KEY_V) and !recding and recspamtimer.elapsed>5000 and key_up(KEY_G))
{
recding=true;
p.play_stationary("von.ogg",false);
rec.record();
rectimer.restart();
}
if((key_up(KEY_V) or rectimer.elapsed>30000) and recding)
{
recding=false;
rec.stop(true,DIRECTORY_TEMP+"\\convert.ogg");
p.play_stationary("voff.ogg",false);
file f;
f.open(DIRECTORY_TEMP+"/convert.ogg","rb");
string vc=f.read();
f.close();
send(0,"voice_chat "+vc,9);
recspamtimer.restart();
}
}
void switch_layout() {
if(!user32.active)
user32.load("user32.dll");
if(window_handle==0) {
@result = user32.call("int GetActiveWindow();");
result.get("0", window_handle);
}
user32.call("int SendMessageA(int, int, int, int);", window_handle, 0x50, 0x02, 0);
}
void switch_layout_monitor() {
if((key_down(KEY_LMENU) or key_down(KEY_RMENU)) and (key_pressed(KEY_LSHIFT) or key_pressed(KEY_RSHIFT)))
switch_layout();
}
void help(string data)
{
string []parameters=string_split(data, "\r\n", true);
if(data=="")
parameters.resize(0);
string []storage=parameters;
while(true) {
wait(5);
netloop();
main_loop();
int counter=0;
speak("Press the up and down arrows to read the topic. To close, press escape.");
while(true) {
wait(5);
netloop();
main_loop();
if(key_pressed(KEY_UP)) {
if(!check_parameters(parameters.length()))
continue;
if(counter>0)
counter--;
speak(parameters[counter]);
}
if(key_pressed(KEY_DOWN)) {
if(!check_parameters(parameters.length()))
continue;
if(counter<parameters.length()-1)
counter++;
speak(parameters[counter]);
}
if(key_pressed(KEY_HOME)) {
if(!check_parameters(parameters.length()))
continue;
counter=0;
speak(parameters[counter]);
}
if(key_pressed(KEY_END)) {
if(!check_parameters(parameters.length()))
continue;
counter=parameters.length()-1;
speak(parameters[counter]);
}
if(key_pressed(KEY_ESCAPE))
{
break;
}
}
break;
}
}
void setupaccount()
{
string uname;
string upassw;
form.create_window("Setup account", false);
int username=form.create_input_box("&Enter a username edit", "", "", 0, false, false);
int pass=form.create_input_box("&Enter a password edit protected", "", "*", 0, false, false);
int ok=form.create_button("&OK");
int cancel=form.create_button("&Cancel");
form.focus(0);
while(true)
{
form.monitor();
switch_layout_monitor();
wait(5);
uname=form.get_text(username);
upassw=form.get_text(pass);
if(form.is_pressed(ok))
{
if(uname=="")
{
form.reset();
dlg("username field cannot be empty");
}
else if (upassw=="")
{
form.reset();
dlg("Password field should not be blank.");
}
else
{
name=uname;
password=upassw;
dlg("Success!");
writeprefs();
form.reset();
optionsmenu();
}
}
if(form.is_pressed(cancel) or key_pressed(KEY_ESCAPE))
{
form.reset();
optionsmenu();
}
}
}
void planeloop()
{
send(0, "i_am_in_plane", 0);
send(0, "plane_turn "+facing, 0);
in_plane=true;
plane.load("duoplaneinside.ogg");
plane.play_looped();
while(true)
{
main_loop();
netloop();
}
}
