void alliancemenu()
{
m.reset(true);
m.edge_sound="menuedge.ogg";
m.click_sound="menumove.ogg";
m.open_sound="menuopen.ogg";
m.enter_sound="menuenter.ogg";
m.repeat_items_at_edges=false;
m.enable_multi_letter_navigation=true;
m.allow_escape=true;
m.wrap=false;
m.enable_home_and_end=true;
m.enable_up_and_down=true;
m.set_callback(netclb,"");
m.add_item_tts("all alliances","all");
m.add_item_tts("create a new alliance","create");
m.add_item_tts("Join a alliance","join");
m.add_item_tts("who in your alliance?","who");
m.add_item_tts("leave the alliance","exit");
m.add_item_tts("remove player from the alliance","remove");
m.add_item_tts("Change the alliance password","pass");
m.add_item_tts("delete your alliance","delete");
int mres=m.run("alliance menu",true);
if (m.get_item_name(mres)=="all")
{
send(0,"/alliances",1);
}
if (m.get_item_name(mres)=="create")
{
send(0,"/alliancecreate",1);
}
else if (m.get_item_name(mres)=="join")
{
string jmessage =input("Type the name of the alliance you want to join, then type the password for the alliance.", "", "", 0, false, false);
if(jmessage!="")
send(0,"/joinalliance "+jmessage,1);
}
else if (m.get_item_name(mres)=="remove")
{
string jmessage =input("Type the name of the player you want to remove from the alliance, note, that you must be the leader of the  alliance.", "", "", 0, false, false);
if(jmessage!="")
send(0,"/allianceremove "+jmessage,1);
}
else if (m.get_item_name(mres)=="who")
{
send(0,"/members",1);
}
else if (m.get_item_name(mres)=="pass")
{
string jmessage =input("Type the new password.", "", "", 0, false, false);
if(jmessage!="")
send(0,"/alliancepass "+jmessage,1);
}
else if (m.get_item_name(mres)=="exit")
{
int e;
e=yesno("Are you sure you want to leave the alliance?");
if(e==1)
{
send(0,"/allianceleave",1);
}
}
else if (m.get_item_name(mres)=="delete")
{
int e;
e=yesno("Are you sure you want to leave and delete the alliance?");
if(e==1)
{
send(0,"/alliancecancel",1);
}
if (m.get_item_name(mres)=="tleave")
{
int e;
e=yesno("Are you sure you want to leave the alliance?");
if(e==1)
{
send(0,"/allianceleave",1);
}
}
else if (m.get_item_name(mres)=="le2ave")
{
int e;
e=yesno("Are you sure you want to leave the alliance?");
if(e==1)
send(0,"/allianceleave",1);
}
}
}
