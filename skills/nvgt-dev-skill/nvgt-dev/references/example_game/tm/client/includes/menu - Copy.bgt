m.add_item_tts("aura_blast, a huge, deadly beam of enerjy, killing all the players on the map. note, it will not damage your alliance members. This enchantment requires 1200 aura.","aura_blast");
int mres=m.run("what spell do you want to cast?",true);
if(m.get_item_name(mres)=="aura_blast")
