#include"mapdata.bgt"
dynamic_menu_pro m;
void sheltermenu()
{
m.reset(true);
m.edge_sound="menuedge.ogg";
m.click_sound="menuclick.ogg";
m.open_sound="menuopen.ogg";
m.enter_sound="menuenter.ogg";
m.speak_letter=true;
m.letters_autoactivate=true;
m.repeat_items_at_edges=false;
m.enable_multi_letter_navigation=true;
m.allow_escape=true;
m.wrap=false;
m.enable_home_and_end=true;
m.enable_up_and_down=true;
m.enable_left_and_right=true;
m.add_item_tts("allow player to enter your shelter","allow");
m.add_item_tts("remove player from your shelter","remove");
m.add_item_tts("remove all players from this shelter","removeall");
m.add_item_tts("point your shelter to your alliance","point");
m.add_item_tts("un point the shelter from your alliance","unpoint");
m.add_item_tts("allowed players","players");
int mres=m.run("shelter menu",true);
if (m.get_item_name(mres)=="point")
{
send(0,"/shalliance set",1);
}
else if (m.get_item_name(mres)=="allow")
{
string jmessage =input("type the player name you want to allow to enter this shelter.", "", "", 0, false, false);
if(jmessage!="")
send(0,"/shadd "+jmessage,1);
}
else if (m.get_item_name(mres)=="remove")
{
string jmessage =input("Type the name of the player you want to remove from the shelter.", "", "", 0, false, false);
if(jmessage!="")
send(0,"/shremove "+jmessage,1);
}
else if (m.get_item_name(mres)=="unpoint")
{
send(0,"/shalliance remove",1);
}
else if (m.get_item_name(mres)=="players")
{
send(0,"/shallowed",1);
}
else if (m.get_item_name(mres)=="removeall")
{
int e;
e=yesno("Are you sure you want to remove all allowed players?");
if(e==1)
{
send(0,"/shremoveall",1);
}
}
}
void settingsmenu()
{
form.create_window("Game settings", false);
int pc=form.create_button("&change your password");
int lc=form.create_button("&select language Channel");
int st=form.create_button("&status manager");
int nm=form.create_button("&Notifications menu");
int b=form.create_button("&turn beacons on or off",false);
int p=form.create_button("&pacifist mode");
int nn=form.create_button("&change your nickname");
int cancel=form.create_button("&Cancel");
while(true)
{
main_loop();
form.monitor();
switch_layout_monitor();
wait(5);
if(form.is_pressed(pc))
{
form.reset();
string oldpass =input("type your old password to continue.", "", "*", 0, false, false);
string newpass =input("type your new password to continue.", "", "*", 0, false, false);
string conpass =input("type your new password again for confirmation ", "", "*", 0, false, false);
if(oldpass!="")
if(newpass!="")
if(conpass!="")
send(0,"/changepass "+oldpass+" "+newpass+" "+conpass,1);
break;
}
if(form.is_pressed(lc))
{
form.reset();
send(0,"lchannel",0);
break;
}
if(form.is_pressed(st))
{
form.reset();
statusmenu();
break;
}
if(form.is_pressed(nm))
{
form.reset();
alertmenu();
break;
}
if(form.is_pressed(nn))
{
form.reset();
string cmessage =input("type your new nick name", "", "", 0, false, false);
if(cmessage!="")
send(0,"/nickname "+cmessage,1);
break;
}
if(form.is_pressed(b))
{
form.reset();
send(0,"/beacon",1);
break;
}
if(form.is_pressed(p))
{
form.reset();
send(0,"/sf",1);
break;
}
if(form.is_pressed(cancel) or key_pressed(KEY_ESCAPE))
{
form.reset();
speak("canceled");
break;
}
}
}
void statusmenu()
{
form.create_window("Status manager", false);
int setst=form.create_button("&add a new status message");
int seest=form.create_button("&see another player's status message");
int clearst=form.create_button("&clear your status message");
int cancel=form.create_button("&Cancel");
while(true)
{
main_loop();
form.monitor();
switch_layout_monitor();
wait(5);
if(form.is_pressed(setst))
{
form.reset();
string cmessage =input("Please enter your new status message here. Your status message must contain a maximum of 500 characters.", "", "", 0, false, true);
if(cmessage!="")
send(0,"/setstatus "+cmessage,1);
break;
}
if(form.is_pressed(seest))
{
form.reset();
string cmessage =input("Please enter the name of the player whose status message you want to see.", "", "", 0, false, false);
if(cmessage!="")
send(0,"/viewstatus "+cmessage,1);
break;
}
if(form.is_pressed(clearst))
{
form.reset();
int e;
e=yesno("Are you sure you want to clear your status message?");
if(e==1)
{
send(0,"/setstatus",1);
}
break;
}
if(form.is_pressed(cancel) or key_pressed(KEY_ESCAPE))
{
form.reset();
speak("canceled");
break;
}
}
}
void alertmenu()
{
form.create_window("notifycations", false);
int messages=form.create_checkbox("&Chat messages",false);
if(readmessages==1)
form.set_checkbox_mark(messages,true);
int online=form.create_checkbox("&Online and offline messages",false);
if(speakonlinemsgs==1)
form.set_checkbox_mark(online,true);
int death=form.create_checkbox("&Death messages",false);
if(killmsgs==1)
form.set_checkbox_mark(death,true);
int level=form.create_checkbox("&Level alerts",false);
if(levelup==1)
form.set_checkbox_mark(level,true);
int ok=form.create_button("&OK");
int cancel=form.create_button("&Cancel");
while(true)
{
form.monitor();
wait(5);
main_loop();
switch_layout_monitor();
if(form.is_pressed(ok))
{
if(form.is_checked(messages)) readmessages=1;
else readmessages=0;
if(form.is_checked(online)) speakonlinemsgs=1;
else speakonlinemsgs=0;
if(form.is_checked(death)) killmsgs=1;
else killmsgs=0;
if(form.is_checked(level)) levelup=1;
else levelup=0;
writeprefs();
form.reset();
break;
}
if(form.is_pressed(cancel) or key_pressed(KEY_ESCAPE))
{
form.reset();
speak("canceled");
break;
}
}
}
void mainmenu()
{
setupmenu(true,true);
if(name!="" and password!="")
{
m.add_item_tts("login as "+name+".","play");
}
m.add_item_tts("new account","cn");
m.add_item_tts("game settings","optionsmenu");
m.add_item_tts("test speakers", "speakertest");
m.add_item_tts("Check for updates","cfu");
m.add_item_tts("restart the game","reboot");
int runsn=stn(runs);
int cruns=runsn-lastruns;
lastruns=stn(runs);
m.add_item_tts("Exit","exit");
int mres=m.run("Main Menu",true);
m.fade_music(10);
{
}
if (m.get_item_name(mres)=="play")
{
if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT))
{
if(!SCRIPT_COMPILED)
{
bool wanna_change=true;
if(netaddress!=oldaddress and wanna_change)
{
netaddress=oldaddress;
p.play_stationary("notify_voicecommand.ogg", false);
speak("changed back to default address...");
wanna_change=false;
}
else if(netaddress==oldaddress and wanna_change)
{
netaddress="localhost";
p.play_stationary("notify_voicecommand.ogg", false);
speak("changed to localhost...");
wanna_change=false;
}
}
}
if(netaddress=="")
{
dlg("No server configured");
mainmenu();
}
login();
}
else if(m.get_item_name(mres)=="cn")
{
create();
}
else
{
writeprefs();
wait(20);
}
if(m.get_item_name(mres)=="speakertest")
{
dlgplay("speakertest"+random(1,3)+".ogg",true,5, true);
mainmenu();
}
else if(m.get_item_name(mres)=="cfu")
{
cfu("tm","tm.zip",false);
mainmenu();
}
if(m.get_item_name(mres)=="reboot")
{
if(!SCRIPT_COMPILED)
{
rebootmaster();
}
else
{
reboot();
}
}
else if(m.get_item_name(mres)=="optionsmenu")
{
optionsmenu();
}
else
{
  m.fade_music(10);
writeprefs();
wait(20);
exit();
}
}
void setupmenu(bool main=false, bool audo=false)
{
m.reset(true);
if (main==true)
m.add_music(musictrack);
m.open_sound="menuopen.ogg";
m.enter_sound="menuenter.ogg";
m.click_sound="menumove.ogg";
m.wrap_sound="menuwrap.ogg";
m.edge_sound="menuedge.ogg";
if(sidescrolling==1)
{
m.enable_side_scrolling=true;
}
if(wrap==1)
{
m.wrap=true;
}
m.enable_multi_letter_navigation=true;
if(sidescrolling==1)
m.enable_left_and_right=true;
else
{
m.enable_up_and_down=true;
m.enable_side_scrolling=false;
}
if(wrap==1)
m.wrap=true;
else
{
m.wrap=false;
}
m.enable_home_and_end=true;
if(!main)
m.set_callback(netclb,"");
}
void optionsmenu()
{
form.create_window("settings", false);
int a=form.create_button("&setup account");
int logo=form.create_checkbox("&Logo on startup",false);
if(play_logo==1)
form.set_checkbox_mark(logo,true);
int logs=form.create_checkbox("&Buffer logging",false);
if(importbufferlogs==1)
form.set_checkbox_mark(logs,true);
int beep=form.create_checkbox("&Buffer beeping",false);
if(bufferbeep==1)
form.set_checkbox_mark(beep,true);
int up=form.create_checkbox("&Playing of uploaded sounds",false);
if(uploadedsounds==1)
form.set_checkbox_mark(up,true);
int sc=form.create_checkbox("&Menu side scrolling",false);
if(sidescrolling==1)
form.set_checkbox_mark(sc,true);
int w=form.create_checkbox("&Menu wrapping",false);
if(wrap==1)
form.set_checkbox_mark(w,true);
int rc=form.create_checkbox("&Right control detection",false);
if(rcontrol==1)
form.set_checkbox_mark(rc,true);
int d=form.create_button("&Select output device");
int s=form.create_button("Select speech mode");
int sv,sr;
if(speechmode==1)
{
sv=form.create_button("&Select SAPI voice");
sr=form.create_button("&Select speech rate");
}
int ok=form.create_button("&OK");
int cancel=form.create_button("&Cancel");
while(true)
{
form.monitor();
switch_layout_monitor();
wait(5);
if(form.is_pressed(ok))
{
if(form.is_checked(logo)) play_logo=1;
else play_logo=0;
if(form.is_checked(logs)) importbufferlogs=1;
else importbufferlogs=0;
if(form.is_checked(beep)) bufferbeep=1;
else bufferbeep=0;
if(form.is_checked(up)) uploadedsounds=1;
else uploadedsounds=0;
if(form.is_checked(sc)) sidescrolling=1;
else sidescrolling=0;
if(form.is_checked(w)) wrap=1;
else wrap=0;
if(form.is_checked(rc)) rcontrol=1;
else rcontrol=0;
writeprefs();
form.reset();
mainmenu();
}
if(form.is_pressed(a))
{
form.reset();
setupaccount();
}
if(form.is_pressed(d))
{
form.reset();
soundcardmenu();
}
if(form.is_pressed(s))
{
form.reset();
speechmodemenu();
}
if(form.is_pressed(sv))
{
form.reset();
speak("Please select a voice is_using the up and down keys, and press enter to select");
ttsvoice=df_s.select_voice();
writeprefs();
df_s.set_voice(ttsvoice);
optionsmenu();
}
if(form.is_pressed(sr))
{
form.reset();
speechratemenu();
}
if(form.is_pressed(cancel) or key_pressed(KEY_ESCAPE))
{
form.reset();
speak("Canceled");
mainmenu();
}
}
}
void speechratemenu()
{
setupmenu(false);
for(int i=-10; i<10; i+=1)
{
m.add_item_tts(""+i,""+i);
}
m.add_item_tts("back","back");
int mres=m.run("Select the speech rate you would like to use for sapi",true);
if(m.get_item_name(mres)=="back" or mres==0)
{
optionsmenu();
}
else
{
int nr=stn(m.get_item_name(mres));
df_s.rate=nr;
df_s.set_speech_params(df_s.rate,df_s.pitch,df_s.volume);
speak("set");
writeprefs();
optionsmenu();
}
}
void speechmodemenu()
{
setupmenu();
m.add_item_tts("audo","a");
m.add_item_tts("SAPI","s");
int mres=m.run("Speech mode menu",true);
if(m.get_item_name(mres)=="a")
{
speechmode=0;
writeprefs();
df_s.mode=speechmode;
optionsmenu();
}
else if(m.get_item_name(mres)=="s")
{
speechmode=1;
writeprefs();
df_s.mode=speechmode;
optionsmenu();
}
else
optionsmenu();
}
int yesno(string question)
{
setupmenu(false,true);
m.add_item_tts("Yes","yes");
m.add_item_tts("no","no");
int mres=m.run(question,true);
if (m.get_item_name(mres)=="yes")
return 1;
else
return 2;
}
int netclb(dynamic_menu_pro@ m, string data)
{
if(n.connected_peers>0) main_loop();
return 0;
}
//online menus
void serverside_menu(string sndtxt, string menu, string menuitems)
{
m.reset(true);
m.click_sound="menumove.ogg";
m.enter_sound="menuenter.ogg";
m.enable_multi_letter_navigation=true;
m.wrap=true;
m.enable_up_and_down=true;
m.set_callback(netclb,"");
if(menuitems=="")
return;
string[] items=string_split(menuitems,"[]",false);
for(uint i=0; i<items.length(); i++)
{
string[] parsed=string_split(items[i],":",false);
m.add_item_tts(parsed[0],parsed[1]);
}
int mres=m.run(menu,true);
if(m.get_item_name(mres)=="back" or mres==0)
send(0,sndtxt+" back",0);
else
{
send(0,sndtxt+" "+m.get_item_name(mres),0);
}
}
void store_menu(string storeitems)
{
m.reset(true);
m.enter_sound="store_menuenter.ogg";
m.click_sound="store_move.ogg";
m.edge_sound="menuedge.ogg";
m.enable_multi_letter_navigation=true;
m.enable_up_and_down=true;
m.wrap=false;
m.enable_home_and_end=true;
m.set_callback(netclb,"");
string[] items=string_split(storeitems,"\r\n",true);
for (uint i=0; i<items.length(); i++)
{
string[] item=string_split(items[i]," ",true);
string it=string_replace(item[0],".","",true);
m.add_item_tts(items[i],it);
}
int mres=m.run("store menu. There are "+items.length()+" items.",true);
if (mres!=0)
{
string amount=input("Amount of "+m.get_item_name(mres)+"?", "", "", 0, false, false);
send(0,"purchase "+m.get_item_name(mres)+" "+amount,0);
}
}
