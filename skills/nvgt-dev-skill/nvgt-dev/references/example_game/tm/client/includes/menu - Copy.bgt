void statistics(string [] statistic)
{
get_characters();
string cl;
speak("statistics menu");
int counter=0;
while(true)
{
if(speed_stop_is_hacking(200)==true)
killbitch();
cl=get_characters();
wait(5);
main_loop();
netloop();
if(counter > statistic.length())
{
counter=statistic.length()-1;
}
if(cl!="" and cl.length()==1)
{
int f=0;
int oc=counter;
for(uint i=counter; i<statistic.length(); i++)
{
if(i==counter)
{
continue;
}
if(statistic[i][0]==cl)
{
counter=i;
speak(statistic[counter]);
cl="";
f=1;
break;
}
}
if(f==0)
{
counter=0;
for(uint i=counter; i<statistic.length(); i++)
{
if(statistic[i][0]==cl)
{
counter=i;
speak(statistic[counter]);
cl="";
f=1;
break;
}
}
}
if(f==0)
{
speak("No such item exists");
}
}
if(key_pressed(KEY_UP))
{
if(statistic.length()==1)
{
speak(statistic[0]);
counter=0;
}
else if(counter > 0)
{
counter--;
speak(statistic[counter]);
}
}
if(key_pressed(KEY_DOWN))
{
if(statistic.length()==1)
{
speak(statistic[0]);
counter=0;
}
else if(counter < statistic.length()-1)
{
counter++;
speak(statistic[counter]);
}
}
if(key_pressed(KEY_RETURN) or key_pressed(KEY_NUMPADENTER) and statistic[counter]!="" and counter <= statistic.length()-1)
{
if(statistic[counter]==" cancel")
{
speak("canceled");
return;
}
}
if(key_pressed(KEY_ESCAPE))
{
speak("canceled");
return;
}
}
return;
}
void playermenu(string[] users)
{
get_characters();
string cl;
speak("players menu");
int counter=0;
while(true)
{
if(speed_stop_is_hacking(200)==true)
killbitch();
cl=get_characters();
wait(5);
main_loop();
netloop();
if(counter > users.length())
{
counter=users.length()-1;
}
if(cl!="" and cl.length()==1)
{
int f=0;
int oc=counter;
for(uint i=counter; i<users.length(); i++)
{
if(i==counter)
{
continue;
}
if(users[i][0]==cl)
{
counter=i;
speak(users[counter]);
cl="";
f=1;
break;
}
}
if(f==0)
{
counter=0;
for(uint i=counter; i<users.length(); i++)
{
if(users[i][0]==cl)
{
counter=i;
speak(users[counter]);
cl="";
f=1;
break;
}
}
}
if(f==0)
{
speak("No such player exists");
}
}
if(key_pressed(KEY_UP))
{
if(users.length()==1)
{
speak(users[0]);
counter=0;
}
else if(counter > 0)
{
counter--;
speak(users[counter]);
}
}
if(key_pressed(KEY_DOWN))
{
if(users.length()==1)
{
speak(users[0]);
counter=0;
}
else if(counter < users.length()-1)
{
counter++;
speak(users[counter]);
}
}
if(alt_is_down())
{
if(key_pressed(KEY_M))
{
send(0, "/mute "+users[counter], 1);
}
}
if(alt_is_down())
{
if(key_pressed(KEY_U))
{
send(0, "/unmute "+users[counter], 1);
}
}
if(control_is_down())
{
if(key_pressed(KEY_T))
{
send(0, "/trust "+users[counter], 1);
}
}
if(control_is_down())
{
if(key_pressed(KEY_U))
{
send(0, "/untrust "+users[counter], 1);
}
}
if(control_is_down())
{
if(key_pressed(KEY_L))
{
send(0, "/look "+users[counter], 1);
}
}
if(key_pressed(KEY_F1) and users[counter]!="" and counter <= users.length()-1)
{
send(0, "/where "+users[counter], 1);
}
if(key_pressed(KEY_F2) and users[counter]!="" and counter <= users.length()-1)
{
send(0, "/pinfo "+users[counter], 1);
}
if(key_pressed(KEY_F3) and users[counter]!="" and counter <= users.length()-1)
{
send(0, "/kills "+users[counter], 1);
}
if(key_pressed(KEY_F4) and users[counter]!="" and counter <= users.length()-1)
{
send(0, "/lang "+users[counter], 1);
}
if(key_pressed(KEY_RETURN) or key_pressed(KEY_NUMPADENTER) and users[counter]!="" and counter <= users.length()-1)
{
if(users[counter]==" cancel")
{
speak("canceled");
return;
}
string message=input("enter the message that you want to send to "+users[counter], "", "", 0, false, true);
if(message!="") send(0, "/pm "+users[counter]+" "+message, 1);
return;
}
if(key_pressed(KEY_C) and control_is_down() and users[counter]!="" and counter <= users.length()-1)
{
speak(users[counter]+" copyed to clipboard");
clipboard_copy_text(users[counter]);
return;
}
if(key_pressed(KEY_ESCAPE))
{
speak("canceled");
return;
}
}
return;
}
void pmapmenu(string[] users)
{
get_characters();
string cl;
speak("tracking menu");
int counter=0;
while(true)
{
if(speed_stop_is_hacking(200)==true)
killbitch();
cl=get_characters();
wait(5);
main_loop();
netloop();
if(counter > users.length())
{
counter=users.length()-1;
}
if(cl!="" and cl.length()==1)
{
int f=0;
int oc=counter;
for(uint i=counter; i<users.length(); i++)
{
if(i==counter)
{
continue;
}
if(users[i][0]==cl)
{
counter=i;
speak(users[counter]);
cl="";
f=1;
break;
}
}
if(f==0)
{
counter=0;
for(uint i=counter; i<users.length(); i++)
{
if(users[i][0]==cl)
{
counter=i;
speak(users[counter]);
cl="";
f=1;
break;
}
}
}
if(f==0)
{
speak("No such player exists");
}
}
if(key_pressed(KEY_UP))
{
if(users.length()==1)
{
speak(users[0]);
counter=0;
}
else if(counter > 0)
{
counter--;
speak(users[counter]);
}
}
if(key_pressed(KEY_DOWN))
{
if(users.length()==1)
{
speak(users[0]);
counter=0;
}
else if(counter < users.length()-1)
{
counter++;
speak(users[counter]);
}
}
if(key_pressed(KEY_RETURN) and counter <= users.length()-1 and users[counter]!="")
{
p.play_stationary("trackingnew.ogg",false);
speak("tracking "+users[counter]);
tracking=users[counter];
return;
}
if(key_pressed(KEY_ESCAPE))
{
speak("canceled");
return;
}
}
return;
}
