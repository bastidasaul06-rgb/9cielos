void destroy_v()
{
for(uint i=0; i<vanishing_platforms.length(); i++)
{
for(uint i2=0; i2<maps.length(); i2++)
{
if(maps[i2].id==vanishing_platforms[i].id and !maps[i2].id.is_empty())
{
@maps[i2]=null;
maps.remove_at(i2);
return;
}
}
p.destroy_sound(vanishing_platforms[i].vsound);
}
vanishing_platforms.resize(0);
}