source@[] sources(0);
int source_volume;
int source_pitch;
class source
{
	int source_sound;
	int lx;
	int rx;
	int miny;
	int maxy;
	int minz;
	int maxz;
	int volume;
int pitch;
	string soundfile;
	bool paused=false;
	int id=-1;
	bool p2;
	string vetype;
	source(int source_lx, int source_rx, int source_miny, int source_maxy, int source_minz, int source_maxz, string file, int vol, int spitch , bool source_paused=false, int source_id=-1)
	{
pitch=spitch;
if(pitch<=60)
pitch=60;
		volume=vol;
		if (volume<=-30)
		volume=-30;
		lx=source_lx;
		rx = source_rx;
		miny=source_miny;
		maxy= source_maxy;
		minz=source_minz;
		maxz=source_maxz;
		soundfile=file;
		 source_sound=p.play_3d(soundfile, me.x, me.y, me.z, lx, miny, minz, facing, true);
		id=source_id;
		p.update_sound_3d(source_sound, lx, miny, minz);
		p.update_sound_start_values(source_sound,0,source_volume+volume,source_pitch+pitch);
		paused=source_paused;
		if(paused)
		{
			p.pause_sound(source_sound);
		}
		p2=paused;
		p.update_sound_range_3d(source_sound, 0, rx-lx, 0, maxy-miny, 0, maxz-minz);
	}
}
class amb
{
	double minx,maxx,miny,maxy,minz,maxz;
	sound loop;
	int volume=0;
int pitch=100;
	bool inrange=false,force_paused=false;
	amb(double c1, double c2, double c3, double c4, double c5, double c6, string so, int vo, int p)
	{
		minx=c1; maxx=c2; miny=c3; maxy=c4; minz=c5; maxz=c6; loop.stream(so); volume=vo; pitch=p;
	}
	bool is_in_range()
	{
		return (minx<=mr.x&&maxx>=mr.x&&miny<=mr.y&&maxy>=mr.y&&minz<=me.z&&maxz>=me.z);
	}
	void check()
	{
		if(force_paused or !in_map) return;
		if(volume==0)
		{
			loop.volume=source_volume;
			
		}
		if(volume<=-1)
		{
			loop.volume=volume;
			
		}
		if(pitch==100)
		{
			loop.pitch=source_pitch;
			
		}
		if(pitch<=60)
		{
			loop.pitch=pitch;
			
		}
		bool r=is_in_range();
		if(r==true&&inrange==false)
		{
			inrange=true;
			if(in_map)  loop.play_looped();
			
		}
		else if(r==false&&inrange==true)
		{
			inrange=false;
			loop.pause();
		}
	}
	~amb()
	{

		if(loop.playing)
		loop.stop();
		loop.close();

	}
}
amb@[] ambs;

void sourcecheckloop()
{
	for (uint i=0; i<sources.length(); i++)
	{
		if(sources[i].paused!=sources[i].p2)
		{
			if(sources[i].paused==true and sources[i].p2==false)
			{
				p.pause_sound(sources[i].source_sound);
				sources[i].p2=true;
			}
			else if(sources[i].paused==false and sources[i].p2==true)
			{
				p.resume_sound(sources[i].source_sound);
				sources[i].p2=false;
			}
		}
	}
}
void ambiencescheckloop()
{
	for(uint i=0; i<ambs.length(); i++)
	{
		if(in_map) ambs[i].check();
	}
}

void destroy_all_sources()
{
	for(uint i=0; i<sources.length(); i++)
	{
		p.destroy_sound(sources[i].source_sound);
	}
	sources.resize(0);
}
void destroy_all_ambiences()
{
	ambs.resize(0);
}

void pause_all_sources()
{
	for(uint i=0; i<sources.length(); i++)
	{
		sources[i].paused=true;
	}
	for(uint i=0; i<ambs.length(); i++)
	{
		ambs[i].force_paused=true;
		if(ambs[i].loop.playing) ambs[i].loop.pause();
	}
}
void resume_all_sources()
{
	for(uint i=0; i<sources.length(); i++)
	{
		sources[i].paused=false;
	}
	for(uint i=0; i<ambs.length(); i++)
	{
		ambs[i].force_paused=false;
		ambs[i].check();
	}
}
void spawn_source(int source_lx, int source_rx, int source_miny, int source_maxy, int source_minz, int source_maxz, string soundfile, int volume=0, int pitch=100, bool paused=false, int id=-1)
{
	source source1(source_lx, source_rx, source_miny, source_maxy, source_minz, source_maxz, soundfile, volume, pitch, paused, id);
	sources.insert_last(source1);
}
void destroy_source(int id)
{
	for(uint i=0; i<sources.length(); i++)
	{
		if(sources[i].id==id and id > -1)
		{
			p.destroy_sound(sources[i].source_sound);
			sources.remove_at(i);
		}
	}
}
void create_amb(int minx, int maxx, int miny, int maxy, int minz, int maxz, string sound, int v, int p)
{
	amb amb1(minx,maxx,miny,maxy,minz,maxz,sound, v,p);
	ambs.insert_last(amb1);
}
void change_source_volume(int volume)
{
	source_volume=volume;
	for (uint i=0; i<sources.length(); i++)
p.update_sound_start_values(sources[i].source_sound,0,source_volume+sources[i].volume,100);
}
void change_source_volume_and_pitch(int volume, int pitch)
{
	source_volume=volume;
source_pitch=pitch;
	for (uint i=0; i<sources.length(); i++)
	p.update_sound_start_values(sources[i].source_sound,0,source_volume+sources[i].volume,source_pitch+sources[i].pitch);
}
vanishing_platform@[]vanishing_platforms(0);
class vanishing_platform
{
double minx,maxx,miny,maxy,minz,maxz;
string type;
string id=randomstring();
timer vanishingtimer;
bool vanished=false;
int vanishingtime;
string vanishing_sound;
int vsound;
vanishing_platform( double vminx, double vmaxx, double vminy, double vmaxy, double vminz, double vmaxz, string vtype, string soundfile, int vanishtime)
{
minx=vminx;
maxx=vmaxx;
miny=vminy;
maxy=vmaxy;
minz=vminz;
maxz=vmaxz;
type=vtype;
vanishingtime=vanishtime;
vanishing_sound=soundfile;
spawn_platform(minx,maxx,miny,maxy,minz,maxz,type,id);
vsound=p.play_3d(vanishing_sound, me.x, me.y, me.z, maxx, miny, minz, facing, true);
p.update_sound_3d(vsound, minx, miny, minz);
		p.update_sound_range_3d(vsound, 0, maxx-minx, 0, maxy-miny, 0, maxz-minz);
}
}
void vanishing_loop()
{
for(uint i=0; i<vanishing_platforms.length(); i++)
{
if(vanishing_platforms[i].vanishingtimer.elapsed>=vanishing_platforms[i].vanishingtime and !vanishing_platforms[i].vanished)
{
vanishing_platforms[i].vanishingtimer.restart();
for(uint i2=0; i2<maps.length(); i2++)
{
if(maps[i2].id==vanishing_platforms[i].id and !maps[i2].id.is_empty())
{
@maps[i2]=null;
maps.remove_at(i2);
p.destroy_sound(vanishing_platforms[i].vsound);
continue;
}
}
vanishing_platforms[i].vanished=true;
}
if(vanishing_platforms[i].vanishingtimer.elapsed>=vanishing_platforms[i].vanishingtime and vanishing_platforms[i].vanished)
{
vanishing_platforms[i].vanishingtimer.restart();
spawn_platform(vanishing_platforms[i].minx,vanishing_platforms[i].maxx,vanishing_platforms[i].miny,vanishing_platforms[i].maxy,vanishing_platforms[i].minz,vanishing_platforms[i].maxz,vanishing_platforms[i].type,vanishing_platforms[i].id);
vanishing_platforms[i].vanished=false;
vanishing_platforms[i].vsound=p.play_3d(vanishing_platforms[i].vanishing_sound, me.x, me.y, me.z, vanishing_platforms[i].maxx, vanishing_platforms[i].miny, vanishing_platforms[i].minz, facing, true);
p.update_sound_3d(vanishing_platforms[i].vsound, vanishing_platforms[i].minx, vanishing_platforms[i].miny, vanishing_platforms[i].minz);
		p.update_sound_range_3d(vanishing_platforms[i].vsound, 0, vanishing_platforms[i].maxx-vanishing_platforms[i].minx, 0, vanishing_platforms[i].maxy-vanishing_platforms[i].miny, 0, vanishing_platforms[i].maxz-vanishing_platforms[i].minz);
}
}
}
void spawn_vanishing_platform(double minx, double maxx, double miny, double maxy, double minz, double maxz, string type, string soundfile, int vanishtime)
{
vanishing_platform vanishing_platform1(minx,maxx,miny,maxy,minz,maxz,type,soundfile,vanishtime);
vanishing_platforms.insert_last(vanishing_platform1);
}
