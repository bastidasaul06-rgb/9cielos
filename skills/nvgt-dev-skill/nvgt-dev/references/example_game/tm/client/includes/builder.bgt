door@[] doors(0);
class door
{
	string ds, ds2, ds3, ds4;
	int doorsound, doorsound2;
int minx,maxx,miny,maxy,minz,maxz;
bool locked;
string passcode;
	int fx;
	int fy;
	int fz;
	int movetime=200;
	bool moving;
	bool aimoving;
	timer movetimer;
door(int dminx, int dmaxx, int dminy, int dmaxy, int dminz, int dmaxz, int doorfx, int doorfy, int doorfz,int speed, string doorsnd, string doorsnd2, string doorsnd3, string doorsnd4,bool lc=false,string pscode="")
	{
		ds=doorsnd;
		ds2=doorsnd2;
		ds3=doorsnd3;
		ds4=doorsnd4;
minx=dminx;maxx=dmaxx;miny=dminy;maxy=dmaxy;minz=dminz;maxz=dmaxz;
		fx=doorfx;
		fy=doorfy;
		fz=doorfz;
		movetime=speed;
		doorsound=p.play_3d(ds, me.x, me.y, me.z,minx,miny,minz,calculate_theta(facing),true);
locked=lc;
if(locked) passcode=pscode;
	}
}
void doorcheckloop()
{
	for (uint i=0; i<doors.length(); i++)
	{
		p.update_sound_3d(doors[i].doorsound, doors[i].minx, doors[i].miny,doors[i].minz);
		p.update_sound_range_3d(doors[i].doorsound, 0, doors[i].maxx-doors[i].minx, 0, doors[i].maxy-doors[i].miny, 0, doors[i].maxz-doors[i].minz);
		if (doors[i].moving==true and doors[i].movetimer.elapsed>=doors[i].movetime)
		{
			doors[i].movetimer.restart();
			if(doors[i].movetime==-1)
			{
				me.x=doors[i].fx;
				me.y=doors[i].fy;
				me.z=doors[i].fz;
			}
			if (me.x>doors[i].fx)
			{
				me.x-=1;
			}
			else if (me.x<doors[i].fx)
			{
				me.x+=1;
			}
			if (me.y>doors[i].fy)
			{
				me.y-=1;
			}
			else if (me.y<doors[i].fy)
			{
				me.y+=1;
			}
			if (me.z>doors[i].fz)
			{
				me.z-=1;
			}
			else if (me.z<doors[i].fz)
			{
				me.z+=1;
			}
		}
		if (doors[i].fx==me.x and doors[i].fy==me.y and doors[i].fz==me.z and doors[i].moving==true)
		{
			if (doors[i].ds2!="none.ogg")
			{
				p.destroy_sound(doors[i].doorsound2);
			}
			send(0,"xplay "+doors[i].ds4,0);
			p.play_3d(doors[i].ds4, me.x, me.y, me.z, doors[i].fx, doors[i].fy, doors[i].fz, calculate_theta(facing),false);
			can_move=true;
dmoving=false;
			doors[i].moving=false;
			send(0,"iamnotdmoving",0);
			send(0,"move_to "+me.x+" "+me.y+" "+me.z,0);
		}
	}
}
void destroy_door(int d)
{
	p.destroy_sound(doors[d].doorsound);
	doors.remove_at(d);
}
void destroy_all_doors()
{
	for(uint i=0; i<doors.length(); i++)
	{
		p.destroy_sound(doors[i].doorsound);
	}
	doors.resize(0);
}
void spawn_door(int minx, int maxx, int miny, int maxy, int minz, int maxz, int fx, int fy, int fz, int speed, string doorsnd, string doorsnd2, string doorsnd3, string doorsnd4,bool locked=false,string passcode="")
{
door door1(minx,maxx,miny,maxy,minz,maxz,fx, fy, fz, speed, doorsnd, doorsnd2, doorsnd3, doorsnd4,locked,passcode);
	doors.insert_last(door1);
}
