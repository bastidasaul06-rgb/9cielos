checkpoint@[]cppoints(0);
class checkpoint {
	int x, y, z;
int cp_sound;
	int cpsound=-1;

	checkpoint(int init_x, int init_y, int init_z) {
		x=init_x;
		y=init_y;
		z=init_z;
		cpsound=		p.play_3d("cpget.ogg", me.x, me.y, me.z,x, y, z, calculate_theta(facing), false);
cp_sound=p.play_3d("cp.ogg", me.x, me.y, me.z,init_x, init_y, init_z, calculate_theta(facing), true);
	}
}

void checkpoint_new(int x, int y,  int z)
{
		checkpoint cp1(x, y, z);
		cppoints.insert_last(cp1);
	}
int checkpoint_at(int x, int y, int z)
{
	for(uint i=0; i<cppoints.length(); i++)
	{
		if(cppoints[i].x==x and cppoints[i].y==y and cppoints[i].z==z)
		{
			return i;
		}
	}
	return -1;
}
void checkpointloop()
{
	for(uint i=0; i<cppoints.length(); i++)
	{
		p.update_sound_3d(cppoints[i].cp_sound, cppoints[i].x, cppoints[i].y,cppoints[i].z);
if(me.x==cppoints[i].x and me.y==cppoints[i].y and me.z==cppoints[i].z)
	{
		p.play_3d("cpget.ogg", me.x, me.y, me.z, cppoints[i].x, cppoints[i].y, cppoints[i].z, calculate_theta(facing), false);
		p.play_3d("notice.ogg", me.x, me.y, me.z, cppoints[i].x, cppoints[i].y, cppoints[i].z, calculate_theta(facing), false);
		cpx=cppoints[i].x;
		cpy=cppoints[i].y;
		cpz=cppoints[i].z;
		send(0,"cpdata "+cppoints[i].x+" "+cppoints[i].y+" "+cppoints[i].z+" "+mapname,0);
		if(all_devs_are_stupid.elapsed>=50)
		{
			all_devs_are_stupid.restart();
cppoints[i].cpsound=-1;
		p.destroy_sound(cppoints[i].cp_sound);
					@cppoints[i]=null;
					cppoints.remove_at(i);
			}
		}
	}
}
void fuck_cppoints()
{
	for(uint i=0; i<cppoints.length(); i++)
	{
		p.destroy_sound(cppoints[i].cp_sound);
	}
	cppoints.resize(0);
}
