cmusic@[] cmusics(0);
int cmusic_volume;
int cmusic_pitch;
class cmusic
{
	int cmusic_sound;
	int lx;
	int rx;
	int miny;
	int maxy;
	int minz;
	int maxz;
	int volume;
int pitch;
	string soundfile;
	bool paused=false;
	int id=-1;
	bool p2;
	string vetype;
	cmusic(int cmusic_lx, int cmusic_rx, int cmusic_miny, int cmusic_maxy, int cmusic_minz, int cmusic_maxz, string file, int vol, int spitch , bool cmusic_paused=false, int cmusic_id=-1)
	{
pitch=spitch;
if(pitch<=60)
pitch=60;
		volume=vol;
		if (volume<=-30)
		volume=-30;
		lx=cmusic_lx;
		rx = cmusic_rx;
		miny=cmusic_miny;
		maxy= cmusic_maxy;
		minz=cmusic_minz;
		maxz=cmusic_maxz;
		soundfile=file;
		 cmusic_sound=p.play_3d(soundfile, me.x, me.y, me.z, lx, miny, minz, facing, true);
		id=cmusic_id;
		p.update_sound_3d(cmusic_sound, lx, miny, minz);
		p.update_sound_start_values(cmusic_sound,0,cmusic_volume+volume,cmusic_pitch+pitch);
		paused=cmusic_paused;
		if(paused)
		{
			p.pause_sound(cmusic_sound);
		}
		p2=paused;
		p.update_sound_range_3d(cmusic_sound, 0, rx-lx, 0, maxy-miny, 0, maxz-minz);
	}
}
void cmusiccheckloop()
{
	for (uint i=0; i<cmusics.length(); i++)
	{
		if(cmusics[i].paused!=cmusics[i].p2)
		{
			if(cmusics[i].paused==true and cmusics[i].p2==false)
			{
				p.pause_sound(cmusics[i].cmusic_sound);
				cmusics[i].p2=true;
			}
			else if(cmusics[i].paused==false and cmusics[i].p2==true)
			{
				p.resume_sound(cmusics[i].cmusic_sound);
				cmusics[i].p2=false;
			}
		}
	}
}
void destroy_all_cmusics()
{
	for(uint i=0; i<cmusics.length(); i++)
	{
		p.destroy_sound(cmusics[i].cmusic_sound);
	}
	cmusics.resize(0);
}
void pause_all_cmusics()
{
	for(uint i=0; i<cmusics.length(); i++)
	{
		cmusics[i].paused=true;
	}
}
void resume_all_cmusics()
{
	for(uint i=0; i<cmusics.length(); i++)
	{
		cmusics[i].paused=false;
	}
}
void spawn_cmusic(int cmusic_lx, int cmusic_rx, int cmusic_miny, int cmusic_maxy, int cmusic_minz, int cmusic_maxz, string soundfile, int volume=0, int pitch=100, bool paused=false, int id=-1)
{
	cmusic cmusic1(cmusic_lx, cmusic_rx, cmusic_miny, cmusic_maxy, cmusic_minz, cmusic_maxz, soundfile, volume, pitch, paused, id);
	cmusics.insert_last(cmusic1);
}
void destroy_cmusic(int id)
{
	for(uint i=0; i<cmusics.length(); i++)
	{
		if(cmusics[i].id==id and id > -1)
		{
			p.destroy_sound(cmusics[i].cmusic_sound);
			cmusics.remove_at(i);
		}
	}
}
void change_cmusic_volume(int volume)
{
	cmusic_volume=volume;
	for (uint i=0; i<cmusics.length(); i++)
	p.update_sound_start_values(cmusics[i].cmusic_sound,0,cmusic_volume+cmusics[i].volume,100);
}
void change_cmusic_volume_and_pitch(int volume, int pitch)
{
	cmusic_volume=volume;
cmusic_pitch=pitch;
	for (uint i=0; i<cmusics.length(); i++)
	p.update_sound_start_values(cmusics[i].cmusic_sound,0,cmusic_volume+cmusics[i].volume,cmusic_pitch+cmusics[i].pitch);
}
