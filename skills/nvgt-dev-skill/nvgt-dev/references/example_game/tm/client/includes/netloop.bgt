void netloop()
{
e=n.request();
if (e.type==event_disconnect)
{
speak("you have lost your connection to the server or may be something about your internet, please wait while trying to reconnect");
reset_network();
login();
}
if (e.type==event_receive)
{
if(e.channel==9)
{
string[]parsed=string_split(get_event_message()," ",true);
if(parsed[0]=="ogg_stationary" and parsed.length()>1) {
string oggdata=string_replace(get_event_message(), parsed[0]+" ", "", true);
p.play_stationary(oggdata, false, true); }
if(parsed[0]=="ogg_file")
{
int oggx=stn(parsed[1]);
int oggy=stn(parsed[2]);
int oggz=stn(parsed[3]);
string oggmap=parsed[4];
string recorddata=string_replace(get_event_message(),parsed[0]+" "+parsed[1]+" "+parsed[2]+" "+parsed[3]+" "+parsed[4]+" ","",true);
if(mapname==oggmap)
{
p.play_3d(recorddata,me.x,me.y,me.z,oggx,oggy,oggz,calculate_theta(facing), false, true);
}
}
}
if (e.channel==0)
{
string[] parsed=string_split(get_event_message()," ",true);
if(parsed[0]=="step")
{
int x=string_to_number(parsed[1]);
int y=string_to_number(parsed[2]);
int z=string_to_number(parsed[3]);
string map=parsed[4];
if(parsed[5]!=name and mapname==map)
{
p.play_3d(get_tile_at(x, y, z)+"step"+random(1, 5)+".ogg", me.x, me.y, me.z, x, y, z, calculate_theta(facing), false);
if(lookname==parsed[5])
{
me.x=x;
me.y=y;
me.z=z;
mpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
p.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
sourcepool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
shdistpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
distpool.update_listener_3d(me.x, me.y, me.z, calculate_theta(facing));
}
}
}
else if(parsed[0]=="usewand")
{
wandmenu();
}
else if(parsed[0]=="crystal_teleport")
{
crystaltellymenu();
}
else if(parsed[0]=="teleport")
{
tellymenu();
}
else if(parsed[0]=="meleegifts")
{
giftmenu();
}

else if(parsed[0]=="arenagifts")
{
giftmenu();
}
else if(parsed[0]=="sheltermenu")
{
sheltermenu();
}
else if(parsed[0]=="megamenu")
{
megamenu();
}
else if(parsed[0]=="plane_crash")
{
in_plane=false;
go_out=true;
}
else if(parsed[0]=="start_the_plane")
{
pause_all_sources();
splaneloop();
}
else if(parsed[0]=="start_plane")
{
pause_all_sources();
planeloop();
}
else if(parsed[0]=="sc")
{
if(can_stop==true)
{
can_stop=false;
}
else if(can_stop==false)
{
can_stop=true;
}
}
else if(parsed[0]=="store")
{
string final=string_replace(get_event_message(),"store ","",false);
store_menu(final);
}
else if(parsed[0]=="energystart")
{
walktime=90;
}
else if(parsed[0]=="energystop")
{
walktime=180;
}
else if(parsed[0]=="timebend")
{
walktime=230;
}
else if(parsed[0]=="timeresume")
{
walktime=180;
}
else if(parsed[0]=="jumpstart")
{
jumptime=290;
kangaroo=true;
}
else if(parsed[0]=="jumpstop")
{
jumptime=130;
kangaroo=false;;
}

else if(parsed[0]=="biciclet")
{
if(skateboard==true)
{
send(0, "noskateboard", 0);
}
else
{
skateboard=true;
p.play_stationary("skateboardstart.ogg",false);
}
}
else if(parsed[0]=="skateboard_stop")
{
skateboard=false;
}
else if(parsed[0]=="sitstart")
{
sitting=1;
}
else if(parsed[0]=="sitstop")
{
sitting=0;
}
else if(parsed[0]=="weaponlist" and parsed.length()>1)
{
weapons.resize(0);
w=0;
for(uint i=1; i<parsed.length(); i++)
{
weapons.insert_last(parsed[i]);
}
}
else if(parsed[0]=="weapondata" and parsed.length()>2)
{
firetime=stn(parsed[1]);
weaponauto=(parsed[2]=="auto" ? true : false);
}
else if(parsed[0]=="draw" and parsed.length()>1)
{
weapons.insert_last(parsed[1]);
w=(weapons.length()-1);
speak(weapons[w]);
send(0,"draw "+weapons[w],0);
}
else if(parsed[0]=="playerlog")
{
file lf;
lf.open("players.log","wb");
lf.write(string_replace(get_event_message(),"playerlog ","",false));
lf.close();
speak("log written");
}
else if(parsed[0]=="robotcontrol")
{
robotcontroling=true;
}
else if(parsed[0]=="invstring")
{
inv=string_decompress(string_trim_left(get_event_message(), 10));
invchanged=true;
}
else if(parsed[0]=="upload" and parsed.length()>=2)
{
bool atempbool=false;
int atempint=string_to_number(parsed[1]);
if(atempint==1) atempbool=true;
uploadfile();
}
else if(parsed[0]=="buildzone")
{
binput@ dat=builder_input("minx=enter the left x of your zone" + "\n" +
"maxx=enter the right x of your zone" + "\n" +
"miny=enter the minimum y of your zone" + "\n" +
"maxy=enter the maximum y of your zone" + "\n" +
"minz=enter the bottom z of your zone" + "\n" +
"maxz=enter the top z of your zone" + "\n" +
"text=enter the text of your zone");
if(@dat!=null)
{
string temp="";
int trackable=yesno("would you like this zone to be trackable via the grave menu?");
if(trackable==1) temp="@trackme@";
						send(0,"addzone zone:"+dat.num("minx")+":"+dat.num("maxx")+":"+dat.num("miny")+":"+dat.num("maxy")+":"+dat.num("minz")+":"+dat.num("maxz")+":"+dat.str("text")+(trackable==1 ? "@trackme@" : ""),0);
}
}
				else if(parsed[0]=="buildcp")
{
send(0,"addcp checkpoint:"+round(mr.x,0)+":"+round(mr.y,0)+":"+round(me.z,0),0);
}
				else if(parsed[0]=="buildsign")
				{
binput@ dat=builder_input("x=enter the x of your sign" + "\n" +
"y=enter the y of your sign" + "\n" +
"z=enter the z of your sign" + "\n" +
"text=enter the text of your sign");
					if(@dat!=null)
					{
send(0,"addsign sign:"+dat.num("x")+":"+dat.num("y")+":"+dat.num("z")+":"+dat.str("text"),0);
					}
				}
				else if(parsed[0]=="buildclock")
				{
binput@ dat=builder_input("x=enter the x of this clock" + "\n" +
"y=enter the y of this clock" + "\n" +
"z=enter the z of this clock" + "\n" +
"text=Enter the text that will be used to announced the time, For example. The clock says");
					if(@dat!=null)
					{
send(0,"addclock clock:"+dat.num("x")+":"+dat.num("y")+":"+dat.num("z")+":"+dat.str("text"),0);
					}
				}
				else if(parsed[0]=="buildcalander")
				{
binput@ dat=builder_input("x=enter the x of this calander" + "\n" +
"y=enter the y of this calander" + "\n" +
"z=enter the z of this calander" + "\n" +
"text=Enter the text that will be used to announced the date, For example. today is");
					if(@dat!=null)
					{
send(0,"addcalander calander:"+dat.num("x")+":"+dat.num("y")+":"+dat.num("z")+":"+dat.str("text"),0);
					}
				}
				else if(parsed[0]=="buildpiano")
				{
binput@ dat=builder_input("x=enter the x of this piano" + "\n" +
"y=enter the y of this piano" + "\n" +
"z=enter the z of this piano");
					if(@dat!=null)
					{
send(0,"addpiano piano:"+dat.num("x")+":"+dat.num("y")+":"+dat.num("z"),0);
					}
				}

				else if(parsed[0]=="builddoor")
				{
binput@ dat=builder_input("minx=enter the minimum x of this door" + "\n" +
"maxx=enter the maximum x of this door" + "\n" +
"miny=enter the minimum y of this door" + "\n" +
"maxy=enter the maximum y of this door" + "\n" +
"minz=enter the bottom z of this door" + "\n" +
"maxz=enter the top z of this door" + "\n" +
"dx=enter the x of the destination" + "\n" +
"dy=enter the y of the destination" + "\n" +
"dz=enter the z of the destination" + "\n" +
"s=enter the speed to move the player to the destination in Milliseconds (1000=1second)");
					if(@dat==null) 
					{
						return;
					}
					string s1=dloop();
					if(s1.is_empty())
					{
						speak("canceled, no looping sound that will hear it near the door");
						return;
					}
					string s2=drmoving();
					if(s2.is_empty())
					{
						speak("canceled, i can't find the door sound while move the player");
						return;
					}
					string s3=dropen();
					if(s3.is_empty())
					{
						speak("canceled! I can't find the door open sound while click enteriin to the door! ");
						return;
					}
					string s4=drclose();
					if(s4.is_empty())
					{
						speak("canceled! I can't find the door close sound!");
						return;
					}
string pcode;
					int locked=qa("Do you need to add a passcode to this door to lock it?","yes, i need","no, i dont need it, dont tell to me");
					if(locked==1) 
					{
						pcode=v.input("Type the passcode to lock this door.",false);
					}
					send(0,"adddoor door:"+dat.num("minx")+":"+dat.num("maxx")+":"+dat.num("miny")+":"+dat.num("maxy")+":"+dat.num("minz")+":"+dat.num("maxz")+":"+dat.num("dx")+":"+dat.num("dy")+":"+dat.num("dz")+":"+dat.num("s")+":"+s1+".ogg"+":"+s2+".ogg"+":"+s3+".ogg"+":"+s4+".ogg"+(locked==1 ? ":"+pcode:""),0);
				}
else if(parsed[0]=="buildtpoint")
{
binput@ dat=builder_input("minx=enter the left x of this travelpoint" + "\n" +
"maxx=enter the right x of this travelpoint" + "\n" +
"miny=enter the minimum y of this travelpoint" + "\n" +
